---
import SectionHeader from "./SectionHeader.astro";
import { useSanityClient, groq } from "astro-sanity";

const skillquery = groq`*[_type == "skillsSection"] {
  ...,
  logoCase[]-> {
    adminstrativetitle,
    Logo {
      ...,
      asset-> {
        ...,
        url,
      }
    }
  }
}[0]`;

let skillsData = null;
try {
  skillsData = await useSanityClient().fetch(skillquery);
} catch (err) {
  console.warn("Could not fetch skillsSection from Sanity:", err);
}

const rawLogos = skillsData?.logoCase || [];

// Map Sanity logo entries cleanly
const sanityLogoMap = new Map<string, string>();
rawLogos.forEach((item: any) => {
  const title = (item?.adminstrativetitle || item?.Logo?.alt || "").toLowerCase();
  const url = item?.Logo?.asset?.url;
  if (!url) return;
  if (title.includes('react')) sanityLogoMap.set('react', url);
  else if (title.includes('node')) sanityLogoMap.set('node', url);
  else if (title.includes('redux')) sanityLogoMap.set('redux', url);
  else if (title.includes('graphql')) sanityLogoMap.set('graphql', url);
  else if (title.includes('rest')) sanityLogoMap.set('rest', url);
  else if (title.includes('sanity')) sanityLogoMap.set('sanity', url);
  else if (title.includes('contentful')) sanityLogoMap.set('contentful', url);
  else if (title.includes('js') || title.includes('javascript')) sanityLogoMap.set('js', url);
  else if (title.includes('html')) sanityLogoMap.set('html', url);
  else if (title.includes('css')) sanityLogoMap.set('css', url);
});

// Streamlined, human-psychology-optimized skill categories (scannable in 3 seconds)
const skillGroups = [
  {
    title: "Frontend",
    subtitle: "Web & Reactive UI",
    icon: "code",
    skills: [
      { name: "React", logo: sanityLogoMap.get('react'), color: "#61DAFB", highlight: true },
      { name: "Next.js", color: "#FFFFFF", highlight: true },
      { name: "TypeScript", color: "#3178C6", highlight: true },
      { name: "Tailwind CSS", color: "#38BDF8" },
      { name: "JavaScript", logo: sanityLogoMap.get('js'), color: "#F7DF1E" },
      { name: "Redux", logo: sanityLogoMap.get('redux'), color: "#764ABC" },
      { name: "Astro", color: "#FF5D01" },
      { name: "HTML5 / CSS3", logo: sanityLogoMap.get('html'), color: "#E34F26" }
    ]
  },
  {
    title: "Backend & APIs",
    subtitle: "Services & Logic",
    icon: "server",
    skills: [
      { name: "Node.js", logo: sanityLogoMap.get('node'), color: "#47A248", highlight: true },
      { name: "Express.js", color: "#FFFFFF", highlight: true },
      { name: "REST APIs", logo: sanityLogoMap.get('rest'), color: "#6366F1", highlight: true },
      { name: "GraphQL", logo: sanityLogoMap.get('graphql'), color: "#E10098" },
      { name: "WebSockets", color: "#06B6D4" },
      { name: "Microservices", color: "#A855F7" }
    ]
  },
  {
    title: "Data & CMS",
    subtitle: "Storage & Content",
    icon: "database",
    skills: [
      { name: "PostgreSQL", color: "#336791", highlight: true },
      { name: "MongoDB", color: "#47A248", highlight: true },
      { name: "Sanity CMS", logo: sanityLogoMap.get('sanity'), color: "#F03E2F", highlight: true },
      { name: "Prisma ORM", color: "#2D3748" },
      { name: "Redis", color: "#DC2626" },
      { name: "Contentful", logo: sanityLogoMap.get('contentful'), color: "#2478CC" }
    ]
  },
  {
    title: "AI & Cloud",
    subtitle: "Intelligence & Ops",
    icon: "cpu",
    skills: [
      { name: "OpenAI API", color: "#10A37F", highlight: true },
      { name: "Claude 3.5", color: "#D97706", highlight: true },
      { name: "RAG Pipelines", color: "#5E6AD2", highlight: true },
      { name: "Docker", color: "#2496ED" },
      { name: "Netlify / Vercel", color: "#00C7B7" },
      { name: "Git / CI/CD", color: "#F05032" }
    ]
  }
];
---

<section id="skills" class="py-16 md:py-24 relative z-10 border-t border-border-subtle">
  <div class="container mx-auto px-4 md:px-8 max-w-7xl">
    
    <!-- Clean, Focused Section Header (Low Cognitive Load) -->
    <div class="max-w-3xl mb-12 md:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-primary/10 border border-accent-primary/20 mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-accent-primary"></span>
        <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-accent-primary font-semibold">Capabilities</span>
      </div>
      <h2 class="text-3xl md:text-5xl font-black text-white tracking-tight leading-tight">
        Core <span class="text-gradient">Expertise</span>
      </h2>
      <p class="mt-3 text-text-muted text-sm md:text-base leading-relaxed">
        The core technologies, frameworks, and architectural tools I use to ship production software.
      </p>
    </div>

    <!-- 4 Clean, Scannable Domain Cards (Parsed in 3 Seconds) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
      {skillGroups.map((group) => (
        <div class="group relative rounded-2xl bg-surface-card border border-white/10 p-6 flex flex-col justify-between hover:border-accent-primary/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-black/40">
          
          <!-- Subtle Top Ambient Glow on Hover -->
          <div class="absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-transparent via-accent-primary/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

          <div>
            <!-- Group Header -->
            <div class="flex items-center justify-between pb-4 mb-5 border-b border-white/5">
              <div>
                <h3 class="text-lg font-bold text-white tracking-tight group-hover:text-accent-primary transition-colors">
                  {group.title}
                </h3>
                <span class="text-[11px] font-mono text-text-dim block mt-0.5">
                  {group.subtitle}
                </span>
              </div>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-md bg-white/5 text-text-muted">
                {group.skills.length} tools
              </span>
            </div>

            <!-- Instant-Recognition Tech Chips -->
            <div class="flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <div 
                  class={`flex items-center gap-2 px-3 py-2 rounded-xl text-xs font-semibold tracking-wide transition-all duration-200 border cursor-default select-none ${
                    skill.highlight
                      ? 'bg-white/[0.05] border-white/12 text-white hover:border-accent-primary/60 hover:bg-white/[0.09]'
                      : 'bg-white/[0.02] border-white/5 text-text-muted hover:border-white/20 hover:text-white'
                  }`}
                >
                  <!-- Real Logo or Brand Accent Dot -->
                  {skill.logo ? (
                    <img 
                      src={skill.logo} 
                      alt={`${skill.name} logo`} 
                      width="16" 
                      height="16" 
                      loading="lazy" 
                      decoding="async" 
                      class="w-4 h-4 object-contain rounded-sm"
                    />
                  ) : (
                    <span 
                      class="w-2 h-2 rounded-full shrink-0" 
                      style={`background-color: ${skill.color}; box-shadow: 0 0 8px ${skill.color}80;`}
                    ></span>
                  )}
                  <span class="whitespace-nowrap">{skill.name}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Subtle Bottom Indicator -->
          <div class="mt-6 pt-3 border-t border-white/5 flex items-center justify-between text-[10px] font-mono text-text-dim">
            <span>Production Verified</span>
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400/80"></span>
          </div>

        </div>
      ))}
    </div>

    <!-- Quick Architectural Focus Bar (Clean & Reassuring) -->
    <div class="mt-8 p-4 md:p-5 rounded-2xl bg-white/[0.02] border border-white/5 flex flex-col md:flex-row items-center justify-between gap-4 text-xs font-mono text-text-muted">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-accent-primary"></span>
        <span class="text-white font-semibold">Primary Daily Driver:</span>
        <span class="text-text-primary">TypeScript • React / Next.js • Node.js • PostgreSQL</span>
      </div>
      <div class="flex items-center gap-6 text-[11px] text-text-dim">
        <span>⚡ Sub-100ms APIs</span>
        <span>•</span>
        <span>🔒 Strict Type Safety</span>
        <span>•</span>
        <span>🤖 Production AI Integrations</span>
      </div>
    </div>

  </div>
</section>
