---
import { optimizeSanityImage } from "../lib/optimizeImage";
import type { TemplateItem } from "../lib/templates";

interface Props {
  template: TemplateItem;
  index?: number;
}

const { template, index = 0 } = Astro.props;

const rawImageUrl = template.imageUrl || "/img/custom-project.webp";
const imageUrl = rawImageUrl.includes("cdn.sanity.io") 
  ? optimizeSanityImage(rawImageUrl, 1000, 80)
  : rawImageUrl;

const price = template.price || "$49";
const originalPrice = template.originalPrice;
const tags = template.tags?.slice(0, 4) || ["Next.js", "Tailwind CSS", "TypeScript"];
const highlights = template.highlights?.slice(0, 3) || [];
---

<article 
  class="template-card group rounded-2xl p-1.5 bg-white/[0.04] border border-white/10 hover:border-accent-primary/60 transition-all duration-500 shadow-card flex flex-col justify-between"
  data-category={template.category?.toLowerCase() || "general"}
  data-tags={tags.join(",").toLowerCase()}
  data-aos="fade-up" 
  data-aos-delay={index * 90}
>
  <div class="rounded-xl bg-surface-card h-full w-full overflow-hidden flex flex-col justify-between border border-white/[0.05] shadow-[inset_0_1px_0_0_rgba(255,255,255,0.08)]">
    
    <!-- Image Header with Floating Badges -->
    <div class="relative overflow-hidden w-full aspect-[16/10] bg-surface-elevated border-b border-border-subtle">
      <a href={`/templates/${template.slug.current}`} aria-label={`View ${template.templateName} details`} class="block w-full h-full cursor-pointer overflow-hidden">
        {imageUrl ? (
          <img 
            src={imageUrl} 
            alt={template.templateName}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105 opacity-90 group-hover:opacity-100"
          />
        ) : (
          <div class="w-full h-full flex items-center justify-center bg-surface-elevated text-text-dim font-mono text-xs">
            Template Preview
          </div>
        )}
      </a>

      <!-- Overlay Badges -->
      <div class="absolute top-3 left-3 flex items-center gap-2 pointer-events-none">
        {template.badge && (
          <span class="px-2.5 py-1 rounded-full text-[10px] font-mono uppercase tracking-wider bg-accent-primary text-white font-semibold shadow-lg shadow-accent-primary/20">
            {template.badge}
          </span>
        )}
        <span class="px-2.5 py-1 rounded-full text-[10px] font-mono uppercase tracking-wider bg-black/70 backdrop-blur-md text-text-muted border border-white/10">
          Commercial License
        </span>
      </div>

      <!-- Price Pill Floating Top Right -->
      <div class="absolute top-3 right-3 pointer-events-none">
        <div class="px-3 py-1 rounded-full bg-black/80 backdrop-blur-md border border-white/15 flex items-baseline gap-1.5 shadow-xl">
          <span class="text-sm font-bold text-white font-mono">{price}</span>
          {originalPrice && (
            <span class="text-[11px] line-through text-text-dim font-mono">{originalPrice}</span>
          )}
        </div>
      </div>
    </div>

    <!-- Content Body -->
    <div class="p-6 md:p-7 flex-1 flex flex-col justify-between">
      <div>
        <!-- Tech Stack Tags -->
        <div class="flex flex-wrap gap-1.5 mb-4">
          {tags.map((tag: string) => (
            <span class="text-[10px] font-mono px-2.5 py-1 rounded-md bg-white/[0.05] border border-white/10 text-text-muted">
              {tag}
            </span>
          ))}
        </div>

        <!-- Title & Tagline -->
        <h3 class="text-xl font-bold text-text-primary tracking-tight transition-colors group-hover:text-white mb-2">
          <a href={`/templates/${template.slug.current}`} class="hover:text-accent-primary transition-colors">
            {template.templateName}
          </a>
        </h3>

        <p class="text-xs md:text-sm text-text-muted leading-relaxed line-clamp-2 mb-5">
          {template.tagline}
        </p>

        <!-- Bullet Highlights -->
        {highlights.length > 0 && (
          <ul class="space-y-1.5 pt-4 border-t border-border-subtle/60 mb-6">
            {highlights.map((item: string) => (
              <li class="flex items-center gap-2 text-[11px] text-text-muted">
                <svg class="w-3.5 h-3.5 text-accent-primary flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <span class="truncate">{item}</span>
              </li>
            ))}
          </ul>
        )}
      </div>

      <!-- Action Footer -->
      <div class="pt-4 border-t border-border-subtle flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          {template.demoLink && (
            <a 
              href={template.demoLink}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-xl text-xs font-semibold bg-white/5 border border-white/10 text-text-muted hover:text-white hover:bg-white/10 hover:border-white/20 transition-all flex items-center gap-1.5"
            >
              <span>Live Demo</span>
              <span class="text-[10px]">↗</span>
            </a>
          )}
          <a 
            href={`/templates/${template.slug.current}`}
            class="px-3 py-2 text-xs font-mono text-text-dim hover:text-text-primary transition-colors"
          >
            Details
          </a>
        </div>

        {template.gumroadLink ? (
          <a 
            href={template.gumroadLink}
            target="_blank"
            rel="noopener noreferrer"
            class="group/btn px-5 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider bg-accent-primary hover:bg-accent-hover text-white transition-all duration-300 shadow-md shadow-accent-primary/25 flex items-center justify-center gap-2"
          >
            <span>Get Template</span>
            <span class="w-5 h-5 rounded-full bg-white/20 flex items-center justify-center text-[10px] transition-transform duration-300 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5">
              ↗
            </span>
          </a>
        ) : (
          <a 
            href={`/templates/${template.slug.current}`}
            class="px-5 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider bg-accent-primary text-white hover:bg-accent-hover transition-colors text-center"
          >
            Learn More
          </a>
        )}
      </div>
    </div>

  </div>
</article>
