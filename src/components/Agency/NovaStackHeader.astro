---
// NovaStack Studio Header: Clean Sticky Navigation with Mobile Menu
// Unified Brand Palette: Obsidian #09090B, Neutral Surfaces #FFFFFF / #F4F4F5, Linear Indigo #5E6AD2
interface Props {
  logoUrl?: string;
  logoAlt?: string;
  brandName?: string;
  tagline?: string;
  logoFullWidth?: boolean;
}

const {
  logoUrl = "",
  logoAlt = "NovaStack Studio Logo",
  brandName = "NovaStack Studio",
  tagline = "Software Development Studio",
  logoFullWidth = false,
} = Astro.props;

const navLinks = [
  { label: "Services", href: "#services" },
  { label: "Work", href: "#work" },
  { label: "Process", href: "#process" },
  { label: "About", href: "#about" },
  { label: "Contact", href: "#contact" },
];
---

<header
  class="sticky top-0 z-50 w-full bg-white/90 backdrop-blur-md border-b border-[#E4E4E7] transition-all duration-200"
  id="agency-header"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 sm:h-[72px] items-center justify-between gap-4">

      <!-- 1. Brand Logo / Wordmark -->
      <div class="flex items-center">
        <a href="/agency" class="group flex items-center gap-2.5 text-decoration-none">
          {logoUrl ? (
            <img
              src={logoUrl}
              alt={logoAlt}
              class={logoFullWidth ? "h-8 sm:h-9 w-auto max-w-[170px] object-contain" : "h-8 sm:h-9 w-8 sm:w-9 rounded-xl object-contain bg-[#F4F4F5] border border-[#E4E4E7] p-1 group-hover:border-[#5E6AD2] transition-colors"}
              loading="eager"
              decoding="async"
            />
          ) : (
            <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-[#09090B] text-white flex items-center justify-center font-grotesk font-extrabold text-sm sm:text-base group-hover:bg-[#5E6AD2] transition-colors">
              N<span class="text-[#A5AEF3]">S</span>
            </div>
          )}
          {!(logoUrl && logoFullWidth) && (
            <div class="flex flex-col">
              <span class="font-grotesk font-extrabold text-base sm:text-lg tracking-tight text-[#09090B]">
                NovaStack<span class="text-[#5E6AD2]">.</span>
              </span>
              <span class="text-[9px] font-mono uppercase tracking-[0.14em] text-[#71717A] -mt-0.5 hidden sm:block">
                Founder-Led Studio
              </span>
            </div>
          )}
        </a>
      </div>

      <!-- 2. Desktop Navigation Links (5 Crisp Links) -->
      <nav aria-label="Agency Navigation" class="hidden md:flex items-center gap-7 lg:gap-9">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-xs font-grotesk font-semibold uppercase tracking-[0.08em] text-[#52525B] hover:text-[#09090B] transition-colors py-2"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- 3. Desktop Action Buttons (Decluttered: Portfolio + Primary CTA) -->
      <div class="hidden sm:flex items-center gap-2.5">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full border border-[#E4E4E7] bg-white hover:bg-[#F4F4F5] text-[11px] font-mono text-[#52525B] hover:text-[#09090B] transition-all"
          title="Tanuj Pandey Personal Portfolio"
        >
          <span>Portfolio</span>
          <span class="text-[#5E6AD2]">↗</span>
        </a>

        <a
          href="#contact"
          class="group inline-flex items-center justify-center gap-2.5 pl-5 pr-2.5 py-2 rounded-full bg-[#09090B] hover:bg-[#5E6AD2] text-white font-grotesk font-bold text-xs uppercase tracking-wider transition-all active:scale-[0.98]"
        >
          <span>Start a Project</span>
          <span class="w-6 h-6 rounded-full bg-white text-[#09090B] group-hover:text-[#5E6AD2] flex items-center justify-center text-xs font-bold transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
        </a>
      </div>

      <!-- 4. Mobile Menu Trigger Button -->
      <div class="flex items-center gap-2 sm:hidden">
        <a
          href="#contact"
          class="inline-flex items-center justify-center px-3.5 py-1.5 rounded-full bg-[#09090B] text-white font-grotesk font-bold text-xs uppercase tracking-wider"
        >
          Start
        </a>
        <button
          type="button"
          id="agency-menu-open-btn"
          aria-label="Open mobile navigation menu"
          aria-expanded="false"
          class="w-10 h-10 rounded-xl bg-[#F4F4F5] border border-[#E4E4E7] flex flex-col items-center justify-center gap-1 text-[#09090B] hover:bg-zinc-200 transition-colors"
        >
          <span class="w-4 h-0.5 bg-[#09090B] rounded-full"></span>
          <span class="w-4 h-0.5 bg-[#09090B] rounded-full"></span>
          <span class="w-4 h-0.5 bg-[#09090B] rounded-full"></span>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Navigation Overlay & Drawer -->
  <div
    id="agency-mobile-menu"
    class="fixed inset-0 z-50 bg-[#09090B]/50 backdrop-blur-sm hidden sm:hidden transition-opacity"
    aria-hidden="true"
  >
    <div
      class="absolute top-0 right-0 w-[84%] max-w-sm h-full bg-white border-l border-[#E4E4E7] shadow-2xl p-6 flex flex-col justify-between overflow-y-auto"
      id="agency-mobile-drawer"
    >
      <div>
        <div class="flex items-center justify-between pb-5 border-b border-[#E4E4E7] mb-6">
          <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-lg bg-[#09090B] text-white flex items-center justify-center font-grotesk font-bold text-xs">
              N<span class="text-[#A5AEF3]">S</span>
            </div>
            <span class="font-grotesk font-bold text-base text-[#09090B]">NovaStack Studio</span>
          </div>
          <button
            type="button"
            id="agency-menu-close-btn"
            aria-label="Close mobile navigation menu"
            class="w-9 h-9 rounded-lg bg-[#F4F4F5] border border-[#E4E4E7] text-[#09090B] flex items-center justify-center text-sm font-mono font-bold hover:bg-zinc-200 cursor-pointer"
          >
            ✕
          </button>
        </div>

        <nav class="space-y-1">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="agency-mobile-nav-link flex items-center justify-between px-3.5 py-3 rounded-xl font-grotesk font-semibold text-base text-[#09090B] hover:bg-[#F4F4F5] hover:text-[#5E6AD2] transition-colors"
            >
              <span>{link.label}</span>
              <span class="text-xs text-[#71717A]">→</span>
            </a>
          ))}
        </nav>
      </div>

      <div class="pt-6 border-t border-[#E4E4E7] space-y-3">
        <a
          href="#contact"
          class="agency-mobile-nav-link w-full py-3.5 rounded-full bg-[#5E6AD2] hover:bg-[#4E5AC2] text-white font-grotesk font-bold text-xs uppercase tracking-wider text-center flex items-center justify-center gap-2 transition-colors"
        >
          <span>Start a Project</span>
          <span>↗</span>
        </a>
        <a
          href="/"
          class="w-full py-2.5 rounded-full bg-[#F4F4F5] border border-[#E4E4E7] text-[#09090B] font-mono text-xs text-center block hover:bg-zinc-200 transition-colors"
        >
          Founder Portfolio (tanujbuilds.site) ↗
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const setupAgencyMobileNav = () => {
    const openBtn = document.getElementById("agency-menu-open-btn");
    const closeBtn = document.getElementById("agency-menu-close-btn");
    const menu = document.getElementById("agency-mobile-menu");
    const drawer = document.getElementById("agency-mobile-drawer");
    const links = document.querySelectorAll(".agency-mobile-nav-link");

    if (!openBtn || !closeBtn || !menu || !drawer || openBtn.dataset.bound === "true") return;
    openBtn.dataset.bound = "true";

    const openMenu = () => {
      menu.classList.remove("hidden");
      openBtn.setAttribute("aria-expanded", "true");
      menu.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    };

    const closeMenu = () => {
      menu.classList.add("hidden");
      openBtn.setAttribute("aria-expanded", "false");
      menu.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    };

    openBtn.addEventListener("click", openMenu);
    closeBtn.addEventListener("click", closeMenu);

    menu.addEventListener("click", (e) => {
      if (e.target === menu) closeMenu();
    });

    links.forEach((link) => {
      link.addEventListener("click", closeMenu);
    });
  };

  setupAgencyMobileNav();
  document.addEventListener("astro:page-load", setupAgencyMobileNav);
</script>
