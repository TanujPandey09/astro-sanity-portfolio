---
import { optimizeSanityImage } from "../lib/optimizeImage";

const { project, index } = Astro.props;

const projectName = project?.projectName || "Custom SaaS Product";

let excerpt = "End-to-end production architecture built for speed, reliability, and scale.";
if (Array.isArray(project?.excerpt)) {
  const textBlocks = project.excerpt
    .flatMap((b: any) => b?.children?.map((c: any) => c?.text) || [])
    .filter((t: string) => t && t.trim().length > 0 && !t.includes('🚀'));
  if (textBlocks.length > 0) {
    excerpt = textBlocks.sort((a: string, b: string) => b.length - a.length)[0];
  }
} else if (typeof project?.excerpt === 'string') {
  excerpt = project.excerpt;
}

const rawImageUrl = project?.BackgroundImage?.asset?.url || "/img/custom-project.webp";
const imageUrl = optimizeSanityImage(rawImageUrl, 1200, 80);

const rawTags = project?.tags || project?.techStack || [];
const tags = Array.isArray(rawTags) && rawTags.length > 0 ? rawTags : ['Full-Stack', 'Production', 'SaaS'];

const demoHref = typeof project?.demoLink === 'string' ? project.demoLink : project?.demoLink?.current;

// Bento layout spans (Explicit mobile aspect ratios + desktop bento spans)
const bentoIndex = index % 4;
let bentoGridClasses = "col-span-1 ";
if (bentoIndex === 0) {
  bentoGridClasses += "md:col-span-2 md:row-span-2 md:min-h-[560px] flex flex-col";
} else if (bentoIndex === 1) {
  bentoGridClasses += "md:col-span-1 md:row-span-1 md:min-h-[340px] flex flex-col";
} else if (bentoIndex === 2) {
  bentoGridClasses += "md:col-span-1 md:row-span-1 md:min-h-[340px] flex flex-col";
} else {
  bentoGridClasses += "md:col-span-3 md:row-span-1 md:min-h-[320px] flex flex-col";
}
---

{bentoIndex === 3 ? (
  /* Wide Horizontal Bento Card (Stacks Image on Top on Mobile, Side-by-Side on Desktop) */
  <div class={`project-item group rounded-2xl p-1.5 bg-white/[0.03] border border-white/[0.09] hover:border-border-hover transition-all duration-500 shadow-card ${bentoGridClasses}`} data-aos="fade-up" data-aos-delay={index * 70}>
    <div class="rounded-xl bg-surface-card h-full w-full overflow-hidden grid grid-cols-1 md:grid-cols-12 border border-white/[0.05] shadow-[inset_0_1px_0_0_rgba(255,255,255,0.08)]">
      <!-- Image Side (First on Mobile, Right on Desktop) -->
      <a href={`/projects/${project.slug?.current}`} class="order-1 md:order-2 md:col-span-5 relative overflow-hidden w-full aspect-[16/10] md:aspect-auto md:h-full md:min-h-[240px] border-b md:border-b-0 md:border-l border-border-subtle bg-surface-elevated block">
        {imageUrl ? (
          <img 
            src={imageUrl} 
            alt={projectName}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 opacity-90 group-hover:opacity-100"
          />
        ) : (
          <div class="w-full h-full bg-surface-elevated"></div>
        )}
      </a>

      <!-- Text Side -->
      <div class="order-2 md:order-1 md:col-span-7 p-5 sm:p-7 md:p-9 flex flex-col justify-between z-10 w-full h-full">
        <div>
          <div class="flex items-center justify-between mb-4 sm:mb-5">
            <div class="flex flex-wrap gap-1.5 sm:gap-2">
              {tags.slice(0, 3).map((tech: string) => (
                <span class="text-[10px] sm:text-[11px] font-mono px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-md bg-white/[0.04] border border-border-subtle text-text-muted">
                  {tech}
                </span>
              ))}
            </div>
            <span class="text-xs font-mono tabular-nums text-text-dim">/ {String(index + 1).padStart(2, "0")}</span>
          </div>

          <a href={`/projects/${project.slug?.current}`} class="block group/title">
            <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-text-primary tracking-tight transition-colors group-hover/title:text-white">
              {projectName}
            </h3>
            <p class="mt-2 sm:mt-3 text-xs sm:text-sm text-text-muted font-normal leading-relaxed max-w-xl line-clamp-3 md:line-clamp-none">
              {excerpt}
            </p>
          </a>
        </div>

        <div class="mt-5 sm:mt-6 pt-3.5 sm:pt-4 border-t border-border-subtle flex items-center justify-between gap-4">
          <a href={`/projects/${project.slug?.current}`} class="inline-flex items-center gap-2 text-xs font-mono font-medium text-accent-primary group-hover:text-accent-hover transition-colors">
            <span>View Case Study</span>
            <span class="transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-0.5">↗</span>
          </a>
          {demoHref && (
            <a href={demoHref} target="_blank" rel="noopener noreferrer" class="text-[11px] font-mono text-text-muted hover:text-text-primary transition-colors">
              Live Demo ↗
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
) : (
  /* Standard / Focus Vertical Bento Card */
  <div class={`project-item group rounded-2xl p-1.5 bg-white/[0.03] border border-white/[0.09] hover:border-border-hover transition-all duration-500 shadow-card ${bentoGridClasses}`} data-aos="fade-up" data-aos-delay={index * 70}>
    <div class="rounded-xl bg-surface-card h-full w-full overflow-hidden flex flex-col justify-between border border-white/[0.05] shadow-[inset_0_1px_0_0_rgba(255,255,255,0.08)]">
      <!-- Image Container: Fixed 16:10 aspect ratio on mobile, percentage height on desktop -->
      <a href={`/projects/${project.slug?.current}`} class={`relative overflow-hidden w-full aspect-[16/10] md:aspect-auto ${bentoIndex === 0 ? 'md:h-[58%]' : 'md:h-[48%]'} border-b border-border-subtle bg-surface-elevated block shrink-0`}>
        {imageUrl ? (
          <img 
            src={imageUrl} 
            alt={projectName}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 opacity-90 group-hover:opacity-100"
          />
        ) : (
          <div class="w-full h-full bg-surface-elevated"></div>
        )}
      </a>

      <!-- Text Container -->
      <div class="p-5 sm:p-6 md:p-8 flex-1 flex flex-col justify-between z-10">
        <div>
          <div class="flex items-center justify-between mb-3.5 sm:mb-4">
            <div class="flex flex-wrap gap-1.5">
              {tags.slice(0, 3).map((tech: string) => (
                <span class="text-[10px] font-mono px-2 py-0.5 rounded-md bg-white/[0.04] border border-border-subtle text-text-muted">
                  {tech}
                </span>
              ))}
            </div>
            <span class="text-xs font-mono tabular-nums text-text-dim">/ {String(index + 1).padStart(2, "0")}</span>
          </div>

          <a href={`/projects/${project.slug?.current}`} class="block group/title">
            <h3 class="text-lg md:text-xl font-bold text-text-primary tracking-tight transition-colors group-hover/title:text-white">
              {projectName}
            </h3>
            <p class="mt-2 text-xs md:text-sm text-text-muted font-normal leading-relaxed line-clamp-2">
              {excerpt}
            </p>
          </a>
        </div>

        <div class="mt-4 pt-3.5 border-t border-border-subtle flex items-center justify-between gap-2">
          <a href={`/projects/${project.slug?.current}`} class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-accent-primary group-hover:text-white transition-colors">
            <span>View Case Study</span>
            <span class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
          </a>
          {demoHref && (
            <a href={demoHref} target="_blank" rel="noopener noreferrer" class="text-[11px] font-mono text-text-muted hover:text-text-primary transition-colors">
              Live ↗
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
)}

<style>
  .project-item {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s;
  }
  .project-item:hover {
    transform: translateY(-4px);
  }
</style>
