---
interface Props {
  title: string;
  gradientText?: string;
  subtitle?: string;
  eyebrow?: string;
  center?: boolean;
}

const { title, gradientText, subtitle, eyebrow = "SHOWCASE", center = false } = Astro.props;
const formattedEyebrow = eyebrow.toUpperCase().replace(/^REC:\s*/i, "");
---

<div class={`mb-8 sm:mb-10 lg:mb-12 ${center ? "text-center flex flex-col items-center" : ""}`} data-gsap-heading>
  <div class={`flex items-center gap-2.5 mb-3 ${center ? "justify-center" : ""}`}>
    <span class="w-5 h-px bg-[#5E6AD2]" aria-hidden="true"></span>
    <span class="text-[11px] sm:text-xs font-mono font-semibold tracking-[0.14em] text-[#5E6AD2] uppercase">
      {formattedEyebrow}
    </span>
  </div>

  <div class={`w-full ${center ? "flex flex-col items-center text-center" : "flex flex-col lg:flex-row lg:items-end justify-between gap-4 lg:gap-10"}`}>
    <h2 class="font-grotesk font-bold tracking-[-0.03em] leading-[1.08] text-3xl sm:text-4xl lg:text-[46px] text-[#0F172A]">
      <span>{title}</span>
      {gradientText && (
        <span class="text-[#5E6AD2]"> {gradientText}</span>
      )}
    </h2>

    {subtitle && (
      <p class={`max-w-md text-slate-600 text-sm sm:text-[15px] font-normal leading-[1.65] tracking-[-0.01em] ${center ? "mt-3 mx-auto text-center" : "lg:text-right"}`}>
        {subtitle}
      </p>
    )}
  </div>
</div>
