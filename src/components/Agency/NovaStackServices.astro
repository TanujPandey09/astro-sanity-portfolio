---
// NovaStack Agency Services Section: 6 Professional Disciplines
const services = [
  {
    id: "web-development",
    category: "Full-Stack Web Engineering",
    title: "Web Development",
    summary: "Production-ready web applications, fast corporate sites, and complex web software built for high conversions, accessibility, and speed.",
    deliverables: [
      "Custom Next.js & React Web Applications",
      "Enterprise & B2B Corporate Websites",
      "E-Commerce & High-Conversion Storefronts",
      "SaaS Customer & Administrative Portals",
      "Internal Business Dashboards & Analytics",
      "Headless CMS Integrations (Sanity, Strapi)"
    ],
    techStack: ["Next.js", "React 19", "TypeScript", "Tailwind CSS", "Node.js", "REST/GraphQL"],
    idealFor: "Startups launching new platforms and established companies upgrading legacy web software."
  },
  {
    id: "mobile-development",
    category: "Cross-Platform Mobile Engineering",
    title: "Mobile App Development",
    summary: "Cross-platform mobile applications for iOS and Android powered by React Native, delivering native performance and synchronized cloud state.",
    deliverables: [
      "Cross-Platform iOS & Android Applications",
      "React Native & Expo Ecosystem Builds",
      "Offline Data Synchronization & SQLite Storage",
      "Hardware Integrations (Camera, Biometrics, GPS)",
      "Push Notification & Event Stream Pipelines",
      "App Store & Google Play Store Publishing"
    ],
    techStack: ["React Native", "Expo EAS", "TypeScript", "Native Modules", "Redux/Zustand"],
    idealFor: "Businesses requiring unified mobile experiences without the overhead of two separate native codebases."
  },
  {
    id: "ai-automation",
    category: "Intelligent Systems & Applied AI",
    title: "AI & Automation",
    summary: "Production LLM orchestration, intelligent conversational agents, and automated workflows that eliminate manual friction in business operations.",
    deliverables: [
      "Autonomous Multi-Agent AI Workflows",
      "Conversational AI Chatbots & Support Automation",
      "Multi-Provider LLM Routing (OpenAI, Claude, Gemini)",
      "Contextual Retrieval-Augmented Generation (RAG)",
      "Document Extraction & Data Processing Pipelines",
      "Structured JSON Validation & Guardrails"
    ],
    techStack: ["OpenAI GPT-4o", "Claude 3.5", "Gemini 1.5", "Pinecone/Vector DBs", "LangChain/LlamaIndex"],
    idealFor: "Companies seeking to automate repetitive support or operations with deterministic, hallucination-resistant AI."
  },
  {
    id: "saas-software",
    category: "Product Engineering & Architecture",
    title: "SaaS & Custom Software",
    summary: "From zero to production launch: multi-tenant SaaS MVPs, bespoke CRM systems, and scalable subscription platforms.",
    deliverables: [
      "Rapid SaaS MVP Architecture & Launch (4–8 Weeks)",
      "Bespoke CRM & Pipeline Management Systems",
      "Multi-Role Access Control (RBAC) & Team Workspaces",
      "Subscription Billing (Stripe, MyFatoorah, Lemon Squeezy)",
      "Real-Time State Synchronization via WebSockets",
      "Audit Logging, Webhook Handlers & Rate Limiting"
    ],
    techStack: ["PostgreSQL", "Prisma ORM", "Node.js / Express", "Redis", "Socket.IO", "Stripe API"],
    idealFor: "Founders taking a product idea to market or companies replacing fragmented off-the-shelf software."
  },
  {
    id: "seo-geo",
    category: "Discovery & Answer Engine Optimization",
    title: "SEO & GEO (Generative Engine Optimization)",
    summary: "Technical site architecture, schema engineering, and content modeling designed for traditional search engines and emerging AI answer engines.",
    deliverables: [
      "Core Web Vitals & Sub-Second Page Speed Tuning",
