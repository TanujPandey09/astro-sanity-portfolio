<script>
  // Robust Client-Side Category Filtering, Search, and View Mode Switcher
  const initTemplateDirectory = () => {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>("#template-filters .filter-btn");
    const searchInput = document.getElementById("template-search-input") as HTMLInputElement | null;
    const cards = document.querySelectorAll<HTMLElement>(".template-card");
    const rows = document.querySelectorAll<HTMLElement>(".template-row");
    const noTemplatesState = document.getElementById("no-templates-state");
    const resetBtn = document.getElementById("reset-search-btn");
    const visibleCountEl = document.getElementById("templates-visible-count");

    const gridView = document.getElementById("templates-grid-view");
    const listView = document.getElementById("templates-list-view");
    const gridBtn = document.getElementById("view-grid-btn");
    const listBtn = document.getElementById("view-list-btn");

    let currentFilter = "all";
    let currentSearch = "";

    // 1. View Mode Persistence & Switching
    const setViewMode = (mode: "grid" | "list") => {
      try {
        localStorage.setItem("templates_view_mode", mode);
      } catch (e) {}

      if (mode === "grid") {
        gridView?.classList.remove("hidden");
        listView?.classList.add("hidden");

        gridBtn?.classList.add("active", "bg-white", "text-[#0F172A]", "shadow-xs");
        gridBtn?.classList.remove("text-slate-600");
        listBtn?.classList.remove("active", "bg-white", "text-[#0F172A]", "shadow-xs");
        listBtn?.classList.add("text-slate-600");
      } else {
        gridView?.classList.add("hidden");
        listView?.classList.remove("hidden");

        listBtn?.classList.add("active", "bg-white", "text-[#0F172A]", "shadow-xs");
        listBtn?.classList.remove("text-slate-600");
        gridBtn?.classList.remove("active", "bg-white", "text-[#0F172A]", "shadow-xs");
        gridBtn?.classList.add("text-slate-600");
      }
    };

    gridBtn?.addEventListener("click", () => setViewMode("grid"));
    listBtn?.addEventListener("click", () => setViewMode("list"));

    try {
      const savedMode = localStorage.getItem("templates_view_mode") as "grid" | "list" | null;
      if (savedMode === "list") {
        setViewMode("list");
      } else {
        setViewMode("grid");
      }
    } catch (e) {
      setViewMode("grid");
    }

    // 2. Dual Filtering (Card & Row items)
    const applyFilters = () => {
      let visibleCount = 0;

      const filterItem = (el: HTMLElement) => {
        const category = (el.dataset.category || "").toLowerCase();
        const tags = (el.dataset.tags || "").toLowerCase();
        const name = (el.dataset.name || "").toLowerCase();
        const text = (el.textContent || "").toLowerCase();

        const matchesCategory = 
          currentFilter === "all" || 
          category === currentFilter ||
          category.includes(currentFilter) || 
          tags.includes(currentFilter);

        const matchesSearch = 
          !currentSearch || 
          name.includes(currentSearch) || 
          text.includes(currentSearch) ||
          category.includes(currentSearch) ||
          tags.includes(currentSearch);

        return matchesCategory && matchesSearch;
      };

      cards.forEach((card) => {
        if (filterItem(card)) {
          card.style.display = "flex";
          visibleCount++;
        } else {
          card.style.display = "none";
        }
      });

      rows.forEach((row) => {
        if (filterItem(row)) {
          row.style.display = "flex";
        } else {
          row.style.display = "none";
        }
      });

      if (visibleCountEl) {
        visibleCountEl.textContent = String(visibleCount);
      }

      if (noTemplatesState) {
        if (visibleCount === 0) {
          noTemplatesState.classList.remove("hidden");
        } else {
          noTemplatesState.classList.add("hidden");
        }
      }
    };

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        filterButtons.forEach((b) => {
          b.classList.remove("active", "bg-[#0F172A]", "text-white", "shadow-xs");
          b.classList.add("bg-slate-100", "border", "border-black/[0.08]", "text-slate-700");
        });

        btn.classList.add("active", "bg-[#0F172A]", "text-white", "shadow-xs");
        btn.classList.remove("bg-slate-100", "border", "border-black/[0.08]", "text-slate-700");

        currentFilter = (btn.dataset.filter || "all").toLowerCase();
        applyFilters();
      });
    });

    searchInput?.addEventListener("input", () => {
      currentSearch = (searchInput.value || "").trim().toLowerCase();
      applyFilters();
    });

    resetBtn?.addEventListener("click", () => {
      currentFilter = "all";
      currentSearch = "";
      if (searchInput) searchInput.value = "";
      
      const allBtn = document.querySelector<HTMLButtonElement>('.filter-btn[data-filter="all"]');
      allBtn?.click();
    });

    // 3. FAQ Accordion Handling
    const accordionToggles = document.querySelectorAll<HTMLButtonElement>(".faq-accordion-toggle");
    accordionToggles.forEach((btn) => {
      btn.addEventListener("click", () => {
        const isExpanded = btn.getAttribute("aria-expanded") === "true";
        const body = btn.nextElementSibling as HTMLElement | null;
        const icon = btn.querySelector(".faq-accordion-icon") as HTMLElement | null;

        if (isExpanded) {
          btn.setAttribute("aria-expanded", "false");
          body?.classList.add("hidden");
          icon?.classList.remove("rotate-180");
        } else {
          btn.setAttribute("aria-expanded", "true");
          body?.classList.remove("hidden");
          icon?.classList.add("rotate-180");
        }
      });
    });
  };

  initTemplateDirectory();
  document.addEventListener("astro:after-swap", initTemplateDirectory);
  document.addEventListener("astro:page-load", initTemplateDirectory);
</script>
