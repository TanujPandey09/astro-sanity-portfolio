---
import Header from "../components/Header.astro";
import Loader from "../components/Loader.astro";
import Footer from "../components/Footer.astro";
import QuickContactDrawer from "../components/QuickContactDrawer.astro";
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article" | "profile";
  noindex?: boolean;
  schemaType?: "WebPage" | "ProfilePage" | "CollectionPage" | "AboutPage";
  keywords?: string | string[];
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    section?: string;
    tags?: string[];
  };
  breadcrumbs?: Array<{ name: string; path: string }>;
  jsonLd?: Record<string, any> | Record<string, any>[];
  hideDefaultHeader?: boolean;
  hideDefaultFooter?: boolean;
  isAgency?: boolean;
}
const siteUrl = "https://tanujbuilds.site";
const defaultDescription = "Tanuj Pandey is a Full-Stack & AI Engineer (4+ years experience) building multi-LLM SaaS platforms, real-time Node.js backends, high-performance Next.js & React applications, and commercial website templates.";
const defaultKeywords = "Tanuj Pandey, Full Stack Engineer, AI Solutions Architect, React Developer, Next.js Developer, Astro, Node.js, TypeScript, Sanity CMS, Commercial Website Templates, Next.js Templates, Luxury Real Estate Website Template, Dental Clinic Website Template, SaaS Engineer India";
const defaultOgImage = `${siteUrl}/og-image-dark.png`;

const { 
  title, 
  description = defaultDescription,
  image = defaultOgImage,
  type,
  noindex = false,
  schemaType,
  keywords,
  article,
  breadcrumbs,
  jsonLd,
  hideDefaultHeader = false,
  hideDefaultFooter = false,
  isAgency = false,
} = Astro.props;

const resolvedTitle = (typeof title === "string" && title.trim())
  ? title.trim()
  : "Tanuj Pandey | Full-Stack & AI Engineer";

const resolvedKeywords = Array.isArray(keywords)
  ? keywords.join(", ")
  : keywords || defaultKeywords;

const pathname = Astro.url.pathname;
const isHome = pathname === "/" || pathname === "";
const canonicalPath = pathname === "/" || pathname === "" ? "/" : pathname.replace(/\/+$/, "");
const canonicalURL = new URL(canonicalPath, siteUrl).href;

// Ensure og:image is always an absolute URL and sized for social previews
const resolvedImage = image.startsWith('http') ? image : `${siteUrl}${image.startsWith('/') ? '' : '/'}${image}`;
const isSanityImage = resolvedImage.includes('cdn.sanity.io');
const ogImage = isSanityImage
  ? `${resolvedImage}${resolvedImage.includes('?') ? '&' : '?'}fm=jpg&fit=crop&w=1200&h=630&q=80`
  : resolvedImage;
const resolvedImagePath = resolvedImage.split('?')[0];
const hasKnownImageDimensions = isSanityImage || resolvedImagePath === `${siteUrl}/og-image-dark.png`;
const ogImageType = isSanityImage
  ? 'image/jpeg'
  : /\.png$/i.test(resolvedImagePath)
    ? 'image/png'
    : /\.webp$/i.test(resolvedImagePath)
      ? 'image/webp'
      : 'image/jpeg';
const ogType = type ?? (pathname.startsWith('/blogs/') && pathname !== '/blogs/' ? 'article' : 'website');
const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const personId = `${siteUrl}/#person`;
const websiteId = `${siteUrl}/#website`;
const webpageId = `${canonicalURL}#webpage`;
const additionalNodes = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : Array.isArray((jsonLd as any)["@graph"])
      ? (jsonLd as any)["@graph"]
      : [jsonLd]
  : [];
const primaryNode = additionalNodes.find((node: any) => node?.['@id'] && node?.['@type'] !== 'BreadcrumbList');
const pageSchemaType = schemaType || (isHome ? 'ProfilePage' : 'WebPage');
const pageSchema = {
  "@type": pageSchemaType,
  "@id": webpageId,
  "url": canonicalURL,
  "name": resolvedTitle,
  "description": description,
  "isPartOf": { "@id": websiteId },
  "inLanguage": "en-US",
  ...(primaryNode
    ? { mainEntity: { "@id": primaryNode['@id'] } }
    : pageSchemaType === 'ProfilePage'
      ? { mainEntity: { "@id": personId } }
      : { about: { "@id": personId } }),
};
const breadcrumbSchema = breadcrumbs?.length
  ? {
      "@type": "BreadcrumbList",
      "@id": `${canonicalURL}#breadcrumb`,
      itemListElement: breadcrumbs.map((crumb, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: crumb.name,
        item: new URL(crumb.path, siteUrl).href,
      })),
    }
  : null;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      "name": "Tanuj Pandey",
      "alternateName": ["Tanuj", "Tanuj Builds"],
      "jobTitle": "Full Stack Engineer & AI Solutions Architect",
      "description": "Full Stack Engineer with 4+ years of professional experience building high-performance web applications, scalable APIs, and intelligent AI chatbot workflows.",
      "url": siteUrl,
      "image": defaultOgImage,
      "email": "mailto:tanujp09@gmail.com",
      "nationality": "Indian",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Pauri Garhwal",
        "addressRegion": "Uttarakhand",
        "addressCountry": "India"
      },
      "sameAs": [
        "https://github.com/TanujPandey09",
        "https://www.linkedin.com/in/tanujdev/",
        "https://x.com/TanujPandey",
        siteUrl
      ],
      "knowsAbout": [
        "Full Stack Web Development",
        "Multi-LLM Orchestration (OpenAI, Gemini, Grok, Perplexity)",
        "React.js & Next.js (SSR/SSG)",
        "Astro.js Modern Architecture",
        "Node.js, Express.js & Socket.IO Real-Time Backends",
        "TypeScript & JavaScript",
        "PostgreSQL, MongoDB & Prisma ORM",
        "Sanity CMS, Contentful & Strapi Headless Modeling",
        "Tailwind CSS Design Systems",
        "Commercial Next.js & React Website Templates",
        "REST & GraphQL APIs",
        "Web Performance & Core Web Vitals Optimization"
      ],
      "worksFor": {
        "@type": "Organization",
        "name": "Cxisuite",
        "url": "https://cxisuite.com/"
      },
      "makesOffer": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Custom Full-Stack SaaS & Web Application Development",
            "description": "End-to-end SaaS architecture using Next.js, React, Node.js, TypeScript, and PostgreSQL."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Multi-LLM AI Integration & Agentic Workflows",
            "description": "Production LLM pipelines, RAG architectures, output validation, and bilingual RTL AI interfaces."
          }
        },
        {
          "@type": "Offer",
          "url": `${siteUrl}/templates`,
          "itemOffered": {
            "@type": "Service",
            "name": "Commercial Next.js & React Website Templates",
            "description": "Production-ready Next.js, React, and Tailwind CSS templates with 99+ Lighthouse scores and commercial licenses."
          }
        }
      ]
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      "url": siteUrl,
      "name": "Tanuj Pandey | Full Stack Engineer & AI Solutions Architect",
      "description": "Official portfolio of Tanuj Pandey featuring full stack web engineering projects, technical case studies, and modern web applications.",
      "publisher": { "@id": personId },
      "inLanguage": "en-US"
    },
    pageSchema,
    ...(breadcrumbSchema ? [breadcrumbSchema] : []),
    ...additionalNodes,
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{resolvedTitle}</title>
    <meta name="description" content={description} />
    <!-- Core SEO & Search Indexing -->
    <meta name="keywords" content={resolvedKeywords} />
    <meta name="author" content="Tanuj Pandey" />
    <meta name="creator" content="Tanuj Pandey" />
    <meta name="publisher" content="Tanuj Pandey" />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <meta name="bingbot" content={robotsContent} />
    <meta name="theme-color" content="#0F121C" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title="Tanuj Pandey — Blog" href={`${siteUrl}/rss.xml`} />
    <link rel="alternate" type="text/plain" title="LLMs Context & Entity Index" href={`${siteUrl}/llms.txt`} />
    <link rel="alternate" type="text/plain" title="LLMs Full Knowledge Base" href={`${siteUrl}/llms-full.txt`} />
    <link rel="manifest" href="/manifest.webmanifest" />
    {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION} />
    )}
    {import.meta.env.PUBLIC_BING_SITE_VERIFICATION && (
      <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_SITE_VERIFICATION} />
    )}
    
    <!-- Open Graph (OG) / Social Media Previews (LinkedIn, WhatsApp, Facebook) -->
    <meta property="og:site_name" content="Tanuj Pandey | Full Stack Engineer" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    {hasKnownImageDimensions && <meta property="og:image:width" content="1200" />}
    {hasKnownImageDimensions && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_US" />
    {article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
    {article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
    {article?.author && <meta property="article:author" content={article.author} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    
    <!-- Twitter / X Card Previews -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="twitter:creator" content="@TanujPandey" />
    <meta name="twitter:site" content="@TanujPandey" />

    <!-- Official Brand Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    
    <!-- Google Fonts Preconnect & Stylesheet (Geist, Plus Jakarta Sans, Space Grotesk, Geist Mono, Great Vibes) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&family=Geist+Mono:wght@400;500;600&family=Great+Vibes&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />

    <!-- Structured Data: JSON-LD for Search Engines & AI Engines (AEO / GEO) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

    <!-- Dynamic Web Analytics (GA4, SPA-aware) -->
    {import.meta.env.PUBLIC_GA_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_ID}`} is:inline></script>
        <script
          is:inline
          data-ga-id={import.meta.env.PUBLIC_GA_ID}
          set:html={`
(function () {
  var id = document.currentScript && document.currentScript.getAttribute("data-ga-id");
  if (!id) return;
  window.dataLayer = window.dataLayer || [];
  window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
  gtag("js", new Date());
  gtag("config", id, { send_page_view: false });
  if (window.__gaTrackingBound) return;
  window.__gaTrackingBound = true;
  document.addEventListener("astro:page-load", function () {
    gtag("event", "page_view", {
      page_location: window.location.href,
      page_path: window.location.pathname + window.location.search,
      page_title: document.title
    });
  });
  document.addEventListener("click", function (event) {
    var target = event.target;
    var link = target && target.closest ? target.closest('a[href^="http"]') : null;
    if (!link || link.hostname === window.location.hostname) return;
    gtag("event", "outbound_click", { link_url: link.href, link_domain: link.hostname });
  });
})();
`}
        ></script>
      </>
    )}
    <!-- Prevent Loader flash on repeat visits / navigation -->
    <script is:inline>
      try {
        if (sessionStorage.getItem('tp_intro_loaded')) {
          document.documentElement.classList.add('preloader-done');
        }
      } catch (e) {}
    </script>
  </head>

  <body>
    <!-- Accessibility Skip Link -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:px-4 focus:py-2 focus:bg-white focus:text-black focus:font-bold focus:rounded-full focus:shadow-xl">
      Skip to main content
    </a>

    <!-- Magnificent Lightweight Intro Loader (Home page only) -->
    {isHome && <Loader />}

    <!-- Top Navigation Header -->
    {!hideDefaultHeader && <Header />}

    <main id="main-content">
      <slot />
    </main>

    {!hideDefaultFooter && <Footer />}
    {!isAgency && <QuickContactDrawer />}

    <!-- Global Demo Video Lightbox Modal (On-Demand Video Playback, Zero Autoplay/Refresh Conflict) -->
    <div
      id="global-demo-modal"
      class="fixed inset-0 z-[120] hidden items-center justify-center bg-[#0A0B0E]/85 p-4 sm:p-8"
      role="dialog"
      aria-modal="true"
      aria-labelledby="global-demo-modal-title"
    >
      <div class="relative w-full max-w-5xl rounded-2xl bg-white border border-black/10 overflow-hidden shadow-2xl">
        <div class="px-5 py-3.5 border-b border-black/[0.08] flex items-center justify-between gap-4 bg-slate-50">
          <div class="flex items-center gap-2.5 min-w-0">
            <span class="w-2 h-2 rounded-full bg-[#5E6AD2] shrink-0"></span>
            <span id="global-demo-modal-title" class="font-grotesk font-bold text-sm sm:text-base text-[#0F172A] truncate">
              Product Demo Walkthrough
            </span>
          </div>
          <button
            type="button"
            id="close-global-demo-modal"
            aria-label="Close demo video"
            class="px-3.5 py-1.5 rounded-lg bg-white border border-black/10 hover:border-[#5E6AD2] hover:text-[#5E6AD2] text-xs font-mono font-semibold text-[#0F172A] cursor-pointer transition-colors"
          >
            Close ✕
          </button>
        </div>
        <div id="global-demo-modal-body" class="relative w-full aspect-video bg-[#0A0B0E] flex items-center justify-center"></div>
      </div>
    </div>

    {!isAgency && (
      <div id="magnetic-cursor" class="cursor flex items-center justify-center overflow-hidden">
        <span id="cursor-label" class="cursor-label hidden text-[10px] font-mono font-bold tracking-wider uppercase text-white whitespace-nowrap px-2.5"></span>
      </div>
    )}
    {!isAgency && <div class="cursor2"></div>}
  </body>
</html>

<style is:global>
  @import 'aos/dist/aos.css';

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  *:focus-visible {
    outline: 2px solid var(--accent-primary, #5E6AD2);
    outline-offset: 4px;
    border-radius: 4px;
  }

  body {
    overflow-x: hidden;
    height: 100%;
    width: 100%;
  }

  /* Custom Minimalist Scrollbar */
  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  ::-webkit-scrollbar-track {
    background: #FAFAFB;
  }
  ::-webkit-scrollbar-thumb {
    background: rgba(15, 23, 42, 0.16);
    border-radius: 6px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #5E6AD2;
  }

  :root {
    /* CodeOfSagar Inspired Light Studio Editorial Design Tokens */
    --canvas-bg-rgb: 250 250 251;       /* #FAFAFB - Crisp Off-White Chalk Canvas */
    --surface-card-rgb: 255 255 255;    /* #FFFFFF - Pure Crisp White Card Surface */
    --surface-elevated-rgb: 241 245 249;/* #F1F5F9 - Subtle Elevated Surface */
    --text-primary-rgb: 15 23 42;       /* #0F172A - Deep Charcoal Ink */
    
    /* Developer High-Tech Accent System */
    --accent-primary-rgb: 94 106 210;   /* #5E6AD2 - Linear Indigo */
    --accent-cyan-rgb: 51 65 85;        /* #334155 - Slate */
    --status-live-rgb: 16 185 129;      /* #10B981 - Developer Emerald Live */

    --canvas-bg: #FAFAFB;
    --surface-card: #FFFFFF;
    --surface-elevated: #F1F5F9;
    
    --border-subtle: rgba(15, 23, 42, 0.08);
    --border-hover: rgba(94, 106, 210, 0.45);
    
    --text-primary: #0F172A;
    --text-muted: #475569;              /* Readable Cool Slate Gray */
    --text-dim: #64748B;                /* Tech Slate Metadata */
    
    --accent-primary: #5E6AD2;
    --accent-hover: #4854B8;
    --accent-glow: rgba(94, 106, 210, 0.14);
    --accent-cyan: #334155;
    --status-live: #10B981;

    /* Legacy Fallback Mappings */
    --primary-color: var(--accent-primary);
    --secondary-color: var(--accent-cyan);
    --accent-color: var(--accent-primary);
    --bg-dark: var(--surface-card);
    --bg-deep: var(--canvas-bg);
    --border-color: var(--border-subtle);

    /* Headings - Mobile */
    --h1-mobile: 2.25rem;      
    --h2-mobile: 1.75rem;   
    --h3-mobile: 1.5rem;    
    --h4-mobile: 1.25rem;   
    --h5-mobile: 1.125rem;  
    --h6-mobile: 1rem;      

    /* Paragraph - Mobile */
    --p-mobile: 0.95rem;       
    --small-mobile: 0.85rem; 
    --xs-mobile: 0.75rem;   

    /* Desktop Sizes */
    --h1-desktop: 4rem;   
    --h2-desktop: 2.75rem;   
    --h3-desktop: 2rem;     
    --h4-desktop: 1.5rem;   
    --h5-desktop: 1.25rem;  
    --h6-desktop: 1rem;     

    --p-desktop: 1.05rem;  
    --small-desktop: 0.95rem;  
    --xs-desktop: 0.85rem; 

    /* Line Heights */
    --line-height-tight: 1.15;
    --line-height-normal: 1.6;
    --line-height-relaxed: 1.75;
    --line-height-loose: 2;

    /* Letter Spacing */
    --letter-spacing-tight: -0.03em;
    --letter-spacing-normal: 0;
    --letter-spacing-wide: 0.05em;
    --letter-spacing-wider: 0.1em;

    /* Font Weights */
    --fw-light: 300;
    --fw-normal: 400;
    --fw-medium: 500;
    --fw-semibold: 600;
    --fw-bold: 700;
    --fw-black: 900;
  }

  /* Global Typography Reset */
  html {
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    scroll-behavior: smooth;
    overflow-x: clip;
    max-width: 100vw;
    width: 100%;
  }

  body {
    overflow-x: clip;
    max-width: 100vw;
    width: 100%;
    position: relative;
    background-color: var(--bg-deep);
    color: var(--text-muted);
    font-family: 'Geist', 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    font-size: var(--p-mobile);
    line-height: var(--line-height-normal);
  }

  body:has(.agency-page),
  body.agency-page-body {
    background-color: #FAFAFB !important;
    color: #0F172A !important;
  }

  #main-content {
    overflow-x: clip;
    max-width: 100vw;
    width: 100%;
  }

  /* Ensure [data-aos] elements are ALWAYS visible and never trapped at opacity: 0 */
  [data-aos] {
    opacity: 1 !important;
    transform: none !important;
    visibility: visible !important;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: var(--fw-black);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
  }

  :where(h1, h2, h3, h4, h5, h6):not([class*="text-"]) {
    color: var(--text-primary);
  }

  :where(h1):not([class*="text-"]) { font-size: var(--h1-mobile); }
  :where(h2):not([class*="text-"]) { font-size: var(--h2-mobile); }
  :where(h3):not([class*="text-"]) { font-size: var(--h3-mobile); }
  :where(h4):not([class*="text-"]) { font-size: var(--h4-mobile); }
  :where(h5):not([class*="text-"]) { font-size: var(--h5-mobile); }
  :where(h6):not([class*="text-"]) { font-size: var(--h6-mobile); }

  :where(p):not([class*="text-"]) {
    font-size: var(--p-mobile);
    line-height: var(--line-height-relaxed);
    color: var(--text-muted);
  }

  @media (min-width: 1024px) {
    body { font-size: var(--p-desktop); }
    :where(h1):not([class*="text-"]) { font-size: var(--h1-desktop); }
    :where(h2):not([class*="text-"]) { font-size: var(--h2-desktop); }
    :where(h3):not([class*="text-"]) { font-size: var(--h3-desktop); }
    :where(h4):not([class*="text-"]) { font-size: var(--h4-desktop); }
    :where(h5):not([class*="text-"]) { font-size: var(--h5-desktop); }
    :where(h6):not([class*="text-"]) { font-size: var(--h6-desktop); }
    :where(p):not([class*="text-"]) { font-size: var(--p-desktop); }
  }

  .cursor {
    width: 24px;
    height: 24px;
    border-radius: 9999px;
    border: 1px solid rgba(15, 23, 42, 0.35);
    background-color: transparent;
    transition: width 0.22s cubic-bezier(0.16, 1, 0.3, 1), 
                height 0.22s cubic-bezier(0.16, 1, 0.3, 1), 
                background-color 0.22s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.22s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    position: fixed;
    pointer-events: none;
    left: 0;
    top: 0;
    transform: translate(-50%, -50%);
    z-index: 9999;
    will-change: transform, width, height;
  }

  .cursor.is-pill {
    width: auto !important;
    min-width: 140px;
    height: 38px !important;
    padding: 0 16px;
    background-color: rgba(15, 23, 42, 0.94) !important;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(15, 23, 42, 0.2) !important;
    box-shadow: 0 16px 36px rgba(15, 23, 42, 0.22);
    color: #FFFFFF !important;
  }

  .cursor.is-hover {
    width: 52px;
    height: 52px;
    background-color: rgba(94, 106, 210, 0.08) !important;
    border-color: rgba(94, 106, 210, 0.6) !important;
  }

  .cursor2 {
    width: 6px;
    height: 6px;
    border-radius: 100%;
    background-color: #0F172A;
    position: fixed;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 9999;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .cursorinnerhover {
    width: 4px;
    height: 4px;
    background-color: #0F172A;
  }

  /* CodeOfSagar High-Contrast Deep Ink Gradient */
  .text-gradient {
    background: linear-gradient(135deg, #0F172A 15%, #334155 55%, #5E6AD2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Shared Iridescent Liquid Drapery Art (Arshawn Arbabi Hero Aesthetic) */
  .liquid-aurora {
    background: 
      radial-gradient(circle at 18% 25%, rgba(220, 38, 38, 0.72) 0%, transparent 45%),
      radial-gradient(circle at 45% 15%, rgba(245, 158, 11, 0.82) 0%, transparent 40%),
      radial-gradient(circle at 75% 20%, rgba(13, 148, 136, 0.68) 0%, transparent 50%),
      radial-gradient(circle at 90% 35%, rgba(94, 106, 210, 0.8) 0%, transparent 45%),
      linear-gradient(135deg, #180d2b 0%, #291218 35%, #0f2228 70%, #0a0b0e 100%);
    filter: blur(45px);
    animation: auroraFlow 18s ease-in-out infinite alternate;
  }

  @keyframes auroraFlow {
    0% {
      transform: scale(1.05) translate(0%, 0%) rotate(0deg);
      filter: blur(45px) hue-rotate(0deg);
    }
    50% {
      transform: scale(1.15) translate(-2%, 3%) rotate(1.5deg);
      filter: blur(55px) hue-rotate(15deg);
    }
    100% {
      transform: scale(1.08) translate(2%, -2%) rotate(-1deg);
      filter: blur(48px) hue-rotate(-15deg);
    }
  }

  /* Developer Live Status Pulse Indicator (Emerald Glow) */
  @keyframes ct-rec-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.9); }
  }

  .rec-dot {
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background-color: var(--status-live, #10B981);
    display: inline-block;
    flex-shrink: 0;
    box-shadow: 0 0 10px rgba(16, 185, 129, 0.7);
    animation: ct-rec-pulse 1.8s ease-in-out infinite;
  }

  /* Rushes Vertical Rolling Text Micro-Interaction */
  .rushes-roll {
    position: relative;
    display: inline-flex;
    overflow: hidden;
    line-height: 1.15;
  }
  .rushes-roll-track {
    display: inline-flex;
    flex-direction: column;
    transition: transform 0.42s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  .rushes-roll-track > span:last-child {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
  }
  .group:hover .rushes-roll-track,
  .rushes-roll:hover .rushes-roll-track {
    transform: translateY(-100%);
  }

  /* Premium Card (Glassmorphism & Depth) */
  .glass-card {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.10);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.08), 0 8px 32px -4px rgba(0, 0, 0, 0.5);
    border-radius: 2rem;
  }

  .bg-surface-card {
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.06), 0 8px 24px -4px rgba(0, 0, 0, 0.4);
  }

  /* Clean Card Container (No blueish radial hover overlay glitch) */
  .bento-spotlight {
    position: relative;
    overflow: hidden;
  }

  @media only screen and (max-width: 1024px) {
    .cursor, .cursor2 {
      display: none !important;
    }
  }

 
  @media only screen and (max-width: 768px) {
    body {
      background: var(--bg-deep);
      background-repeat: no-repeat;
      height: 100%;
      animation: none; /* Disable animation on mobile devices */
    }

    /* Add additional mobile styles if needed */

    /* ....Projects Cards */

    /* .....Blog details */

    .blog-content a {
      color: var(--accent-color);
    }

    .blog-content a:hover {
      color: var(--bg2);
      transition: all ease-in 0.5s;
      text-decoration: underline;
    }
  }
</style>

<style is:global>
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
    [data-aos] {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  import Lenis from 'lenis';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import AOS from 'aos';

  gsap.registerPlugin(ScrollTrigger);

  // Respect the OS "reduce motion" setting: collapse GSAP tweens to near-instant
  // and turn off smooth-scroll hijacking. Content still appears and scroll still works.
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReducedMotion) {
    gsap.globalTimeline.timeScale(100);
  }

  // When AOS is disabled (mobile) it strips the [data-aos] attributes once and
  // never enables its MutationObserver. Strip [data-aos] on mobile viewports
  // BEFORE initializing AOS so off-axis transforms never widen the mobile viewport.
  const isAOSDisabled = () =>
    window.matchMedia('(max-width: 767px)').matches ||
    /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);

  const stripMobileAOS = () => {
    if (isAOSDisabled()) {
      document.querySelectorAll('[data-aos]').forEach((el) => {
        el.removeAttribute('data-aos');
        el.removeAttribute('data-aos-delay');
        el.removeAttribute('data-aos-duration');
        el.removeAttribute('data-aos-easing');
      });
    }
  };

  stripMobileAOS();

  // Initialize AOS locally (disabled on <768px viewports and mobile devices)
  AOS.init({ once: true, duration: 600, disable: isAOSDisabled });

  const syncAOS = () => {
    if (isAOSDisabled()) {
      stripMobileAOS();
    } else {
      AOS.refreshHard();
    }
  };

  syncAOS();
  document.addEventListener('astro:after-swap', syncAOS);
  document.addEventListener('astro:page-load', syncAOS);

  // Initialize Lenis smooth scroll
  const lenis = new Lenis({
    duration: 1.2,
    easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    orientation: 'vertical',
    gestureOrientation: 'vertical',
    smoothWheel: !prefersReducedMotion,
  });

  // Sync ScrollTrigger with Lenis
  lenis.on('scroll', ScrollTrigger.update);

  gsap.ticker.add((time) => {
    lenis.raf(time * 1000);
  });

  gsap.ticker.lagSmoothing(0);

  // Intercept anchor clicks for #contact and /#contact for smooth local scroll
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const link = target.closest('a');
    if (!link) return;

    const href = link.getAttribute('href');
    if (!href) return;

    if (href === '#contact' || (href === '/#contact' && (window.location.pathname === '/' || window.location.pathname === ''))) {
      const contactSection = document.getElementById('contact');
      if (contactSection) {
        e.preventDefault();
        lenis.scrollTo(contactSection, {
          duration: 1.5,
          offset: -50,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t))
        });
      }
    }
  });

  // Handle hash scrolling on page load/navigation
  const checkHashAndScroll = () => {
    if (window.location.hash === '#contact') {
      const contactSection = document.getElementById('contact');
      if (contactSection) {
        setTimeout(() => {
          lenis.scrollTo(contactSection, {
            duration: 1.5,
            offset: -50,
            immediate: false
          });
        }, 400); // Wait for animations to settle
      }
    }
  };

  window.addEventListener('load', checkHashAndScroll);
  document.addEventListener('astro:after-swap', checkHashAndScroll);

  // If not on homepage, dispatch portfolio-loaded immediately to trigger header/nav animations
  window.addEventListener('load', () => {
    window.dispatchEvent(new Event('portfolio-loaded'));
  });

  document.addEventListener('astro:after-swap', () => {
    window.dispatchEvent(new Event('portfolio-loaded'));
  });

  let cursor = document.querySelector(".cursor");
  let cursorinner = document.querySelector(".cursor2");

  const initCursor = () => {
    cursor = document.querySelector(".cursor");
    cursorinner = document.querySelector(".cursor2");
    
    // Hide cursor on mobile
    if (window.innerWidth < 1024) {
      if (cursor) (cursor as HTMLElement).style.display = 'none';
      if (cursorinner) (cursorinner as HTMLElement).style.display = 'none';
    }
  };

  initCursor();
  document.addEventListener('astro:after-swap', initCursor);

  let mouseX = 0;
  let mouseY = 0;

  document.addEventListener("mousemove", (e) => {
    mouseX = e.clientX;
    mouseY = e.clientY;
    if (!cursor || !cursorinner) return;

    gsap.to(cursor, {
      x: mouseX,
      y: mouseY,
      duration: 0.5,
      ease: "power2.out"
    });

    gsap.to(cursorinner, {
      x: mouseX,
      y: mouseY,
      duration: 0.1
    });
  });

  document.addEventListener("mousedown", () => {
    if (!cursor || !cursorinner) return;
    gsap.to(cursor, { scale: 0.8, duration: 0.3 });
    gsap.to(cursorinner, { scale: 2, duration: 0.3 });
  });

  document.addEventListener("mouseup", () => {
    if (!cursor || !cursorinner) return;
    gsap.to(cursor, { scale: 1, duration: 0.3 });
    gsap.to(cursorinner, { scale: 1, duration: 0.3 });
  });

  // High-End Lerp Cursor Interaction (Awwwards Style: Arshawn Arbabi & Code of Sagar)
  document.addEventListener("mouseover", (e) => {
    if (!cursor || window.innerWidth < 1024) return;
    const target = e.target as HTMLElement;
    const pillTarget = target.closest<HTMLElement>("[data-cursor-text]");
    const hoverTarget = target.closest<HTMLElement>("a, button, [data-hover-glow], .magnetic-btn");
    const cursorLabel = document.getElementById("cursor-label");

    if (pillTarget && cursorLabel) {
      const text = pillTarget.getAttribute("data-cursor-text") || "EXPLORE ↗";
      cursorLabel.textContent = text;
      cursorLabel.classList.remove("hidden");
      cursor.classList.remove("is-hover");
      cursor.classList.add("is-pill");
      if (cursorinner) (cursorinner as HTMLElement).style.opacity = "0";
    } else if (hoverTarget) {
      if (cursorLabel) cursorLabel.classList.add("hidden");
      cursor.classList.remove("is-pill");
      cursor.classList.add("is-hover");
      if (cursorinner) {
        (cursorinner as HTMLElement).style.opacity = "0.5";
        (cursorinner as HTMLElement).style.transform = "translate(-50%, -50%) scale(0.6)";
      }
    }
  });

  document.addEventListener("mouseout", (e) => {
    if (!cursor || window.innerWidth < 1024) return;
    const related = e.relatedTarget as HTMLElement | null;

    if (!related || (!related.closest("[data-cursor-text]") && !related.closest("a, button, [data-hover-glow], .magnetic-btn"))) {
      const cursorLabel = document.getElementById("cursor-label");
      if (cursorLabel) cursorLabel.classList.add("hidden");
      cursor.classList.remove("is-pill", "is-hover");
      if (cursorinner) {
        (cursorinner as HTMLElement).style.opacity = "1";
        (cursorinner as HTMLElement).style.transform = "translate(-50%, -50%) scale(1)";
      }
    }
  });

  // Portfolio-Wide GSAP ScrollTrigger, Parallax, 3D Hardware Tilt, Magnetic Buttons & Counters
  const initPortfolioMotion = () => {
    ScrollTrigger.getAll().forEach((t) => {
      const id = String(t.vars?.id || '');
      if (id !== 'about-horizontal-trigger' && !id.startsWith('career-stack-depth-') && !id.startsWith('agency-') && !id.startsWith('tilt-')) {
        t.kill();
      }
    });

    // 1. Hero Entrance Choreography (Transform + Clip Reveal, never stuck invisible)
    const heroWordmark = document.querySelector('[data-gsap-hero="wordmark"]');
    const heroPortrait = document.querySelector('[data-gsap-hero="portrait"]');
    const heroHeadline = document.querySelector('[data-gsap-hero="headline"]');
    const heroBio = document.querySelector('[data-gsap-hero="bio"]');
    const heroRetrospective = document.querySelector('[data-gsap-hero="retrospective"]');
    const heroBottom = document.querySelector('[data-gsap-hero="bottombar"]');

    if (heroWordmark) {
      gsap.fromTo(
        heroWordmark,
        { y: 36, scale: 0.975 },
        { y: 0, scale: 1, duration: 1.05, ease: "power4.out", clearProps: "transform" }
      );
    }
    if (heroPortrait) {
      gsap.fromTo(
        heroPortrait,
        { y: 28, scale: 0.94, clipPath: "inset(12% 0% 12% 0% round 24px)" },
        { y: 0, scale: 1, clipPath: "inset(0% 0% 0% 0% round 24px)", duration: 1.1, delay: 0.1, ease: "power3.out", clearProps: "clipPath,transform" }
      );
    }
    if (heroBio) {
      gsap.fromTo(
        heroBio,
        { y: 28 },
        { y: 0, duration: 0.95, delay: 0.14, ease: "power3.out", clearProps: "transform" }
      );
    }
    if (heroRetrospective) {
      gsap.fromTo(
        heroRetrospective,
        { y: 24 },
        {
          y: 0,
          duration: 0.9,
          ease: "power3.out",
          clearProps: "transform",
          scrollTrigger: {
            trigger: heroRetrospective,
            start: "top 95%",
            once: true,
          },
        }
      );
    }
    if (heroHeadline) {
      gsap.fromTo(
        heroHeadline,
        { y: 24 },
        { y: 0, duration: 0.95, delay: 0.08, ease: "power3.out", clearProps: "transform" }
      );
    }
    if (heroBottom) {
      gsap.fromTo(
        heroBottom,
        { y: 22 },
        { y: 0, duration: 0.9, delay: 0.18, ease: "power3.out", clearProps: "transform" }
      );
    }

    // 2. Hero Background Video / Liquid Aurora Scroll Parallax
    const heroBgVideo = document.getElementById("hero-bg-video");
    const heroAurora = document.querySelector<HTMLElement>(".liquid-aurora");
    const heroSection = document.getElementById("hero");
    if (heroBgVideo && heroSection) {
      gsap.to(heroBgVideo, {
        yPercent: 18,
        scale: 1.14,
        ease: "none",
        scrollTrigger: {
          trigger: heroSection,
          start: "top top",
          end: "bottom top",
          scrub: true,
        },
      });
    }
    if (heroAurora && heroSection) {
      gsap.to(heroAurora, {
        yPercent: 25,
        ease: "none",
        scrollTrigger: {
          trigger: heroSection,
          start: "top top",
          end: "bottom top",
          scrub: 0.6,
        },
      });
    }

    // 3. Hardware Showcase Scrub Parallax (Safe subtle vertical parallax without fighting hover/tilt)
    document.querySelectorAll<HTMLElement>("[data-gsap-parallax]").forEach((el) => {
      gsap.fromTo(
        el,
        { y: 18 },
        {
          y: -10,
          ease: "none",
          scrollTrigger: {
            trigger: el,
            start: "top bottom",
            end: "bottom top",
            scrub: 0.6,
          },
        }
      );
    });

    // 4. 3D MacBook Hardware Stage Subtle Tilt (Zero glare gradient flicker)
    document.querySelectorAll<HTMLElement>(".laptop-3d-stage").forEach((stage) => {
      if (stage.dataset.tiltBound === "true") return;
      stage.dataset.tiltBound = "true";

      const chassis = stage.querySelector<HTMLElement>(".laptop-chassis");
      if (!chassis) return;

      stage.addEventListener("mousemove", (e: MouseEvent) => {
        if (window.innerWidth < 1024 || prefersReducedMotion) return;
        const rect = stage.getBoundingClientRect();
        const relX = (e.clientX - rect.left) / rect.width - 0.5;
        const relY = (e.clientY - rect.top) / rect.height - 0.5;

        gsap.to(chassis, {
          rotateY: relX * 5,
          rotateX: relY * -3.5,
          transformPerspective: 1400,
          duration: 0.45,
          ease: "power2.out",
        });
      });

      stage.addEventListener("mouseleave", () => {
        if (window.innerWidth < 1024) return;
        gsap.to(chassis, {
          rotateX: 0,
          rotateY: 0,
          duration: 0.65,
          ease: "power3.out",
        });
      });
    });

    // 5. Section Headings Kinetic Masked Reveal
    document.querySelectorAll<HTMLElement>("[data-gsap-heading]").forEach((heading) => {
      gsap.fromTo(
        heading,
        { y: 34, scale: 0.985 },
        {
          y: 0,
          scale: 1,
          duration: 0.9,
          ease: "power3.out",
          clearProps: "transform",
          scrollTrigger: {
            trigger: heading,
            start: "top 92%",
            once: true,
          },
        }
      );
    });

    // 6. Editorial Hairline Divider Sweep
    document.querySelectorAll<HTMLElement>("[data-gsap-line]").forEach((line) => {
      gsap.fromTo(
        line,
        { scaleX: 0, transformOrigin: "left center" },
        {
          scaleX: 1,
          duration: 0.95,
          ease: "power3.inOut",
          scrollTrigger: {
            trigger: line,
            start: "top 92%",
            once: true,
          },
        }
      );
    });

    // 7. Cards ScrollTrigger Staggered Glide (Never leaves cards rotated or trapped)
    document.querySelectorAll<HTMLElement>("[data-gsap-card]").forEach((card, idx) => {
      gsap.fromTo(
        card,
        { y: 20 },
        {
          y: 0,
          duration: 0.65,
          delay: (idx % 3) * 0.05,
          ease: "power2.out",
          clearProps: "transform",
          scrollTrigger: {
            trigger: card,
            start: "top 98%",
            once: true,
          },
        }
      );
    });

    // 8. Footer Monumental Wordmark Scrub Reveal
    const footerWordmark = document.querySelector<HTMLElement>(".footer-giant-wordmark");
    if (footerWordmark) {
      gsap.fromTo(
        footerWordmark,
        { yPercent: 12, scale: 0.97 },
        {
          yPercent: 0,
          scale: 1,
          ease: "none",
          scrollTrigger: {
            trigger: footerWordmark,
            start: "top 95%",
            end: "bottom 90%",
            scrub: 0.6,
          },
        }
      );
    }

    // 9. Global Demo Video Lightbox Modal (Delegated — survives ClientRouter swaps cleanly)
    if (!(window as any).__globalDemoModalBound) {
      (window as any).__globalDemoModalBound = true;

      const closeDemoModal = () => {
        const modal = document.getElementById("global-demo-modal");
        const body = document.getElementById("global-demo-modal-body");
        if (!modal || !body) return;
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        body.innerHTML = "";
        document.body.style.overflow = "";
      };

      document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement | null;
        if (!target) return;

        const closeBtn = target.closest("#close-global-demo-modal");
        if (closeBtn || target.id === "global-demo-modal") {
          closeDemoModal();
          return;
        }

        const trigger = target.closest<HTMLElement>("[data-open-demo-modal]");
        if (!trigger) return;

        e.preventDefault();
        e.stopPropagation();

        const modal = document.getElementById("global-demo-modal");
        const body = document.getElementById("global-demo-modal-body");
        const titleEl = document.getElementById("global-demo-modal-title");
        if (!modal || !body || !titleEl) return;

        const kind = trigger.getAttribute("data-demo-kind") || "video";
        const src = trigger.getAttribute("data-demo-src") || "";
        const poster = trigger.getAttribute("data-demo-poster") || "";
        const title = trigger.getAttribute("data-demo-title") || "Product Demo Walkthrough";
        if (!src) return;

        titleEl.textContent = title;
        body.innerHTML = "";

        if (kind === "iframe") {
          const iframe = document.createElement("iframe");
          iframe.src = src;
          iframe.title = title;
          iframe.className = "w-full h-full border-0";
          iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen";
          iframe.setAttribute("allowfullscreen", "true");
          body.appendChild(iframe);
        } else {
          const video = document.createElement("video");
          video.src = src;
          if (poster) video.poster = poster;
          video.controls = true;
          video.autoplay = true;
          video.playsInline = true;
          video.preload = "auto";
          video.className = "w-full h-full object-contain bg-[#0A0B0E]";
          body.appendChild(video);
          video.play().catch(() => {});
        }

        modal.classList.remove("hidden");
        modal.classList.add("flex");
        document.body.style.overflow = "hidden";
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          const modal = document.getElementById("global-demo-modal");
          if (modal && !modal.classList.contains("hidden")) {
            closeDemoModal();
          }
        }
      });
    }

    // 10. Project Card Hover Video Preview
    document.querySelectorAll<HTMLElement>(".project-item").forEach((item) => {
      const video = item.querySelector<HTMLVideoElement>(".project-hover-video");
      if (!video || item.dataset.videoBound === "true") return;
      item.dataset.videoBound = "true";

      item.addEventListener("mouseenter", () => {
        video.play().catch(() => {});
      });
      item.addEventListener("mouseleave", () => {
        video.pause();
      });
    });

    // 11. Magnetic Buttons
    document.querySelectorAll<HTMLElement>(".magnetic-btn").forEach((btn) => {
      if (btn.dataset.magneticBound === "true") return;
      btn.dataset.magneticBound = "true";

      btn.addEventListener("mousemove", (e: MouseEvent) => {
        if (window.innerWidth < 1024) return;
        const rect = btn.getBoundingClientRect();
        const dx = (e.clientX - (rect.left + rect.width / 2)) * 0.28;
        const dy = (e.clientY - (rect.top + rect.height / 2)) * 0.28;
        gsap.to(btn, { x: dx, y: dy, duration: 0.3, ease: "power2.out" });
      });

      btn.addEventListener("mouseleave", () => {
        gsap.to(btn, { x: 0, y: 0, duration: 0.6, ease: "elastic.out(1, 0.4)" });
      });
    });

    // 12. Animated Metric Counters
    document.querySelectorAll<HTMLElement>("[data-counter]").forEach((counterEl) => {
      if (counterEl.dataset.counterAnimated === "true") return;
      const targetVal = parseFloat(counterEl.getAttribute("data-counter") || "0");
      const suffix = counterEl.getAttribute("data-suffix") || "";
      if (!targetVal) return;

      const state = { val: 0 };
      ScrollTrigger.create({
        trigger: counterEl,
        start: "top 92%",
        once: true,
        onEnter: () => {
          counterEl.dataset.counterAnimated = "true";
          gsap.to(state, {
            val: targetVal,
            duration: 1.4,
            ease: "power3.out",
            onUpdate: () => {
              counterEl.textContent = `${Math.round(state.val)}${suffix}`;
            },
          });
        },
      });
    });

    ScrollTrigger.refresh();
  };

  initPortfolioMotion();
  document.addEventListener("astro:page-load", initPortfolioMotion);
  document.addEventListener("astro:after-swap", initPortfolioMotion);
</script>
