---
import {
  PiStackDuotone,
  PiSparkleDuotone,
  PiBroadcastDuotone,
  PiSwatchesDuotone,
  PiArrowRightBold,
  PiLightningDuotone,
  PiGaugeDuotone,
  PiBriefcaseDuotone,
} from "react-icons/pi";
import { SiOpenai, SiAnthropic, SiStripe, SiGooglegemini } from "react-icons/si";

const metrics = [
  { id: "systems", value: "10+", label: "Shipped Production Modules", detail: "Multi-role portals & SaaS APIs" },
  { id: "speed", value: "50%", label: "Faster Page Load Speed", detail: "SSR, code splitting & edge caching" },
  { id: "vitals", value: "99+", label: "Core Web Vitals Score", detail: "Across Next.js & Astro storefronts" },
  { id: "exp", value: "4+ Yrs", label: "Full-Stack Experience", detail: "React, Node.js, PostgreSQL & AI" },
];

const DEVICON = "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons";

const techStack = [
  { name: "React.js", role: "UI Library", iconUrl: `${DEVICON}/react/react-original.svg` },
  { name: "Next.js 15", role: "Full-Stack SSR", iconUrl: `${DEVICON}/nextjs/nextjs-original.svg`, lightPlate: true },
  { name: "TypeScript", role: "Type Safety", iconUrl: `${DEVICON}/typescript/typescript-original.svg` },
  { name: "Node.js", role: "Backend Runtime", iconUrl: `${DEVICON}/nodejs/nodejs-original.svg` },
  { name: "Express.js", role: "REST APIs", iconUrl: `${DEVICON}/express/express-original.svg`, invert: true },
  { name: "PostgreSQL", role: "Relational DB", iconUrl: `${DEVICON}/postgresql/postgresql-original.svg` },
  { name: "Prisma ORM", role: "Schema & Queries", iconUrl: `${DEVICON}/prisma/prisma-original.svg`, invert: true },
  { name: "MongoDB", role: "Document Store", iconUrl: `${DEVICON}/mongodb/mongodb-original.svg` },
  { name: "Sanity CMS", role: "Headless CMS", iconUrl: `${DEVICON}/sanity/sanity-original.svg` },
  { name: "Astro 5", role: "Edge Web Apps", iconUrl: `${DEVICON}/astro/astro-original.svg`, lightPlate: true },
  { name: "Tailwind CSS", role: "Design System", iconUrl: `${DEVICON}/tailwindcss/tailwindcss-original.svg` },
  { name: "Socket.IO", role: "Real-Time Sync", iconUrl: `${DEVICON}/socketio/socketio-original.svg`, invert: true },
  { name: "Redis", role: "Cache & Pub/Sub", iconUrl: `${DEVICON}/redis/redis-original.svg` },
  { name: "GraphQL", role: "Typed APIs", iconUrl: `${DEVICON}/graphql/graphql-plain.svg` },
  { name: "OpenAI", role: "GPT & Agents", brandKey: "openai" },
  { name: "Gemini", role: "Multimodal AI", brandKey: "gemini" },
  { name: "Claude", role: "Reasoning LLMs", brandKey: "claude" },
  { name: "Stripe", role: "SaaS Billing", brandKey: "stripe" },
];
---

<!-- OBSIDIAN DARK MID-PAGE ANCHOR BAND (#0A0B0E) -->
<section id="services" class="py-16 sm:py-24 bg-[#0A0B0E] text-white border-y border-white/10 relative z-10 overflow-hidden">
  <!-- Subtle Linear Indigo Studio Ambient Glow -->
  <div
    class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 w-[960px] h-[380px] bg-[radial-gradient(ellipse_at_top,rgba(94,106,210,0.22)_0%,transparent_70%)]"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Dark-Surface Section Header -->
    <div class="mb-10 sm:mb-12" data-gsap-heading>
      <div class="flex items-center gap-2.5 mb-3">
        <span class="w-5 h-px bg-[#828FFF]" aria-hidden="true"></span>
        <span class="text-[11px] sm:text-xs font-mono font-semibold tracking-[0.14em] text-[#828FFF] uppercase">
          02 / Capabilities &amp; Stack
        </span>
      </div>
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 lg:gap-10">
        <h2 class="font-grotesk font-bold tracking-[-0.03em] leading-[1.08] text-3xl sm:text-4xl lg:text-[46px] text-white">
          Engineered for <span class="text-[#828FFF]">Production.</span>
        </h2>
        <p class="max-w-md text-slate-300 text-sm sm:text-[15px] leading-[1.65] lg:text-right">
          Four core engineering disciplines backed by strict TypeScript, measurable Core Web Vitals, and real production architectures.
        </p>
      </div>
    </div>

    <!-- Unified 4-Metric Dark Architectural Proof Strip (Uniform Surface, Clear Internal Hierarchy) -->
    <div data-gsap-card class="mb-7 rounded-2xl bg-[#11141E] border border-white/10 overflow-hidden">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y lg:divide-y-0 sm:divide-x divide-white/10">
        {metrics.map((m) => (
          <div class="p-6 flex flex-col justify-between gap-4 hover:bg-white/[0.025] transition-colors">
            <div class="flex items-center justify-between gap-3">
              <span class="text-xs font-grotesk font-semibold text-[#828FFF] tracking-[-0.01em]">
                {m.label}
              </span>
              <span class="w-8 h-8 rounded-lg bg-white/[0.05] border border-white/10 flex items-center justify-center text-[#828FFF] shrink-0" aria-hidden="true">
                {m.id === "systems" && <PiStackDuotone className="w-4 h-4" />}
                {m.id === "speed" && <PiLightningDuotone className="w-4 h-4" />}
                {m.id === "vitals" && <PiGaugeDuotone className="w-4 h-4" />}
                {m.id === "exp" && <PiBriefcaseDuotone className="w-4 h-4" />}
              </span>
            </div>

            <div>
              <div class="font-grotesk font-bold text-3xl sm:text-4xl text-white tracking-[-0.03em] leading-none tabular-nums">
                {m.value}
              </div>
              <p class="text-xs font-sans text-slate-300 mt-2.5 leading-relaxed">
                {m.detail}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- 2x2 Dark Architectural Capability Matrix (Phosphor Duotone + Multi-Color Official Logos) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      
      <!-- 01: Full-Stack SaaS & Web Platforms -->
      <article data-gsap-card class="group relative overflow-hidden rounded-2xl bg-[#11141E] border border-white/10 hover:border-[#828FFF]/50 hover:-translate-y-0.5 transition-all duration-200 flex flex-col justify-between">
        <div class="h-[2px] w-full bg-[#828FFF] origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-300" aria-hidden="true"></div>

        <div class="px-6 py-4 bg-white/[0.03] border-b border-white/[0.08] flex items-center justify-between gap-3">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#0A0B0E] border border-white/10 text-[11px] font-mono font-medium text-white">
              <img src={`${DEVICON}/nextjs/nextjs-original.svg`} alt="" width="14" height="14" class="w-3.5 h-3.5 rounded-full bg-white p-[1px]" loading="lazy" />
              Next.js
            </span>
            <PiArrowRightBold className="w-3 h-3 text-slate-500" />
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#0A0B0E] border border-white/10 text-[11px] font-mono font-medium text-white">
              <img src={`${DEVICON}/typescript/typescript-original.svg`} alt="" width="14" height="14" class="w-3.5 h-3.5 rounded-[2px]" loading="lazy" />
              API + RBAC
            </span>
            <PiArrowRightBold className="w-3 h-3 text-slate-500" />
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#0A0B0E] border border-white/10 text-[11px] font-mono font-medium text-white">
              <img src={`${DEVICON}/postgresql/postgresql-original.svg`} alt="" width="14" height="14" class="w-3.5 h-3.5" loading="lazy" />
              PostgreSQL
            </span>
          </div>
          <span class="text-xs font-mono font-semibold text-slate-500 shrink-0">01</span>
        </div>

        <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between gap-5">
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <span class="w-10 h-10 rounded-xl bg-gradient-to-b from-[#5E6AD2]/30 to-[#5E6AD2]/10 border border-[#828FFF]/35 text-[#A5B0FF] flex items-center justify-center shrink-0 shadow-[inset_0_1px_0_rgba(255,255,255,0.2)]">
                <PiStackDuotone className="w-5 h-5" />
              </span>
              <span class="text-[11px] font-mono uppercase tracking-[0.12em] text-[#828FFF] font-semibold">
                Core Architecture
              </span>
            </div>
            <h3 class="font-grotesk text-xl sm:text-[22px] font-bold text-white tracking-[-0.025em]">
              Full-Stack SaaS &amp; Web Platforms
            </h3>
            <p class="text-sm text-slate-300 leading-[1.68] font-sans">
              End-to-end engineering from relational database schemas to sub-second React &amp; Next.js interfaces with multi-tenant RBAC, Stripe/MyFatoorah billing, and clean repository handoff.
            </p>
          </div>

          <div class="pt-4 border-t border-white/[0.08] flex items-center justify-between gap-2 text-xs font-mono text-slate-400">
            <span>Shipped: Sawt AI · Breeze SaaS · Healthcare Portals</span>
            <SiStripe className="w-4 h-4 text-[#828FFF] shrink-0" />
          </div>
        </div>
      </article>

      <!-- 02: Multi-LLM & Agentic Workflows -->
      <article data-gsap-card class="group relative overflow-hidden rounded-2xl bg-[#11141E] border border-white/10 hover:border-[#828FFF]/50 hover:-translate-y-0.5 transition-all duration-200 flex flex-col justify-between">
        <div class="h-[2px] w-full bg-[#828FFF] origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-300" aria-hidden="true"></div>

        <div class="px-6 py-4 bg-white/[0.03] border-b border-white/[0.08] flex items-center justify-between gap-3">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#0A0B0E] border border-white/10 text-[11px] font-mono font-medium text-white">
              <SiOpenai className="w-3.5 h-3.5 text-white" />
              GPT
            </span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#0A0B0E] border border-white/10 text-[11px] font-mono font-medium text-white">
              <SiGooglegemini className="w-3.5 h-3.5 text-[#828FFF]" />
              Gemini
            </span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#0A0B0E] border border-white/10 text-[11px] font-mono font-medium text-white">
              <SiAnthropic className="w-3.5 h-3.5 text-[#E89B72]" />
              Claude
            </span>
            <span class="px-2 py-0.5 rounded-full bg-emerald-500/15 border border-emerald-400/30 text-[10px] font-mono font-semibold text-emerald-300">
              RAG Validated
            </span>
          </div>
          <span class="text-xs font-mono font-semibold text-slate-500 shrink-0">02</span>
        </div>

        <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between gap-5">
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <span class="w-10 h-10 rounded-xl bg-gradient-to-b from-[#5E6AD2]/30 to-[#5E6AD2]/10 border border-[#828FFF]/35 text-[#A5B0FF] flex items-center justify-center shrink-0 shadow-[inset_0_1px_0_rgba(255,255,255,0.2)]">
                <PiSparkleDuotone className="w-5 h-5" />
              </span>
              <span class="text-[11px] font-mono uppercase tracking-[0.12em] text-[#828FFF] font-semibold">
                Applied AI Systems
              </span>
            </div>
            <h3 class="font-grotesk text-xl sm:text-[22px] font-bold text-white tracking-[-0.025em]">
              Multi-LLM &amp; Agentic Workflows
            </h3>
            <p class="text-sm text-slate-300 leading-[1.68] font-sans">
              Production LLM orchestration with structured JSON output validation, private vector RAG retrieval, automatic fallback routing, and streaming conversational interfaces.
            </p>
          </div>

          <div class="pt-4 border-t border-white/[0.08] flex items-center justify-between gap-2 text-xs font-mono text-slate-400">
            <span>Zero-drift JSON schemas · Streaming UI · Tool Agents</span>
            <span class="w-2 h-2 rounded-full bg-emerald-400 shrink-0"></span>
          </div>
        </div>
      </article>

      <!-- 03: Real-Time CRMs & Event Streams -->
      <article data-gsap-card class="group relative overflow-hidden rounded-2xl bg-[#11141E] border border-white/10 hover:border-[#828FFF]/50 hover:-translate-y-0.5 transition-all duration-200 flex flex-col justify-between">
        <div class="h-[2px] w-full bg-[#828FFF] origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-300" aria-hidden="true"></div>

        <div class="px-6 py-4 bg-white/[0.03] border-b border-white/[0.08] flex items-center justify-between gap-3">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#0A0B0E] border border-white/10 text-[11px] font-mono font-medium text-white">
              <img src={`${DEVICON}/socketio/socketio-original.svg`} alt="" width="14" height="14" class="w-3.5 h-3.5 invert" loading="lazy" />
              Socket.IO
            </span>
            <PiArrowRightBold className="w-3 h-3 text-slate-500" />
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#0A0B0E] border border-white/10 text-[11px] font-mono font-medium text-white">
              <img src={`${DEVICON}/redis/redis-original.svg`} alt="" width="14" height="14" class="w-3.5 h-3.5" loading="lazy" />
              Redis Pub/Sub
            </span>
            <span class="px-2 py-0.5 rounded-full bg-[#5E6AD2]/20 border border-[#828FFF]/30 text-[10px] font-mono font-semibold text-[#828FFF]">
              Live SLA
            </span>
          </div>
          <span class="text-xs font-mono font-semibold text-slate-500 shrink-0">03</span>
        </div>

        <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between gap-5">
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <span class="w-10 h-10 rounded-xl bg-gradient-to-b from-[#5E6AD2]/30 to-[#5E6AD2]/10 border border-[#828FFF]/35 text-[#A5B0FF] flex items-center justify-center shrink-0 shadow-[inset_0_1px_0_rgba(255,255,255,0.2)]">
                <PiBroadcastDuotone className="w-5 h-5" />
              </span>
              <span class="text-[11px] font-mono uppercase tracking-[0.12em] text-[#828FFF] font-semibold">
                Low-Latency Systems
              </span>
            </div>
            <h3 class="font-grotesk text-xl sm:text-[22px] font-bold text-white tracking-[-0.025em]">
              Real-Time CRMs &amp; Event Streams
            </h3>
            <p class="text-sm text-slate-300 leading-[1.68] font-sans">
              Bi-directional state synchronization, live support ticket pipelines, webhook idempotency, rate limiting, and audit-logged operational dashboards.
            </p>
          </div>

          <div class="pt-4 border-t border-white/[0.08] flex items-center justify-between gap-2 text-xs font-mono text-slate-400">
            <span>Sub-100ms Events · Audit Logs · Webhooks</span>
            <img src={`${DEVICON}/nodejs/nodejs-original.svg`} alt="" width="16" height="16" class="w-4 h-4 shrink-0" loading="lazy" />
          </div>
        </div>
      </article>

      <!-- 04: Design Systems, RTL & Headless CMS -->
      <article data-gsap-card class="group relative overflow-hidden rounded-2xl bg-[#11141E] border border-white/10 hover:border-[#828FFF]/50 hover:-translate-y-0.5 transition-all duration-200 flex flex-col justify-between">
        <div class="h-[2px] w-full bg-[#828FFF] origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-300" aria-hidden="true"></div>

        <div class="px-6 py-4 bg-white/[0.03] border-b border-white/[0.08] flex items-center justify-between gap-3">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#0A0B0E] border border-white/10 text-[11px] font-mono font-medium text-white">
              <img src={`${DEVICON}/sanity/sanity-original.svg`} alt="" width="14" height="14" class="w-3.5 h-3.5" loading="lazy" />
              Sanity CMS
            </span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#0A0B0E] border border-white/10 text-[11px] font-mono font-medium text-white">
              <img src={`${DEVICON}/astro/astro-original.svg`} alt="" width="14" height="14" class="w-3.5 h-3.5 rounded bg-white p-[1px]" loading="lazy" />
              Astro 5
            </span>
            <span class="px-2 py-0.5 rounded-full bg-emerald-500/15 border border-emerald-400/30 text-[10px] font-mono font-semibold text-emerald-300">
              99+ Vitals
            </span>
          </div>
          <span class="text-xs font-mono font-semibold text-slate-500 shrink-0">04</span>
        </div>

        <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between gap-5">
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <span class="w-10 h-10 rounded-xl bg-gradient-to-b from-[#5E6AD2]/30 to-[#5E6AD2]/10 border border-[#828FFF]/35 text-[#A5B0FF] flex items-center justify-center shrink-0 shadow-[inset_0_1px_0_rgba(255,255,255,0.2)]">
                <PiSwatchesDuotone className="w-5 h-5" />
              </span>
              <span class="text-[11px] font-mono uppercase tracking-[0.12em] text-[#828FFF] font-semibold">
                Interface &amp; CMS
              </span>
            </div>
            <h3 class="font-grotesk text-xl sm:text-[22px] font-bold text-white tracking-[-0.025em]">
              Design Systems, RTL &amp; Headless CMS
            </h3>
            <p class="text-sm text-slate-300 leading-[1.68] font-sans">
              Accessible component libraries, bilingual Arabic/English RTL-first layouts, and fast editorial publishing pipelines with Sanity, Contentful, and Astro SSR.
            </p>
          </div>

          <div class="pt-4 border-t border-white/[0.08] flex items-center justify-between gap-2 text-xs font-mono text-slate-400">
            <span>Arabic/English RTL · Token Systems · SEO Ready</span>
            <img src={`${DEVICON}/tailwindcss/tailwindcss-original.svg`} alt="" width="16" height="16" class="w-4 h-4 shrink-0" loading="lazy" />
          </div>
        </div>
      </article>
    </div>

    <!-- Official Multi-Color Brand Logos Production Tech Stack Grid -->
    <div id="skills" class="mt-12 pt-10 border-t border-white/10">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-6">
        <div>
          <span class="text-[11px] font-mono uppercase tracking-[0.14em] text-[#828FFF] font-semibold block mb-1">
            Daily Production Stack
          </span>
          <h3 class="font-grotesk text-xl sm:text-2xl font-bold text-white tracking-tight">
            Technologies I Ship With.
          </h3>
        </div>
        <span class="text-xs font-mono text-slate-400">
          {techStack.length} core production tools
        </span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
        {techStack.map((item) => (
          <div class="group rounded-xl bg-[#11141E] border border-white/10 hover:border-[#828FFF]/50 hover:bg-[#171B2A] hover:-translate-y-0.5 px-3.5 py-3 flex items-center gap-3 transition-all duration-200">
            <div class={`w-9 h-9 rounded-lg border flex items-center justify-center shrink-0 ${item.lightPlate ? "bg-white border-white/20 p-1.5" : "bg-[#0A0B0E] border-white/10 p-1.5"}`}>
              {item.iconUrl ? (
                <img
                  src={item.iconUrl}
                  alt={`${item.name} logo`}
                  width="22"
                  height="22"
                  loading="lazy"
                  decoding="async"
                  class={`w-5 h-5 object-contain transition-transform duration-200 group-hover:scale-110 ${item.invert ? "invert" : ""}`}
                />
              ) : item.brandKey === "openai" ? (
                <SiOpenai className="w-5 h-5 text-white transition-transform duration-200 group-hover:scale-110" />
              ) : item.brandKey === "gemini" ? (
                <svg class="w-5 h-5 transition-transform duration-200 group-hover:scale-110" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <defs>
                    <linearGradient id="geminiGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#4285F4" />
                      <stop offset="50%" stop-color="#9B72CB" />
                      <stop offset="100%" stop-color="#D96570" />
                    </linearGradient>
                  </defs>
                  <path d="M12 2C12.4 7.2 16.8 11.6 22 12C16.8 12.4 12.4 16.8 12 22C11.6 16.8 7.2 12.4 2 12C7.2 11.6 11.6 7.2 12 2Z" fill="url(#geminiGrad)" />
                </svg>
              ) : item.brandKey === "claude" ? (
                <SiAnthropic className="w-5 h-5 text-[#E89B72] transition-transform duration-200 group-hover:scale-110" />
              ) : (
                <SiStripe className="w-5 h-5 text-[#828FFF] transition-transform duration-200 group-hover:scale-110" />
              )}
            </div>
            <div class="min-w-0">
              <span class="block text-xs font-grotesk font-bold text-white truncate">
                {item.name}
              </span>
              <span class="block text-[10px] font-mono text-slate-400 truncate">
                {item.role}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
