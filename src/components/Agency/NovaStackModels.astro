---
// NovaStack Engagement Models / Pricing: 3 Equal-Height Clean Light Cards
// Recommended model highlighted ONLY with a blue top border + --blue-50 badge (no dark panels, no glow)

const models = [
  {
    id: "fixed-scope",
    highlighted: false,
    badge: "Fixed-Scope Sprint",
    timeline: "2–6 Weeks",
    title: "Fixed-Scope Build",
    description:
      "Defined specs, fixed investment, and milestone-gated delivery for websites, SaaS MVPs, and custom HTML email systems.",
    bestFor: "Startups & businesses with clear launch goals.",
    highlights: [
      "Written technical scope & milestone roadmap",
      "Private staging reviews before each sign-off",
      "100% repository & IP handover at launch",
      "14-day post-launch warranty included",
    ],
    ctaText: "Request a Fixed Quote",
    ctaHref: "#contact",
  },
  {
    id: "freelance-support",
    highlighted: true,
    badge: "Recommended · Embedded",
    timeline: "Immediate Start",
    title: "Dedicated Engineering",
    description:
      "Senior React, Next.js, and full-stack reinforcement without hiring delays. Plug directly into your GitHub, Linear, and Slack.",
    bestFor: "Digital agencies, studios & fast-moving product teams.",
    highlights: [
      "Direct GitHub, Linear/Jira & Slack integration",
      "High-velocity Next.js, React & TypeScript builds",
      "Daily async updates & Loom walkthroughs",
      "Flexible weekly sprints—scale up or pause anytime",
    ],
    ctaText: "Check Availability",
    ctaHref: "#contact",
  },
  {
    id: "ongoing-collaboration",
    highlighted: false,
    badge: "Monthly Retainer",
    timeline: "Month-to-Month",
    title: "Technical Partnership",
    description:
      "Continuous feature iterations, API integrations, performance audits, and active maintenance with zero long-term lock-in.",
    bestFor: "Post-launch SaaS founders iterating on live products.",
    highlights: [
      "Direct channel via Slack, WhatsApp, or email",
      "Continuous feature sprints & third-party API sync",
      "Core Web Vitals audits & dependency updates",
      "Transparent task board & cancel-anytime terms",
    ],
    ctaText: "Discuss Partnership",
    ctaHref: "#contact",
  },
];
---

<section id="models" class="ns-section bg-[var(--bg)] text-[var(--ink)] border-b border-[var(--border)]">
  <div class="ns-container">
    <!-- Section Header -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-12 lg:mb-16">
      <div class="max-w-2xl">
        <div class="flex items-center gap-2.5 mb-3">
          <span class="w-5 h-px bg-[var(--blue-600)]" aria-hidden="true"></span>
          <span class="ns-mono-label text-[var(--blue-600)] font-medium">
            05 / Engagement Models
          </span>
        </div>
        <h2 class="ns-h2 text-[var(--ink)]">
          Transparent Models. <span class="text-[var(--blue-600)]">Zero Lock-In.</span>
        </h2>
      </div>

      <p class="ns-body max-w-md">
        Fixed-scope milestones or flexible weekly sprints—structured around working software on staging.
      </p>
    </div>

    <!-- 3 Equal-Height Clean Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8 items-stretch mb-10">
      {models.map((model) => (
          <article
            class={`ns-card ns-reveal h-full p-6 sm:p-8 flex flex-col justify-between ${
              model.highlighted ? "border-t-[3px] border-t-[var(--blue-600)]" : ""
            }`}
          >
            <div class="space-y-5">
              <!-- Top Mono Badges -->
              <div class="flex items-center justify-between gap-2 flex-wrap">
                <span
                  class={`px-3 py-1 rounded-full text-xs font-mono font-medium ${
                    model.highlighted
                      ? "bg-[var(--blue-50)] text-[var(--blue-700)]"
                      : "bg-[var(--bg)] text-[var(--muted)] border border-[var(--border)]"
                  }`}
                >
                  {model.badge}
                </span>
                <span class="text-xs font-mono text-[var(--muted)]">
                  {model.timeline}
                </span>
              </div>

              <div class="space-y-2.5">
                <h3 class="text-2xl font-semibold tracking-[-0.02em] text-[var(--ink)]">
                  {model.title}
                </h3>
                <p class="text-base leading-[1.65] text-[var(--muted)]">
                  {model.description}
                </p>
              </div>

              <!-- Clear Best For Line -->
              <div class="p-4 rounded-[12px] bg-[var(--bg)] border border-[var(--border)]">
                <span class="text-xs font-mono uppercase tracking-[0.08em] text-[var(--blue-600)] font-medium block mb-1">
                  Best for
                </span>
                <p class="text-sm font-medium text-[var(--ink)] leading-snug">
                  {model.bestFor}
                </p>
              </div>

              <!-- 4 Clear Bullets (>= 16px) -->
              <ul class="space-y-3 text-base leading-[1.55] text-[var(--muted)] pt-1">
                {model.highlights.map((item) => (
                  <li class="flex items-start gap-3">
                    <span
                      class="text-[var(--blue-600)] font-semibold shrink-0 mt-0.5"
                      aria-hidden="true"
                    >
                      ✓
                    </span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Action CTA -->
            <div class="pt-7 mt-7 border-t border-[var(--border)]">
              <a
                href={model.ctaHref}
                class={
                  model.highlighted
                    ? "ns-btn-primary w-full py-3.5 px-5 text-base"
                    : "ns-link-arrow w-full inline-flex items-center justify-center gap-2 py-3.5 px-5 rounded-[12px] bg-[var(--surface)] border border-[var(--border)] hover:border-[var(--blue-600)] hover:text-[var(--blue-600)] text-base font-medium text-[var(--ink)] transition-colors duration-150"
                }
              >
                <span>{model.ctaText}</span>
                <span class="ns-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </article>
      ))}
    </div>

    <!-- Clean 3-Pillar Ownership Assurance Strip -->
    <div class="rounded-[16px] bg-[var(--surface)] border border-[var(--border)] p-6 sm:p-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 divide-y md:divide-y-0 md:divide-x divide-[var(--border)]">
        <div class="pt-4 first:pt-0 md:pt-0">
          <h4 class="font-semibold text-base text-[var(--ink)]">
            Full Repository &amp; IP Ownership
          </h4>
          <p class="text-sm text-[var(--muted)] mt-1 leading-relaxed">
            Code, DNS, and cloud infrastructure live directly in your own accounts from day one.
          </p>
        </div>

        <div class="pt-4 md:pt-0 md:pl-6">
          <h4 class="font-semibold text-base text-[var(--ink)]">
            Staging-Verified Milestones
          </h4>
          <p class="text-sm text-[var(--muted)] mt-1 leading-relaxed">
            Inspect live builds on a private staging URL before approving milestone releases.
          </p>
        </div>

        <div class="pt-4 md:pt-0 md:pl-6">
          <h4 class="font-semibold text-base text-[var(--ink)]">
            Direct Founder Execution
          </h4>
          <p class="text-sm text-[var(--muted)] mt-1 leading-relaxed">
            Communicate directly with the senior engineer writing and deploying your code.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
