<style>
  .career-stack-inner {
    transform-origin: top center;
    will-change: transform, opacity;
  }

  /* Explicit dark-surface typography for Sanity PortableText ("What I Do", "My Goal", etc.)
     because @tailwindcss/typography is not installed and Layout.astro sets dark ink on h1-h6/p */
  .about-prose-dark {
    color: #E2E8F0;
    font-size: 0.9375rem;
    line-height: 1.68;
  }

  .about-prose-dark :global(h1),
  .about-prose-dark :global(h2),
  .about-prose-dark :global(h3),
  .about-prose-dark :global(h4),
  .about-prose-dark :global(h5),
  .about-prose-dark :global(h6) {
    color: #FFFFFF !important;
    font-family: "Space Grotesk", "Geist", sans-serif;
    font-size: 1.0625rem !important;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin-top: 1.25rem;
    margin-bottom: 0.4rem;
  }

  .about-prose-dark :global(p) {
    color: #CBD5E1 !important;
    font-size: 0.9375rem;
    line-height: 1.68;
    margin-bottom: 0.75rem;
  }

  .about-prose-dark :global(strong),
  .about-prose-dark :global(b) {
    color: #FFFFFF !important;
    font-weight: 600;
  }

  .about-prose-dark :global(ul),
  .about-prose-dark :global(ol) {
    color: #CBD5E1 !important;
    margin: 0.5rem 0 0.85rem;
    padding-left: 1.25rem;
  }

  .about-prose-dark :global(ul) {
    list-style-type: disc;
  }

  .about-prose-dark :global(ol) {
    list-style-type: decimal;
  }

  .about-prose-dark :global(li) {
    color: #CBD5E1 !important;
    font-size: 0.92rem;
    line-height: 1.62;
    margin-bottom: 0.35rem;
  }

  .about-prose-dark :global(li::marker) {
    color: #828FFF;
  }

  .about-prose-dark :global(a) {
    color: #828FFF !important;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .about-prose-dark :global(blockquote) {
    border-left: 2px solid #5E6AD2;
    padding-left: 1rem;
    color: #E2E8F0 !important;
    margin: 1rem 0;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initAbout = () => {
    // 1. Resume Download Button
    const resumeBtn = document.querySelector('#about-resume-btn');
    if (resumeBtn && !resumeBtn.hasAttribute('data-bound')) {
      resumeBtn.setAttribute('data-bound', 'true');
      resumeBtn.addEventListener('click', () => {
        const link = document.createElement("a");
        link.href = "/Resume.pdf";
        link.target = "_blank";
        link.download = "resume.pdf";
        link.click();
      });
    }

    // 2. Stack-Up Depth Scaling on Sticky Career Deck
    ScrollTrigger.getAll()
      .filter((t) => String(t.vars.id || '').startsWith('career-stack-depth-'))
      .forEach((t) => t.kill());

    const slots = Array.from(document.querySelectorAll<HTMLElement>('[data-stack-card]'));
    slots.forEach((slot, idx) => {
      if (idx === slots.length - 1) return;
      const nextSlot = slots[idx + 1];
      const innerCard = slot.querySelector<HTMLElement>('.career-stack-inner');
      if (!nextSlot || !innerCard) return;

      gsap.to(innerCard, {
        scale: 0.94,
        opacity: 0.72,
        ease: 'none',
        scrollTrigger: {
          id: `career-stack-depth-${idx}`,
          trigger: nextSlot,
          start: 'top 80%',
          end: 'top 22%',
          scrub: true,
        },
      });
    });
    // 3. 3D Portrait Tilt on About Hero
    const tiltCard = document.getElementById('about-portrait-tilt');
    const sheenEl = document.getElementById('about-portrait-sheen');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (tiltCard && !reduceMotion && tiltCard.dataset.tiltBound !== 'true') {
      tiltCard.dataset.tiltBound = 'true';
      tiltCard.addEventListener('pointermove', (e: PointerEvent) => {
        if (window.innerWidth < 768) return;
        const rect = tiltCard.getBoundingClientRect();
        const px = (e.clientX - rect.left) / rect.width;
        const py = (e.clientY - rect.top) / rect.height;
        const rotateY = (px - 0.5) * 12;
        const rotateX = (0.5 - py) * 10;
        tiltCard.style.transform = `rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) scale3d(1.012, 1.012, 1.012)`;
        if (sheenEl) {
          sheenEl.style.setProperty('--tilt-x', `${(px * 100).toFixed(1)}%`);
          sheenEl.style.setProperty('--tilt-y', `${(py * 100).toFixed(1)}%`);
        }
      });
      tiltCard.addEventListener('pointerleave', () => {
        tiltCard.style.transform = 'rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
      });
    }
  };

  initAbout();
  document.addEventListener('astro:page-load', initAbout);
  document.addEventListener('astro:after-swap', initAbout);
</script>
