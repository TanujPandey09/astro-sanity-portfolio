---
import Layout from "../../layouts/Layout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import PremiumBackground from "../../components/PremiumBackground.astro";
import TemplateCard from "../../components/TemplateCard.astro";
import TemplateRow from "../../components/TemplateRow.astro";
import { fetchAllTemplates, formatCategoryLabel } from "../../lib/templates";

const templates = await fetchAllTemplates();
const featuredTemplate = templates[0];
const featuredRawImg = featuredTemplate?.imageUrl || "/img/custom-project.webp";
const featuredImgUrl = featuredRawImg.includes("cdn.sanity.io")
  ? `${featuredRawImg}${featuredRawImg.includes("?") ? "&" : "?"}auto=format&fit=max&w=1000&q=85`
  : featuredRawImg;

const siteUrl = "https://tanujbuilds.site";
const itemList = {
  "@type": "ItemList",
  "@id": `${siteUrl}/templates#itemlist`,
  name: "Tanuj Pandey — Commercial Next.js & React Website Templates",
  description: "Production-ready Next.js, React, TypeScript, and Tailwind CSS website templates with 99+ Lighthouse performance, lifetime updates, and commercial licenses.",
  itemListElement: templates.map((template, index) => {
    const priceNumeric = template.price?.replace(/[^0-9.]/g, "") || "49";
    const rawImg = template.imageUrl || "/og-image-dark.png";
    const resolvedImg = rawImg.startsWith("http") ? rawImg : `${siteUrl}${rawImg.startsWith("/") ? "" : "/"}${rawImg}`;
    return {
      "@type": "ListItem",
      position: index + 1,
      name: template.templateName,
      url: `${siteUrl}/templates/${template.slug.current}`,
      item: {
        "@type": "Product",
        name: template.templateName,
        description: template.tagline || "Production-ready commercial website template engineered with Next.js, React, and Tailwind CSS.",
        image: [resolvedImg],
        url: `${siteUrl}/templates/${template.slug.current}`,
        sku: template.slug.current,
        category: "SoftwareApplication",
        brand: {
          "@type": "Brand",
          name: "Tanuj Builds",
        },
        offers: {
          "@type": "Offer",
          price: priceNumeric,
          priceCurrency: "USD",
          availability: "https://schema.org/InStock",
          url: template.gumroadLink || `${siteUrl}/templates/${template.slug.current}`,
          seller: {
            "@type": "Organization",
            name: "Tanuj Builds",
          },
          hasMerchantReturnPolicy: {
            "@type": "MerchantReturnPolicy",
            applicableCountry: "US",
            returnPolicyCategory: "https://schema.org/MerchantReturnNotPermitted",
          },
          shippingDetails: {
            "@type": "OfferShippingDetails",
            shippingRate: {
              "@type": "MonetaryAmount",
              value: "0",
              currency: "USD",
            },
            shippingDestination: {
              "@type": "DefinedRegion",
              addressCountry: "US",
            },
            deliveryTime: {
              "@type": "ShippingDeliveryTime",
              handlingTime: {
                "@type": "QuantitativeValue",
                minValue: 0,
                maxValue: 0,
                unitCode: "DAY",
              },
              transitTime: {
                "@type": "QuantitativeValue",
                minValue: 0,
                maxValue: 0,
                unitCode: "DAY",
              },
            },
          },
        },
      },
    };
  }),
};

const templatesFaqJsonLd = {
  "@type": "FAQPage",
  "@id": `${siteUrl}/templates#faq`,
  mainEntity: [
    {
      "@type": "Question",
      name: "What tech stack are these commercial website templates built with?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "All templates are built with modern production stacks including Next.js 15, React 19, TypeScript, Tailwind CSS, Framer Motion, and GSAP, engineered for 99+ Google PageSpeed and Core Web Vitals performance."
      }
    },
    {
      "@type": "Question",
      name: "Does the purchase include a commercial license for client projects?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Every template includes an unlimited commercial license allowing you to build and deploy both personal projects and paying client websites with zero recurring royalties."
      }
    },
    {
      "@type": "Question",
      name: "Do I get lifetime updates and source code access?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. You receive instant access to the full TypeScript/React source code, design tokens, setup documentation, and free lifetime updates via Gumroad."
      }
    }
  ]
};

const templateKeywords = [
  "Next.js Website Templates",
  "React Tailwind CSS Templates",
  "Commercial Website Templates",
  "Luxury Real Estate Next.js Template",
  "Dental Clinic Website Template Next.js",
  "Healthcare React Website Template",
  "TypeScript SaaS Templates",
  "High PageSpeed Website Templates",
  "Tanuj Pandey Templates"
];

const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Templates", path: "/templates" },
];

// Dynamically extract categories from all templates uploaded in Sanity CMS
const categoryMap = new Map<string, { label: string; count: number; filterKey: string }>();

for (const t of templates) {
  const rawCat = (t.category || "other").trim();
  const label = formatCategoryLabel(rawCat);
  const filterKey = rawCat.toLowerCase().replace(/[^a-z0-9]+/g, "-");

  if (!categoryMap.has(filterKey)) {
    categoryMap.set(filterKey, {
      label,
      count: 0,
      filterKey,
    });
  }
  categoryMap.get(filterKey)!.count += 1;
}

const dynamicCategories = Array.from(categoryMap.values()).sort((a, b) => b.count - a.count);
---

<Layout
  title="Commercial Next.js & React Website Templates | Tanuj Pandey"
  description="Download production-ready Next.js, React, TypeScript, and Tailwind CSS website templates for Real Estate, Healthcare, and SaaS. 99+ Lighthouse scores & commercial license included."
  schemaType="CollectionPage"
  keywords={templateKeywords}
  jsonLd={[itemList, templatesFaqJsonLd]}
  breadcrumbs={breadcrumbs}
>
  <div class="relative min-h-screen selection:bg-accent-primary/30 overflow-x-clip bg-canvas">
    <PremiumBackground />

    <!-- ACT 1: OBSIDIAN STOREFRONT SPLIT HERO (CALM BLUEPRINT GRID, ZERO NOISE) -->
    <section class="relative w-full overflow-hidden bg-[#0A0B0E] text-white pt-24 sm:pt-28 md:pt-32 pb-12 sm:pb-16 border-b border-white/[0.08]">
      <!-- Crisp Static Linear Blueprint Grid + Soft Indigo Corner Glow -->
      <div class="pointer-events-none absolute inset-0 overflow-hidden z-0" aria-hidden="true">
        <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.035)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.035)_1px,transparent_1px)] [background-size:48px_48px] [mask-image:radial-gradient(ellipse_85%_75%_at_50%_20%,#000_45%,transparent_100%)]"></div>
        <div class="absolute -top-24 right-0 w-[520px] h-[420px] bg-[radial-gradient(circle,rgba(94,106,210,0.22)_0%,transparent_70%)]"></div>
        <div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-[#0A0B0E] to-transparent"></div>
      </div>

      <div class="relative z-10 mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center" data-gsap-hero="wordmark">
          <!-- Left Storefront Copy & Immediate Proof -->
          <div class="lg:col-span-7 space-y-6">
            <div class="inline-flex items-center gap-2.5 px-3 py-1 rounded-full bg-white/[0.05] border border-white/10 text-[11px] font-mono uppercase tracking-[0.16em] text-[#828FFF]">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              <span>COMMERCIAL WEBSITE KITS · NEXT.JS &amp; REACT</span>
            </div>

            <h1 class="font-grotesk font-extrabold text-4xl sm:text-5xl md:text-[3.5rem] lg:text-[4rem] text-white tracking-[-0.04em] leading-[0.98] max-w-2xl">
              Website Kits <span class="text-slate-400 font-semibold">Built to Launch.</span>
            </h1>

            <p class="text-sm sm:text-base text-slate-300 font-sans leading-relaxed max-w-xl">
              Clean Next.js 15, React 19, and TypeScript starter codebases engineered for 99+ Lighthouse performance, lifetime source updates, and unlimited client licensing.
            </p>

            <!-- Action Row -->
            <div class="flex flex-wrap items-center gap-3 pt-1">
              <a
                href="#templates-catalog"
                class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white text-[#0A0B0E] hover:bg-slate-200 font-grotesk font-bold text-xs uppercase tracking-wider transition-all active:scale-95"
              >
                <span>Browse Catalog ({templates.length})</span>
                <span>↓</span>
              </a>
              <button
                type="button"
                data-open-contact
                data-contact-subject="Template Customization / Bespoke Build"
                class="magnetic-btn inline-flex items-center gap-2 px-5 py-3 rounded-full bg-[#5E6AD2]/15 border border-[#828FFF]/35 text-white hover:bg-[#5E6AD2]/25 font-grotesk font-semibold text-xs uppercase tracking-wider transition-all cursor-pointer"
              >
                <span>Hire to Customize ↗</span>
              </button>
              <a
                href="https://wa.me/919557321978?text=Hi%20Tanuj%2C%20I%20have%20a%20question%20about%20your%20website%20templates."
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-4 py-3 rounded-full bg-white/[0.06] border border-white/10 text-slate-200 hover:bg-white/12 font-grotesk font-semibold text-xs uppercase tracking-wider transition-all"
              >
                <span>WhatsApp ↗</span>
              </a>
            </div>

            <!-- Compact Verified Engineering Specs Strip -->
            <div class="pt-4 border-t border-white/[0.08] grid grid-cols-2 sm:grid-cols-4 gap-3 text-[11px] font-mono">
              <div class="px-3 py-2 rounded-xl bg-white/[0.03] border border-white/[0.08]">
                <span class="text-emerald-300 font-bold block">99+ Score</span>
                <span class="text-slate-400">Lighthouse Vitals</span>
              </div>
              <div class="px-3 py-2 rounded-xl bg-white/[0.03] border border-white/[0.08]">
                <span class="text-[#828FFF] font-bold block">Strict TS</span>
                <span class="text-slate-400">Clean Typed Code</span>
              </div>
              <div class="px-3 py-2 rounded-xl bg-white/[0.03] border border-white/[0.08]">
                <span class="text-white font-bold block">Unlimited Use</span>
                <span class="text-slate-400">Commercial License</span>
              </div>
              <div class="px-3 py-2 rounded-xl bg-white/[0.03] border border-white/[0.08]">
                <span class="text-white font-bold block">Instant ZIP</span>
                <span class="text-slate-400">Lifetime Updates</span>
              </div>
            </div>
          </div>

          <!-- Right Featured Template Live Preview Card -->
          <div class="lg:col-span-5">
            {featuredTemplate ? (
              <a
                href={`/templates/${featuredTemplate.slug.current}`}
                class="group block rounded-2xl bg-[#11131A] border border-white/12 hover:border-[#828FFF]/50 shadow-[0_24px_60px_rgba(0,0,0,0.45)] overflow-hidden transition-all duration-300"
              >
                <!-- Window Chrome Bar -->
                <div class="flex items-center justify-between px-4 py-2.5 border-b border-white/[0.08] bg-white/[0.02]">
                  <div class="flex items-center gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-white/20"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-white/20"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-white/20"></span>
                  </div>
                  <span class="text-[10px] font-mono text-slate-400 truncate max-w-[180px]">
                    /templates/{featuredTemplate.slug.current}
                  </span>
                  <span class="px-2 py-0.5 rounded-md bg-emerald-500/15 border border-emerald-400/30 text-emerald-300 text-[10px] font-mono font-bold">
                    {featuredTemplate.price || "$49"}
                  </span>
                </div>

                <!-- Cover Image -->
                <div class="relative aspect-[16/10] w-full overflow-hidden bg-[#0A0B0E]">
                  <img
                    src={featuredImgUrl}
                    alt={featuredTemplate.templateName}
                    loading="eager"
                    decoding="async"
                    class="w-full h-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                  />
                  <span class="absolute top-3 left-3 px-2.5 py-1 rounded-md bg-black/75 backdrop-blur-md border border-white/15 text-[10px] font-mono uppercase tracking-wider text-white">
                    Featured Release
                  </span>
                </div>

                <!-- Card Footer -->
                <div class="p-4 sm:p-5 flex items-center justify-between gap-4 border-t border-white/[0.08]">
                  <div class="min-w-0">
                    <span class="text-[10px] font-mono uppercase tracking-wider text-[#828FFF] block mb-0.5">
                      {formatCategoryLabel(featuredTemplate.category)}
                    </span>
                    <p class="font-grotesk font-bold text-base text-white truncate group-hover:text-[#828FFF] transition-colors">
                      {featuredTemplate.templateName}
                    </p>
                  </div>
                  <span class="shrink-0 inline-flex items-center gap-1 px-3 py-1.5 rounded-full bg-white text-[#0A0B0E] text-[11px] font-mono font-bold group-hover:bg-slate-200 transition-colors">
                    Inspect ↗
                  </span>
                </div>
              </a>
            ) : (
              <div class="rounded-2xl bg-[#11131A] border border-white/12 p-8 text-center">
                <p class="font-grotesk font-bold text-lg text-white mb-2">Next.js 15 + TypeScript Kits</p>
                <p class="text-xs font-mono text-slate-400">Production-grade UI architecture &amp; commercial licensing.</p>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>

    <main id="templates-catalog" class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 pt-10 sm:pt-14 pb-20 md:pb-28 relative z-10">

      <!-- Real-Time Filter, Search & View Switcher Toolbar -->
      <div class="mb-6 flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4 p-4 rounded-2xl bg-white border border-black/[0.08] shadow-xs">
        
        <!-- Dynamic Category Filter Pills (Direct from Sanity CMS) -->
        <div class="flex flex-wrap items-center gap-1.5 sm:gap-2" id="template-filters">
          <button 
            data-filter="all"
            class="filter-btn active px-3.5 py-1.5 rounded-xl text-xs font-mono font-bold transition-all duration-300 bg-[#0F172A] text-white shadow-xs cursor-pointer"
          >
            All ({templates.length})
          </button>
          {dynamicCategories.map((cat) => (
            <button 
              data-filter={cat.filterKey}
              class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-mono font-medium transition-all duration-300 bg-slate-100 border border-black/[0.08] text-slate-700 hover:text-black hover:bg-slate-200 cursor-pointer"
            >
              {cat.label} ({cat.count})
            </button>
          ))}
        </div>

        <!-- Right Side: Search + View Mode Switcher -->
        <div class="flex items-center gap-3">
          <!-- Live Search Input -->
          <div class="relative flex-1 sm:w-64">
            <input 
              type="text" 
              id="template-search-input"
              placeholder="Search templates..." 
              class="w-full px-3.5 py-1.5 pl-8 text-xs font-mono bg-slate-50 border border-black/10 rounded-xl text-[#0F172A] placeholder:text-slate-400 focus:bg-white focus:outline-none focus:border-accent-primary transition-all"
            />
            <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>

          <!-- View Mode Toggle (Grid vs High-Density List) -->
          <div class="flex items-center p-1 rounded-xl bg-slate-100 border border-black/10 shrink-0" id="view-mode-switcher">
            <button
              id="view-grid-btn"
              type="button"
              class="view-btn active px-2.5 py-1 rounded-lg text-xs font-mono font-medium flex items-center gap-1.5 transition-all bg-white text-[#0F172A] shadow-xs"
              title="3-Column Visual Grid View"
              aria-label="Switch to Grid view"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
              </svg>
              <span class="hidden sm:inline">Grid</span>
            </button>
            <button
              id="view-list-btn"
              type="button"
              class="view-btn px-2.5 py-1 rounded-lg text-xs font-mono font-medium flex items-center gap-1.5 transition-all text-slate-600 hover:text-black"
              title="Compact Catalog List View"
              aria-label="Switch to List view"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
              <span class="hidden sm:inline">List</span>
            </button>
          </div>
        </div>

      </div>

      <!-- Live Results Counter & Feedback Bar -->
      <div class="mb-8 flex items-center justify-between text-xs font-mono text-slate-600 px-1">
        <div>
          <span>Showing </span>
          <span id="templates-visible-count" class="text-[#0F172A] font-bold">{templates.length}</span>
          <span> of {templates.length} commercial templates</span>
        </div>
        <div class="text-[11px] text-slate-500">
          Direct download with instant source access
        </div>
      </div>

      <!-- 1. Grid View (3-Column Modern Studio Marketplace) -->
      <div 
        id="templates-grid-view"
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-7xl mx-auto items-stretch"
      >
        {templates.map((template, index) => (
          <TemplateCard template={template} index={index} />
        ))}
      </div>

      <!-- 2. List View (Compact High-Density Developer Catalog) -->
      <div 
        id="templates-list-view"
        class="hidden space-y-3 max-w-7xl mx-auto"
      >
        {templates.map((template, index) => (
          <TemplateRow template={template} index={index} />
        ))}
      </div>

      <!-- Empty State Feedback -->
      <div id="no-templates-state" class="hidden text-center py-16 px-4 bg-white rounded-2xl border border-black/10 shadow-sm max-w-xl mx-auto my-8">
        <span class="text-3xl block mb-2">🔍</span>
        <h3 class="text-lg font-bold font-grotesk text-[#0F172A] mb-1">No Matching Templates</h3>
        <p class="text-xs font-mono text-slate-600 mb-4">No template matches your current search or category filter.</p>
        <button 
          id="reset-search-btn"
          class="px-4 py-2 rounded-full text-xs font-mono bg-[#0F172A] text-white font-bold cursor-pointer hover:bg-black transition-all"
        >
          Reset Filters
        </button>
      </div>

      <!-- Value Proposition Matrix (Why Buy These Templates) -->
      <section class="mt-24 md:mt-36 pt-16 md:pt-20 border-t border-border-subtle">
        <div class="text-center max-w-2xl mx-auto mb-14">
          <p class="text-[11px] font-mono uppercase tracking-[0.3em] text-accent-primary mb-3">// WHY CHOOSE THESE TEMPLATES</p>
          <h2 class="text-2xl md:text-4xl font-bold font-grotesk text-[#0F172A] tracking-tight">
            What Sets These Codebases Apart?
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 mt-2 font-mono">
            Commercial-grade engineering built for agencies, freelancers, and ambitious founders.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div data-gsap-card class="bento-spotlight rounded-2xl p-6 sm:p-7 bg-white border border-black/[0.08] hover:border-accent-primary/50 transition-[border-color,box-shadow] duration-300 shadow-xs group">
            <div class="w-10 h-10 rounded-xl bg-accent-primary/10 border border-accent-primary/30 flex items-center justify-center text-accent-primary mb-5 font-mono font-bold text-sm group-hover:bg-accent-primary group-hover:text-white transition-colors">
              01/
            </div>
            <h3 class="text-base font-bold font-grotesk text-[#0F172A] mb-2">Unlimited Commercial Rights</h3>
            <p class="text-xs text-slate-600 leading-relaxed font-sans">
              Deploy unlimited paying client websites or SaaS platforms. No seat limits, no royalties, and zero recurring subscription fees.
            </p>
          </div>

          <div data-gsap-card class="bento-spotlight rounded-2xl p-6 sm:p-7 bg-white border border-black/[0.08] hover:border-accent-primary/50 transition-[border-color,box-shadow] duration-300 shadow-xs group">
            <div class="w-10 h-10 rounded-xl bg-accent-primary/10 border border-accent-primary/30 flex items-center justify-center text-accent-primary mb-5 font-mono font-bold text-sm group-hover:bg-accent-primary group-hover:text-white transition-colors">
              02/
            </div>
            <h3 class="text-base font-bold font-grotesk text-[#0F172A] mb-2">99+ Google PageSpeed</h3>
            <p class="text-xs text-slate-600 leading-relaxed font-sans">
              Zero JavaScript bloat, hardware-accelerated micro-interactions, responsive WebP asset pipelines, and optimal Core Web Vitals.
            </p>
          </div>

          <div data-gsap-card class="bento-spotlight rounded-2xl p-6 sm:p-7 bg-white border border-black/[0.08] hover:border-accent-primary/50 transition-[border-color,box-shadow] duration-300 shadow-xs group">
            <div class="w-10 h-10 rounded-xl bg-accent-primary/10 border border-accent-primary/30 flex items-center justify-center text-accent-primary mb-5 font-mono font-bold text-sm group-hover:bg-accent-primary group-hover:text-white transition-colors">
              03/
            </div>
            <h3 class="text-base font-bold font-grotesk text-[#0F172A] mb-2">Modular TypeScript Stack</h3>
            <p class="text-xs text-slate-600 leading-relaxed font-sans">
              Strict compile-time typing, reusable Tailwind components, and semantic token variables for frictionless restyling.
            </p>
          </div>

          <div data-gsap-card class="bento-spotlight rounded-2xl p-6 sm:p-7 bg-white border border-black/[0.08] hover:border-accent-primary/50 transition-[border-color,box-shadow] duration-300 shadow-xs group">
            <div class="w-10 h-10 rounded-xl bg-accent-primary/10 border border-accent-primary/30 flex items-center justify-center text-accent-primary mb-5 font-mono font-bold text-sm group-hover:bg-accent-primary group-hover:text-white transition-colors">
              04/
            </div>
            <h3 class="text-base font-bold font-grotesk text-[#0F172A] mb-2">Lifetime Free Updates</h3>
            <p class="text-xs text-slate-600 leading-relaxed font-sans">
              Instant zip download via Gumroad with automated email delivery for all future dependency updates, framework upgrades, and fixes.
            </p>
          </div>
        </div>
      </section>

      <!-- Interactive FAQ Accordion Section -->
      <section class="mt-20 md:mt-28 pt-16 border-t border-border-subtle max-w-4xl mx-auto">
        <div class="text-center mb-10">
          <p class="text-[11px] font-mono uppercase tracking-[0.25em] text-accent-primary mb-2">// LICENSING &amp; SETUP FAQ</p>
          <h2 class="text-2xl md:text-3xl font-bold font-grotesk text-[#0F172A] tracking-tight">
