---
import SectionHeader from "./SectionHeader.astro";

const services = [
  {
    number: "01",
    title: "Full-Stack Web Engineering",
    description: "Designing end-to-end web applications with Next.js, React, Node.js, and TypeScript. Architected for speed, reliability, and maintainability.",
    stack: ["Next.js / React", "Node.js / Express", "PostgreSQL / Prisma", "REST & GraphQL APIs"]
  },
  {
    number: "02",
    title: "AI & Agentic Workflows",
    description: "Integrating intelligent LLM capabilities (OpenAI, Claude, Gemini) with retrieval-augmented generation (RAG), vector stores, and automated agent pipelines.",
    stack: ["LLM Orchestration", "Vector Databases", "Contextual RAG", "Streaming Chat UIs"]
  },
  {
    number: "03",
    title: "Real-Time & Distributed Systems",
    description: "Engineering low-latency communication hubs, live event streaming, and state synchronization with WebSockets, Socket.IO, and Redis.",
    stack: ["WebSockets / Socket.IO", "Redis Pub/Sub", "Event Sourcing", "Sub-100ms Latency"]
  },
  {
    number: "04",
    title: "Design Systems & UI Engineering",
    description: "Translating complex designs into pixel-perfect, accessible, and responsive user interfaces with fluid spring animations and tactile micro-interactions.",
    stack: ["Tailwind CSS", "GSAP / Motion", "Micro-Interactions", "WCAG AA Compliance"]
  },
  {
    number: "05",
    title: "Database Design & Optimization",
    description: "Structuring robust schemas, high-efficiency indexes, and transactional query pipelines across relational and NoSQL databases.",
    stack: ["PostgreSQL", "MongoDB", "Query Optimization", "Prisma / Mongoose"]
  },
  {
    number: "06",
    title: "Production SaaS Architecture",
    description: "Building production-grade subscription models, multi-tenant databases, role-based access control (RBAC), and bulletproof authentication.",
    stack: ["OAuth & JWT Auth", "Stripe Integration", "Role-Based Access", "Audit Logging"]
  }
];
---

<section id="services" class="py-16 md:py-24 relative z-20 border-t border-border-subtle">
  <div class="container mx-auto px-4 md:px-8 max-w-7xl">
    
    <SectionHeader 
      eyebrow="Capabilities // Matrix"
      title="Engineering" 
      gradientText="Services" 
      subtitle="From system architecture to reactive client interfaces, delivering production-grade digital products."
    />

    <div class="mt-12 md:mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((item, index) => (
        <div 
          class="group rounded-2xl p-1.5 bg-white/[0.04] border border-white/10 hover:border-accent-primary/50 transition-all duration-500 shadow-card flex flex-col justify-between hover:-translate-y-1.5"
          data-aos="fade-up"
          data-aos-delay={index * 80}
        >
          <div class="rounded-xl p-7 bg-surface-card h-full flex flex-col justify-between border border-white/[0.05] shadow-[inset_0_1px_0_0_rgba(255,255,255,0.08)]">
            <div>
              <!-- Top Row: Number & Status -->
              <div class="flex items-center justify-between mb-6">
                <span class="text-[11px] font-mono font-medium text-text-dim uppercase tracking-widest">// {item.number}</span>
                <span class="w-1.5 h-1.5 rounded-full bg-accent-primary opacity-80 group-hover:opacity-100 transition-opacity"></span>
              </div>

              <!-- Title -->
              <h3 class="text-xl font-bold text-text-primary tracking-tight mb-3 transition-colors">
                {item.title}
              </h3>

              <!-- Description -->
              <p class="text-sm text-text-muted font-normal leading-relaxed mb-6">
                {item.description}
              </p>
            </div>

            <!-- Tech Chips -->
            <div class="pt-4 border-t border-border-subtle">
              <div class="flex flex-wrap gap-2">
                {item.stack.map((tech) => (
                  <span class="text-[10px] font-mono px-2.5 py-1 rounded-md bg-white/[0.03] border border-border-subtle text-text-muted">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
