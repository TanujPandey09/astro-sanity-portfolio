---
const { aboutData } = Astro.props;
import { PortableText } from "astro-portabletext";
import SectionHeader from "../SectionHeader.astro";
import PremiumBackground from "../PremiumBackground.astro";
import Skills from "../Skills.astro";
import { optimizeSanityImage } from "../../lib/optimizeImage";

const chapters = [
  {
    num: "01",
    title: "Frontend Foundations",
    subtitle: "Component Systems & Core Web Vitals",
    desc: "Built responsive React and Next.js applications at Scube.co and Techmatys, cutting page load times by 50% and standardizing reusable UI libraries across enterprise dashboards.",
    statNum: "React / Next.js",
    statLabel: "UI Architecture"
  },
  {
    num: "02",
    title: "Solo SaaS Ownership",
    subtitle: "Multi-Role Healthcare Platforms",
    desc: "Owned the entire frontend architecture at Nasya IT across Super Admin, Doctor, Patient, and Clinic portals, shipping 10+ CRUD modules and real-time reporting from zero to launch.",
    statNum: "10+ Modules",
    statLabel: "Zero-to-One Delivery"
  },
  {
    num: "03",
    title: "Multi-LLM & AI Engineering",
    subtitle: "RAG, Validation & Bilingual RTL UX",
    desc: "Engineered Sawt AI at Cxisuite with OpenAI, Gemini, Grok, and Perplexity integrations, automated output validation, Arabic/English RTL interfaces, and MyFatoorah subscription billing.",
    statNum: "Multi-LLM",
    statLabel: "Production AI Workflows"
  },
  {
    num: "04",
    title: "Real-Time Full-Stack Systems",
    subtitle: "Socket.IO CRMs & Scalable APIs",
    desc: "Designed event-driven Node.js and PostgreSQL backends with Socket.IO live pipelines, SLA tracking, role-based access control, rate limiting, and audit logging.",
    statNum: "Full-Stack",
    statLabel: "End-to-End Systems"
  }
];
---

<div class="relative min-h-screen selection:bg-accent-primary/30 overflow-hidden">
  <PremiumBackground />

  <main class="relative z-10">
    <!-- Hero Section: Structured Bento Grid -->
    <section class="mx-auto w-full max-w-7xl px-4 md:px-6 lg:px-8 pt-28 pb-16 md:pt-36 md:pb-24 relative z-10">
      
      <!-- Section Header -->
      <div class="mb-12 space-y-3" data-aos="fade-up">
         <span class="text-[11px] font-mono uppercase tracking-[0.2em] text-accent-hover block">About · Tanuj Pandey</span>
         <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-text-primary tracking-tight leading-[1.08] m-0">
           Engineering <span class="text-gradient">Background</span>
         </h1>
         <p class="text-text-muted text-sm md:text-base max-w-2xl">
           Full-Stack Engineer with 4+ years of commercial experience building multi-LLM SaaS products, real-time CRM systems, and high-performance web applications.
         </p>
      </div>

      <!-- Bento Grid Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 w-full items-stretch">
         
         <!-- Cell 1: Widescreen Profile Image (Left) -->
         <div class="lg:col-span-5 relative group rounded-2xl overflow-hidden border border-white/[0.09] p-1.5 bg-white/[0.03] min-h-[260px] sm:min-h-[360px] flex flex-col" data-aos="fade-up">
            <div class="relative w-full h-full flex-grow rounded-xl overflow-hidden bg-surface-card">
               {aboutData?.[0]?.heroImage?.asset?.url ? (
                 <img
                   src={optimizeSanityImage(aboutData[0].heroImage.asset.url, 800, 80)}
                   alt="Tanuj Pandey - Full Stack Engineer"
                   loading="lazy"
                   decoding="async"
                   width="600"
                   height="600"
                   class="w-full h-full object-cover rounded-xl grayscale group-hover:grayscale-0 transition-all duration-700 opacity-90 group-hover:opacity-100"
                 />
               ) : (
                  <div class="w-full h-full bg-surface-elevated flex items-center justify-center rounded-xl">
                     <span class="font-mono text-text-dim text-xs">Tanuj Pandey</span>
                  </div>
               )}
            </div>
         </div>

         <!-- Cell 2: The Bio Narrative (Right) -->
         <div class="lg:col-span-7 rounded-2xl p-1.5 bg-white/[0.03] border border-white/[0.09] flex flex-col" data-aos="fade-up" data-aos-delay="80">
            <div class="bg-surface-card border border-white/[0.05] p-5 sm:p-7 md:p-9 rounded-xl h-full flex flex-col justify-between relative overflow-hidden">
              <div class="space-y-4 sm:space-y-5">
                 <span class="font-mono text-xs text-accent-hover block">Engineering Philosophy</span>
                 <h2 class="text-text-primary font-bold tracking-tight leading-snug text-lg sm:text-xl md:text-2xl">
                   {aboutData?.[0]?.aboutName || "Shipping resilient software where backend architecture and frontend craft meet."}
                 </h2>
                 <div class="prose prose-invert prose-sm md:prose-base max-w-none text-text-muted leading-relaxed space-y-4">
                   <PortableText value={aboutData?.[0]?.description} />
                 </div>
              </div>
            </div>
         </div>

         <!-- Cell 3: Core Architecture Stack (Bottom Left) -->
         <div class="lg:col-span-6 rounded-2xl p-1.5 bg-white/[0.03] border border-white/[0.09]" data-aos="fade-up">
            <div class="bg-surface-card border border-white/[0.05] p-5 sm:p-7 rounded-xl h-full flex flex-col justify-between">
               <div class="space-y-4 sm:space-y-5 w-full">
                  <span class="font-mono text-xs text-text-dim block">Primary Production Stack</span>
                  
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                     <div class="bg-surface-elevated/70 border border-border-subtle p-3.5 sm:p-4 rounded-xl flex items-center justify-between">
                        <div class="space-y-0.5">
                           <span class="text-[11px] font-mono text-text-dim">Frontend &amp; SSR</span>
                           <p class="text-xs font-bold text-text-primary">React, Next.js &amp; Astro</p>
                        </div>
                        <span class="w-2 h-2 rounded-full bg-accent-primary shrink-0"></span>
                     </div>

                     <div class="bg-surface-elevated/70 border border-border-subtle p-3.5 sm:p-4 rounded-xl flex items-center justify-between">
                        <div class="space-y-0.5">
                           <span class="text-[11px] font-mono text-text-dim">Backend &amp; Realtime</span>
                           <p class="text-xs font-bold text-text-primary">Node.js, Express &amp; Socket.IO</p>
                        </div>
                        <span class="w-2 h-2 rounded-full bg-accent-primary shrink-0"></span>
                     </div>

                     <div class="bg-surface-elevated/70 border border-border-subtle p-3.5 sm:p-4 rounded-xl flex items-center justify-between">
                        <div class="space-y-0.5">
                           <span class="text-[11px] font-mono text-text-dim">Data &amp; CMS</span>
                           <p class="text-xs font-bold text-text-primary">PostgreSQL, MongoDB &amp; Sanity</p>
                        </div>
                        <span class="w-2 h-2 rounded-full bg-accent-primary shrink-0"></span>
                     </div>

                     <div class="bg-surface-elevated/70 border border-border-subtle p-3.5 sm:p-4 rounded-xl flex items-center justify-between">
                        <div class="space-y-0.5">
                           <span class="text-[11px] font-mono text-text-dim">AI &amp; LLMs</span>
                           <p class="text-xs font-bold text-text-primary">OpenAI, Gemini &amp; RAG</p>
                        </div>
                        <span class="w-2 h-2 rounded-full bg-status-live shrink-0"></span>
                     </div>
                  </div>
               </div>
            </div>
         </div>

         <!-- Cell 4: Verified Career Metrics & Resume (Bottom Right) -->
         <div class="lg:col-span-6 rounded-2xl p-1.5 bg-white/[0.03] border border-white/[0.09]" data-aos="fade-up" data-aos-delay="80">
            <div class="bg-surface-card border border-white/[0.05] p-5 sm:p-7 rounded-xl h-full flex flex-col justify-between">
               <div class="space-y-4 sm:space-y-5 w-full">
                  <span class="font-mono text-xs text-text-dim block">Career Snapshot</span>
                  
                  <div class="grid grid-cols-3 gap-2 sm:gap-3.5 text-center">
                     <div class="bg-surface-elevated/70 border border-border-subtle p-3 sm:p-4 rounded-xl">
                        <p class="text-[10px] sm:text-[11px] font-mono text-text-dim mb-1">Experience</p>
                        <p class="text-sm sm:text-lg md:text-xl text-text-primary font-bold font-mono tabular-nums whitespace-nowrap">4+ Yrs</p>
                     </div>
                     <div class="bg-surface-elevated/70 border border-border-subtle p-3 sm:p-4 rounded-xl">
                        <p class="text-[10px] sm:text-[11px] font-mono text-text-dim mb-1">Speed Gain</p>
                        <p class="text-sm sm:text-lg md:text-xl text-text-primary font-bold font-mono tabular-nums whitespace-nowrap">+50%</p>
                     </div>
                     <div class="bg-surface-elevated/70 border border-border-subtle p-3 sm:p-4 rounded-xl">
                        <p class="text-[10px] sm:text-[11px] font-mono text-text-dim mb-1">Delivery</p>
                        <p class="text-sm sm:text-lg md:text-xl text-text-primary font-bold whitespace-nowrap">Full-Stack</p>
                     </div>
                  </div>
               </div>

               <div class="pt-4 sm:pt-5 border-t border-border-subtle mt-5 sm:mt-6 flex flex-col xs:flex-row sm:flex-row items-stretch sm:items-center justify-between gap-3 sm:gap-4">
                  <span class="text-xs font-mono text-text-muted text-center sm:text-left">Full curriculum vitae</span>
                  <button 
                    id="about-resume-btn"
                    aria-label="Download Resume PDF"
                    class="group inline-flex items-center justify-center gap-2.5 px-5 py-2.5 bg-text-primary text-canvas font-bold text-xs uppercase tracking-wider rounded-full transition-all duration-300 hover:bg-white cursor-pointer"
                  >
                     <span>Download Resume</span>
                     <span>↗</span>
                  </button>
               </div>
            </div>
         </div>

      </div>
    </section>

    <!-- Horizontal Scrolling Journey Timeline Section -->
    <section id="journey-timeline-section" class="relative py-16 md:py-20 bg-canvas overflow-hidden border-y border-border-subtle">
      <div class="mx-auto w-full max-w-7xl px-4 md:px-6 lg:px-8 mb-8 md:mb-12">
        <SectionHeader 
          title="Career" 
          gradientText="Progression" 
          subtitle="Four chapters of commercial engineering across frontend systems, full-stack SaaS, and production AI."
        />
      </div>

      <!-- Horizontal Scroll Area (Native swipe on mobile, GSAP pin on desktop) -->
      <div class="horizontal-scroll-container flex items-center relative overflow-x-auto md:overflow-x-hidden snap-x snap-mandatory md:snap-none pb-4 md:pb-0 min-h-[320px] md:min-h-[400px]">
        <div class="timeline-scroll-track flex gap-4 sm:gap-6 md:gap-8 px-4 sm:px-6 md:px-20 relative">
          <!-- Connector Line -->
          <div class="hidden md:block absolute top-1/2 left-0 right-0 h-[1px] bg-gradient-to-r from-accent-primary/30 via-white/10 to-transparent -translate-y-1/2 z-0"></div>
          
          {chapters.map((chapter) => (
            <div class="timeline-card snap-center flex-none w-[285px] sm:w-[320px] md:w-[400px] bg-surface-card border border-white/[0.09] p-5 sm:p-7 rounded-2xl relative z-10 group hover:border-border-hover transition-all duration-500">
              <div class="flex items-center justify-between mb-6">
                <span class="text-xs font-mono text-accent-hover bg-accent-primary/10 border border-accent-primary/20 px-3 py-1 rounded-full">Chapter {chapter.num}</span>
                <span class="text-3xl font-bold text-white/10 font-mono tabular-nums">{chapter.num}</span>
              </div>

              <h3 class="text-xl font-bold text-text-primary tracking-tight mb-1.5">{chapter.title}</h3>
              <p class="text-xs text-accent-hover font-mono mb-3.5">{chapter.subtitle}</p>
              <p class="text-xs sm:text-sm text-text-muted leading-relaxed mb-6">{chapter.desc}</p>

              <div class="border-t border-border-subtle pt-4 flex items-center justify-between text-xs font-mono">
                <span class="text-text-dim">{chapter.statLabel}</span>
                <span class="text-text-primary font-semibold">{chapter.statNum}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Academic Background -->
    <section class="mx-auto w-full max-w-7xl px-4 md:px-6 lg:px-8 py-20 md:py-28 relative z-10">
       <div class="max-w-4xl mx-auto">
          <div class="mb-10">
             <h2 class="text-2xl md:text-3xl font-bold text-text-primary tracking-tight">Education</h2>
             <p class="text-xs sm:text-sm text-text-muted mt-1">Academic foundation in computer science and software engineering.</p>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
             <div class="rounded-2xl p-1.5 bg-white/[0.03] border border-white/[0.09]">
                <div class="bg-surface-card border border-white/[0.05] p-6 rounded-xl h-full flex flex-col justify-between">
                   <div>
                      <span class="font-mono text-xs text-accent-hover bg-accent-primary/10 px-2.5 py-1 rounded-md inline-block mb-3 tabular-nums">2018 - 2020</span>
                      <h3 class="text-lg font-bold text-text-primary tracking-tight">Master of Computer Applications (MCA)</h3>
                   </div>
                   <p class="text-text-muted font-mono text-xs mt-4 pt-3 border-t border-border-subtle">GBPEC Pauri Garhwal</p>
                </div>
             </div>

             <div class="rounded-2xl p-1.5 bg-white/[0.03] border border-white/[0.09]">
                <div class="bg-surface-card border border-white/[0.05] p-6 rounded-xl h-full flex flex-col justify-between">
                   <div>
                      <span class="font-mono text-xs text-text-dim bg-surface-elevated px-2.5 py-1 rounded-md inline-block mb-3 tabular-nums">2015 - 2018</span>
                      <h3 class="text-lg font-bold text-text-primary tracking-tight">Bachelor of Computer Applications (BCA)</h3>
                   </div>
                   <p class="text-text-muted font-mono text-xs mt-4 pt-3 border-t border-border-subtle">BFIT Dehradun</p>
                </div>
             </div>
          </div>
       </div>
    </section>
  </main>
  
  <div class="relative z-20 mx-auto w-full max-w-7xl px-4 md:px-6 lg:px-8">
    <Skills />
  </div>
</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initAbout = () => {
    const resumeBtn = document.querySelector('#about-resume-btn');
    resumeBtn?.addEventListener('click', () => {
      const link = document.createElement("a");
      link.href = "/Resume.pdf";
      link.target = "_blank";
      link.download = "resume.pdf";
      link.click();
    });

    const track = document.querySelector('.timeline-scroll-track');
    const section = document.getElementById('journey-timeline-section');
    if (track && section && window.innerWidth >= 768) {
      const getScrollAmount = () => {
        let trackWidth = track.scrollWidth;
        return Math.min(0, -(trackWidth - window.innerWidth));
      };

      gsap.to(track, {
        x: getScrollAmount,
        ease: "none",
        scrollTrigger: {
          trigger: section,
          start: "top top",
          end: () => `+=${track.scrollWidth}`,
          pin: true,
          scrub: 1,
          invalidateOnRefresh: true,
        }
      });
    }
  };

  initAbout();
  document.addEventListener('astro:after-swap', initAbout);
</script>
