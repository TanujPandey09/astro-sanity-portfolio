---
// NovaStack Services Section: Interactive Split Showcase (Left Tab Navigator + Right Unified HD Light Mockup Stage)
// Uses current NovaStack Design Tokens (--surface, --bg, --ink, --muted, --border, --blue-600, --blue-50) & Geist Sans/Mono scale
import { optimizeSanityImage } from "../../lib/optimizeImage";

interface SanityServiceInput {
  _key?: string;
  serviceKey?: string;
  title?: string;
  category?: string;
  description?: string;
  mockupCaption?: string;
  mockupBadge?: string;
  mockupImage?: {
    alt?: string;
    asset?: { url?: string };
  };
}

interface Props {
  sanityServices?: SanityServiceInput[];
}

const { sanityServices = [] } = Astro.props;

interface ServiceItem {
  id: string;
  num: string;
  title: string;
  category: string;
  iconKey: string;
  sketchKey: string;
  description: string;
  deliverables: string;
  customMockupUrl?: string;
  customMockupAlt?: string;
  customMockupCaption?: string;
  customMockupBadge?: string;
}

const defaultServices: ServiceItem[] = [
  {
    id: "web-dev",
    num: "01",
    title: "Web Design & Development",
    category: "High-Performance Websites & Web Apps",
    iconKey: "web",
    sketchKey: "web-dev",
    description:
      "Fast, conversion-focused websites built with Next.js 15, Astro, and headless Sanity CMS for effortless team publishing.",
    deliverables: "Next.js / Astro · Sanity CMS · Core Web Vitals",
  },
  {
    id: "saas-dev",
    num: "02",
    title: "SaaS & Full-Stack Development",
    category: "Web Software, Portals & MVPs",
    iconKey: "saas",
    sketchKey: "saas-dev",
    description:
      "Production multi-tenant software with PostgreSQL schemas, role-based access control, and automated Stripe billing.",
    deliverables: "PostgreSQL · RBAC · Stripe Billing · Multi-Tenant MVP",
  },
  {
    id: "ai-automation",
    num: "03",
    title: "AI Integrations & Automation",
    category: "RAG Pipelines & Autonomous Agents",
    iconKey: "ai",
    sketchKey: "ai-automation",
    description:
      "Embed Claude, OpenAI, and Gemini into real workflows with private vector RAG retrieval, tool-calling agents, and CRM sync.",
    deliverables: "LLM APIs · Vector RAG · Tool Agents · Webhooks",
  },
  {
    id: "html-email",
    num: "04",
    title: "Email Design Systems & HTML",
    category: "Production Email Engineering",
    iconKey: "email",
    sketchKey: "html-email",
    description:
      "Modular, handcrafted table-based HTML email campaigns tested across Outlook 365, Gmail, and Apple Mail.",
    deliverables: "Handcoded HTML · Inline CSS · Outlook VML · ESP-Ready",
  },
];

const iconForServiceKey = (key?: string): string => {
  if (key === "web-dev") return "web";
  if (key === "saas-dev") return "saas";
  if (key === "ai-automation") return "ai";
  if (key === "html-email") return "email";
  return "custom";
};

// Prioritize real Sanity `agencyServices` content & uploaded mockup images (q=100 lossless crispness)
const servicesData: ServiceItem[] =
  Array.isArray(sanityServices) && sanityServices.length > 0
    ? sanityServices.map((s, idx) => {
        const key = s?.serviceKey || "custom";
        const fallback = defaultServices.find((d) => d.id === key);
        const rawImg = s?.mockupImage?.asset?.url || "";
        return {
          id: s?._key || `${key}-${idx}`,
          num: String(idx + 1).padStart(2, "0"),
          title: s?.title || fallback?.title || "Engineering Service",
          category: s?.category || fallback?.category || "Custom Capability",
          iconKey: iconForServiceKey(key),
          sketchKey: fallback ? fallback.sketchKey : "custom",
          description: s?.description || fallback?.description || "",
          deliverables:
            fallback?.deliverables ||
            s?.category ||
            "Production Engineering Deliverable",
          customMockupUrl: rawImg ? optimizeSanityImage(rawImg, 2400, 100) : undefined,
          customMockupAlt: s?.mockupImage?.alt || s?.title || "Service mockup preview",
          customMockupCaption: s?.mockupCaption || s?.category || s?.title || "Live Deliverable Preview",
          customMockupBadge: s?.mockupBadge || "Production Ready",
        };
      })
    : defaultServices;

const initialActiveId = servicesData[0]?.id || "web-dev";
---

<section id="services" class="ns-section bg-[var(--surface)] text-[var(--ink)] border-b border-[var(--border)]">
  <div class="ns-container">
    <!-- Section Header (Consistent Geist Sans/Mono Type Scale) -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-12 lg:mb-16">
      <div class="max-w-2xl">
        <div class="flex items-center gap-2.5 mb-3">
          <span class="w-5 h-px bg-[var(--blue-600)]" aria-hidden="true"></span>
          <span class="ns-mono-label text-[var(--blue-600)] font-medium">
            01 / Services
          </span>
        </div>
        <h2 class="ns-h2 text-[var(--ink)]">
          Focused Engineering, Built for <span class="text-[var(--blue-600)]">Production.</span>
        </h2>
      </div>

      <p class="ns-body max-w-md">
        Four core disciplines delivered with strict TypeScript, clear architecture, and full repository handover.
      </p>
    </div>

    <!-- Equal-Height Split Showcase Layout (Left 41% Navigator | Right 59% Larger Crisp HD Mockup Stage) -->
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,0.82fr)_minmax(0,1.18fr)] gap-6 items-stretch">
      <!-- Left Column: Interactive Services Tabs -->
      <div class="flex flex-col justify-between gap-2.5" role="tablist" aria-label="NovaStack Services">
        {servicesData.map((service) => {
          const isInitialActive = service.id === initialActiveId;

          return (
            <div
              data-service-item={service.id}
              role="tab"
              aria-selected={isInitialActive ? "true" : "false"}
              tabindex="0"
              class={`service-item-wrapper rounded-[16px] cursor-pointer select-none transition-all duration-200 ${
                isInitialActive
                  ? "bg-[var(--bg)] border border-[var(--blue-600)] p-4 sm:p-5"
                  : "bg-[var(--surface)] border border-[var(--border)] hover:border-[#CBD5E1] py-3.5 px-4 sm:px-5"
              }`}
            >
              <div class="flex items-center justify-between gap-3">
                <div class="flex items-center gap-3.5 min-w-0">
                  <!-- 40px Rounded Square Icon Container -->
                  <div
                    class={`service-icon-badge w-10 h-10 rounded-[10px] flex items-center justify-center shrink-0 transition-colors duration-200 ${
                      isInitialActive
                        ? "bg-[var(--blue-600)] text-white"
                        : "bg-[var(--blue-50)] text-[var(--blue-600)]"
                    }`}
                  >
                    {service.iconKey === "web" && (
                      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="4" width="18" height="14" rx="2"></rect>
                        <line x1="8" y1="21" x2="16" y2="21"></line>
                        <line x1="12" y1="18" x2="12" y2="21"></line>
                        <path d="M3 9h18"></path>
                      </svg>
                    )}
                    {service.iconKey === "saas" && (
                      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                        <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                      </svg>
                    )}
                    {service.iconKey === "ai" && (
                      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 2v4"></path>
                        <path d="M12 18v4"></path>
                        <path d="M4.93 4.93l2.83 2.83"></path>
                        <path d="M16.24 16.24l2.83 2.83"></path>
                        <path d="M2 12h4"></path>
                        <path d="M18 12h4"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                      </svg>
                    )}
                    {service.iconKey === "email" && (
                      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                      </svg>
                    )}
                    {service.iconKey === "custom" && (
                      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                        <polyline points="2 17 12 22 22 17"></polyline>
                        <polyline points="2 12 12 17 22 12"></polyline>
                      </svg>
                    )}
                  </div>

                  <div class="min-w-0">
                    <h3 class="text-lg sm:text-xl font-semibold text-[var(--ink)] tracking-[-0.02em] leading-snug">
                      {service.title}
                    </h3>
                    <span class="text-xs font-mono text-[var(--muted)] block truncate mt-0.5">
                      {service.category}
                    </span>
                  </div>
                </div>

                <span
                  class={`service-num-label text-xs font-mono font-medium shrink-0 transition-colors ${
                    isInitialActive ? "text-[var(--blue-600)]" : "text-[var(--muted)]"
                  }`}
                >
                  {service.num}
                </span>
              </div>

              <!-- Expandable Description + Mono Deliverables (Current 16px Readable Copy) -->
              <div class={`service-details-panel mt-3.5 pt-3.5 border-t border-[var(--border)] space-y-2.5 ${isInitialActive ? "block" : "hidden"}`}>
                <p class="text-[15px] sm:text-base leading-[1.6] text-[var(--muted)]">
                  {service.description}
                </p>
                <div class="flex items-center gap-2 text-xs font-mono text-[var(--muted)]">
                  <span class="text-[var(--blue-600)] font-semibold uppercase tracking-[0.06em] shrink-0">
                    Deliverables:
                  </span>
                  <span class="truncate">{service.deliverables}</span>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Right Column: Wider Crisp HD Mockup Card (Outer Light Frame + Inner Card, Bigger Clear UI) -->
      <div class="flex flex-col">
        <div id="mockup-stage-container" class="relative w-full flex-1 flex flex-col">
          {servicesData.map((service) => {
            const isInitialActive = service.id === initialActiveId;

            return (
              <div
                data-mockup-panel={service.id}
                role="tabpanel"
                class={`mockup-display-panel w-full flex-1 flex-col select-none ${isInitialActive ? "flex" : "hidden"}`}
              >
                {service.customMockupUrl ? (
                  /* PRIORITY 1: Real Sanity Uploaded HD Mockup Image (Bigger & Clearer Inside Crisp Inner Card) */
                  <div class="flex-1 flex flex-col justify-between rounded-[16px] bg-[var(--bg)] border border-[var(--border)] p-2 sm:p-2.5">
                    <div class="flex-1 min-h-[300px] sm:min-h-[380px] lg:min-h-0 w-full rounded-[12px] bg-[var(--surface)] border border-[var(--border)] overflow-hidden flex items-center justify-center">
                      <img
                        src={service.customMockupUrl}
                        alt={service.customMockupAlt}
                        loading="eager"
                        decoding="sync"
                        class="w-full h-full object-contain scale-[1.06] block"
                      />
                    </div>

                    <div class="pt-2.5 px-1.5 flex items-center justify-between gap-3 shrink-0">
                      <div class="flex items-center gap-2 min-w-0">
                        <span class="w-2 h-2 rounded-full bg-[var(--blue-600)] shrink-0" aria-hidden="true"></span>
                        <span class="text-xs font-mono text-[var(--muted)] truncate">
                          {service.customMockupCaption}
                        </span>
                      </div>
                      <span class="px-3 py-1 rounded-full bg-[var(--blue-50)] text-[var(--blue-700)] text-xs font-mono font-medium shrink-0">
                        {service.customMockupBadge}
                      </span>
                    </div>
                  </div>
                ) : (
                  /* PRIORITY 2: Clean Neutral + Blue Light Browser Sketch Fallback (Exact Same Height as Left List) */
                  <div class="flex-1 flex flex-col justify-between rounded-[16px] bg-[var(--bg)] border border-[var(--border)] p-2.5 sm:p-3">
                    <div class="flex-1 min-h-[280px] sm:min-h-[340px] lg:min-h-0 w-full rounded-[12px] bg-[var(--surface)] border border-[var(--border)] overflow-hidden flex flex-col">
                      <!-- Thin Light Browser Bar -->
                      <div class="h-10 px-4 bg-[var(--bg)] border-b border-[var(--border)] flex items-center justify-between gap-3 shrink-0">
                        <div class="flex items-center gap-1.5">
                          <span class="w-2.5 h-2.5 rounded-full bg-[#CBD5E1]"></span>
                          <span class="w-2.5 h-2.5 rounded-full bg-[#CBD5E1]"></span>
                          <span class="w-2.5 h-2.5 rounded-full bg-[#CBD5E1]"></span>
                        </div>
                        <span class="text-xs font-mono text-[var(--muted)] truncate">
                          {service.title}
                        </span>
                        <span class="px-2.5 py-0.5 rounded-full bg-[var(--blue-50)] text-[var(--blue-700)] text-[11px] font-mono font-medium shrink-0">
                          {service.num}
                        </span>
                      </div>

                      <!-- Service-Specific Structural Sketch -->
                      {service.sketchKey === "web-dev" ? (
                        <div class="flex-1 p-5 sm:p-6 grid grid-cols-12 gap-4 items-stretch bg-[var(--bg)]/40" aria-hidden="true">
                          <div class="col-span-8 rounded-[12px] bg-[var(--surface)] border border-[var(--border)] p-5 flex flex-col justify-between">
                            <div class="space-y-3">
                              <div class="h-2.5 w-24 rounded-full bg-[var(--blue-50)]"></div>
                              <div class="h-4 w-4/5 rounded bg-[#0B111A]/85"></div>
                              <div class="h-4 w-3/5 rounded bg-[var(--blue-600)]"></div>
                              <div class="h-2.5 w-11/12 rounded bg-[#E2E8F0] mt-3"></div>
                              <div class="h-2.5 w-3/4 rounded bg-[#E2E8F0]"></div>
                            </div>
                            <div class="flex items-center gap-2.5 pt-4">
                              <div class="h-7 w-28 rounded-[8px] bg-[var(--blue-600)]"></div>
                              <div class="h-7 w-24 rounded-[8px] bg-[var(--bg)] border border-[var(--border)]"></div>
                            </div>
                          </div>
                          <div class="col-span-4 rounded-[16px] bg-[var(--surface)] border border-[var(--border)] p-4 flex flex-col justify-between">
                            <div class="w-10 h-1 rounded-full bg-[#CBD5E1] mx-auto"></div>
                            <div class="space-y-2.5 my-3">
                              <div class="h-2.5 w-full rounded bg-[#0B111A]/80"></div>
                              <div class="h-2.5 w-3/4 rounded bg-[var(--blue-600)]"></div>
                              <div class="h-14 w-full rounded-[8px] bg-[var(--blue-50)] mt-3"></div>
                            </div>
                            <div class="h-6 w-full rounded-[8px] bg-[var(--blue-600)]"></div>
                          </div>
                        </div>
                      ) : service.sketchKey === "saas-dev" ? (
                        <div class="flex-1 p-5 sm:p-6 flex gap-4 bg-[var(--bg)]/40" aria-hidden="true">
                          <div class="w-1/4 rounded-[12px] bg-[var(--surface)] border border-[var(--border)] p-3.5 flex flex-col justify-between">
                            <div class="space-y-2.5">
                              <div class="h-3.5 w-3/4 rounded bg-[#0B111A]/85"></div>
                              <div class="h-2.5 w-full rounded bg-[var(--blue-50)] border border-[#BFDBFE]"></div>
                              <div class="h-2.5 w-5/6 rounded bg-[#E2E8F0]"></div>
                              <div class="h-2.5 w-4/5 rounded bg-[#E2E8F0]"></div>
                              <div class="h-2.5 w-5/6 rounded bg-[#E2E8F0]"></div>
                            </div>
                            <div class="h-2.5 w-1/2 rounded bg-[#CBD5E1]"></div>
                          </div>
                          <div class="flex-1 flex flex-col gap-3.5">
                            <div class="grid grid-cols-3 gap-3">
                              <div class="h-16 rounded-[10px] bg-[var(--surface)] border border-[var(--border)] p-3 flex flex-col justify-between">
                                <div class="h-2 w-12 rounded bg-[#CBD5E1]"></div>
                                <div class="h-3.5 w-16 rounded bg-[var(--blue-600)]"></div>
                              </div>
                              <div class="h-16 rounded-[10px] bg-[var(--surface)] border border-[var(--border)] p-3 flex flex-col justify-between">
                                <div class="h-2 w-12 rounded bg-[#CBD5E1]"></div>
                                <div class="h-3.5 w-14 rounded bg-[#0B111A]/80"></div>
                              </div>
                              <div class="h-16 rounded-[10px] bg-[var(--surface)] border border-[var(--border)] p-3 flex flex-col justify-between">
                                <div class="h-2 w-12 rounded bg-[#CBD5E1]"></div>
                                <div class="h-3.5 w-16 rounded bg-[#0B111A]/80"></div>
                              </div>
                            </div>
                            <div class="flex-1 rounded-[12px] bg-[var(--surface)] border border-[var(--border)] p-4 flex flex-col justify-between">
                              <div class="flex items-center justify-between">
                                <div class="h-2.5 w-28 rounded bg-[#0B111A]/75"></div>
                                <div class="h-2.5 w-16 rounded bg-[var(--blue-50)]"></div>
                              </div>
                              <div class="grid grid-cols-6 gap-2.5 items-end h-20 pt-3">
                                <div class="h-8 rounded-t bg-[#E2E8F0]"></div>
                                <div class="h-12 rounded-t bg-[#E2E8F0]"></div>
                                <div class="h-10 rounded-t bg-[#BFDBFE]"></div>
                                <div class="h-16 rounded-t bg-[var(--blue-600)]"></div>
                                <div class="h-12 rounded-t bg-[#BFDBFE]"></div>
                                <div class="h-18 rounded-t bg-[var(--blue-600)]"></div>
                              </div>
                            </div>
                          </div>
                        </div>
                      ) : service.sketchKey === "ai-automation" ? (
                        <div class="flex-1 p-5 sm:p-6 flex flex-col justify-between bg-[var(--bg)]/40" aria-hidden="true">
                          <div class="flex items-center justify-between">
                            <span class="text-xs font-mono text-[var(--blue-600)] font-medium">
                              trigger → rag.query → tool.exec → webhook
                            </span>
                            <span class="w-2.5 h-2.5 rounded-full bg-[var(--blue-600)]"></span>
                          </div>
                          <div class="grid grid-cols-3 gap-3.5 my-3">
                            <div class="rounded-[12px] bg-[var(--surface)] border border-[var(--border)] p-4 space-y-2">
                              <div class="w-7 h-7 rounded-[8px] bg-[var(--blue-50)]"></div>
                              <div class="h-2.5 w-3/4 rounded bg-[#0B111A]/80"></div>
                              <div class="h-2 w-1/2 rounded bg-[#CBD5E1]"></div>
                            </div>
                            <div class="rounded-[12px] bg-[var(--surface)] border border-[var(--blue-600)] p-4 space-y-2">
                              <div class="w-7 h-7 rounded-[8px] bg-[var(--blue-600)]"></div>
                              <div class="h-2.5 w-4/5 rounded bg-[#0B111A]/85"></div>
                              <div class="h-2 w-2/3 rounded bg-[#BFDBFE]"></div>
                            </div>
                            <div class="rounded-[12px] bg-[var(--surface)] border border-[var(--border)] p-4 space-y-2">
                              <div class="w-7 h-7 rounded-[8px] bg-[var(--blue-50)]"></div>
                              <div class="h-2.5 w-3/4 rounded bg-[#0B111A]/80"></div>
                              <div class="h-2 w-1/2 rounded bg-[#CBD5E1]"></div>
                            </div>
                          </div>
                          <div class="rounded-[12px] bg-[var(--surface)] border border-[var(--border)] px-4 py-3 font-mono text-xs text-[var(--muted)] flex items-center justify-between">
                            <span>POST /api/agent/execute</span>
                            <span class="text-[var(--blue-600)] font-medium">JSON Schema</span>
                          </div>
                        </div>
                      ) : (
                        <div class="flex-1 p-5 sm:p-6 flex items-center justify-center bg-[var(--bg)]/40" aria-hidden="true">
                          <div class="w-full max-w-[360px] h-full rounded-[12px] bg-[var(--surface)] border border-[var(--border)] overflow-hidden flex flex-col">
                            <div class="px-4 py-3 bg-[var(--blue-50)] border-b border-[var(--border)] flex items-center justify-between">
                              <div class="h-3 w-24 rounded bg-[var(--blue-600)]"></div>
                              <div class="h-2.5 w-14 rounded bg-white/80"></div>
                            </div>
                            <div class="p-4 space-y-3 flex-1 flex flex-col justify-between">
                              <div class="space-y-2">
                                <div class="h-3 w-4/5 rounded bg-[#0B111A]/85"></div>
                                <div class="h-2.5 w-full rounded bg-[#E2E8F0]"></div>
                                <div class="h-2.5 w-5/6 rounded bg-[#E2E8F0]"></div>
                              </div>
                              <div class="grid grid-cols-2 gap-2.5">
                                <div class="h-14 rounded-[8px] bg-[var(--bg)] border border-[var(--border)]"></div>
                                <div class="h-14 rounded-[8px] bg-[var(--bg)] border border-[var(--border)]"></div>
                              </div>
                              <div class="h-7 w-32 rounded-[8px] bg-[var(--blue-600)]"></div>
                            </div>
                          </div>
                        </div>
                      )}
                    </div>

                    <div class="pt-4 px-1 flex items-center justify-between gap-3">
                      <span class="text-xs font-mono text-[var(--muted)] truncate">
                        {service.deliverables}
                      </span>
                      <span class="px-3 py-1 rounded-full bg-[var(--blue-50)] text-[var(--blue-700)] text-xs font-mono font-medium shrink-0">
                        Production Ready
                      </span>
                    </div>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const setupNovaStackServices = () => {
    const items = Array.from(document.querySelectorAll<HTMLElement>("[data-service-item]"));
    const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-mockup-panel]"));

    if (!items.length || !panels.length) return;

    const activateService = (targetId: string) => {
      items.forEach((item) => {
        const isActive = item.getAttribute("data-service-item") === targetId;
        const iconBadge = item.querySelector(".service-icon-badge");
        const numLabel = item.querySelector(".service-num-label");
        const details = item.querySelector(".service-details-panel");

        item.setAttribute("aria-selected", isActive ? "true" : "false");

        if (isActive) {
          item.classList.remove("bg-[var(--surface)]", "border-[var(--border)]", "hover:border-[#CBD5E1]", "py-3.5", "px-4", "sm:px-5");
          item.classList.add("bg-[var(--bg)]", "border-[var(--blue-600)]", "p-4", "sm:p-5");

          iconBadge?.classList.remove("bg-[var(--blue-50)]", "text-[var(--blue-600)]");
          iconBadge?.classList.add("bg-[var(--blue-600)]", "text-white");

          numLabel?.classList.remove("text-[var(--muted)]");
          numLabel?.classList.add("text-[var(--blue-600)]");

          details?.classList.remove("hidden");
          details?.classList.add("block");
        } else {
          item.classList.remove("bg-[var(--bg)]", "border-[var(--blue-600)]", "p-4", "sm:p-5");
          item.classList.add("bg-[var(--surface)]", "border-[var(--border)]", "hover:border-[#CBD5E1]", "py-3.5", "px-4", "sm:px-5");

          iconBadge?.classList.remove("bg-[var(--blue-600)]", "text-white");
          iconBadge?.classList.add("bg-[var(--blue-50)]", "text-[var(--blue-600)]");

          numLabel?.classList.remove("text-[var(--blue-600)]");
          numLabel?.classList.add("text-[var(--muted)]");

          details?.classList.remove("block");
          details?.classList.add("hidden");
        }
      });

      panels.forEach((panel) => {
        const isMatch = panel.getAttribute("data-mockup-panel") === targetId;
        if (isMatch) {
          panel.classList.remove("hidden");
          panel.classList.add("flex");
        } else {
          panel.classList.add("hidden");
          panel.classList.remove("flex");
        }
      });
    };

    items.forEach((item) => {
      if (item.dataset.bound === "true") return;
      item.dataset.bound = "true";

      const id = item.getAttribute("data-service-item");
      if (!id) return;

      item.addEventListener("click", () => activateService(id));
      item.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          activateService(id);
        }
      });
    });
  };

  setupNovaStackServices();
  document.addEventListener("astro:page-load", setupNovaStackServices);
  document.addEventListener("astro:after-swap", setupNovaStackServices);
</script>
