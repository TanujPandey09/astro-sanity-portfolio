---
import { optimizeSanityImage } from "../lib/optimizeImage";

const { blog, index } = Astro.props;
const blogImageUrl = optimizeSanityImage(blog.FeatureImage?.asset?.url, 300, 80);
const blogTitle = blog.title || blog.projectName || "Technical Article";
---

<div class="blog-item group relative py-16 px-8 border-b border-border-subtle last:border-0 hover:bg-white/[0.02] rounded-2xl transition-all duration-500 -mx-8 hover:shadow-ambient" data-aos="fade-up" data-aos-delay={index * 50}>
  <a href={`/blogs/${blog.slug.current}`} aria-label={`Read article: ${blogTitle}`} class="flex items-center justify-between gap-8">
    <div class="flex-1">
      <div class="flex items-center gap-6 mb-4">
        <span class="text-[10px] font-black text-accent-primary group-hover:tracking-widest transition-all duration-500">JOURNAL {index + 1}</span>
        <span class="text-[10px] font-black text-text-dim italic group-hover:text-text-primary transition-colors duration-500">{new Date(blog._createdAt).toLocaleDateString()}</span>
      </div>
      
      <h3 class="text-text-primary group-hover:text-white transition-colors duration-500 uppercase tracking-tight leading-none group-hover:translate-x-2">
        {blog.projectName || blog.title}
      </h3>
    </div>

    <div class="hidden md:block w-32 h-32 rounded-2xl overflow-hidden scale-95 opacity-0 group-hover:scale-100 group-hover:opacity-100 transition-all duration-700 ease-[cubic-bezier(0.23,1,0.32,1)] border border-border-subtle shadow-ambient">
      {blogImageUrl && (
        <img 
          src={blogImageUrl} 
          alt={blogTitle}
          width="128"
          height="128"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover"
        />
      )}
    </div>

    <div class="flex items-center justify-center w-12 h-12 rounded-full border border-border-subtle group-hover:bg-accent-primary group-hover:border-accent-primary group-hover:text-white transition-all duration-500 group-hover:rotate-45">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
        <path d="M5 12h14m-7-7 7 7-7 7"/>
      </svg>
    </div>
  </a>
</div>

<style>
  .blog-item {
    cursor: pointer;
  }
  h3 {
    font-size: clamp(var(--h3-mobile), 3vw, var(--h3-desktop));
  }
</style>
