---
import Header from "../components/Header.astro";
import Loader from "../components/Loader.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article" | "profile";
  noindex?: boolean;
  schemaType?: "WebPage" | "ProfilePage" | "CollectionPage" | "AboutPage";
  keywords?: string | string[];
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    section?: string;
    tags?: string[];
  };
  breadcrumbs?: Array<{ name: string; path: string }>;
  jsonLd?: Record<string, any> | Record<string, any>[];
  hideDefaultHeader?: boolean;
  hideDefaultFooter?: boolean;
  isAgency?: boolean;
}
const siteUrl = "https://tanujbuilds.site";
const defaultDescription = "Tanuj Pandey is a Full-Stack & AI Engineer (4+ years experience) building multi-LLM SaaS platforms, real-time Node.js backends, high-performance Next.js & React applications, and commercial website templates.";
const defaultKeywords = "Tanuj Pandey, Full Stack Engineer, AI Solutions Architect, React Developer, Next.js Developer, Astro, Node.js, TypeScript, Sanity CMS, Commercial Website Templates, Next.js Templates, Luxury Real Estate Website Template, Dental Clinic Website Template, SaaS Engineer India";
const defaultOgImage = `${siteUrl}/og-image-dark.png`;

const { 
  title, 
  description = defaultDescription,
  image = defaultOgImage,
  type,
  noindex = false,
  schemaType,
  keywords,
  article,
  breadcrumbs,
  jsonLd,
  hideDefaultHeader = false,
  hideDefaultFooter = false,
  isAgency = false,
} = Astro.props;

const resolvedKeywords = Array.isArray(keywords)
  ? keywords.join(", ")
  : keywords || defaultKeywords;

const pathname = Astro.url.pathname;
const isHome = pathname === "/" || pathname === "";
const canonicalPath = pathname === "/" || pathname === "" ? "/" : pathname.replace(/\/+$/, "");
const canonicalURL = new URL(canonicalPath, siteUrl).href;

// Ensure og:image is always an absolute URL and sized for social previews
const resolvedImage = image.startsWith('http') ? image : `${siteUrl}${image.startsWith('/') ? '' : '/'}${image}`;
const isSanityImage = resolvedImage.includes('cdn.sanity.io');
const ogImage = isSanityImage
  ? `${resolvedImage}${resolvedImage.includes('?') ? '&' : '?'}fm=jpg&fit=crop&w=1200&h=630&q=80`
  : resolvedImage;
const resolvedImagePath = resolvedImage.split('?')[0];
const hasKnownImageDimensions = isSanityImage || resolvedImagePath === `${siteUrl}/og-image-dark.png`;
const ogImageType = isSanityImage
  ? 'image/jpeg'
  : /\.png$/i.test(resolvedImagePath)
    ? 'image/png'
    : /\.webp$/i.test(resolvedImagePath)
      ? 'image/webp'
      : 'image/jpeg';
const ogType = type ?? (pathname.startsWith('/blogs/') && pathname !== '/blogs/' ? 'article' : 'website');
const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const personId = `${siteUrl}/#person`;
const websiteId = `${siteUrl}/#website`;
const webpageId = `${canonicalURL}#webpage`;
const additionalNodes = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const primaryNode = additionalNodes.find((node: any) => node?.['@id'] && node?.['@type'] !== 'BreadcrumbList');
const pageSchemaType = schemaType || (isHome ? 'ProfilePage' : 'WebPage');
const pageSchema = {
  "@type": pageSchemaType,
  "@id": webpageId,
  "url": canonicalURL,
  "name": title,
  "description": description,
  "isPartOf": { "@id": websiteId },
  "inLanguage": "en-US",
  ...(primaryNode
    ? { mainEntity: { "@id": primaryNode['@id'] } }
    : pageSchemaType === 'ProfilePage'
      ? { mainEntity: { "@id": personId } }
      : { about: { "@id": personId } }),
};
const breadcrumbSchema = breadcrumbs?.length
  ? {
      "@type": "BreadcrumbList",
      "@id": `${canonicalURL}#breadcrumb`,
      itemListElement: breadcrumbs.map((crumb, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: crumb.name,
        item: new URL(crumb.path, siteUrl).href,
      })),
    }
  : null;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      "name": "Tanuj Pandey",
      "alternateName": ["Tanuj", "Tanuj Builds"],
      "jobTitle": "Full Stack Engineer & AI Solutions Architect",
      "description": "Full Stack Engineer with 4+ years of professional experience building high-performance web applications, scalable APIs, and intelligent AI chatbot workflows.",
      "url": siteUrl,
      "image": defaultOgImage,
      "email": "mailto:tanujp09@gmail.com",
      "nationality": "Indian",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Pauri Garhwal",
        "addressRegion": "Uttarakhand",
        "addressCountry": "India"
      },
      "sameAs": [
        "https://github.com/TanujPandey09",
        "https://linkedin.com/in/tanujdev",
        "https://x.com/TanujPandey",
        siteUrl
      ],
      "knowsAbout": [
        "Full Stack Web Development",
        "Multi-LLM Orchestration (OpenAI, Gemini, Grok, Perplexity)",
        "React.js & Next.js (SSR/SSG)",
        "Astro.js Modern Architecture",
        "Node.js, Express.js & Socket.IO Real-Time Backends",
        "TypeScript & JavaScript",
        "PostgreSQL, MongoDB & Prisma ORM",
        "Sanity CMS, Contentful & Strapi Headless Modeling",
        "Tailwind CSS Design Systems",
        "Commercial Next.js & React Website Templates",
        "REST & GraphQL APIs",
        "Web Performance & Core Web Vitals Optimization"
      ],
      "worksFor": {
        "@type": "Organization",
        "name": "Cxisuite",
        "url": "https://cxisuite.com/"
      },
      "makesOffer": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Custom Full-Stack SaaS & Web Application Development",
            "description": "End-to-end SaaS architecture using Next.js, React, Node.js, TypeScript, and PostgreSQL."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Multi-LLM AI Integration & Agentic Workflows",
            "description": "Production LLM pipelines, RAG architectures, output validation, and bilingual RTL AI interfaces."
          }
        },
        {
          "@type": "Offer",
          "url": `${siteUrl}/templates`,
          "itemOffered": {
            "@type": "SoftwareApplication",
            "name": "Commercial Next.js & React Website Templates",
            "applicationCategory": "WebApplication",
            "description": "Production-ready Next.js, React, and Tailwind CSS templates with 99+ Lighthouse scores and commercial licenses."
          }
        }
      ]
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      "url": siteUrl,
      "name": "Tanuj Pandey | Full Stack Engineer & AI Solutions Architect",
      "description": "Official portfolio of Tanuj Pandey featuring full stack web engineering projects, technical case studies, and modern web applications.",
      "publisher": { "@id": personId },
      "inLanguage": "en-US"
    },
    pageSchema,
    ...(breadcrumbSchema ? [breadcrumbSchema] : []),
    ...additionalNodes,
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <!-- Core SEO & Search Indexing -->
    <meta name="keywords" content={resolvedKeywords} />
    <meta name="author" content="Tanuj Pandey" />
    <meta name="creator" content="Tanuj Pandey" />
    <meta name="publisher" content="Tanuj Pandey" />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <meta name="bingbot" content={robotsContent} />
    <meta name="theme-color" content="#0F121C" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title="Tanuj Pandey — Blog" href={`${siteUrl}/rss.xml`} />
    <link rel="alternate" type="text/plain" title="LLMs Context & Entity Index" href={`${siteUrl}/llms.txt`} />
    <link rel="manifest" href="/manifest.webmanifest" />
    {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION} />
    )}
    {import.meta.env.PUBLIC_BING_SITE_VERIFICATION && (
      <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_SITE_VERIFICATION} />
    )}
    
    <!-- Open Graph (OG) / Social Media Previews (LinkedIn, WhatsApp, Facebook) -->
    <meta property="og:site_name" content="Tanuj Pandey | Full Stack Engineer" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    {hasKnownImageDimensions && <meta property="og:image:width" content="1200" />}
    {hasKnownImageDimensions && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_US" />
    {article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
    {article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
    {article?.author && <meta property="article:author" content={article.author} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    
    <!-- Twitter / X Card Previews -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="twitter:creator" content="@TanujPandey" />
    <meta name="twitter:site" content="@TanujPandey" />

    <!-- Official Brand Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    
    <!-- Google Fonts Preconnect & Optimized Async Link -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" />
    </noscript>
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />

    <!-- Structured Data: JSON-LD for Search Engines & AI Engines (AEO / GEO) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

    <!-- Dynamic Web Analytics (GA4, SPA-aware) -->
    {import.meta.env.PUBLIC_GA_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_ID}`} is:inline></script>
        <script
          is:inline
          data-ga-id={import.meta.env.PUBLIC_GA_ID}
          set:html={`
(function () {
  var id = document.currentScript && document.currentScript.getAttribute("data-ga-id");
  if (!id) return;
  window.dataLayer = window.dataLayer || [];
  window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
  gtag("js", new Date());
  gtag("config", id, { send_page_view: false });
  if (window.__gaTrackingBound) return;
  window.__gaTrackingBound = true;
  document.addEventListener("astro:page-load", function () {
    gtag("event", "page_view", {
      page_location: window.location.href,
      page_path: window.location.pathname + window.location.search,
      page_title: document.title
    });
  });
  document.addEventListener("click", function (event) {
    var target = event.target;
    var link = target && target.closest ? target.closest('a[href^="http"]') : null;
    if (!link || link.hostname === window.location.hostname) return;
    gtag("event", "outbound_click", { link_url: link.href, link_domain: link.hostname });
  });
})();
`}
        ></script>
      </>
    )}
    <!-- Prevent Loader flash on repeat visits / navigation -->
    <script is:inline>
      try {
        if (sessionStorage.getItem('tp_intro_loaded')) {
          document.documentElement.classList.add('preloader-done');
        }
      } catch (e) {}
    </script>
  </head>

  <body>
    <!-- Accessibility Skip Link -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:px-4 focus:py-2 focus:bg-white focus:text-black focus:font-bold focus:rounded-full focus:shadow-xl">
      Skip to main content
    </a>

    <!-- Magnificent Lightweight Intro Loader (Home page only) -->
    {isHome && <Loader />}

    <!-- Top Navigation Header -->
    {!hideDefaultHeader && <Header />}

    <main id="main-content">
      <slot />
    </main>

    {!hideDefaultFooter && <Footer />}
    {!isAgency && <div class="cursor"></div>}
    {!isAgency && <div class="cursor2"></div>}
  </body>
</html>

<style is:global>
  @import 'aos/dist/aos.css';

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  *:focus-visible {
    outline: 2px solid var(--accent-primary, #5E6AD2);
    outline-offset: 4px;
    border-radius: 4px;
  }

  body {
    overflow-x: hidden;
    height: 100%;
    width: 100%;
  }

  /* Custom Minimalist Scrollbar */
  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  ::-webkit-scrollbar-track {
    background: #0B0F17;
  }
  ::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.16);
    border-radius: 6px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #5E6AD2;
  }

  :root {
    /* Modern Framer Developer Design Tokens (Linear & Obsidian System) */
    --canvas-bg-rgb: 11 15 23;          /* #0B0F17 - Deep Midnight Obsidian Slate */
    --surface-card-rgb: 17 23 38;       /* #111726 - Bento Slate Card Surface */
    --surface-elevated-rgb: 26 34 54;   /* #1A2236 - Elevated / Interactive Surface */
    --text-primary-rgb: 248 250 252;    /* #F8FAFC - Crisp Pure White */
    
    /* Developer High-Tech Accent System */
    --accent-primary-rgb: 94 106 210;   /* #5E6AD2 - Linear Indigo */
    --accent-cyan-rgb: 56 189 248;      /* #38BDF8 - Electric Sky / Cyan */
    --status-live-rgb: 16 185 129;      /* #10B981 - Developer Emerald Live */

    --canvas-bg: #0B0F17;
    --surface-card: #111726;
    --surface-elevated: #1A2236;
    
    --border-subtle: rgba(255, 255, 255, 0.08);
    --border-hover: rgba(94, 106, 210, 0.40);
    
    --text-primary: #F8FAFC;
    --text-muted: #94A3B8;              /* Readable Cool Slate Gray */
    --text-dim: #64748B;                /* Tech Slate Metadata */
    
    --accent-primary: #5E6AD2;
    --accent-hover: #7580E0;
    --accent-glow: rgba(94, 106, 210, 0.28);
    --accent-cyan: #38BDF8;
    --status-live: #10B981;

    /* Legacy Fallback Mappings */
    --primary-color: var(--accent-primary);
    --secondary-color: var(--accent-cyan);
    --accent-color: var(--accent-primary);
    --bg-dark: var(--surface-card);
    --bg-deep: var(--canvas-bg);
    --border-color: var(--border-subtle);

    /* Headings - Mobile */
    --h1-mobile: 2.25rem;      
    --h2-mobile: 1.75rem;   
    --h3-mobile: 1.5rem;    
    --h4-mobile: 1.25rem;   
    --h5-mobile: 1.125rem;  
    --h6-mobile: 1rem;      

    /* Paragraph - Mobile */
    --p-mobile: 0.95rem;       
    --small-mobile: 0.85rem; 
    --xs-mobile: 0.75rem;   

    /* Desktop Sizes */
    --h1-desktop: 4rem;   
    --h2-desktop: 2.75rem;   
    --h3-desktop: 2rem;     
    --h4-desktop: 1.5rem;   
    --h5-desktop: 1.25rem;  
    --h6-desktop: 1rem;     

    --p-desktop: 1.05rem;  
    --small-desktop: 0.95rem;  
    --xs-desktop: 0.85rem; 

    /* Line Heights */
    --line-height-tight: 1.15;
    --line-height-normal: 1.6;
    --line-height-relaxed: 1.75;
    --line-height-loose: 2;

    /* Letter Spacing */
    --letter-spacing-tight: -0.03em;
    --letter-spacing-normal: 0;
    --letter-spacing-wide: 0.05em;
    --letter-spacing-wider: 0.1em;

    /* Font Weights */
    --fw-light: 300;
    --fw-normal: 400;
    --fw-medium: 500;
    --fw-semibold: 600;
    --fw-bold: 700;
    --fw-black: 900;
  }

  /* Global Typography Reset */
  html {
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    scroll-behavior: smooth;
    overflow-x: hidden;
    max-width: 100vw;
    width: 100%;
  }

  body {
    overflow-x: hidden;
    max-width: 100vw;
    width: 100%;
    position: relative;
    background-color: var(--bg-deep);
    color: var(--text-muted);
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    font-size: var(--p-mobile);
    line-height: var(--line-height-normal);
  }

  body:has(.agency-page),
  body.agency-page-body {
    background-color: #FAFAFA !important;
    color: #334155 !important;
  }

  #main-content {
    overflow-x: hidden;
    max-width: 100vw;
    width: 100%;
  }

  /* Ensure [data-aos] elements are ALWAYS visible and never trapped at opacity: 0 */
  [data-aos] {
    opacity: 1 !important;
    transform: none !important;
    visibility: visible !important;
  }

  h1, h2, h3, h4, h5, h6 {
    color: var(--text-primary);
    font-family: 'Space Grotesk', sans-serif;
    font-weight: var(--fw-black);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
  }

  h1 { font-size: var(--h1-mobile); }
  h2 { font-size: var(--h2-mobile); }
  h3 { font-size: var(--h3-mobile); }
  h4 { font-size: var(--h4-mobile); }
  h5 { font-size: var(--h5-mobile); }
  h6 { font-size: var(--h6-mobile); }

  p {
    font-size: var(--p-mobile);
    line-height: var(--line-height-relaxed);
    color: var(--text-muted);
  }

  @media (min-width: 1024px) {
    body { font-size: var(--p-desktop); }
    h1 { font-size: var(--h1-desktop); }
    h2 { font-size: var(--h2-desktop); }
    h3 { font-size: var(--h3-desktop); }
    h4 { font-size: var(--h4-desktop); }
    h5 { font-size: var(--h5-desktop); }
    h6 { font-size: var(--h6-desktop); }
    p { font-size: var(--p-desktop); }
  }

  .cursor {
    width: 25px;
    height: 25px;
    border-radius: 100%;
    border: 1px solid var(--primary-color);
    transition: all 150ms ease-out;
    position: fixed;
    pointer-events: none;
    left: 0;
    top: 0;
    transform: translate(-50%, -50%);
    z-index: 9999;
  }

  .cursor2 {
    width: 8px;
    height: 8px;
    border-radius: 100%;
    background-color: var(--primary-color);
    position: fixed;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 9999;
    transition: width 0.3s, height 0.3s, background-color 0.3s;
  }

  .hover {
    background-color: var(--accent-glow);
    border-color: var(--accent-primary);
    width: 60px;
    height: 60px;
  }

  .cursorinnerhover {
    width: 4px;
    height: 4px;
    background-color: white;
  }

  /* Framer High-Contrast Pure White to Slate Sheen Gradient */
  .text-gradient {
    background: linear-gradient(135deg, #FFFFFF 20%, #E2E8F0 60%, #94A3B8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Developer Live Status Pulse Indicator (Emerald Glow) */
  @keyframes ct-rec-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.9); }
  }

  .rec-dot {
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background-color: var(--status-live, #10B981);
    display: inline-block;
    flex-shrink: 0;
    box-shadow: 0 0 10px rgba(16, 185, 129, 0.7);
    animation: ct-rec-pulse 1.8s ease-in-out infinite;
  }

  /* Rushes Vertical Rolling Text Micro-Interaction */
  .rushes-roll {
    position: relative;
    display: inline-flex;
    overflow: hidden;
    line-height: 1.15;
  }
  .rushes-roll-track {
    display: inline-flex;
    flex-direction: column;
    transition: transform 0.42s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  .rushes-roll-track > span:last-child {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
  }
  .group:hover .rushes-roll-track,
  .rushes-roll:hover .rushes-roll-track {
    transform: translateY(-100%);
  }

  /* Premium Card (Glassmorphism & Depth) */
  .glass-card {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.10);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.08), 0 8px 32px -4px rgba(0, 0, 0, 0.5);
    border-radius: 2rem;
  }

  .bg-surface-card {
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.06), 0 8px 24px -4px rgba(0, 0, 0, 0.4);
  }

  /* Real-Time Mouse-Tracking Radial Spotlight Surface */
  .bento-spotlight {
    position: relative;
    overflow: hidden;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .bento-spotlight::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.35s ease;
    background: radial-gradient(
      520px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(94, 106, 210, 0.14),
      transparent 45%
    );
  }
  .bento-spotlight:hover::before {
    opacity: 1;
  }

  @media only screen and (max-width: 1024px) {
    .cursor, .cursor2 {
      display: none !important;
    }
  }

 
  @media only screen and (max-width: 768px) {
    body {
      background: var(--bg-deep);
      background-repeat: no-repeat;
      height: 100%;
      animation: none; /* Disable animation on mobile devices */
    }

    /* Add additional mobile styles if needed */

    /* ....Projects Cards */

    /* .....Blog details */

    .blog-content a {
      color: var(--accent-color);
    }

    .blog-content a:hover {
      color: var(--bg2);
      transition: all ease-in 0.5s;
      text-decoration: underline;
    }
  }
</style>

<style is:global>
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
    [data-aos] {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  import Lenis from 'lenis';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import AOS from 'aos';

  gsap.registerPlugin(ScrollTrigger);

  // Respect the OS "reduce motion" setting: collapse GSAP tweens to near-instant
  // and turn off smooth-scroll hijacking. Content still appears and scroll still works.
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReducedMotion) {
    gsap.globalTimeline.timeScale(100);
  }

  // When AOS is disabled (mobile) it strips the [data-aos] attributes once and
  // never enables its MutationObserver. Strip [data-aos] on mobile viewports
  // BEFORE initializing AOS so off-axis transforms never widen the mobile viewport.
  const isAOSDisabled = () =>
    window.matchMedia('(max-width: 767px)').matches ||
    /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);

  const stripMobileAOS = () => {
    if (isAOSDisabled()) {
      document.querySelectorAll('[data-aos]').forEach((el) => {
        el.removeAttribute('data-aos');
        el.removeAttribute('data-aos-delay');
        el.removeAttribute('data-aos-duration');
        el.removeAttribute('data-aos-easing');
      });
    }
  };

  stripMobileAOS();

  // Initialize AOS locally (disabled on <768px viewports and mobile devices)
  AOS.init({ once: true, duration: 600, disable: isAOSDisabled });

  const syncAOS = () => {
    if (isAOSDisabled()) {
      stripMobileAOS();
    } else {
      AOS.refreshHard();
    }
  };

  syncAOS();
  document.addEventListener('astro:after-swap', syncAOS);
  document.addEventListener('astro:page-load', syncAOS);

  // Initialize Lenis smooth scroll
  const lenis = new Lenis({
    duration: 1.2,
    easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    orientation: 'vertical',
    gestureOrientation: 'vertical',
    smoothWheel: !prefersReducedMotion,
  });

  // Sync ScrollTrigger with Lenis
  lenis.on('scroll', ScrollTrigger.update);

  gsap.ticker.add((time) => {
    lenis.raf(time * 1000);
  });

  gsap.ticker.lagSmoothing(0);

  // Intercept anchor clicks for #contact and /#contact for smooth local scroll
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const link = target.closest('a');
    if (!link) return;

    const href = link.getAttribute('href');
    if (!href) return;

    if (href === '#contact' || (href === '/#contact' && (window.location.pathname === '/' || window.location.pathname === ''))) {
      const contactSection = document.getElementById('contact');
      if (contactSection) {
        e.preventDefault();
        lenis.scrollTo(contactSection, {
          duration: 1.5,
          offset: -50,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t))
        });
      }
    }
  });

  // Handle hash scrolling on page load/navigation
  const checkHashAndScroll = () => {
    if (window.location.hash === '#contact') {
      const contactSection = document.getElementById('contact');
      if (contactSection) {
        setTimeout(() => {
          lenis.scrollTo(contactSection, {
            duration: 1.5,
            offset: -50,
            immediate: false
          });
        }, 400); // Wait for animations to settle
      }
    }
  };

  window.addEventListener('load', checkHashAndScroll);
  document.addEventListener('astro:after-swap', checkHashAndScroll);

  // If not on homepage, dispatch portfolio-loaded immediately to trigger header/nav animations
  window.addEventListener('load', () => {
    window.dispatchEvent(new Event('portfolio-loaded'));
  });

  document.addEventListener('astro:after-swap', () => {
    window.dispatchEvent(new Event('portfolio-loaded'));
  });

  let cursor = document.querySelector(".cursor");
  let cursorinner = document.querySelector(".cursor2");

  const initCursor = () => {
    cursor = document.querySelector(".cursor");
    cursorinner = document.querySelector(".cursor2");
    
    // Hide cursor on mobile
    if (window.innerWidth < 1024) {
      if (cursor) (cursor as HTMLElement).style.display = 'none';
      if (cursorinner) (cursorinner as HTMLElement).style.display = 'none';
    }
  };

  initCursor();
  document.addEventListener('astro:after-swap', initCursor);

  let mouseX = 0;
  let mouseY = 0;

  document.addEventListener("mousemove", (e) => {
    mouseX = e.clientX;
    mouseY = e.clientY;
    if (!cursor || !cursorinner) return;

    gsap.to(cursor, {
      x: mouseX,
      y: mouseY,
      duration: 0.5,
      ease: "power2.out"
    });

    gsap.to(cursorinner, {
      x: mouseX,
      y: mouseY,
      duration: 0.1
    });
  });

  document.addEventListener("mousedown", () => {
    if (!cursor || !cursorinner) return;
    gsap.to(cursor, { scale: 0.8, duration: 0.3 });
    gsap.to(cursorinner, { scale: 2, duration: 0.3 });
  });

  document.addEventListener("mouseup", () => {
    if (!cursor || !cursorinner) return;
    gsap.to(cursor, { scale: 1, duration: 0.3 });
    gsap.to(cursorinner, { scale: 1, duration: 0.3 });
  });

  // Use event delegation for hover states
  document.addEventListener("mouseover", (e) => {
    const target = (e.target as HTMLElement).closest("a, button, .group, [data-hover-glow]");
    if (target && cursor && cursorinner) {
      gsap.to(cursor, { 
        width: 80, 
        height: 80, 
        backgroundColor: "rgba(94, 106, 210, 0.08)",
        borderColor: "rgba(94, 106, 210, 0.4)",
        duration: 0.3 
      });
      gsap.to(cursorinner, { scale: 0.5, opacity: 0, duration: 0.3 });
    }
  });

  document.addEventListener("mouseout", (e) => {
    const target = (e.target as HTMLElement).closest("a, button, .group, [data-hover-glow]");
    if (target && cursor && cursorinner) {
      gsap.to(cursor, { 
        width: 25, 
        height: 25, 
        backgroundColor: "transparent",
        borderColor: "var(--primary-color)",
        duration: 0.3 
      });
      gsap.to(cursorinner, { scale: 1, opacity: 1, duration: 0.3 });
    }
  });

  // Portfolio-Wide GSAP ScrollTrigger, Video Parallax, 3D Card Tilt, Magnetic Buttons & Counters
  const initPortfolioMotion = () => {
    ScrollTrigger.getAll().forEach((t) => {
      if (t.vars.id !== 'about-horizontal-trigger') {
        t.kill();
      }
    });

    // 1. Hero Entrance Choreography (Transform-only, never hides opacity)
    const heroWordmark = document.querySelector('[data-gsap-hero="wordmark"]');
    const heroHeadline = document.querySelector('[data-gsap-hero="headline"]');
    const heroBottom = document.querySelector('[data-gsap-hero="bottombar"]');

    if (heroWordmark) {
      gsap.fromTo(
        heroWordmark,
        { y: 26, scale: 0.97 },
        { y: 0, scale: 1, duration: 1, ease: "power4.out" }
      );
    }
    if (heroHeadline) {
      gsap.fromTo(
        heroHeadline,
        { y: 22 },
        { y: 0, duration: 0.95, delay: 0.08, ease: "power3.out" }
      );
    }
    if (heroBottom) {
      gsap.fromTo(
        heroBottom,
        { y: 20 },
        { y: 0, duration: 0.9, delay: 0.18, ease: "power3.out" }
      );
    }

    // 2. Hero Background Video Scroll Parallax
    const heroBgVideo = document.getElementById("hero-bg-video");
    const heroSection = document.getElementById("hero");
    if (heroBgVideo && heroSection) {
      gsap.to(heroBgVideo, {
        yPercent: 18,
        scale: 1.14,
        ease: "none",
        scrollTrigger: {
          trigger: heroSection,
          start: "top top",
          end: "bottom top",
          scrub: true,
        },
      });
    }

    // 3. Section Headings Kinetic Glide
    document.querySelectorAll<HTMLElement>("[data-gsap-heading]").forEach((heading) => {
      gsap.fromTo(
        heading,
        { y: 28, scale: 0.985 },
        {
          y: 0,
          scale: 1,
          duration: 0.85,
          ease: "power3.out",
          scrollTrigger: {
            trigger: heading,
            start: "top 90%",
            toggleActions: "play none none none",
          },
        }
      );
    });

    // 4. Cards ScrollTrigger Glide & 3D Tilt + Spotlight
    document.querySelectorAll<HTMLElement>("[data-gsap-card]").forEach((card, idx) => {
      gsap.fromTo(
        card,
        { y: 32, scale: 0.985 },
        {
          y: 0,
          scale: 1,
          duration: 0.8,
          delay: (idx % 3) * 0.05,
          ease: "power3.out",
          scrollTrigger: {
            trigger: card,
            start: "top 92%",
            toggleActions: "play none none none",
          },
        }
      );
    });

    // 5. Spotlight Coordinates & Subtle 3D Tilt on Bento Cards
    document.querySelectorAll<HTMLElement>(".bento-spotlight").forEach((card) => {
      if (card.dataset.spotlightBound === "true") return;
      card.dataset.spotlightBound = "true";

      card.addEventListener("mousemove", (e: MouseEvent) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty("--mouse-x", `${x}px`);
        card.style.setProperty("--mouse-y", `${y}px`);

        if (window.innerWidth >= 1024 && !card.hasAttribute("data-exp-item")) {
          const rotateY = ((x / rect.width) - 0.5) * 4;
          const rotateX = ((y / rect.height) - 0.5) * -4;
          gsap.to(card, {
            rotateX,
            rotateY,
            transformPerspective: 1000,
            duration: 0.35,
            ease: "power2.out",
          });
        }
      });

      card.addEventListener("mouseleave", () => {
        if (window.innerWidth >= 1024) {
          gsap.to(card, {
            rotateX: 0,
            rotateY: 0,
            duration: 0.5,
            ease: "power3.out",
          });
        }
      });
    });

    // 6. Project Card Hover Video Preview
    document.querySelectorAll<HTMLElement>(".project-item").forEach((item) => {
      const video = item.querySelector<HTMLVideoElement>(".project-hover-video");
      if (!video || item.dataset.videoBound === "true") return;
      item.dataset.videoBound = "true";

      item.addEventListener("mouseenter", () => {
        video.play().catch(() => {});
      });
      item.addEventListener("mouseleave", () => {
        video.pause();
      });
    });

    // 7. Magnetic Buttons
    document.querySelectorAll<HTMLElement>(".magnetic-btn").forEach((btn) => {
      if (btn.dataset.magneticBound === "true") return;
      btn.dataset.magneticBound = "true";

      btn.addEventListener("mousemove", (e: MouseEvent) => {
        if (window.innerWidth < 1024) return;
        const rect = btn.getBoundingClientRect();
        const dx = (e.clientX - (rect.left + rect.width / 2)) * 0.28;
        const dy = (e.clientY - (rect.top + rect.height / 2)) * 0.28;
        gsap.to(btn, { x: dx, y: dy, duration: 0.3, ease: "power2.out" });
      });

      btn.addEventListener("mouseleave", () => {
        gsap.to(btn, { x: 0, y: 0, duration: 0.6, ease: "elastic.out(1, 0.4)" });
      });
    });

    // 8. Animated Metric Counters
    document.querySelectorAll<HTMLElement>("[data-counter]").forEach((counterEl) => {
      if (counterEl.dataset.counterAnimated === "true") return;
      const targetVal = parseFloat(counterEl.getAttribute("data-counter") || "0");
      const suffix = counterEl.getAttribute("data-suffix") || "";
      if (!targetVal) return;

      const state = { val: 0 };
      ScrollTrigger.create({
        trigger: counterEl,
        start: "top 92%",
        once: true,
        onEnter: () => {
          counterEl.dataset.counterAnimated = "true";
          gsap.to(state, {
            val: targetVal,
            duration: 1.4,
            ease: "power3.out",
            onUpdate: () => {
              counterEl.textContent = `${Math.round(state.val)}${suffix}`;
            },
          });
        },
      });
    });

    ScrollTrigger.refresh();
  };

  initPortfolioMotion();
  document.addEventListener("astro:page-load", initPortfolioMotion);
  document.addEventListener("astro:after-swap", initPortfolioMotion);
</script>
