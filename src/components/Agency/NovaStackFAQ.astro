---
// NovaStack Frequently Asked Questions: 6 Core Answers
const faqs = [
  {
    question: "What services does NovaStack provide?",
    answer: "NovaStack is an AI & digital technology studio delivering six core disciplines: Full-Stack Web Development (Next.js, React 19), Cross-Platform Mobile App Development (React Native for iOS and Android), Applied AI & Automation (multi-LLM orchestration, RAG pipelines, chatbots, autonomous agents), SaaS & Custom Software Engineering (MVPs, CRM systems, subscription billing, real-time sync), Technical SEO & GEO (Core Web Vitals tuning, structured schema, machine-readable discovery), and UI/UX & Product Design (Figma prototyping, accessible design systems)."
  },
  {
    question: "Do you work with international clients?",
    answer: "Yes. Over 80% of our projects are with founders, startups, and businesses located internationally across the United States, United Kingdom, United Arab Emirates, Australia, and India. We accommodate asynchronous communication through Slack, Teams, Linear, and Loom, while maintaining reliable daily overlapping windows for sprint syncs, milestone reviews, and technical discussions."
  },
  {
    question: "Can you build custom SaaS applications from scratch?",
    answer: "Yes. End-to-end SaaS engineering is our core specialty. We handle the complete product lifecycle: from initial database modeling (PostgreSQL / Prisma) and multi-tenant authentication (RBAC, JWT) to subscription billing (Stripe, MyFatoorah), real-time WebSockets state synchronization, and high-conversion client dashboards. We also build rapid 4-to-8 week SaaS MVPs designed for investor demos and early customer acquisition."
  },
  {
    question: "Do you integrate AI into existing products without a full rewrite?",
    answer: "Absolutely. We routinely audit existing codebases and embed production-grade AI features without disrupting your current user traffic. This includes multi-provider routing (OpenAI GPT-4o, Claude 3.5, Gemini 1.5) with fallback logic, custom RAG search over proprietary documents, automated customer support assistants, and background AI data processing workers."
  },
  {
    question: "Do you provide ongoing maintenance and post-launch support?",
    answer: "Yes. Every fixed-price project includes a complimentary 30-day post-launch warranty covering any bug fixes and deployment support. Beyond launch, we offer dedicated Monthly Maintenance & SLA retainers covering continuous uptime monitoring, security patching, library updates, performance tuning, and reserved hours for ongoing feature enhancements."
  },
  {
    question: "How can I start a project with NovaStack?",
    answer: "Getting started is simple: fill out the inquiry form below with a brief summary of your product goals, timeline, and rough budget. Senior engineering leadership reviews every submission and responds within 24 hours with an initial technical assessment and a link to schedule a 30-minute discovery consultation."
  }
];
---

<section id="faq" class="py-16 sm:py-20 md:py-28 bg-white border-b border-slate-200/80">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-slate-100 border border-slate-200 text-xs font-mono font-semibold text-slate-700 uppercase tracking-wider mb-3">
        // FREQUENTLY ASKED QUESTIONS
      </div>
      <h2 class="font-grotesk font-extrabold text-3xl sm:text-4xl text-slate-900 tracking-[-0.03em] leading-tight">
        Clear Answers to Common Questions.
      </h2>
      <p class="text-sm sm:text-base text-slate-600 mt-3 font-sans">
        Everything you need to know about partnering with NovaStack for software engineering and AI implementation.
      </p>
    </div>

    <!-- Accordion List -->
    <div class="space-y-4" id="faq-accordion-group">
      {faqs.map((faq, index) => {
        const isFirst = index === 0;
        return (
          <div class="rounded-2xl bg-[#FAFAFA] border border-slate-200 overflow-hidden transition-all duration-200 hover:border-slate-300">
            <button
              type="button"
              id={`faq-btn-${index}`}
              aria-expanded={isFirst ? "true" : "false"}
              aria-controls={`faq-answer-${index}`}
              class="faq-trigger w-full text-left px-5 sm:px-7 py-4 sm:py-5 flex items-center justify-between gap-4 cursor-pointer focus:outline-none focus:bg-slate-100/50"
            >
              <span class="font-grotesk font-bold text-base sm:text-lg text-slate-900 tracking-tight pr-2">
                {faq.question}
              </span>
              <span class={`faq-chevron w-8 h-8 rounded-full border border-slate-200 flex items-center justify-center shrink-0 text-slate-600 transition-transform duration-300 ${isFirst ? 'rotate-180 bg-slate-900 text-white border-slate-900' : 'bg-white'}`}>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </button>

            <div
              id={`faq-answer-${index}`}
              role="region"
              aria-labelledby={`faq-btn-${index}`}
              class={`faq-content px-5 sm:px-7 pb-5 pt-1 text-xs sm:text-sm text-slate-600 leading-relaxed font-sans border-t border-slate-200/60 ${isFirst ? '' : 'hidden'}`}
            >
              {faq.answer}
            </div>
          </div>
        );
      })}
    </div>

    <!-- Bottom Help Notice -->
    <div class="mt-10 text-center text-xs font-mono text-slate-500">
      Have a question not listed here? <a href="#contact" class="text-[#0284C7] font-semibold hover:underline">Ask our engineering lead directly →</a>
    </div>

  </div>
</section>

<script>
  const initFaqAccordions = () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.faq-trigger');
    
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        const targetId = btn.getAttribute('aria-controls');
        if (!targetId) return;
        const targetContent = document.getElementById(targetId);
        const chevron = btn.querySelector('.faq-chevron');

        if (isExpanded) {
          btn.setAttribute('aria-expanded', 'false');
          targetContent?.classList.add('hidden');
          chevron?.classList.remove('rotate-180', 'bg-slate-900', 'text-white', 'border-slate-900');
          chevron?.classList.add('bg-white');
        } else {
          btn.setAttribute('aria-expanded', 'true');
          targetContent?.classList.remove('hidden');
          chevron?.classList.add('rotate-180', 'bg-slate-900', 'text-white', 'border-slate-900');
          chevron?.classList.remove('bg-white');
        }
      });
    });
  };

  initFaqAccordions();
  document.addEventListener('astro:after-swap', initFaqAccordions);
</script>

