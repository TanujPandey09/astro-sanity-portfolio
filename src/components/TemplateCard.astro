---
import { optimizeSanityImage } from "../lib/optimizeImage";
import type { TemplateItem } from "../lib/templates";

interface Props {
  template: TemplateItem;
  index?: number;
}

const { template, index = 0 } = Astro.props;

const rawImageUrl = template.imageUrl || "/img/custom-project.webp";
const imageUrl = rawImageUrl.includes("cdn.sanity.io") 
  ? optimizeSanityImage(rawImageUrl, 1000, 80)
  : rawImageUrl;

const price = template.price || "$49";
const originalPrice = template.originalPrice;
const tags = template.tags?.slice(0, 4) || ["Next.js", "Tailwind CSS", "TypeScript"];
const highlights = template.highlights?.slice(0, 3) || [];
---

<article 
  data-gsap-card
  class="template-card bento-spotlight group relative rounded-[22px] p-1.5 bg-[#111726] border border-white/[0.10] hover:border-accent-primary/40 transition-all duration-500 flex flex-col justify-between overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.65)]"
  data-category={template.category?.toLowerCase() || "general"}
  data-tags={tags.join(",").toLowerCase()}
>
  <div class="h-full w-full rounded-[16px] bg-[#111726] border border-white/[0.05] overflow-hidden flex flex-col justify-between">
    
    <!-- Image Header with Developer HUD Viewfinder Crosshairs -->
    <div class="relative overflow-hidden w-full aspect-[16/10] bg-[#0B0F17] border-b border-white/[0.10]">
      <a href={`/templates/${template.slug.current}`} aria-label={`View ${template.templateName} details`} class="block w-full h-full cursor-pointer overflow-hidden">
        {imageUrl ? (
          <img 
            src={imageUrl} 
            alt={template.templateName}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105 opacity-85 group-hover:opacity-100"
          />
        ) : (
          <div class="w-full h-full flex items-center justify-center bg-[#111726] text-[#64748B] font-mono text-xs">
            Template Preview
          </div>
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-[#111726] via-transparent to-[#111726]/30"></div>
      </a>

      <!-- 4-Corner HUD Crosshairs inside Image -->
      <div class="pointer-events-none absolute inset-3.5 z-10">
        <span class="absolute top-0 left-0 w-7 h-[1px] bg-white/40 group-hover:bg-accent-primary transition-colors"></span>
        <span class="absolute top-0 left-0 w-[1px] h-7 bg-white/40 group-hover:bg-accent-primary transition-colors"></span>
        <span class="absolute top-0 right-0 w-7 h-[1px] bg-white/40 group-hover:bg-accent-primary transition-colors"></span>
        <span class="absolute top-0 right-0 w-[1px] h-7 bg-white/40 group-hover:bg-accent-primary transition-colors"></span>
        <span class="absolute bottom-0 left-0 w-7 h-[1px] bg-white/40 group-hover:bg-accent-primary transition-colors"></span>
        <span class="absolute bottom-0 left-0 w-[1px] h-7 bg-white/40 group-hover:bg-accent-primary transition-colors"></span>
        <span class="absolute bottom-0 right-0 w-7 h-[1px] bg-white/40 group-hover:bg-accent-primary transition-colors"></span>
        <span class="absolute bottom-0 right-0 w-[1px] h-7 bg-white/40 group-hover:bg-accent-primary transition-colors"></span>
      </div>

      <!-- Overlay Badges -->
      <div class="absolute top-5 left-5 flex items-center gap-2 pointer-events-none z-20">
        {template.badge && (
          <span class="px-2.5 py-1 text-[10px] font-mono uppercase tracking-[0.12em] bg-accent-primary text-white font-bold">
            {template.badge}
          </span>
        )}
        <span class="px-2.5 py-1 text-[10px] font-mono uppercase tracking-[0.12em] bg-[#0B0F17]/85 backdrop-blur-md text-[#F8FAFC] border border-white/15">
          [ COMMERCIAL LICENSE ]
        </span>
      </div>

      <!-- Price Pill Floating Top Right -->
      <div class="absolute top-5 right-5 pointer-events-none z-20">
        <div class="px-3 py-1 bg-[#0B0F17]/90 backdrop-blur-md border border-white/20 flex items-baseline gap-1.5">
          <span class="text-sm font-bold text-[#F8FAFC] font-mono">{price}</span>
          {originalPrice && (
            <span class="text-[11px] line-through text-[#64748B] font-mono">{originalPrice}</span>
          )}
        </div>
      </div>
    </div>

    <!-- Content Body -->
    <div class="p-6 md:p-7 flex-1 flex flex-col justify-between">
      <div>
        <!-- Tech Stack Tags -->
        <div class="flex flex-wrap gap-1.5 mb-4">
          {tags.map((tag: string) => (
            <span class="text-[10px] font-mono uppercase tracking-[0.04em] px-2.5 py-0.5 bg-white/[0.04] border border-white/10 text-[#94A3B8]">
              {tag}
            </span>
          ))}
        </div>

        <!-- Title & Tagline -->
        <h3 class="font-grotesk text-2xl font-bold text-[#F8FAFC] tracking-[-0.035em] transition-colors group-hover:text-white mb-2">
          <a href={`/templates/${template.slug.current}`} class="hover:text-accent-primary transition-colors">
            {template.templateName}
          </a>
        </h3>

        <p class="text-xs md:text-sm text-[#94A3B8] leading-relaxed line-clamp-2 mb-5">
          {template.tagline}
        </p>

        <!-- Bullet Highlights -->
        {highlights.length > 0 && (
          <ul class="space-y-1.5 pt-4 border-t border-white/[0.08] mb-6">
            {highlights.map((item: string) => (
              <li class="flex items-center gap-2 text-[11px] font-mono text-[#94A3B8]">
                <span class="w-1.5 h-1.5 rounded-full bg-accent-primary shrink-0"></span>
                <span class="truncate">{item}</span>
              </li>
            ))}
          </ul>
        )}
      </div>

      <!-- Action Footer -->
      <div class="pt-4 border-t border-white/[0.10] flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          {template.demoLink && (
            <a 
              href={template.demoLink}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-full text-xs font-grotesk font-semibold uppercase tracking-[0.04em] bg-white/[0.04] border border-white/15 text-[#F8FAFC] hover:bg-white hover:text-[#0B0F17] transition-all flex items-center gap-1.5"
            >
              <span>LIVE DEMO</span>
              <span class="text-[10px]">↗</span>
            </a>
          )}
          <a 
            href={`/templates/${template.slug.current}`}
            class="px-3 py-2 text-xs font-mono uppercase text-[#64748B] hover:text-[#F8FAFC] transition-colors"
          >
            [ DETAILS ]
          </a>
        </div>

        {template.gumroadLink ? (
          <a 
            href={template.gumroadLink}
            target="_blank"
            rel="noopener noreferrer"
            class="group/btn px-5 py-2.5 rounded-full text-xs font-grotesk font-bold uppercase tracking-[0.04em] bg-white hover:bg-slate-100 text-[#0B0F17] transition-all duration-300 flex items-center justify-center gap-2 shadow-[0_0_15px_rgba(255,255,255,0.2)]"
          >
            <span class="rushes-roll">
              <span class="rushes-roll-track">
                <span>GET TEMPLATE</span>
                <span>GET TEMPLATE</span>
              </span>
            </span>
            <span>↗</span>
          </a>
        ) : (
          <a 
            href={`/templates/${template.slug.current}`}
            class="px-5 py-2.5 rounded-full text-xs font-grotesk font-bold uppercase tracking-[0.04em] bg-white text-[#0B0F17] hover:bg-slate-100 transition-colors text-center"
          >
            LEARN MORE
          </a>
        )}
      </div>
    </div>

  </div>
</article>
