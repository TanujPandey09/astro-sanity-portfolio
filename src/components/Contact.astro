---
---

<section id="contact" class="py-14 sm:py-20 md:py-28 relative z-10 bg-canvas border-t border-border-subtle">
  <div class="w-full">
    <div class="max-w-3xl mb-8 sm:mb-12 md:mb-16" data-aos="fade-up">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-status-live/10 border border-status-live/20 mb-3.5">
        <span class="w-1.5 h-1.5 rounded-full bg-status-live animate-pulse"></span>
        <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-status-live font-semibold">Open for New Projects</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-text-primary tracking-[-0.03em] leading-[1.1]">
        Start a <span class="text-gradient">Conversation</span>
      </h2>
      <p class="mt-3.5 text-text-muted text-sm md:text-base leading-relaxed max-w-2xl">
        Hiring for a senior full-stack or AI role, or scoping a new SaaS product? Send a note below or copy my direct email. I respond within 24 hours.
      </p>
    </div>

    <div class="grid lg:grid-cols-12 gap-8 lg:gap-10 max-w-7xl mx-auto items-start">
      <!-- Left Column: Direct Channels & One-Click Copy Card -->
      <div class="lg:col-span-5 min-w-0" data-aos="fade-up">
        <div class="rounded-2xl p-1.5 bg-white/[0.03] border border-white/[0.09] shadow-card">
          <div class="p-6 md:p-8 rounded-xl bg-surface-card border border-white/[0.05] space-y-6 relative overflow-hidden">
            
            <!-- Direct Email with One-Click Copy (PRD §4.9) -->
            <div class="p-4 rounded-xl bg-surface-elevated/70 border border-border-subtle space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-mono text-text-dim">Direct Email</span>
                <span class="text-[10px] font-mono text-status-live bg-status-live/10 px-2 py-0.5 rounded">Replies &lt; 24h</span>
              </div>
              <div class="flex items-center justify-between gap-3">
                <a href="mailto:tanujp09@gmail.com" class="text-sm sm:text-base font-mono font-semibold text-text-primary hover:text-accent-hover transition-colors truncate">
                  tanujp09@gmail.com
                </a>
                <button
                  type="button"
                  id="contact-copy-email"
                  data-email="tanujp09@gmail.com"
                  class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/[0.05] hover:bg-accent-primary hover:text-white border border-border-subtle text-xs font-mono text-text-primary transition-all active:scale-95 cursor-pointer"
                >
                  <span id="contact-copy-text">Copy</span>
                </button>
              </div>
            </div>

            <!-- Phone & Location -->
            <div class="space-y-4 pt-1">
              <a href="tel:+919557321978" class="flex items-center gap-4 group/link p-3 rounded-xl hover:bg-white/[0.02] transition-colors">
                <div class="w-10 h-10 rounded-xl bg-white/[0.04] border border-border-subtle flex items-center justify-center text-text-muted group-hover/link:border-accent-primary/50 group-hover/link:text-accent-hover transition-all shrink-0">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </div>
                <div>
                  <p class="text-[11px] font-mono text-text-dim">Phone / WhatsApp</p>
                  <p class="text-sm text-text-primary font-semibold group-hover/link:text-white transition-colors tabular-nums">+91 9557321978</p>
                </div>
              </a>

              <div class="flex items-center gap-4 p-3 rounded-xl">
                <div class="w-10 h-10 rounded-xl bg-white/[0.04] border border-border-subtle flex items-center justify-center text-text-muted shrink-0">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                </div>
                <div>
                  <p class="text-[11px] font-mono text-text-dim">Base &amp; Timezone</p>
                  <p class="text-sm text-text-primary font-semibold">Uttarakhand, India · IST (UTC+5:30)</p>
                </div>
              </div>
            </div>

            <!-- Social Profiles -->
            <div class="pt-5 border-t border-border-subtle flex items-center justify-between gap-3">
              <span class="text-xs font-mono text-text-dim">Profiles</span>
              <div class="flex gap-2.5">
                <a href="https://github.com/TanujPandey09" target="_blank" rel="noopener noreferrer" aria-label="GitHub Profile" class="px-3.5 py-2 rounded-xl bg-white/[0.03] border border-border-subtle hover:border-border-hover hover:text-white text-xs font-mono text-text-muted transition-all inline-flex items-center gap-2">
                  <svg fill="currentColor" viewBox="0 0 24 24" class="w-4 h-4"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23a11.509 11.509 0 0 0-3.007-.403c-1.02.005-2.047.138-3.006.404-2.291-1.552-3.297-1.23-3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                  <span>GitHub</span>
                </a>
                <a href="https://linkedin.com/in/tanujdev" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn Profile" class="px-3.5 py-2 rounded-xl bg-white/[0.03] border border-border-subtle hover:border-border-hover hover:text-white text-xs font-mono text-text-muted transition-all inline-flex items-center gap-2">
                  <svg fill="currentColor" viewBox="0 0 24 24" class="w-4 h-4"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                  <span>LinkedIn</span>
                </a>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- Right Column: Double-Bezel Inquiry Form -->
      <div class="lg:col-span-7 min-w-0" data-aos="fade-up" data-aos-delay="100">
        <div class="rounded-2xl p-1.5 bg-white/[0.03] border border-white/[0.09] shadow-card">
          <div class="rounded-xl bg-surface-card border border-white/[0.05] p-6 sm:p-8">
            <form id="contactForm" class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div class="space-y-2">
                <label for="contact-name" class="block text-xs font-mono text-text-muted">Your Name</label>
                <input id="contact-name" type="text" name="from_name" required placeholder="Alex Rivera" class="w-full bg-surface-elevated border border-border-subtle rounded-xl px-4 py-3 text-text-primary placeholder:text-text-dim focus:outline-none focus:border-accent-primary focus:ring-2 focus:ring-accent-primary/20 transition-all text-sm" />
              </div>
              <div class="space-y-2">
                <label for="contact-email" class="block text-xs font-mono text-text-muted">Work Email</label>
                <input id="contact-email" type="email" name="from_email" required placeholder="alex@vanguard.dev" class="w-full bg-surface-elevated border border-border-subtle rounded-xl px-4 py-3 text-text-primary placeholder:text-text-dim focus:outline-none focus:border-accent-primary focus:ring-2 focus:ring-accent-primary/20 transition-all text-sm" />
              </div>
              <div class="md:col-span-2 space-y-2">
                <label for="contact-subject" class="block text-xs font-mono text-text-muted">Project Scope or Role</label>
                <input id="contact-subject" type="text" name="subject" required placeholder="Full-Stack SaaS Build / Engineering Role" class="w-full bg-surface-elevated border border-border-subtle rounded-xl px-4 py-3 text-text-primary placeholder:text-text-dim focus:outline-none focus:border-accent-primary focus:ring-2 focus:ring-accent-primary/20 transition-all text-sm" />
              </div>
              <div class="md:col-span-2 space-y-2">
                <label for="contact-message" class="block text-xs font-mono text-text-muted">Project Details</label>
                <textarea id="contact-message" name="message" required rows="4" placeholder="Share your timeline, tech stack, or goals..." class="w-full bg-surface-elevated border border-border-subtle rounded-xl px-4 py-3.5 text-text-primary placeholder:text-text-dim focus:outline-none focus:border-accent-primary focus:ring-2 focus:ring-accent-primary/20 transition-all resize-none text-sm"></textarea>
              </div>
              <div class="md:col-span-2 pt-2 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <span class="text-xs font-mono text-text-dim">Direct inbox delivery · Zero spam</span>
                <button type="submit" class="group relative inline-flex items-center justify-center gap-3 pl-6 pr-3 py-3 bg-text-primary text-canvas font-bold text-xs uppercase tracking-wider rounded-full transition-all duration-300 hover:bg-white active:scale-[0.98] cursor-pointer">
                  <span>Send Message</span>
                  <span class="w-7 h-7 rounded-full bg-canvas text-text-primary flex items-center justify-center transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
                    ↗
                  </span>
                </button>
              </div>
            </form>
            <div id="form-status" class="mt-5 text-center text-xs font-mono hidden"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { trackEvent } from '../lib/analytics';

  const setupContactSection = () => {
    const form = document.getElementById('contactForm') as HTMLFormElement;
    const status = document.getElementById('form-status');
    const copyBtn = document.getElementById('contact-copy-email');
    const copyText = document.getElementById('contact-copy-text');

    copyBtn?.addEventListener('click', async () => {
      const email = copyBtn.getAttribute('data-email') || 'tanujp09@gmail.com';
      try {
        await navigator.clipboard.writeText(email);
        if (copyText) {
          copyText.textContent = 'Copied';
          setTimeout(() => {
            copyText.textContent = 'Copy';
          }, 2000);
        }
      } catch (e) {
        window.location.href = `mailto:${email}`;
      }
    });

    const showStatus = (msg: string, isError = false) => {
      if (!status) return;
      status.textContent = msg;
      status.className = `mt-5 text-center text-xs font-mono ${isError ? 'text-red-400' : 'text-status-live'}`;
      status.classList.remove('hidden');
      setTimeout(() => status.classList.add('hidden'), 5000);
    };

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const originalText = submitBtn.innerHTML;
      
      submitBtn.disabled = true;
      submitBtn.innerHTML = `<span class="px-4 py-1">Sending...</span>`;

      const formData = new FormData(form);

      try {
        const resp = await fetch('/api/contact', {
          method: 'POST',
          body: formData
        });

        if (resp.ok) {
          showStatus('Message received. I will reply within 24 hours.');
          trackEvent('generate_lead', { method: 'contact_form' });
          form.reset();
        } else {
          const errorData = await resp.json().catch(() => ({}));
          throw new Error(errorData.message || 'Submission failed');
        }
      } catch (error) {
        console.error('Submit Error:', error);
        showStatus('Could not send message. Please email tanujp09@gmail.com directly.', true);
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
      }
    });
  };

  setupContactSection();
  document.addEventListener('astro:after-swap', setupContactSection);
</script>
