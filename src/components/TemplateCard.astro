---
import { optimizeSanityImage } from "../lib/optimizeImage";
import { formatCategoryLabel, type TemplateItem } from "../lib/templates";

interface Props {
  template: TemplateItem;
  index?: number;
}

const { template, index = 0 } = Astro.props;

const rawImageUrl = template.imageUrl || "/og-image-dark.png";
const imageUrl = rawImageUrl.includes("cdn.sanity.io") 
  ? optimizeSanityImage(rawImageUrl, 900, 80)
  : rawImageUrl;

const price = template.price || "$49";
const originalPrice = template.originalPrice;
const tags = template.tags?.slice(0, 4) || ["Next.js", "React 19", "TypeScript", "Tailwind CSS"];
const slug = template.slug?.current || "";
const category = template.category || "other";
const categoryLabel = formatCategoryLabel(category);
const categoryFilterKey = category.toLowerCase().replace(/[^a-z0-9]+/g, "-");
const priceNumeric = price.replace(/[^0-9.]/g, "") || "49";
---

<article 
  data-gsap-card
  data-cursor-text="EXPLORE TEMPLATE ↗"
  class="template-card group relative rounded-2xl bg-white border border-black/[0.08] hover:border-accent-primary/50 hover:shadow-[0_20px_40px_rgba(0,0,0,0.08)] shadow-[0_4px_20px_rgba(0,0,0,0.05)] transition-all duration-300 flex flex-col justify-between overflow-hidden"
  data-category={categoryFilterKey}
  data-tags={tags.join(",").toLowerCase()}
  data-price={priceNumeric}
  data-name={template.templateName.toLowerCase()}
>
  <!-- Top Visual Showcase with Micro-Window Chrome Header -->
  <div class="relative overflow-hidden w-full bg-[#F1F5F9] border-b border-black/[0.08]">
    
    <!-- Micro-Browser Header -->
    <div class="px-3.5 py-2 bg-slate-50 border-b border-black/[0.08] flex items-center justify-between text-xs font-mono">
      <div class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-slate-300"></span>
        <span class="w-2 h-2 rounded-full bg-slate-300"></span>
        <span class="w-2 h-2 rounded-full bg-slate-300"></span>
      </div>

      <div class="flex items-center gap-1 text-[10px] text-accent-primary font-mono uppercase tracking-wider font-semibold">
        <span>[ {categoryLabel} ]</span>
      </div>
    </div>

    <!-- Preview Image Container -->
    <a 
      href={`/templates/${slug}`} 
      aria-label={`Inspect ${template.templateName} details and live preview`} 
      class="block relative w-full aspect-[16/10] cursor-pointer overflow-hidden group/thumb bg-[#F1F5F9]"
    >
      {imageUrl ? (
        <img 
          src={imageUrl} 
          alt={`${template.templateName} commercial web template preview`}
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover object-top transition-transform duration-500 ease-out group-hover/thumb:scale-[1.03] opacity-95 group-hover:opacity-100"
        />
      ) : (
        <div class="w-full h-full flex flex-col items-center justify-center bg-[#F1F5F9] text-slate-500 font-mono text-xs gap-1.5">
          <span class="text-xl font-bold font-grotesk text-[#0F172A]">NovaStack</span>
          <span class="text-[10px]">Commercial Template</span>
        </div>
      )}

      <!-- Quick Action Hover Overlay -->
      <div class="absolute inset-0 bg-black/30 backdrop-blur-[2px] opacity-0 group-hover/thumb:opacity-100 transition-opacity duration-300 flex items-center justify-center pointer-events-none">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white text-[#0F172A] font-grotesk font-bold text-xs uppercase tracking-wider shadow-lg transform translate-y-1 group-hover/thumb:translate-y-0 transition-transform duration-300">
          <span>Inspect Template</span>
          <span>→</span>
        </span>
      </div>

      <!-- Floating Price Tag (Top Right) -->
      <div class="absolute top-2.5 right-2.5 z-10 pointer-events-none">
        <div class="px-2.5 py-1 rounded-full bg-white/95 backdrop-blur-md border border-black/10 flex items-baseline gap-1 shadow-sm">
          <span class="text-xs font-bold text-[#0F172A] font-mono">{price}</span>
          {originalPrice && (
            <span class="text-[10px] line-through text-slate-400 font-mono">{originalPrice}</span>
          )}
        </div>
      </div>

      <!-- Commercial / Badge (Top Left) -->
      <div class="absolute top-2.5 left-2.5 z-10 flex items-center gap-1 pointer-events-none">
        {template.badge ? (
          <span class="px-2 py-0.5 rounded-md text-[9px] font-mono uppercase tracking-wider bg-accent-primary text-white font-bold shadow-xs">
            {template.badge}
          </span>
        ) : (
          <span class="px-2 py-0.5 rounded-md text-[9px] font-mono uppercase tracking-wider bg-[#0F172A] text-white border border-black/10 shadow-xs">
            Commercial
          </span>
        )}
      </div>
    </a>

  </div>

  <!-- Card Body & Meta Details -->
  <div class="p-4 sm:p-5 flex-1 flex flex-col justify-between">
    <div>
      <!-- Tech Stack Badges -->
      <div class="flex flex-wrap gap-1 mb-2.5">
        {tags.map((tag: string) => (
          <span class="text-[9px] font-mono font-medium uppercase tracking-wider px-2 py-0.5 rounded bg-slate-100 border border-black/[0.08] text-slate-700">
            {tag}
          </span>
        ))}
      </div>

      <!-- Title & Tagline -->
      <h3 class="font-grotesk text-base sm:text-lg font-bold text-[#0F172A] tracking-[-0.02em] transition-colors group-hover:text-accent-primary leading-snug mb-1.5">
        <a href={`/templates/${slug}`} class="hover:text-accent-primary transition-colors">
          {template.templateName}
        </a>
      </h3>

      <p class="text-xs text-slate-600 leading-relaxed line-clamp-2 font-sans font-normal mb-3">
        {template.tagline}
      </p>

      <!-- Key Proof Micro-Bar -->
      <div class="py-2 px-2.5 rounded-lg bg-slate-50 border border-black/[0.06] flex items-center justify-between text-[10px] font-mono text-slate-600 mb-4">
        <span class="inline-flex items-center gap-1 text-emerald-600 font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          99+ Speed
        </span>
        <span class="text-black/20">·</span>
        <span>Commercial Rights</span>
        <span class="text-black/20">·</span>
        <span>Free Updates</span>
      </div>
    </div>

    <!-- Card Action Buttons -->
    <div class="pt-3 border-t border-black/[0.08] flex items-center justify-between gap-2">
      <div class="flex items-center gap-1.5">
        {template.demoLink && (
          <a 
            href={template.demoLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-mono font-medium text-slate-700 hover:text-black bg-slate-100 hover:bg-slate-200 border border-black/[0.08] transition-all"
            title="Open live interactive demo preview"
          >
            <span>Demo</span>
            <span class="text-[10px]">↗</span>
          </a>
        )}
        
        <a 
          href={`/templates/${slug}`}
          class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-mono text-slate-600 hover:text-black hover:bg-slate-100 transition-colors"
          title="Inspect full template specs, screenshots and features"
        >
          <span>Specs</span>
          <span class="text-[10px]">→</span>
        </a>
      </div>

      {template.gumroadLink ? (
        <a 
          href={template.gumroadLink}
          target="_blank"
          rel="noopener noreferrer"
          class="group/btn inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-grotesk font-bold uppercase tracking-wider bg-[#0F172A] hover:bg-black text-white transition-all shadow-xs active:scale-95"
        >
          <span>Get {price}</span>
          <span class="text-[10px] transition-transform duration-200 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5">↗</span>
        </a>
      ) : (
        <a 
          href={`/templates/${slug}`}
          class="inline-flex items-center px-3.5 py-1.5 rounded-lg text-xs font-grotesk font-bold uppercase tracking-wider bg-[#0F172A] hover:bg-black text-white transition-colors"
        >
          <span>Details</span>
          <span class="text-[10px]">→</span>
        </a>
      )}
    </div>

  </div>
</article>
