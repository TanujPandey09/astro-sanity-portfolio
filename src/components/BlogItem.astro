---
import { optimizeSanityImage } from "../lib/optimizeImage";

const { blog, index } = Astro.props;
const blogImageUrl = optimizeSanityImage(blog.FeatureImage?.asset?.url || blog.BackgroundImage?.asset?.url, 320, 80);
const blogTitle = blog.title || blog.projectName || "Technical Article";
const readTime = blog.estimatedReadTime || "5 min read";
const formattedDate = blog._createdAt
  ? new Date(blog._createdAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
  : "Recent";
---

<article class="group rounded-2xl p-1.5 bg-white/[0.02] hover:bg-white/[0.04] border border-white/[0.07] hover:border-border-hover transition-all duration-300" data-aos="fade-up" data-aos-delay={index * 50}>
  <a href={`/blogs/${blog.slug?.current}`} aria-label={`Read article: ${blogTitle}`} class="rounded-xl bg-surface-card p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-5 border border-white/[0.04]">
    
    <div class="flex items-start sm:items-center gap-4 sm:gap-5 flex-1 min-w-0">
      {blogImageUrl ? (
        <div class="hidden sm:block w-20 h-16 rounded-lg overflow-hidden border border-border-subtle bg-surface-elevated shrink-0">
          <img 
            src={blogImageUrl} 
            alt={blogTitle}
            width="80"
            height="64"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        </div>
      ) : (
        <div class="hidden sm:flex w-12 h-12 rounded-lg border border-border-subtle bg-surface-elevated items-center justify-center font-mono text-xs text-text-dim shrink-0 tabular-nums">
          {String(index + 1).padStart(2, "0")}
        </div>
      )}

      <div class="space-y-1.5 min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-2.5 text-[11px] font-mono text-text-dim">
          <span class="text-accent-hover font-medium tabular-nums">#{String(index + 1).padStart(2, "0")}</span>
          <span>·</span>
          <time datetime={blog._createdAt}>{formattedDate}</time>
          <span>·</span>
          <span>{readTime}</span>
        </div>
        
        <h3 class="text-base sm:text-lg md:text-xl font-bold text-text-primary group-hover:text-white transition-colors tracking-tight leading-snug truncate">
          {blogTitle}
        </h3>
      </div>
    </div>

    <div class="flex items-center justify-between sm:justify-end gap-3 pt-3 sm:pt-0 border-t sm:border-t-0 border-border-subtle shrink-0">
      <span class="text-xs font-mono text-text-muted group-hover:text-text-primary transition-colors">Read Article</span>
      <div class="w-8 h-8 rounded-full bg-white/[0.04] border border-border-subtle group-hover:bg-accent-primary group-hover:border-accent-primary group-hover:text-white flex items-center justify-center transition-all duration-300">
        <span class="text-xs transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
      </div>
    </div>

  </a>
</article>
