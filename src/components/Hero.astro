---
// High-End Design Engineering Hero Component (Mobile-First & Desktop Architectural Layout)
---

<section id="hero" class="min-h-[calc(100dvh-4.5rem)] flex flex-col justify-center relative overflow-hidden pt-24 sm:pt-28 md:pt-28 pb-10 md:pb-14">
  <div class="w-full relative z-20">
    <div class="max-w-4xl mx-auto text-center flex flex-col items-center relative">
      
      <!-- Subtle Ambient Hero Spotlight Halo -->
      <div class="absolute -top-12 left-1/2 -translate-x-1/2 w-[320px] sm:w-[680px] h-[240px] sm:h-[320px] bg-accent-glow blur-[90px] sm:blur-[110px] pointer-events-none -z-10 rounded-full"></div>

      <!-- 1. Eyebrow: Single-line on both mobile and desktop -->
      <div class="mb-5 sm:mb-6 inline-flex items-center gap-2 sm:gap-2.5 px-3.5 sm:px-4 py-1.5 rounded-full bg-surface-card/90 border border-white/[0.10] backdrop-blur-md shadow-sm max-w-full" data-aos="fade-up">
        <span class="relative flex h-2 w-2 shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-status-live opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-status-live"></span>
        </span>
        <span class="text-[10px] sm:text-[11px] font-mono uppercase tracking-[0.14em] sm:tracking-[0.18em] text-text-primary font-medium whitespace-nowrap">Available for Projects</span>
        <span class="text-white/20 hidden xs:inline sm:inline">·</span>
        <span class="text-[10px] sm:text-[11px] font-mono text-text-muted whitespace-nowrap hidden xs:inline sm:inline">Full-Stack &amp; AI</span>
      </div>

      <!-- 2. Main Headline: Balanced mobile scale (no awkward 4-line wrapping) -->
      <div class="mb-4 sm:mb-5 max-w-4xl px-1" data-aos="fade-up" data-aos-delay="80">
        <h1 class="hero-title font-extrabold text-text-primary leading-[1.12] sm:leading-[1.08] tracking-[-0.035em] text-[2rem] sm:text-5xl md:text-6xl lg:text-[4rem] font-grotesk">
          Engineering Scalable SaaS <br class="hidden sm:inline" />
          <span class="text-gradient">&amp; Production AI Systems.</span>
        </h1>
      </div>

      <!-- 3. Subheadline: Concise, readable width on mobile -->
      <div class="max-w-xl sm:max-w-2xl mb-7 sm:mb-9 mx-auto px-2 sm:px-0" data-aos="fade-up" data-aos-delay="140">
        <p class="text-sm sm:text-base md:text-lg text-text-muted leading-relaxed font-normal">
          Full-Stack Engineer with 4+ years of experience building multi-LLM web applications, real-time Node.js backends, and fast React &amp; Next.js interfaces.
        </p>
      </div>

      <!-- 4. Action Row: Clean equal-height buttons on mobile & desktop -->
      <div class="w-full max-w-[290px] sm:max-w-none mx-auto flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 sm:gap-4 mb-10 sm:mb-12" data-aos="fade-up" data-aos-delay="200">
        <a 
          href="#projects" 
          aria-label="View Selected Work projects"
          class="group relative inline-flex items-center justify-center gap-2.5 h-12 px-6 rounded-full bg-text-primary text-canvas font-bold text-xs uppercase tracking-wider hover:bg-white transition-all duration-300 shadow-[0_0_25px_rgba(255,255,255,0.16)] active:scale-[0.98] whitespace-nowrap"
        >
          <span>Selected Work</span>
          <span class="w-6 h-6 rounded-full bg-canvas text-text-primary flex items-center justify-center shrink-0 transition-transform duration-300 group-hover:scale-105 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 17L17 7H7M17 7V17"/>
            </svg>
          </span>
        </a>

        <a 
          href="#contact" 
          aria-label="Start a Project with Tanuj Pandey"
          class="inline-flex items-center justify-center gap-2 h-12 px-6 rounded-full bg-surface-card/90 border border-white/[0.12] hover:border-white/25 hover:bg-surface-elevated text-text-primary font-semibold text-xs uppercase tracking-wider transition-all duration-300 active:scale-[0.98] whitespace-nowrap"
        >
          <span>Start a Project</span>
          <span class="text-accent-hover text-sm leading-none">↗</span>
        </a>
      </div>

      <!-- 5. True 1px Hairline Proof Grid (Perfect 2x2 Crosshair on Mobile, 1x4 on Desktop) -->
      <div class="w-full max-w-4xl rounded-2xl p-[1px] bg-white/[0.08] shadow-card overflow-hidden" data-aos="fade-up" data-aos-delay="260">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-[1px] bg-white/[0.07] rounded-[15px] overflow-hidden">
          
          <div class="bg-surface-card px-3 py-4 sm:px-5 sm:py-5 text-center hover:bg-surface-elevated transition-colors">
            <div class="text-xl sm:text-2xl md:text-[1.7rem] font-bold text-text-primary font-mono tabular-nums tracking-tight mb-0.5 sm:mb-1">4+ Years</div>
            <div class="text-[10px] sm:text-[11px] font-mono text-text-muted">Commercial Depth</div>
          </div>

          <div class="bg-surface-card px-3 py-4 sm:px-5 sm:py-5 text-center hover:bg-surface-elevated transition-colors">
            <div class="text-xl sm:text-2xl md:text-[1.7rem] font-bold text-text-primary font-mono tabular-nums tracking-tight mb-0.5 sm:mb-1">10+ Builds</div>
            <div class="text-[10px] sm:text-[11px] font-mono text-text-muted">Production SaaS &amp; AI</div>
          </div>

          <div class="bg-surface-card px-3 py-4 sm:px-5 sm:py-5 text-center hover:bg-surface-elevated transition-colors">
            <div class="text-xl sm:text-2xl md:text-[1.7rem] font-bold text-text-primary font-mono tabular-nums tracking-tight mb-0.5 sm:mb-1">50% Faster</div>
            <div class="text-[10px] sm:text-[11px] font-mono text-text-muted">Core Web Vitals</div>
          </div>

          <div class="bg-surface-card px-3 py-4 sm:px-5 sm:py-5 text-center hover:bg-surface-elevated transition-colors">
            <div class="text-xl sm:text-2xl md:text-[1.7rem] font-bold text-text-primary font-mono tabular-nums tracking-tight mb-0.5 sm:mb-1">99+ Score</div>
            <div class="text-[10px] sm:text-[11px] font-mono text-text-muted">Lighthouse Speed</div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  let heroAnimated = false;
  const animateHero = () => {
    if (heroAnimated) return;
    heroAnimated = true;
    gsap.from('.hero-title', {
      y: 24,
      opacity: 0,
      duration: 0.9,
      ease: "power3.out"
    });
  };

  window.addEventListener('portfolio-loaded', animateHero);
  if (document.readyState === 'complete') {
    setTimeout(animateHero, 50);
  } else {
    window.addEventListener('load', animateHero, { once: true });
  }
</script>
