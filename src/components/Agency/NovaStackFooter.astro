---
// NovaStack Minimalist Footer: Obsidian Monochrome (#09090B) + Linear Indigo (#5E6AD2)
interface Props {
  logoUrl?: string;
  logoAlt?: string;
  brandName?: string;
  logoFullWidth?: boolean;
}

const {
  logoUrl = "",
  logoAlt = "NovaStack Logo",
  brandName = "NovaStack",
  logoFullWidth = false,
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class="bg-[#09090B] text-[#A1A1AA] font-sans border-t border-white/10">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-8 pb-10 border-b border-white/10">
      
      <!-- Brand & Studio Title -->
      <div class="space-y-2">
        <a href="/agency" class="group inline-flex items-center gap-2.5">
          {logoUrl ? (
            <img
              src={logoUrl}
              alt={logoAlt}
              class={logoFullWidth ? "h-8 w-auto max-w-[160px] object-contain" : "h-7 w-7 rounded-lg object-contain bg-white/10 p-0.5"}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="w-7 h-7 rounded-lg bg-[#5E6AD2] text-white flex items-center justify-center font-grotesk font-extrabold text-sm">
              N<span class="text-[#C7CDF7]">S</span>
            </div>
          )}
          {!(logoUrl && logoFullWidth) && (
            <span class="font-grotesk font-extrabold text-lg tracking-tight text-white">
              {brandName}<span class="text-[#5E6AD2]">.</span>
            </span>
          )}
        </a>
        <p class="text-xs font-mono text-[#71717A]">
          NovaStack Studio — Independent full-stack engineering studio.
        </p>
      </div>

      <!-- Navigation Links -->
      <nav class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs font-mono text-[#A1A1AA]" aria-label="Footer navigation">
        <a href="#services" class="hover:text-white transition-colors">Services</a>
        <a href="#work" class="hover:text-white transition-colors">Work</a>
        <a href="#process" class="hover:text-white transition-colors">Process</a>
        <a href="#about" class="hover:text-white transition-colors">About</a>
        <a href="#contact" class="hover:text-white transition-colors">Contact</a>
        <a href="/" class="text-[#8B95E8] hover:text-white transition-colors inline-flex items-center gap-1 font-semibold">
          <span>Personal Portfolio</span>
          <span>↗</span>
        </a>
      </nav>

    </div>

    <!-- Bottom Copyright Strip -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-[#71717A]">
      <div>
        <span>© {currentYear} NovaStack Studio · Tanuj Pandey.</span>
      </div>

      <div class="flex items-center gap-4">
        <span>Remote Worldwide</span>
        <span>·</span>
        <a href="#hero" class="hover:text-white transition-colors">Back to top ↑</a>
      </div>
    </div>

  </div>
</footer>
