---
const currentYear = new Date().getFullYear();
---

<footer class="relative py-12 md:py-16 border-t border-border-subtle bg-canvas overflow-hidden">
  <div class="mx-auto w-full max-w-7xl px-4 md:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-12 gap-10 items-start">

      <div class="lg:col-span-6 space-y-4">
        <a href="/" aria-label="Tanuj Pandey - Home" class="inline-flex items-center gap-3 group">
          <div class="relative w-9 h-9 rounded-xl flex items-center justify-center border border-white/10 bg-surface-elevated/60 group-hover:border-accent-primary/60 transition-all duration-300 overflow-hidden">
            <img src="/favicon.svg" alt="Tanuj Pandey Logo" class="w-full h-full object-cover" width="36" height="36" />
          </div>
          <div>
            <span class="block text-sm font-bold text-text-primary tracking-tight">Tanuj Pandey</span>
            <span class="block text-[11px] font-mono text-text-dim">Full-Stack &amp; AI Engineer</span>
          </div>
        </a>

        <p class="text-text-muted text-sm max-w-md leading-relaxed">
          Engineering full-stack SaaS platforms, multi-LLM workflows, and high-performance React &amp; Node.js applications for startups and product teams.
        </p>
      </div>

      <div class="lg:col-span-6 grid grid-cols-2 sm:grid-cols-3 gap-8">
        <div class="space-y-3">
          <p class="text-xs font-mono text-text-primary font-semibold">Directory</p>
          <ul class="space-y-2">
            <li><a href="/projects" class="text-xs sm:text-sm text-text-muted hover:text-white transition-colors">Case Studies</a></li>
            <li><a href="/templates" class="text-xs sm:text-sm text-text-muted hover:text-white transition-colors">Templates</a></li>
            <li><a href="/blogs" class="text-xs sm:text-sm text-text-muted hover:text-white transition-colors">Articles</a></li>
            <li><a href="/about" class="text-xs sm:text-sm text-text-muted hover:text-white transition-colors">About</a></li>
          </ul>
        </div>

        <div class="space-y-3">
          <p class="text-xs font-mono text-text-primary font-semibold">Connect</p>
          <ul class="space-y-2">
            <li><a href="https://github.com/TanujPandey09" target="_blank" rel="noopener noreferrer" class="text-xs sm:text-sm text-text-muted hover:text-white transition-colors inline-flex items-center gap-1.5">GitHub <span>↗</span></a></li>
            <li><a href="https://linkedin.com/in/tanujdev" target="_blank" rel="noopener noreferrer" class="text-xs sm:text-sm text-text-muted hover:text-white transition-colors inline-flex items-center gap-1.5">LinkedIn <span>↗</span></a></li>
            <li><a href="mailto:tanujp09@gmail.com" class="text-xs sm:text-sm text-text-muted hover:text-white transition-colors inline-flex items-center gap-1.5">Email <span>↗</span></a></li>
          </ul>
        </div>

        <div class="col-span-2 sm:col-span-1 space-y-3">
          <p class="text-xs font-mono text-text-primary font-semibold">Availability</p>
          <div class="space-y-2 text-xs text-text-muted">
            <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-status-live/10 border border-status-live/20 text-status-live font-mono text-[11px]">
              <span class="w-1.5 h-1.5 rounded-full bg-status-live animate-pulse"></span>
              <span>Open for Select Roles</span>
            </div>
            <p class="text-text-dim font-mono text-[11px]">Uttarakhand, India (UTC+5:30)</p>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-border-subtle flex flex-col sm:flex-row justify-between items-center gap-4 text-xs font-mono text-text-dim">
      <span>&copy; {currentYear} Tanuj Pandey. All rights reserved.</span>
      <span>Built with Astro, Sanity &amp; Tailwind CSS</span>
    </div>
  </div>
</footer>
