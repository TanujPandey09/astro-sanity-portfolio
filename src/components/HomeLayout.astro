---
import { useSanityClient, groq } from "astro-sanity";
import { fallbackSanityClient } from "../lib/sanityClient.js";
import ProjectItem from "./ProjectItem.astro";
import BlogItem from "./BlogItem.astro";
import AiChatbot from "./AiChatbot";
import PremiumBackground from "./PremiumBackground.astro";
import Hero from "./Hero.astro";
import Services from "./Services.astro";
import Skills from "./Skills.astro";
import Experience from "./Experience.astro";
import Process from "./Process.astro";
import Contact from "./Contact.astro";
import SectionHeader from "./SectionHeader.astro";
import ProjectCard from "./ProjectCard.astro";
import Ticker from "./Ticker.astro";
import TemplateCard from "./TemplateCard.astro";

import { fetchAllTemplates } from "../lib/templates";

const query = groq`*[_type == "projects" && !defined(gumroadLink) && !(slug.current in [
  "lumina-dental-premium-dental-website-template",
  "apex-luxury-ultra-luxury-real-estate-and-architectural-web-template"
])]{...,BackgroundImage{asset->{url}},demoVideo{asset->{url}}}`;
const blogquery = groq`*[_type == "blogs"] | order(_createdAt desc) {...,FeatureImage{asset->{url}},BackgroundImage{asset->{url}}}`;
const bannerQuery = groq`*[_type == "herobanner"] | order(_updatedAt desc)[0]{_updatedAt, BackgroundImage{asset->{url}}}`;
const aboutPortraitQuery = groq`*[_type == "about"] | order(_updatedAt desc)[0]{_updatedAt, heroImage{asset->{url}}}`;

const fetchWithFallback = async (groqQuery: string) => {
  try {
    const res = await useSanityClient().fetch(groqQuery);
    if (res && (!Array.isArray(res) || res.length > 0)) return res;
  } catch {}
  try {
    return await fallbackSanityClient.fetch(groqQuery);
  } catch (err) {
    console.warn("Could not fetch from Sanity:", err);
    return null;
  }
};

const [projectResult, blogResult, bannerResult, aboutResult] = await Promise.all([
  fetchWithFallback(query),
  fetchWithFallback(blogquery),
  fetchWithFallback(bannerQuery),
  fetchWithFallback(aboutPortraitQuery),
]);

const projectData = Array.isArray(projectResult) ? projectResult : [];
const blogData = Array.isArray(blogResult) ? blogResult : [];
const aboutUrl = aboutResult?.heroImage?.asset?.url;
const bannerUrl = bannerResult?.BackgroundImage?.asset?.url;
const aboutUpdatedAt = aboutResult?._updatedAt ? Date.parse(aboutResult._updatedAt) : 0;
const bannerUpdatedAt = bannerResult?._updatedAt ? Date.parse(bannerResult._updatedAt) : 0;
const homePortraitUrl =
  aboutUrl && (!bannerUrl || aboutUpdatedAt >= bannerUpdatedAt)
    ? aboutUrl
    : bannerUrl || undefined;

const templatesData = await fetchAllTemplates();
---

<div class="relative min-h-screen w-full max-w-[100vw] overflow-x-hidden selection:bg-accent-primary/30">
  <PremiumBackground />

  <!-- Hero Experience (Edge to Edge with Dark Canvas & Iridescent Liquid Drapery) -->
  <Hero portraitUrl={homePortraitUrl} />

  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Selected Work Showcase -->
    <section id="projects" class="py-14 sm:py-16 lg:py-20 relative z-10">
      <div class="w-full">
        <SectionHeader
          eyebrow="01 / Selected Work"
          title="Selected"
          gradientText="Work."
          subtitle="Production SaaS platforms, multi-LLM systems, and high-performance web applications shipped end-to-end."
        />
        
        <!-- Featured Deliveries -->
        <div class="flex flex-col gap-12 sm:gap-16 lg:gap-20">
          {projectData?.slice(0, 4).map((project, index) => (
            <ProjectItem project={project} index={index} />
          ))}
        </div>
        
        {projectData?.length > 4 && (
          <div class="mt-14 md:mt-20 pt-10 border-t border-black/[0.08]">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-8 pb-4 border-b border-black/[0.08] gap-4">
               <div>
                  <h3 class="font-grotesk text-xl md:text-2xl font-bold text-[#0F172A] tracking-tight">More Shipped Builds</h3>
                  <p class="text-xs sm:text-sm text-slate-600 mt-1">Additional client deliveries, internal tools, and web applications.</p>
               </div>
               <button 
                 id="expand-repo"
                 aria-label="Show all additional projects"
                 aria-expanded="false"
                 class="group inline-flex items-center gap-3 px-4 py-2 rounded-full bg-white border border-black/10 hover:border-[#5E6AD2] hover:text-[#5E6AD2] text-xs font-mono text-[#0F172A] transition-colors cursor-pointer"
               >
                 <span>Show All ({projectData.length - 4})</span>
                 <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" id="repo-icon" class="transition-transform duration-300"><path d="m6 9 6 6 6-6"/></svg>
               </button>
            </div>

            <div id="repo-grid" class="hidden grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
               {projectData?.slice(4).map((project, index) => (
                 <ProjectCard project={project} index={index} />
               ))}
            </div>

            <div class="mt-10 flex justify-center">
               <a href="/projects" class="group inline-flex items-center gap-3 pl-5 pr-2 py-2 rounded-full bg-white border border-black/10 hover:border-[#5E6AD2] text-xs font-mono font-semibold text-[#0F172A] transition-colors">
                  <span>View All Case Studies</span>
                  <span class="w-7 h-7 rounded-full bg-slate-100 group-hover:bg-[#5E6AD2] group-hover:text-white flex items-center justify-center transition-colors font-bold">↗</span>
               </a>
            </div>
          </div>
        )}
      </div>
    </section>
  </div>

  <!-- Full-Bleed Impact & Domain Ticker -->
  <Ticker />

  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- High-Value Bento Services -->
    <Services />

    <!-- Experience Timeline -->
    <Experience />

    <!-- Technology Stack -->
    <Skills />

    <!-- Strategic Development Workflow & FAQ -->
    <Process />

    <!-- Commercial Templates & Digital Products Section -->
    {templatesData && templatesData.length > 0 && (
      <section id="templates" class="py-14 sm:py-16 lg:py-20 relative z-10 border-t border-black/[0.08]">
        <div class="max-w-7xl mx-auto">
          <SectionHeader 
            eyebrow="06 / Commercial Assets"
            title="Commercial" 
            gradientText="Templates." 
            subtitle="Production-ready Next.js, React, and TypeScript templates with commercial licenses and 99+ Lighthouse performance."
          />

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
            {templatesData.slice(0, 2).map((template, index) => (
              <TemplateCard template={template} index={index} />
            ))}
          </div>

          <div class="mt-10 flex justify-center">
            <a 
              href="/templates" 
              class="group inline-flex items-center gap-3 pl-5 pr-2 py-2 rounded-full bg-white border border-black/10 hover:border-[#5E6AD2] text-xs font-mono font-semibold text-[#0F172A] transition-colors"
            >
              <span>Browse All Templates</span>
              <span class="w-7 h-7 rounded-full bg-slate-100 group-hover:bg-[#5E6AD2] group-hover:text-white flex items-center justify-center transition-colors font-bold">↗</span>
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- Blogs Section -->
    <section id="blogs" class="py-14 sm:py-16 lg:py-20 relative z-10 border-t border-black/[0.08]">
      <div class="max-w-7xl mx-auto">
        <SectionHeader 
          eyebrow="07 / Engineering Writing"
          title="Engineering" 
          gradientText="Writing." 
          subtitle="Deep dives on full-stack architecture, multi-LLM orchestration, and Core Web Vitals optimization."
        />
        
        <div class="rounded-2xl bg-white border border-black/[0.08] overflow-hidden shadow-xs">
          {blogData?.slice(0, 4).map((blog, index) => (
            <BlogItem blog={blog} index={index} />
          ))}
        </div>
        
        <div class="mt-8 flex justify-start sm:justify-end">
           <a href="/blogs" class="group inline-flex items-center gap-3 pl-5 pr-2 py-2 rounded-full bg-white border border-black/10 hover:border-[#5E6AD2] text-xs font-mono font-semibold text-[#0F172A] transition-colors">
              <span>Read All Articles</span>
              <span class="w-7 h-7 rounded-full bg-slate-100 group-hover:bg-[#5E6AD2] group-hover:text-white flex items-center justify-center transition-colors font-bold">↗</span>
           </a>
        </div>
      </div>
    </section>

    <!-- Contact Experience -->
    <Contact />
  </div>
</div>

<AiChatbot client:load />

<script>
  const setupRepoExpand = () => {
    const expandBtn = document.getElementById('expand-repo');
    const repoGrid = document.getElementById('repo-grid');
    const repoIcon = document.getElementById('repo-icon');

    if (!expandBtn || !repoGrid || expandBtn.dataset.bound === 'true') return;
    expandBtn.dataset.bound = 'true';

    expandBtn.addEventListener('click', () => {
      const willExpand = repoGrid.classList.contains('hidden');
      repoGrid.classList.toggle('hidden', !willExpand);
      repoGrid.classList.toggle('grid', willExpand);
      repoIcon?.classList.toggle('rotate-180', willExpand);

      expandBtn.setAttribute('aria-expanded', String(willExpand));
      const labelSpan = expandBtn.querySelector('span');
      if (labelSpan) {
        const countMatch = labelSpan.textContent?.match(/\(\d+\)/)?.[0] || '';
        labelSpan.textContent = willExpand ? 'Collapse List' : `Show All ${countMatch}`.trim();
      }
    });
  };

  setupRepoExpand();
  document.addEventListener('astro:page-load', setupRepoExpand);
  document.addEventListener('astro:after-swap', setupRepoExpand);
</script>
