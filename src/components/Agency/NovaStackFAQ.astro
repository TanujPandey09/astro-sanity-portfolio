---
// NovaStack FAQ: Clean Editorial Accordion with 1px --border Dividers & Smooth Height Animation
const faqs = [
  {
    question: "What kind of projects do you take on?",
    answer:
      "I partner with startups, digital agencies, and product teams across four core areas: custom marketing websites (Next.js, Astro, Sanity CMS), full-stack SaaS applications (MVPs, portals, RBAC, Stripe billing), applied AI workflows (RAG pipelines, autonomous agents, LLM APIs), and production HTML email design systems.",
  },
  {
    question: "Who actually builds the product?",
    answer:
      "Every architectural decision, UI implementation, and backend integration is written directly by founder Tanuj Pandey. You communicate directly in Slack, WhatsApp, or email with the engineer shipping your commits—never an account manager or outsourced junior team.",
  },
  {
    question: "How are milestones and payments structured?",
    answer:
      "Fixed-scope projects follow a 5-step milestone roadmap: Discovery, Technical Planning, UI/UX Design, Sprint Development, and Launch. Before coding starts, we lock a written scope and milestone schedule. You test working code on a private staging URL at each checkpoint before approving the next invoice.",
  },
  {
    question: "Do I own 100% of the source code and accounts?",
    answer:
      "Yes. All repositories, cloud hosting accounts (Vercel, Netlify, AWS, Neon), and Sanity CMS workspaces belong directly to your organization. On final sign-off, 100% intellectual property transfers cleanly with zero proprietary lock-in.",
  },
  {
    question: "How do custom HTML email design systems work?",
    answer:
      "I design and hand-code modular, table-based HTML email kits using inline CSS and Outlook VML fallbacks—tested across Outlook 365, Gmail, and Apple Mail. Deliverables arrive as clean, reusable HTML ready for Klaviyo, Mailchimp, HubSpot, SendGrid, or Resend. (Campaign sending and list management stay with your team.)",
  },
];
---

<section id="faq" class="ns-section bg-[var(--surface)] text-[var(--ink)] border-b border-[var(--border)]">
  <div class="ns-container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      <!-- Left Editorial Header (4 cols) -->
      <div class="lg:col-span-4 space-y-4">
        <div class="flex items-center gap-2.5">
          <span class="w-5 h-px bg-[var(--blue-600)]" aria-hidden="true"></span>
          <span class="ns-mono-label text-[var(--blue-600)] font-medium">
            06 / FAQ
          </span>
        </div>
        <h2 class="ns-h2 text-[var(--ink)]">
          Common <span class="text-[var(--blue-600)]">Questions.</span>
        </h2>
        <p class="ns-body">
          Clear answers on scope, engineering workflow, and repository ownership.
        </p>
      </div>

      <!-- Right Accordion with Clean 1px --border Dividers (8 cols) -->
      <div class="lg:col-span-8 border-t border-[var(--border)]" id="faq-accordion-group">
        {faqs.map((faq, index) => {
          const isFirst = index === 0;
          return (
            <div class="border-b border-[var(--border)]">
              <button
                type="button"
                id={`faq-btn-${index}`}
                aria-expanded={isFirst ? "true" : "false"}
                aria-controls={`faq-answer-${index}`}
                class="faq-trigger group w-full text-left py-6 flex items-center justify-between gap-6 cursor-pointer focus:outline-none"
              >
                <span class="text-lg sm:text-[19px] font-semibold text-[var(--ink)] group-hover:text-[var(--blue-600)] transition-colors duration-150 tracking-[-0.015em] leading-snug">
                  {faq.question}
                </span>
                <span
                  class={`faq-chevron w-8 h-8 rounded-full flex items-center justify-center shrink-0 text-[var(--blue-600)] bg-[var(--blue-50)] transition-transform duration-200 ${
                    isFirst ? "rotate-180" : ""
                  }`}
                  aria-hidden="true"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </button>

              <div
                id={`faq-answer-${index}`}
                role="region"
                aria-labelledby={`faq-btn-${index}`}
                data-open={isFirst ? "true" : "false"}
                class="ns-faq-body"
              >
                <div>
                  <p class="pb-6 pr-8 text-base sm:text-[17px] leading-[1.65] text-[var(--muted)]">
                    {faq.answer}
                  </p>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<script>
  const setupAgencyFAQ = () => {
    const container = document.getElementById("faq-accordion-group");
    if (!container || container.dataset.bound === "true") return;
    container.dataset.bound = "true";

    const triggers = container.querySelectorAll<HTMLButtonElement>(".faq-trigger");

    triggers.forEach((btn) => {
      btn.addEventListener("click", () => {
        const expanded = btn.getAttribute("aria-expanded") === "true";
        const answerId = btn.getAttribute("aria-controls");
        const answer = document.getElementById(answerId || "");
        const chevron = btn.querySelector(".faq-chevron");

        if (expanded) {
          btn.setAttribute("aria-expanded", "false");
          answer?.setAttribute("data-open", "false");
          chevron?.classList.remove("rotate-180");
        } else {
          triggers.forEach((otherBtn) => {
            if (otherBtn !== btn) {
              otherBtn.setAttribute("aria-expanded", "false");
              const otherAnswerId = otherBtn.getAttribute("aria-controls");
              document.getElementById(otherAnswerId || "")?.setAttribute("data-open", "false");
              otherBtn.querySelector(".faq-chevron")?.classList.remove("rotate-180");
            }
          });

          btn.setAttribute("aria-expanded", "true");
          answer?.setAttribute("data-open", "true");
          chevron?.classList.add("rotate-180");
        }
      });
    });
  };

  setupAgencyFAQ();
  document.addEventListener("astro:page-load", setupAgencyFAQ);
</script>
