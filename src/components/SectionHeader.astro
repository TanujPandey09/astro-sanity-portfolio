---
interface Props {
  title: string;
  gradientText?: string;
  subtitle?: string;
  eyebrow?: string;
  center?: boolean;
}

const { title, gradientText, subtitle, eyebrow = "SHOWCASE", center = false } = Astro.props;
// Clean Developer Framer Eyebrow formatting
const formattedEyebrow = eyebrow.toUpperCase().replace(/^REC:\s*/i, "");
---

<div class={`mb-10 sm:mb-14 md:mb-16 ${center ? 'text-center flex flex-col items-center' : ''}`} data-gsap-heading>
  <!-- Modern Developer Eyebrow Badge (Linear Indigo Pill) -->
  <div class={`inline-flex items-center gap-2.5 px-3.5 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/30 mb-4 sm:mb-5 shadow-[0_0_12px_rgba(94,106,210,0.15)] ${center ? 'justify-center' : ''}`}>
    <span class="w-1.5 h-1.5 rounded-full bg-accent-primary animate-pulse shadow-[0_0_8px_rgba(94,106,210,0.8)]"></span>
    <span class="text-[11px] sm:text-xs font-mono font-semibold tracking-[0.08em] text-indigo-300 uppercase">
      // {formattedEyebrow}
    </span>
  </div>

  <!-- Space Grotesk Display Heading + Subtitle -->
  <div class={`w-full ${center ? 'flex flex-col items-center text-center' : 'flex flex-col lg:flex-row lg:items-end justify-between gap-5 lg:gap-10'}`}>
    <h2 class="font-grotesk font-bold tracking-[-0.035em] leading-[1.02] text-[2.25rem] sm:text-5xl md:text-6xl lg:text-[4rem]">
      <span class="block text-[#F8FAFC] drop-shadow-[0_2px_15px_rgba(0,0,0,0.6)]">{title}</span>
      {gradientText && (
        <span class="block text-gradient mt-1">{gradientText}</span>
      )}
    </h2>

    {subtitle && (
      <p class={`max-w-md text-[#94A3B8] text-sm sm:text-[15px] font-normal leading-[1.6] tracking-[-0.01em] ${center ? 'mt-4 mx-auto text-center' : 'lg:text-right lg:pb-1'}`}>
        {subtitle}
      </p>
    )}
  </div>
</div>
