---
// NovaStack Studio Header: Adaptive Scroll Navigation
// Starts crisp solid white (#FFFFFF) at Hero -> smoothly transitions to solid dark #0B111A (matching Footer) on scroll
interface Props {
  logoUrl?: string;
  logoAlt?: string;
  brandName?: string;
  tagline?: string;
  logoFullWidth?: boolean;
}

const {
  logoUrl = "",
  logoAlt = "NovaStack Studio Logo",
  brandName = "NovaStack Studio",
  logoFullWidth = false,
} = Astro.props;

const navLinks = [
  { label: "Services", href: "#services" },
  { label: "Work", href: "#work" },
  { label: "Process", href: "#process" },
  { label: "Founder", href: "#about" },
  { label: "Pricing", href: "#models" },
  { label: "Contact", href: "#contact" },
];
---

<header
  class="agency-header sticky top-0 z-50 w-full"
  id="agency-header"
  data-scrolled="false"
>
  <div class="ns-container">
    <div class="flex h-14 sm:h-[60px] items-center justify-between gap-4">
      <!-- 1. Tight Brand Lockup -->
      <a href="/agency" class="group flex items-center gap-2.5 shrink-0">
        {logoUrl ? (
          <span
            class={
              logoFullWidth
                ? "agency-logo-wrap inline-flex items-center rounded-[8px] transition-colors duration-200"
                : "agency-logo-icon inline-flex items-center justify-center h-8 w-8 rounded-[9px] p-1 border transition-colors duration-200"
            }
          >
            <img
              src={logoUrl}
              alt={logoAlt}
              class={logoFullWidth ? "h-7 sm:h-8 w-auto max-w-[148px] object-contain" : "h-full w-full object-contain"}
              loading="eager"
              decoding="async"
            />
          </span>
        ) : (
          <div class="agency-brand-mark w-8 h-8 rounded-[9px] flex items-center justify-center font-semibold text-xs tracking-tight transition-colors duration-200">
            NS
          </div>
        )}
        {!(logoUrl && logoFullWidth) && (
          <span class="agency-brand-name font-semibold text-[15px] sm:text-base tracking-[-0.025em] transition-colors duration-200">
            {brandName}<span class="agency-brand-dot">.</span>
          </span>
        )}
      </a>

      <!-- 2. Crisp Pill-Grouped Desktop Navigation (lg+) -->
      <nav
        aria-label="Agency Navigation"
        class="agency-nav-rail hidden lg:flex items-center gap-0.5 p-1 rounded-full border transition-colors duration-200"
      >
        {navLinks.map((link) => (
          <a
            href={link.href}
            data-agency-nav={link.href.replace("#", "")}
            data-active="false"
            class="agency-nav-link px-3.5 py-1.5 rounded-full text-[13px] font-medium transition-all duration-150"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- 3. Right Actions (Desktop & Tablet) + Mobile/Tablet Menu Trigger (< lg) -->
      <div class="flex items-center gap-2 sm:gap-2.5">
        <a
          href="/"
          class="agency-portfolio-btn hidden sm:inline-flex items-center gap-1 px-3 py-1.5 rounded-[10px] border text-xs font-mono font-medium transition-colors duration-150"
          title="Tanuj Pandey Personal Portfolio"
        >
          <span>Portfolio</span>
          <span aria-hidden="true">↗</span>
        </a>

        <a
          href="#contact"
          class="ns-btn-primary px-3.5 sm:px-4 py-2 text-xs sm:text-[13px]"
        >
          <span>Start a Project</span>
          <span class="ns-arrow" aria-hidden="true">→</span>
        </a>

        <button
          type="button"
          id="agency-menu-open-btn"
          aria-label="Open navigation menu"
          aria-expanded="false"
          class="agency-menu-btn lg:hidden w-9 h-9 rounded-[10px] border flex flex-col items-center justify-center gap-1.5 cursor-pointer transition-colors duration-200"
        >
          <span class="agency-menu-bar w-4 h-[1.5px] transition-colors duration-200"></span>
          <span class="agency-menu-bar w-4 h-[1.5px] transition-colors duration-200"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile & Tablet Navigation Drawer (< lg) -->
  <div
    id="agency-mobile-menu"
    class="fixed inset-0 z-50 bg-[#0B111A]/60 hidden lg:hidden"
    aria-hidden="true"
  >
    <div
      class="absolute top-0 right-0 w-[84%] max-w-xs h-full bg-[#0B111A] border-l border-[#1F2A3A] p-5 flex flex-col justify-between overflow-y-auto text-white"
      id="agency-mobile-drawer"
    >
      <div>
        <div class="flex items-center justify-between pb-4 border-b border-[#1F2A3A] mb-4">
          <span class="font-semibold text-[15px] text-white">
            {brandName}<span class="text-[#38BDF8]">.</span>
          </span>
          <button
            type="button"
            id="agency-menu-close-btn"
            aria-label="Close navigation menu"
            class="w-8 h-8 rounded-[9px] bg-[#121A26] border border-[#1F2A3A] text-white flex items-center justify-center text-xs font-mono cursor-pointer"
          >
            ✕
          </button>
        </div>

        <nav class="space-y-1" aria-label="Mobile Navigation">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="agency-mobile-nav-link flex items-center justify-between px-3 py-2.5 rounded-[10px] font-medium text-[15px] text-[#E2E8F0] hover:bg-[#121A26] hover:text-[#38BDF8] transition-colors"
            >
              <span>{link.label}</span>
              <span class="text-xs text-[#9AA6B8]" aria-hidden="true">→</span>
            </a>
          ))}
        </nav>
      </div>

      <div class="pt-4 border-t border-[#1F2A3A] space-y-2.5">
        <a
          href="#contact"
          class="agency-mobile-nav-link ns-btn-primary w-full py-3 text-sm"
        >
          <span>Start a Project</span>
          <span class="ns-arrow" aria-hidden="true">→</span>
        </a>
        <a
          href="/"
          class="w-full py-2.5 rounded-[10px] bg-[#121A26] border border-[#1F2A3A] text-[#9AA6B8] hover:text-white font-mono text-xs text-center block transition-colors"
        >
          Founder Portfolio ↗
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* Default Top-of-Page Light State (Solid #FFFFFF — Zero Transparency) */
  .agency-header {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
    transition: background-color 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
  }

  .agency-brand-mark {
    background-color: #0B111A;
    color: #FFFFFF;
  }

  .agency-brand-name {
    color: #0B111A;
  }

  .agency-brand-dot {
    color: #2563EB;
  }

  .agency-logo-icon {
    background-color: #F5F7FA;
    border-color: #E2E8F0;
  }

  .agency-nav-rail {
    background-color: #F5F7FA;
    border-color: #E2E8F0;
  }

  .agency-nav-link {
    color: #4B5565;
  }

  .agency-nav-link:hover {
    color: #0B111A;
    background-color: #FFFFFF;
  }

  .agency-nav-link[data-active="true"] {
    color: #2563EB;
    background-color: #FFFFFF;
    box-shadow: 0 1px 2px rgba(11, 17, 26, 0.06);
  }

  .agency-portfolio-btn {
    background-color: #FFFFFF;
    border-color: #E2E8F0;
    color: #4B5565;
  }

  .agency-portfolio-btn:hover {
    border-color: #2563EB;
    color: #2563EB;
  }

  .agency-menu-btn {
    background-color: #F5F7FA;
    border-color: #E2E8F0;
  }

  .agency-menu-bar {
    background-color: #0B111A;
  }

  /* Scrolled Dark State (Solid #0B111A — Matches Footer & Selected Work) */
  .agency-header[data-scrolled="true"] {
    background-color: #0B111A;
    border-bottom-color: #1F2A3A;
    box-shadow: 0 10px 28px -12px rgba(11, 17, 26, 0.55);
  }

  .agency-header[data-scrolled="true"] .agency-brand-mark {
    background-color: #2563EB;
    color: #FFFFFF;
  }

  .agency-header[data-scrolled="true"] .agency-brand-name {
    color: #FFFFFF;
  }

  .agency-header[data-scrolled="true"] .agency-brand-dot {
    color: #38BDF8;
  }

  .agency-header[data-scrolled="true"] .agency-logo-wrap {
    background-color: #FFFFFF;
    padding: 2px 8px;
  }

  .agency-header[data-scrolled="true"] .agency-logo-icon {
    background-color: #FFFFFF;
    border-color: #1F2A3A;
  }

  .agency-header[data-scrolled="true"] .agency-nav-rail {
    background-color: #121A26;
    border-color: #1F2A3A;
  }

  .agency-header[data-scrolled="true"] .agency-nav-link {
    color: #9AA6B8;
  }

  .agency-header[data-scrolled="true"] .agency-nav-link:hover {
    color: #FFFFFF;
    background-color: #1F2A3A;
  }

  .agency-header[data-scrolled="true"] .agency-nav-link[data-active="true"] {
    color: #38BDF8;
    background-color: #1F2A3A;
    box-shadow: none;
  }

  .agency-header[data-scrolled="true"] .agency-portfolio-btn {
    background-color: #121A26;
    border-color: #1F2A3A;
    color: #E2E8F0;
  }

  .agency-header[data-scrolled="true"] .agency-portfolio-btn:hover {
    border-color: #38BDF8;
    color: #38BDF8;
  }

  .agency-header[data-scrolled="true"] .agency-menu-btn {
    background-color: #121A26;
    border-color: #1F2A3A;
  }

  .agency-header[data-scrolled="true"] .agency-menu-bar {
    background-color: #FFFFFF;
  }
</style>

<script>
  const setupAgencyHeader = () => {
    const header = document.getElementById("agency-header");
    const openBtn = document.getElementById("agency-menu-open-btn");
    const closeBtn = document.getElementById("agency-menu-close-btn");
    const menu = document.getElementById("agency-mobile-menu");
    const drawer = document.getElementById("agency-mobile-drawer");
    const mobileLinks = document.querySelectorAll(".agency-mobile-nav-link");
    const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".agency-nav-link"));

    if (openBtn && closeBtn && menu && drawer && openBtn.dataset.bound !== "true") {
      openBtn.dataset.bound = "true";

      const openMenu = () => {
        menu.classList.remove("hidden");
        openBtn.setAttribute("aria-expanded", "true");
        menu.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      };

      const closeMenu = () => {
        menu.classList.add("hidden");
        openBtn.setAttribute("aria-expanded", "false");
        menu.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      };

      openBtn.addEventListener("click", openMenu);
      closeBtn.addEventListener("click", closeMenu);
      menu.addEventListener("click", (e) => {
        if (e.target === menu) closeMenu();
      });
      mobileLinks.forEach((link) => link.addEventListener("click", closeMenu));
    }

    const w = window as any;
    if (w.__agencyHeaderScroll) {
      window.removeEventListener("scroll", w.__agencyHeaderScroll);
    }

    const sectionIds = navLinks.map((a) => a.dataset.agencyNav || "").filter(Boolean);

    w.__agencyHeaderScroll = () => {
      if (header) {
        header.setAttribute("data-scrolled", window.scrollY > 40 ? "true" : "false");
      }

      let activeId = "";
      for (const id of sectionIds) {
        const el = document.getElementById(id);
        if (!el) continue;
        const rect = el.getBoundingClientRect();
        if (rect.top <= 120) {
          activeId = id;
        }
      }

      navLinks.forEach((link) => {
        link.setAttribute("data-active", link.dataset.agencyNav === activeId ? "true" : "false");
      });
    };

    window.addEventListener("scroll", w.__agencyHeaderScroll, { passive: true });
    w.__agencyHeaderScroll();
  };

  setupAgencyHeader();
  document.addEventListener("astro:page-load", setupAgencyHeader);
  document.addEventListener("astro:after-swap", setupAgencyHeader);
</script>
