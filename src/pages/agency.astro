---
export const prerender = false;

import { useSanityClient, groq } from "astro-sanity";
import { fallbackSanityClient } from "../lib/sanityClient.js";
import { optimizeSanityImage } from "../lib/optimizeImage";
import Layout from "../layouts/Layout.astro";
import NovaStackHeader from "../components/Agency/NovaStackHeader.astro";
import NovaStackHero from "../components/Agency/NovaStackHero.astro";
import NovaStackCapabilities from "../components/Agency/NovaStackCapabilities.astro";
import NovaStackServices from "../components/Agency/NovaStackServices.astro";
import NovaStackWork from "../components/Agency/NovaStackWork.astro";
import NovaStackWhyUs from "../components/Agency/NovaStackWhyUs.astro";
import NovaStackProcess from "../components/Agency/NovaStackProcess.astro";
import NovaStackModels from "../components/Agency/NovaStackModels.astro";
import NovaStackFAQ from "../components/Agency/NovaStackFAQ.astro";
import NovaStackContact from "../components/Agency/NovaStackContact.astro";
import NovaStackFooter from "../components/Agency/NovaStackFooter.astro";

const agencyQuery = groq`*[_type == "agencySettings"] | order(_updatedAt desc)[0]{
  brandName,
  tagline,
  logoFullWidth,
  logo{
    alt,
    asset->{url}
  }
}`;

let agencySettings: any = null;
try {
  agencySettings = await useSanityClient().fetch(agencyQuery);
  if (!agencySettings) {
    agencySettings = await fallbackSanityClient.fetch(agencyQuery);
  }
} catch {
  try {
    agencySettings = await fallbackSanityClient.fetch(agencyQuery);
  } catch {}
}

const rawLogoUrl = agencySettings?.logo?.asset?.url;
const agencyLogoUrl = rawLogoUrl ? optimizeSanityImage(rawLogoUrl, 360, 90) : "";
const agencyLogoAlt = agencySettings?.logo?.alt || "NovaStack Logo";
const agencyBrandName = agencySettings?.brandName || "NovaStack";
const agencyTagline = agencySettings?.tagline || "AI & Digital Studio";
const agencyLogoFullWidth = Boolean(agencySettings?.logoFullWidth);

const siteUrl = "https://tanujbuilds.site";
const canonicalURL = `${siteUrl}/agency`;

const pageTitle = "NovaStack — AI & Digital Technology Studio | Web, Mobile & Custom SaaS";
const pageDescription = "NovaStack is an AI & digital technology studio helping startups, founders, and businesses build scalable web applications, mobile platforms, and production AI automation workflows across the USA, UK, UAE, Australia, and India.";

const agencyJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "ProfessionalService"],
      "@id": `${canonicalURL}#organization`,
      "name": agencyBrandName,
      "alternateName": ["NovaStack Studio", "NovaStack AI & Digital Technology Studio"],
      "url": canonicalURL,
      "logo": agencyLogoUrl || `${siteUrl}/favicon.svg`,
      "image": `${siteUrl}/og-image-dark.png`,
      "description": pageDescription,
      "slogan": "We Build. Automate. Optimize. Scale.",
      "email": "tanujp09@gmail.com",
      "telephone": "+919557321978",
      "founder": {
        "@type": "Person",
        "@id": `${siteUrl}/#person`,
        "name": "Tanuj Pandey",
        "jobTitle": "Founder & Lead Architect",
        "url": siteUrl,
      },
      "areaServed": [
        { "@type": "Country", "name": "United States" },
        { "@type": "Country", "name": "United Kingdom" },
        { "@type": "Country", "name": "United Arab Emirates" },
        { "@type": "Country", "name": "Australia" },
        { "@type": "Country", "name": "India" }
      ],
      "knowsAbout": [
        "Full-Stack Web Development",
        "Next.js & React 19 Applications",
        "Mobile App Development with React Native",
        "Applied Generative AI & Multi-LLM Orchestration",
        "SaaS MVP Architecture & Subscription Platforms",
        "Technical SEO & Generative Engine Optimization (GEO)",
        "UI/UX Product Design & Design Systems"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "NovaStack Services",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Web Development" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Mobile App Development" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "AI & Automation" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "SaaS & Custom Software" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "SEO & GEO" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "UI/UX & Product Design" } }
        ]
      }
    }
  ]
};

const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Agency", path: "/agency" },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  schemaType="WebPage"
  breadcrumbs={breadcrumbs}
  jsonLd={agencyJsonLd}
  hideDefaultHeader={true}
  hideDefaultFooter={true}
  isAgency={true}
>
  <!-- Dedicated Agency Container matching Deep Obsidian Architectural Aesthetic -->
  <div class="agency-page w-full min-h-screen bg-[#090A0F] text-white font-sans selection:bg-[#5E6AD2]/35 selection:text-white overflow-x-clip">
    <!-- Top Scroll Progress Hairline -->
    <div id="agency-scroll-progress" class="fixed top-0 left-0 h-[2px] w-0 bg-gradient-to-r from-[#5E6AD2] to-[#828FFF] z-[60] pointer-events-none transition-[width] duration-75"></div>

    <!-- NovaStack Navigation Header -->
    <NovaStackHeader
      logoUrl={agencyLogoUrl}
      logoAlt={agencyLogoAlt}
      brandName={agencyBrandName}
      tagline={agencyTagline}
      logoFullWidth={agencyLogoFullWidth}
    />

    <!-- Main Content Flow -->
    <main id="agency-main-content" class="overflow-x-clip">
      <!-- 1. Hero Section -->
      <NovaStackHero />

      <!-- 2. Trusted Capabilities -->
      <NovaStackCapabilities />

      <!-- 3. Agency Services (6 Categories) -->
      <NovaStackServices />

      <!-- 4. Featured Work (Custom vs Commercial Templates) -->
      <NovaStackWork />

      <!-- 5. Why NovaStack (6 Pillars) -->
      <NovaStackWhyUs />

      <!-- 6. Development Process (6 Steps) -->
      <NovaStackProcess />

      <!-- 7. Engagement Models (4 Structures) -->
      <NovaStackModels />

      <!-- 8. Frequently Asked Questions -->
      <NovaStackFAQ />

      <!-- 9. Contact Section & Project Inquiry Form -->
      <NovaStackContact />
    </main>

    <!-- 10. NovaStack Agency Footer -->
    <NovaStackFooter
      logoUrl={agencyLogoUrl}
      logoAlt={agencyLogoAlt}
      brandName={agencyBrandName}
      logoFullWidth={agencyLogoFullWidth}
    />
  </div>
</Layout>

<style is:global>
  /* Ensure smooth scrolling across anchor navigation under sticky navbar */
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 84px;
  }

  /* Accessible focus indicators for international B2B clients */
  .agency-page *:focus-visible {
    outline: 2px solid #5E6AD2 !important;
    outline-offset: 2px !important;
  }

  /* Unified Linear Indigo Cursor-Tracking Spotlight across Agency Cards */
  .agency-page [data-agency-dir].rounded-2xl,
  .agency-page #agency-main-content .rounded-2xl {
    position: relative;
    overflow: hidden;
    transition: border-color 0.3s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .agency-page #agency-main-content .rounded-2xl::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      340px circle at var(--agency-spot-x, 50%) var(--agency-spot-y, 50%),
      rgba(94, 106, 210, 0.14),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }

  .agency-page #agency-main-content .rounded-2xl:hover::after {
    opacity: 1;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initAgencyProductionMotion() {
    const root = document.getElementById('agency-main-content');
    if (!root) return;

    const w = window as any;

    // 1. Top Progress Hairline
    const progressEl = document.getElementById('agency-scroll-progress');
    if (w.__agencyScrollProgressHandler) {
      window.removeEventListener('scroll', w.__agencyScrollProgressHandler);
    }
    w.__agencyScrollProgressHandler = () => {
      if (!progressEl) return;
      const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      const pct = Math.min(100, Math.max(0, (window.scrollY / maxScroll) * 100));
      progressEl.style.width = `${pct.toFixed(1)}%`;
    };
    window.addEventListener('scroll', w.__agencyScrollProgressHandler, { passive: true });
    w.__agencyScrollProgressHandler();

    // 2. Global Agency Spotlight Cursor Tracking on all Section Cards
    root.querySelectorAll<HTMLElement>('.rounded-2xl').forEach((card) => {
      if (card.dataset.agencySpotBound === 'true') return;
      card.dataset.agencySpotBound = 'true';
      card.addEventListener('pointermove', (e: PointerEvent) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--agency-spot-x', `${e.clientX - rect.left}px`);
        card.style.setProperty('--agency-spot-y', `${e.clientY - rect.top}px`);
      });
    });

    // 3. Kill prior agency ScrollTriggers cleanly
    ScrollTrigger.getAll().forEach((trigger) => {
      const id = String(trigger.vars?.id || '');
      if (id.startsWith('agency-')) {
        trigger.kill();
      }
    });

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const elements = Array.from(root.querySelectorAll('[data-agency-dir]')) as HTMLElement[];
    const sectionHeadings = Array.from(root.querySelectorAll('section h2')) as HTMLElement[];

    if (reduceMotion) {
      elements.forEach((el) => {
        el.style.opacity = '1';
        el.style.transform = '';
      });
      return;
    }

    // 4. CountUp Proof Metrics Animation
    root.querySelectorAll<HTMLElement>('[data-count-target]').forEach((counterEl) => {
      const target = Number(counterEl.getAttribute('data-count-target') || 0);
      const suffix = counterEl.getAttribute('data-count-suffix') || '';
      if (!target) return;
      const obj = { val: 0 };
      gsap.to(obj, {
        val: target,
        duration: 1.4,
        ease: 'power2.out',
        scrollTrigger: {
          id: `agency-count-${target}`,
          trigger: counterEl,
          start: 'top 92%',
          once: true,
        },
        onUpdate: () => {
          counterEl.textContent = `${Math.round(obj.val)}${suffix}`;
        },
      });
    });

    // 5. Section Heading Cinematic Reveals
    sectionHeadings.forEach((h2, idx) => {
      gsap.fromTo(
        h2,
        { y: 22, opacity: 0.25 },
        {
          y: 0,
          opacity: 1,
          duration: 0.75,
          ease: 'power3.out',
          clearProps: 'transform,opacity',
          scrollTrigger: {
            id: `agency-heading-${idx}`,
            trigger: h2,
            start: 'top 92%',
            once: true,
          },
        }
      );
    });

    // 6. Left / Right -> Center Convergence on Cards & Split Showcases
    elements.forEach((el, index) => {
      const dir = el.getAttribute('data-agency-dir') || 'center';
      const offsetX = dir === 'left' ? -64 : dir === 'right' ? 64 : 0;
      const offsetY = dir === 'center' ? 28 : 14;
      const startScale = dir === 'center' ? 0.95 : 0.97;

      gsap.fromTo(
        el,
        {
          x: offsetX,
          y: offsetY,
          scale: startScale,
          opacity: 0.2,
        },
        {
          x: 0,
          y: 0,
          scale: 1,
          opacity: 1,
          duration: 0.8,
          ease: 'power3.out',
          clearProps: 'transform,opacity',
          scrollTrigger: {
            id: `agency-reveal-${index}`,
            trigger: el,
            start: 'top 90%',
            once: true,
          },
        }
      );
    });

    ScrollTrigger.refresh();
  }

  initAgencyProductionMotion();
  document.addEventListener('astro:page-load', initAgencyProductionMotion);
  document.addEventListener('astro:after-swap', initAgencyProductionMotion);
</script>

