---
import { PortableText } from "astro-portabletext";
import PremiumBackground from "../PremiumBackground.astro";
import PortableTextImage from "./PortableTextImage.astro";
import { optimizeSanityImage } from "../../lib/optimizeImage";

const { detailsData = {}, blogData = [] } = Astro.props;

const components = {
  type: {
    image: PortableTextImage,
  },
};

const safeBlogList = Array.isArray(blogData) ? blogData : [];
const relatedPosts = safeBlogList
  .filter(
    (post) =>
      post?.slug?.current &&
      post.slug.current !== detailsData?.slug?.current
  )
  .slice(0, 3);

const coverImage =
  detailsData?.BackgroundImage?.asset?.url ||
  detailsData?.FeatureImage?.asset?.url ||
  detailsData?.image?.asset?.url;

const formattedDate = detailsData?._createdAt
  ? new Date(detailsData._createdAt).toLocaleDateString("en-US", {
      month: "long",
      day: "numeric",
      year: "numeric",
    })
  : "Published Article";

const tags = Array.isArray(detailsData?.tags) ? detailsData.tags : [];
---

<div class="relative min-h-screen selection:bg-accent-primary/30 overflow-hidden">
  <PremiumBackground />

  <main class="mx-auto w-full max-w-[1440px] px-4 md:px-10 pt-28 pb-24 md:pt-36 md:pb-32 relative z-10">
    <!-- Top Studio Breadcrumb Bar -->
    <div class="max-w-5xl mx-auto flex flex-wrap items-center justify-between gap-4 pb-6 mb-10 border-b border-white/[0.08] font-mono text-xs text-[#94A3B8]">
      <a
        href="/blogs"
        class="inline-flex items-center gap-2 text-[#F8FAFC] hover:text-accent-primary transition-colors font-medium"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Back to All Articles
      </a>

      <div class="flex items-center gap-3">
        {detailsData?.Category && (
          <span class="px-2.5 py-1 rounded-md bg-accent-primary/10 border border-accent-primary/30 text-accent-hover font-semibold">
            {detailsData.Category}
          </span>
        )}
        <span>{formattedDate}</span>
      </div>
    </div>

    <!-- Article Header -->
    <header class="max-w-5xl mx-auto mb-12 md:mb-16">
      <h1 class="font-grotesk text-3xl sm:text-5xl md:text-6xl font-bold text-[#F4F2ED] tracking-[-0.03em] leading-[1.08] mb-8">
        {detailsData?.projectName || "Engineering Deep Dive"}
      </h1>

      <div class="flex flex-wrap items-center justify-between gap-6 pt-6 border-t border-white/[0.08]">
        <div class="flex items-center gap-3.5">
          <div class="w-11 h-11 rounded-full overflow-hidden border border-white/15 bg-surface-elevated flex items-center justify-center p-1.5">
            <img
              src="/favicon.svg"
              alt="Tanuj Pandey — Senior Full-Stack Engineer"
              width="44"
              height="44"
              loading="eager"
              decoding="async"
              class="w-full h-full object-contain"
            />
          </div>
          <div>
            <p class="text-sm font-grotesk font-bold text-text-primary">Tanuj Pandey</p>
            <p class="text-xs font-mono text-text-muted">Senior Full-Stack & AI Engineer</p>
          </div>
        </div>

        {tags.length > 0 && (
          <div class="flex flex-wrap items-center gap-2">
            {tags.map((tag: string) => (
              <span class="px-3 py-1 rounded-full bg-white/[0.03] border border-white/[0.08] font-mono text-xs text-text-muted">
                #{tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </header>

    <!-- Main Content & Sidebar Grid -->
    <div class="max-w-6xl mx-auto grid lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      <article class="lg:col-span-8 space-y-10">
        {coverImage && (
          <div class="rounded-[22px] p-1.5 bg-white/[0.02] border border-white/[0.08] shadow-[0_24px_60px_rgba(0,0,0,0.6)]">
            <div class="rounded-[16px] overflow-hidden border border-white/[0.06] bg-surface-card">
              <img
                src={optimizeSanityImage(coverImage, 1200, 82)}
                alt={detailsData?.projectName || "Article cover image"}
                loading="eager"
                decoding="async"
                class="w-full h-auto max-h-[520px] object-cover"
              />
            </div>
          </div>
        )}

        <div class="rounded-[22px] p-1.5 bg-white/[0.02] border border-white/[0.08]">
          <div class="rounded-[16px] bg-surface-card border border-white/[0.05] p-6 sm:p-8 md:p-12 prose-custom">
            {detailsData?.blogcontent ? (
              <PortableText value={detailsData.blogcontent} components={components} />
            ) : (
              <p class="text-text-muted">
                This article is currently being updated. Check back shortly for the full technical write-up.
              </p>
            )}
          </div>
        </div>
      </article>

      <!-- Sticky Sidebar -->
      <aside class="lg:col-span-4 lg:sticky lg:top-28 space-y-6">
        {relatedPosts.length > 0 && (
          <div class="rounded-[22px] p-1.5 bg-white/[0.02] border border-white/[0.08]">
            <div class="rounded-[16px] bg-surface-card border border-white/[0.05] p-6 md:p-7">
              <div class="flex items-center gap-2 mb-5 font-mono text-xs uppercase tracking-[0.15em] text-accent-primary">
                <span class="w-2 h-2 rounded-full bg-accent-primary" />
                <span>Related Articles</span>
              </div>

              <div class="space-y-5">
                {relatedPosts.map((post: any, idx: number) => (
                  <a
                    href={`/blogs/${post.slug.current}`}
                    class="group block pb-5 border-b border-white/[0.07] last:border-0 last:pb-0"
                  >
                    <div class="flex items-center justify-between gap-2 mb-1.5 font-mono text-[11px] text-text-dim">
                      <span class="text-accent-primary">0{idx + 1}</span>
                      <span>
                        {post._createdAt
                          ? new Date(post._createdAt).toLocaleDateString("en-US", {
                              month: "short",
                              day: "numeric",
                              year: "numeric",
                            })
                          : "Article"}
                      </span>
                    </div>
                    <h3 class="font-grotesk text-base font-bold text-text-primary group-hover:text-accent-hover transition-colors leading-snug">
                      {post.projectName}
                    </h3>
                  </a>
                ))}
              </div>
            </div>
          </div>
        )}

        <!-- Engineering CTA Card -->
        <div class="rounded-[22px] p-1.5 bg-white/[0.02] border border-accent-primary/30">
          <div class="rounded-[16px] bg-surface-card p-6 md:p-7 border border-white/[0.05]">
            <span class="inline-block font-mono text-[11px] uppercase tracking-[0.16em] text-accent-primary mb-2">
              Work Together
            </span>
            <h3 class="font-grotesk text-xl font-bold text-text-primary mb-2.5">
              Building a High-Scale Product?
            </h3>
            <p class="text-sm text-text-muted leading-relaxed mb-6">
              Available for full-stack architecture, custom web applications, and AI system integrations.
            </p>
            <a
              href="/#contact"
              class="inline-flex items-center justify-center w-full px-5 py-3 rounded-xl bg-accent-primary hover:bg-accent-hover text-white font-grotesk font-semibold text-sm transition-colors shadow-[0_10px_25px_rgba(94,106,210,0.35)]"
            >
              Start a Project
            </a>
          </div>
        </div>
      </aside>
    </div>
  </main>
</div>

<style>
  .prose-custom {
    color: var(--text-muted);
    font-size: 1.0625rem;
    line-height: 1.8;
  }
  .prose-custom :global(p) {
    margin-bottom: 1.5rem;
    color: #cbd5e1;
  }
  .prose-custom :global(h1),
  .prose-custom :global(h2) {
    color: rgb(var(--text-primary-rgb));
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.25;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .prose-custom :global(h3),
  .prose-custom :global(h4) {
    color: rgb(var(--text-primary-rgb));
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.3;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose-custom :global(strong) {
    color: rgb(var(--text-primary-rgb));
    font-weight: 700;
  }
  .prose-custom :global(a) {
    color: var(--accent-hover);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .prose-custom :global(ul),
  .prose-custom :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    color: #cbd5e1;
  }
  .prose-custom :global(ul) {
    list-style: disc;
  }
  .prose-custom :global(ol) {
    list-style: decimal;
  }
  .prose-custom :global(blockquote) {
    border-left: 3px solid var(--accent-primary);
    padding: 1rem 1.25rem;
    margin: 1.75rem 0;
    background: rgba(94, 106, 210, 0.08);
    border-radius: 0 0.75rem 0.75rem 0;
    color: rgb(var(--text-primary-rgb));
    font-style: italic;
  }
  .prose-custom :global(pre) {
    background: #090b10;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.875rem;
    padding: 1.25rem;
    overflow-x: auto;
    margin: 1.75rem 0;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.875rem;
  }
  .prose-custom :global(code) {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.875em;
    background: rgba(255, 255, 255, 0.06);
    padding: 0.15rem 0.4rem;
    border-radius: 0.35rem;
    color: #e2e8f0;
  }
  .prose-custom :global(pre code) {
    background: transparent;
    padding: 0;
  }
  .prose-custom :global(img) {
    width: 100%;
    height: auto;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    margin: 2rem 0;
  }
</style>
