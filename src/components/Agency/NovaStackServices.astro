---
// NovaStack Agency Services: Screenshot-Inspired "One System" Centered Header + Asymmetric Split Showcases (Zero Sticky Repetition)
const services = [
  {
    id: "uiux-design",
    badge: "01 · PRODUCT DESIGN & UI SYSTEMS",
    title: "UI/UX & Brand Systems",
    summary: "High-converting product interfaces, Figma component libraries, and cohesive visual identity systems built for engineering speed and visual authority.",
    bulletsLeft: ["SaaS Dashboard UX", "Design Token Systems", "Interactive Prototypes"],
    bulletsRight: ["B2B Conversion Pages", "RTL & Mobile Responsive", "WCAG AA Accessibility"],
    techStack: ["Figma", "Design Tokens", "Tailwind CSS", "Micro-Interactions"],
    frameBg: "bg-gradient-to-br from-[#161B2E] via-[#101320] to-[#0C0E16]",
    previewDesktop: "https://cdn.sanity.io/images/fqd3bez7/production/fbe9b67497b5d77fb4822116a0b3b31db990eed4-1825x853.png?w=900&auto=format&q=85",
    previewMobile: "https://cdn.sanity.io/images/fqd3bez7/production/9e3002b16f302b12708b1fa01238a73cda1c4919-1672x941.png?w=500&auto=format&q=85",
    imageRight: true,
  },
  {
    id: "web-development",
    badge: "02 · FULL-STACK WEB ENGINEERING",
    title: "Web Design & Development",
    summary: "Production web applications, SSR corporate sites, and custom SaaS portals engineered for sub-second speed, strict type safety, and measurable conversion.",
    bulletsLeft: ["Next.js & React 19 SSR", "E-Commerce Storefronts", "Headless Sanity CMS"],
    bulletsRight: ["Admin & Customer Portals", "Enterprise Analytics UI", "99+ Core Web Vitals"],
    techStack: ["Next.js", "React 19", "TypeScript", "Node.js", "Tailwind CSS"],
    frameBg: "bg-gradient-to-br from-[#141724] via-[#11131D] to-[#1A1F33]",
    previewDesktop: "https://cdn.sanity.io/images/fqd3bez7/production/2ce01332eb1f37c21197a65b9723c429873b54d1-1348x635.png?w=900&auto=format&q=85",
    previewMobile: "https://cdn.sanity.io/images/fqd3bez7/production/a789384b9bb85b4c62ff3abd42a14259ff219699-1815x717.png?w=500&auto=format&q=85",
    imageRight: false,
  },
  {
    id: "ai-automation",
    badge: "03 · INTELLIGENT SYSTEMS & APPLIED AI",
    title: "AI & Automation",
    summary: "Production LLM orchestration, contextual RAG search, autonomous workflows, and structured JSON guardrails that eliminate manual operational bottlenecks.",
    bulletsLeft: ["Multi-LLM Routing", "Contextual RAG Pipelines", "Autonomous Support Agents"],
    bulletsRight: ["Document Data Extraction", "Schema Validation Guardrails", "Token Cost Optimization"],
    techStack: ["OpenAI GPT-4o", "Claude 3.5", "Gemini", "Vector DBs"],
    frameBg: "bg-gradient-to-br from-[#171B30] via-[#101321] to-[#0D0F18]",
    previewDesktop: "https://cdn.sanity.io/images/fqd3bez7/production/cff0d5b6d2c8144035c77a26fd7616a85a437e7e-1365x1186.png?w=900&auto=format&q=85",
    previewMobile: "https://cdn.sanity.io/images/fqd3bez7/production/2ce01332eb1f37c21197a65b9723c429873b54d1-1348x635.png?w=500&auto=format&q=85",
    imageRight: true,
  },
  {
    id: "saas-software",
    badge: "04 · PRODUCT ARCHITECTURE",
    title: "SaaS & Custom Software",
    summary: "From zero to launch in 4–8 weeks: multi-tenant architectures, real-time WebSocket CRMs, RBAC permissions, and global Stripe/MyFatoorah billing.",
    bulletsLeft: ["4–8 Week MVP Launch", "Socket.IO Real-Time Sync", "Multi-Tenant RBAC"],
    bulletsRight: ["Stripe & Regional Billing", "PostgreSQL & Prisma ORM", "Webhook & Audit Logs"],
    techStack: ["PostgreSQL", "Prisma", "Socket.IO", "Redis", "Stripe API"],
    frameBg: "bg-gradient-to-br from-[#151828] via-[#10131F] to-[#1B1F36]",
    previewDesktop: "https://cdn.sanity.io/images/fqd3bez7/production/a789384b9bb85b4c62ff3abd42a14259ff219699-1815x717.png?w=900&auto=format&q=85",
    previewMobile: "https://cdn.sanity.io/images/fqd3bez7/production/cff0d5b6d2c8144035c77a26fd7616a85a437e7e-1365x1186.png?w=500&auto=format&q=85",
    imageRight: false,
  }
];

const additionalDisciplines = [
  {
    id: "mobile-development",
    num: "05/",
    title: "Mobile App Development",
    desc: "Unified iOS and Android apps built with React Native & Expo EAS — offline sync, biometrics, push notifications, and App Store release.",
    tags: ["React Native", "Expo EAS", "TypeScript", "SQLite"],
  },
  {
    id: "seo-geo",
    num: "06/",
    title: "Technical SEO & GEO Optimization",
    desc: "Structured JSON-LD schema, sub-second TTFB edge caching, semantic knowledge graphs, and llms.txt discoverability across Google & AI engines.",
    tags: ["JSON-LD Schema", "Core Web Vitals", "llms.txt", "Edge Caching"],
  }
];
---

<section id="services" class="py-20 sm:py-28 bg-[#090A0F] text-white border-b border-white/[0.08]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <!-- 1. CENTERED MANIFESTO HEADER (Matches Screenshot Mid-Page Headline) -->
    <div class="max-w-3xl mx-auto text-center mb-16 sm:mb-24">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.05] border border-white/10 text-[11px] font-mono uppercase tracking-[0.16em] text-[#828FFF] mb-4">
        // INTEGRATED STUDIO SYSTEM
      </span>
      <h2 class="font-grotesk font-extrabold text-3xl sm:text-5xl md:text-[3.25rem] text-white tracking-[-0.04em] leading-[1.06]">
        Design, web, growth and AI built as one system.
      </h2>
      <p class="text-sm sm:text-base text-slate-300 mt-4 leading-relaxed font-sans">
        Zero fragmented contractors. Every layer—brand UX, frontend velocity, AI orchestration, and cloud APIs—ships under one accountable engineering team.
      </p>
    </div>

    <!-- 2. ALTERNATING SPLIT SHOWCASE ROWS (Mirrors Reference Visual Card + Right Spec Layout, Zero Bugs) -->
    <div class="space-y-16 sm:space-y-24">
      {services.map((service) => (
        <div
          id={`service-${service.id}`}
          class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center"
        >
          <!-- Visual Showcase Frame (Warm Gallery Card + Nested Desktop/Mobile Device Bezel) -->
          <div data-agency-dir={service.imageRight ? 'right' : 'left'} class={`lg:col-span-6 ${service.imageRight ? 'lg:order-2' : 'lg:order-1'}`}>
            <div class={`group relative rounded-[26px] ${service.frameBg} p-5 sm:p-7 overflow-hidden shadow-[0_30px_70px_rgba(0,0,0,0.45)] border border-[#5E6AD2]/25 hover:border-[#828FFF]/45 transition-colors`}>
              <div class="relative rounded-2xl overflow-hidden bg-[#0F1118] border border-black/15 shadow-xl">
                <!-- Minimal Browser Chrome -->
                <div class="flex items-center gap-1.5 px-3.5 py-2 bg-[#171A25] border-b border-white/10">
                  <span class="w-2 h-2 rounded-full bg-white/25"></span>
                  <span class="w-2 h-2 rounded-full bg-white/25"></span>
                  <span class="w-2 h-2 rounded-full bg-white/25"></span>
                  <span class="ml-2 text-[9px] font-mono text-slate-400 truncate">novastack.studio/{service.id}</span>
                </div>
                <div class="aspect-[16/10] w-full overflow-hidden">
                  <img
                    src={service.previewDesktop}
                    alt={service.title}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.03]"
                  />
                </div>
              </div>

              <!-- Secondary Floating Companion Card (Mimics Screenshot Dual-Mockup Overlay) -->
              <div class="hidden sm:block absolute right-4 bottom-4 w-36 md:w-44 aspect-[4/3] rounded-xl overflow-hidden bg-[#0B0D14] border-2 border-white shadow-2xl transform rotate-3 group-hover:rotate-0 group-hover:-translate-y-1 transition-all duration-500">
                <img
                  src={service.previewMobile}
                  alt={`${service.title} preview`}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover object-top"
                />
              </div>
            </div>
          </div>

          <!-- Editorial Service Copy & Two-Column Deliverable Matrix -->
          <div data-agency-dir={service.imageRight ? 'left' : 'right'} class={`lg:col-span-6 space-y-5 ${service.imageRight ? 'lg:order-1' : 'lg:order-2'}`}>
            <span class="text-[11px] font-mono uppercase tracking-[0.16em] text-[#828FFF] font-semibold block">
              {service.badge}
            </span>

            <h3 class="font-grotesk font-extrabold text-2xl sm:text-3xl md:text-4xl text-white tracking-[-0.03em]">
              {service.title}
            </h3>

            <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-sans">
              {service.summary}
            </p>

            <!-- Two-Column Bullet Deliverables (Matches Screenshot Clean Split List) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2.5 pt-2 pb-2 text-xs sm:text-sm text-slate-300 font-sans border-y border-white/[0.08] py-4">
              <ul class="space-y-2">
                {service.bulletsLeft.map((item) => (
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#828FFF] shrink-0"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <ul class="space-y-2">
                {service.bulletsRight.map((item) => (
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Stack Pills & Action -->
            <div class="flex flex-wrap items-center justify-between gap-4 pt-1">
              <div class="flex flex-wrap gap-1.5">
                {service.techStack.map((tech) => (
                  <span class="text-[10px] font-mono px-2.5 py-1 rounded-full bg-white/[0.05] border border-white/10 text-slate-300">
                    {tech}
                  </span>
                ))}
              </div>
              <a
                href={`#contact?service=${encodeURIComponent(service.title)}`}
                class="inline-flex items-center gap-2 text-xs font-grotesk font-bold uppercase tracking-wider text-white hover:text-[#828FFF] transition-colors"
              >
                <span>Scope This Service</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- 3. ADDITIONAL SPECIALIST DISCIPLINES (05 & 06) -->
    <div class="mt-20 grid grid-cols-1 md:grid-cols-2 gap-6">
      {additionalDisciplines.map((item, idx) => (
        <div data-agency-dir={idx % 2 === 0 ? 'left' : 'right'} id={`service-${item.id}`} class="rounded-2xl bg-white/[0.03] border border-white/[0.08] hover:border-white/20 p-6 sm:p-8 flex flex-col justify-between transition-all">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono text-[#828FFF] font-bold">{item.num}</span>
              <a href={`#contact?service=${encodeURIComponent(item.title)}`} class="text-xs font-mono text-slate-300 hover:text-white transition-colors">
                Inquire ↗
              </a>
            </div>
            <h3 class="font-grotesk font-bold text-xl sm:text-2xl text-white tracking-tight mb-2">{item.title}</h3>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-5">{item.desc}</p>
          </div>
          <div class="flex flex-wrap gap-1.5">
            {item.tags.map((t) => (
              <span class="text-[10px] font-mono px-2.5 py-1 rounded-full bg-white/[0.04] border border-white/10 text-slate-300">{t}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- SEO & GEO Policy Note -->
    <div class="mt-8 p-4 sm:p-5 rounded-2xl bg-white/[0.02] border border-white/[0.08] text-xs text-slate-400 flex items-start gap-3">
      <span class="text-[#828FFF] font-mono font-bold mt-0.5 text-sm">ⓘ</span>
      <p class="leading-relaxed">
        <strong class="text-white font-semibold">SEO &amp; GEO Transparency Policy:</strong> NovaStack engineers strict technical crawlability, structured schema markup, fast TTFB, and contextual knowledge graphs without misleading #1 ranking guarantees.
      </p>
    </div>

  </div>
</section>
