---
// NovaStack Studio Header: Calm, Editorial Sticky Navigation
// Tokens: --surface (#FFFFFF), --ink (#0B111A), --muted (#4B5565), --blue-600 (#2563EB), --border (#E2E8F0)
interface Props {
  logoUrl?: string;
  logoAlt?: string;
  brandName?: string;
  tagline?: string;
  logoFullWidth?: boolean;
}

const {
  logoUrl = "",
  logoAlt = "NovaStack Studio Logo",
  brandName = "NovaStack Studio",
  tagline = "Independent Engineering Studio",
  logoFullWidth = false,
} = Astro.props;

const navLinks = [
  { label: "Services", href: "#services" },
  { label: "Work", href: "#work" },
  { label: "Process", href: "#process" },
  { label: "Founder", href: "#about" },
  { label: "Pricing", href: "#models" },
  { label: "Contact", href: "#contact" },
];
---

<header
  class="sticky top-0 z-50 w-full bg-[var(--surface)] border-b border-[var(--border)]"
  id="agency-header"
>
  <div class="ns-container">
    <div class="flex h-16 sm:h-[72px] items-center justify-between gap-6">
      <!-- 1. Brand Wordmark -->
      <a href="/agency" class="group flex items-center gap-3 shrink-0">
        {logoUrl ? (
          <img
            src={logoUrl}
            alt={logoAlt}
            class={
              logoFullWidth
                ? "h-8 sm:h-9 w-auto max-w-[164px] object-contain"
                : "h-9 w-9 rounded-[10px] object-contain bg-[var(--bg)] border border-[var(--border)] p-1 transition-colors group-hover:border-[var(--blue-600)]"
            }
            loading="eager"
            decoding="async"
          />
        ) : (
          <div class="w-9 h-9 rounded-[10px] bg-[var(--ink)] text-white flex items-center justify-center font-semibold text-sm tracking-tight transition-colors group-hover:bg-[var(--blue-600)]">
            NS
          </div>
        )}
        {!(logoUrl && logoFullWidth) && (
          <div class="flex flex-col leading-none">
            <span class="font-semibold text-base sm:text-[17px] tracking-[-0.02em] text-[var(--ink)]">
              {brandName}
            </span>
            <span class="text-[11px] font-mono uppercase tracking-[0.08em] text-[var(--muted)] mt-1 hidden sm:block">
              {tagline}
            </span>
          </div>
        )}
      </a>

      <!-- 2. Desktop Navigation -->
      <nav aria-label="Agency Navigation" class="hidden lg:flex items-center gap-7">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-[var(--muted)] hover:text-[var(--ink)] transition-colors duration-150 py-2"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- 3. Desktop Actions -->
      <div class="hidden sm:flex items-center gap-4">
        <a
          href="/"
          class="ns-link-arrow inline-flex items-center gap-1 text-sm font-mono text-[var(--muted)] hover:text-[var(--blue-600)] transition-colors duration-150"
          title="Tanuj Pandey Personal Portfolio"
        >
          <span>Portfolio</span>
          <span class="ns-arrow" aria-hidden="true">↗</span>
        </a>

        <a
          href="#contact"
          class="ns-btn-primary px-5 py-2.5 text-sm"
        >
          <span>Start a Project</span>
          <span class="ns-arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <!-- 4. Mobile Trigger -->
      <div class="flex items-center gap-2.5 sm:hidden">
        <a
          href="#contact"
          class="ns-btn-primary px-3.5 py-2 text-xs"
        >
          Start
        </a>
        <button
          type="button"
          id="agency-menu-open-btn"
          aria-label="Open mobile navigation menu"
          aria-expanded="false"
          class="w-10 h-10 rounded-[12px] bg-[var(--bg)] border border-[var(--border)] flex flex-col items-center justify-center gap-1.5 text-[var(--ink)] cursor-pointer"
        >
          <span class="w-4 h-[1.5px] bg-[var(--ink)]"></span>
          <span class="w-4 h-[1.5px] bg-[var(--ink)]"></span>
          <span class="w-4 h-[1.5px] bg-[var(--ink)]"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div
    id="agency-mobile-menu"
    class="fixed inset-0 z-50 bg-[#0B111A]/50 hidden sm:hidden"
    aria-hidden="true"
  >
    <div
      class="absolute top-0 right-0 w-[85%] max-w-sm h-full bg-[var(--surface)] border-l border-[var(--border)] p-6 flex flex-col justify-between overflow-y-auto"
      id="agency-mobile-drawer"
    >
      <div>
        <div class="flex items-center justify-between pb-5 border-b border-[var(--border)] mb-6">
          <span class="font-semibold text-base text-[var(--ink)]">{brandName}</span>
          <button
            type="button"
            id="agency-menu-close-btn"
            aria-label="Close mobile navigation menu"
            class="w-9 h-9 rounded-[10px] bg-[var(--bg)] border border-[var(--border)] text-[var(--ink)] flex items-center justify-center text-sm font-mono cursor-pointer"
          >
            ✕
          </button>
        </div>

        <nav class="space-y-1" aria-label="Mobile Navigation">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="agency-mobile-nav-link flex items-center justify-between px-3 py-3 rounded-[12px] font-medium text-base text-[var(--ink)] hover:bg-[var(--bg)] hover:text-[var(--blue-600)] transition-colors"
            >
              <span>{link.label}</span>
              <span class="text-sm text-[var(--muted)]" aria-hidden="true">→</span>
            </a>
          ))}
        </nav>
      </div>

      <div class="pt-6 border-t border-[var(--border)] space-y-3">
        <a
          href="#contact"
          class="agency-mobile-nav-link ns-btn-primary w-full py-3.5 text-sm"
        >
          <span>Start a Project</span>
          <span class="ns-arrow" aria-hidden="true">→</span>
        </a>
        <a
          href="/"
          class="w-full py-3 rounded-[12px] bg-[var(--bg)] border border-[var(--border)] text-[var(--ink)] font-mono text-xs text-center block"
        >
          Founder Portfolio (tanujbuilds.site) ↗
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const setupAgencyMobileNav = () => {
    const openBtn = document.getElementById("agency-menu-open-btn");
    const closeBtn = document.getElementById("agency-menu-close-btn");
    const menu = document.getElementById("agency-mobile-menu");
    const drawer = document.getElementById("agency-mobile-drawer");
    const links = document.querySelectorAll(".agency-mobile-nav-link");

    if (!openBtn || !closeBtn || !menu || !drawer || openBtn.dataset.bound === "true") return;
    openBtn.dataset.bound = "true";

    const openMenu = () => {
      menu.classList.remove("hidden");
      openBtn.setAttribute("aria-expanded", "true");
      menu.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    };

    const closeMenu = () => {
      menu.classList.add("hidden");
      openBtn.setAttribute("aria-expanded", "false");
      menu.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    };

    openBtn.addEventListener("click", openMenu);
    closeBtn.addEventListener("click", closeMenu);

    menu.addEventListener("click", (e) => {
      if (e.target === menu) closeMenu();
    });

    links.forEach((link) => {
      link.addEventListener("click", closeMenu);
    });
  };

  setupAgencyMobileNav();
  document.addEventListener("astro:page-load", setupAgencyMobileNav);
</script>
