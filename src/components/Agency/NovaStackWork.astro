---
// NovaStack Featured Work: Custom Engineering & Commercial Templates
interface WorkItem {
  id: string;
  name: string;
  category: "CUSTOM CLIENT BUILD" | "COMMERCIAL WEBSITE TEMPLATE";
  badgeColor: string;
  subtitle: string;
  description: string;
  highlights: string[];
  stack: string[];
  caseStudyUrl: string;
  demoUrl?: string;
  commercialStatus?: string;
}

const workItems: WorkItem[] = [
  {
    id: "sawt-ai",
    name: "SAWT AI",
    category: "CUSTOM CLIENT BUILD",
    badgeColor: "bg-[#5E6AD2]/15 text-[#828FFF] border-[#5E6AD2]/35",
    subtitle: "Bilingual Arabic/English AI Survey & Analytics SaaS",
    description: "Architected and shipped a bilingual AI survey intelligence platform for the Saudi market. Integrated multi-LLM pipelines with structured response validation, MyFatoorah payment gateway, and RTL-first UX.",
    highlights: [
      "Multi-LLM pipeline orchestration across OpenAI, Gemini, Grok & Perplexity",
      "MyFatoorah subscription billing, webhooks & tier access control",
      "RTL-first Arabic/English localization with sub-second transitions",
      "Real-time CRM integration with Socket.IO & live SLA tracking"
    ],
    stack: ["Next.js", "Node.js", "Multi-LLM", "MyFatoorah", "Socket.IO", "TypeScript"],
    caseStudyUrl: "/projects",
    demoUrl: "https://cxisuite.com/",
  },
  {
    id: "omnexia-crm",
    name: "Omnexia CRM",
    category: "CUSTOM CLIENT BUILD",
    badgeColor: "bg-[#5E6AD2]/15 text-[#828FFF] border-[#5E6AD2]/35",
    subtitle: "Real-Time Event Stream CRM & SLA Tracking Dashboard",
    description: "Built a low-latency operations CRM for fast-moving customer service teams. Powered by Node.js, WebSockets, and Redis Pub/Sub to provide instant state synchronization across active agents.",
    highlights: [
      "Bi-directional state synchronization via Socket.IO & Redis Pub/Sub",
      "Live ticket queue with automated SLA breach timers",
      "Role-based authentication (RBAC) and audit logging",
      "High-density responsive dashboard views for desktop & tablet"
    ],
    stack: ["Node.js", "Socket.IO", "Redis", "React.js", "Tailwind CSS"],
    caseStudyUrl: "/projects",
  },
  {
    id: "careai-portal",
    name: "CareAI / CxiSuite Healthcare",
    category: "CUSTOM CLIENT BUILD",
    badgeColor: "bg-[#5E6AD2]/15 text-[#828FFF] border-[#5E6AD2]/35",
    subtitle: "Multi-Role Medical Operations & Patient Management Portal",
    description: "Solely owned the frontend architecture of a comprehensive multi-role healthcare SaaS from design through production release, handling administrative, doctor, clinic, and patient workflows.",
    highlights: [
      "4 distinct authentication portals (Super Admin, Doctor, Clinic, Patient)",
      "10+ operational CRUD modules for medical records & scheduling",
      "Interactive health metrics dashboards with data visualization",
      "Clean REST API integration with Node.js & MongoDB services"
    ],
    stack: ["React.js", "Node.js", "MongoDB", "REST APIs", "Tailwind CSS"],
    caseStudyUrl: "/projects",
    demoUrl: "https://www.nasyait.com/",
  },
  {
    id: "lumina-dental",
    name: "Lumina Dental Clinic",
    category: "COMMERCIAL WEBSITE TEMPLATE",
    badgeColor: "bg-white/[0.08] text-slate-300 border-white/15",
    subtitle: "Production-Ready Dental Clinic & Healthcare Web Platform",
    description: "A commercially available Next.js website template engineered for modern dental clinics and medical practices, featuring high-converting consultation booking and silky smooth micro-interactions.",
    highlights: [
      "Fluid appointment consultation workflow with multi-step validation",
      "Hardware-accelerated GSAP & Framer Motion micro-interactions",
      "Interactive Before/After smile comparison slider module",
      "100% PageSpeed performance score with Core Web Vitals optimization"
    ],
    stack: ["Next.js", "GSAP", "Tailwind CSS", "TypeScript"],
    caseStudyUrl: "/templates/lumina-dental-premium-dental-website-template",
    commercialStatus: "Available with Commercial License ($39)",
  },
  {
    id: "apex-luxury",
    name: "Apex Luxury Real Estate",
    category: "COMMERCIAL WEBSITE TEMPLATE",
    badgeColor: "bg-white/[0.08] text-slate-300 border-white/15",
    subtitle: "Ultra-Luxury Real Estate & Architectural Discovery Platform",
    description: "A premium commercial template engineered for high-end luxury real estate agencies and architectural firms, featuring interactive property map discovery and multi-currency pricing.",
    highlights: [
      "Interactive property showcase with dynamic map filtering",
      "Refined architectural aesthetic with champagne & obsidian tones",
      "Multilingual readiness (English, Spanish, German)",
      "Multi-currency conversion and responsive mobile-first views"
    ],
    stack: ["Next.js", "Framer Motion", "Tailwind CSS", "TypeScript"],
    caseStudyUrl: "/templates/apex-luxury-ultra-luxury-real-estate-and-architectural-web-template",
    commercialStatus: "Available with Commercial License ($49)",
  }
];
---

<section id="work" class="py-20 sm:py-28 bg-[#090A0F] text-white border-b border-white/[0.08]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.05] border border-white/10 text-[11px] font-mono font-semibold text-[#828FFF] uppercase tracking-[0.16em] mb-4">
        // FEATURED WORK &amp; ASSETS
      </div>
      <h2 class="font-grotesk font-extrabold text-3xl sm:text-4xl md:text-5xl text-white tracking-[-0.035em] leading-tight">
        Real Production Systems. Verifiable Engineering.
      </h2>
      <p class="text-sm sm:text-base md:text-lg text-slate-300 mt-4 leading-relaxed font-sans">
        We showcase real software platforms engineered for real production traffic. In our portfolio, we explicitly distinguish between custom client software developments and our commercially available web templates.
      </p>
    </div>

    <!-- Category Legend Bar -->
    <div class="mb-8 p-4 rounded-2xl bg-white/[0.03] border border-white/[0.08] flex flex-wrap items-center justify-between gap-4 text-xs font-mono text-slate-300">
      <div class="flex flex-wrap items-center gap-4">
        <span class="inline-flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-[#828FFF]"></span>
          <strong class="text-white">Custom Client Builds:</strong> Bespoke architectures tailored for commercial client operations.
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
          <strong class="text-white">Commercial Templates:</strong> Pre-engineered, production-ready codebases available for purchase.
        </span>
      </div>
      <a href="/projects" class="text-[#828FFF] font-semibold hover:text-white transition-colors">
        View All Case Studies →
      </a>
    </div>

    <!-- 5 Showcase Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8">
      {workItems.map((item, idx) => {
        const isFeatured = idx === 0;
        const colSpan = isFeatured ? "lg:col-span-12" : "lg:col-span-6";
        const dir = isFeatured ? "center" : idx % 2 === 1 ? "left" : "right";

        return (
          <div 
            data-agency-dir={dir}
            class={`rounded-2xl bg-white/[0.03] hover:bg-white/[0.05] border border-white/[0.08] hover:border-[#828FFF]/40 p-6 sm:p-8 transition-all duration-300 flex flex-col justify-between ${colSpan}`}
          >
            <div>
              <!-- Top Category Badge & Name -->
              <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                <span class={`text-[10px] font-mono uppercase tracking-wider font-semibold px-3 py-1 rounded-full border ${item.badgeColor}`}>
                  {item.category}
                </span>
                {item.commercialStatus && (
                  <span class="text-xs font-mono font-semibold text-emerald-300 bg-emerald-500/15 border border-emerald-400/30 px-3 py-0.5 rounded-full">
                    {item.commercialStatus}
                  </span>
                )}
              </div>

              <!-- Project Title -->
              <h3 class="font-grotesk font-extrabold text-2xl sm:text-3xl text-white tracking-tight mb-1">
                {item.name}
              </h3>
              <p class="text-xs sm:text-sm font-mono text-[#828FFF] font-medium mb-4">
                {item.subtitle}
              </p>

              <!-- Description -->
              <p class="text-sm text-slate-300 leading-relaxed font-sans mb-6">
                {item.description}
              </p>

              <!-- Highlights -->
              <div class="mb-6 space-y-2">
                <span class="text-[11px] font-mono uppercase tracking-wider text-slate-300 font-semibold block">
                  Key Technical Features:
                </span>
                <ul class="space-y-1.5 text-xs text-slate-300 font-sans">
                  {item.highlights.map((point) => (
                    <li class="flex items-start gap-2">
                      <span class="text-[#828FFF] font-bold mt-0.5 select-none font-mono">→</span>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- Bottom: Tech Stack & Action Links -->
            <div class="pt-5 border-t border-white/[0.08] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="flex flex-wrap gap-1.5">
                {item.stack.map((tech) => (
                  <span class="text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-white/[0.04] border border-white/10 text-slate-300">
                    {tech}
                  </span>
                ))}
              </div>

              <div class="flex items-center gap-3 shrink-0">
                <a
                  href={item.caseStudyUrl}
                  class="inline-flex items-center gap-1.5 text-xs font-grotesk font-bold text-white hover:text-[#828FFF] transition-colors"
                >
                  <span>{item.category.includes('TEMPLATE') ? 'Template Details' : 'Case Study'}</span>
                  <span>↗</span>
                </a>
                {item.demoUrl && (
                  <a
                    href={item.demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/[0.06] border border-white/15 text-xs font-mono font-medium text-slate-200 hover:bg-white/15 transition-all"
                  >
                    <span>Live Site</span>
                    <span class="text-slate-400">↗</span>
                  </a>
                )}
              </div>
            </div>

          </div>
        );
      })}
    </div>

    <!-- Bottom Archive Action -->
    <div class="mt-12 text-center">
      <p class="text-xs font-mono text-slate-400 mb-4">
        Need a custom build similar to these, or looking to customize a commercial template?
      </p>
      <div class="inline-flex flex-wrap items-center justify-center gap-3">
        <a
          href="#contact"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white text-[#090A0F] font-grotesk font-bold text-xs uppercase tracking-wider hover:bg-slate-200 transition-all"
        >
          <span>Discuss Your Architecture With Us</span>
          <span>→</span>
        </a>
        <a
          href="/templates"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white/[0.05] border border-white/15 text-white font-grotesk font-bold text-xs uppercase tracking-wider hover:bg-white/10 transition-all"
        >
          <span>Browse All Templates</span>
          <span>↗</span>
        </a>
      </div>
    </div>

  </div>
</section>

