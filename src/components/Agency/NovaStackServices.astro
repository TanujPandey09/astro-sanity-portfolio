---
// NovaStack Services Section: Sanity-Configurable Services & Custom Mockups + Interactive Fallbacks
// Unified Obsidian Monochrome + Linear Indigo (#5E6AD2)
import { optimizeSanityImage } from "../../lib/optimizeImage";

interface SanityServiceInput {
  _key?: string;
  serviceKey?: string;
  title?: string;
  category?: string;
  description?: string;
  mockupCaption?: string;
  mockupBadge?: string;
  mockupImage?: {
    alt?: string;
    asset?: { url?: string };
  };
}

interface Props {
  sanityServices?: SanityServiceInput[];
}

const { sanityServices = [] } = Astro.props;

interface ServiceItem {
  id: string;
  num: string;
  title: string;
  category: string;
  iconKey: string;
  builtinMockupKey: string;
  description: string;
  customMockupUrl?: string;
  customMockupAlt?: string;
  customMockupCaption?: string;
  customMockupBadge?: string;
}

const defaultServices: ServiceItem[] = [
  {
    id: "web-dev",
    num: "01",
    title: "Web Design & Development",
    category: "High-Performance Websites & Web Apps",
    iconKey: "web",
    builtinMockupKey: "web-dev",
    description:
      "Fast, conversion-focused websites built with Next.js 15, Astro, and headless Sanity CMS. 99+ Core Web Vitals and effortless team publishing.",
  },
  {
    id: "saas-dev",
    num: "02",
    title: "SaaS & Full-Stack Development",
    category: "Web Software, Portals & MVPs",
    iconKey: "saas",
    builtinMockupKey: "saas-dev",
    description:
      "Production multi-tenant software: PostgreSQL schemas, role-based access control (RBAC), and automated Stripe billing—shipped in 4–8 weeks.",
  },
  {
    id: "ai-automation",
    num: "03",
    title: "AI Integrations & Automation",
    category: "RAG Pipelines & Autonomous Agents",
    iconKey: "ai",
    builtinMockupKey: "ai-automation",
    description:
      "Embed Claude, OpenAI, and Gemini into real workflows: private vector RAG retrieval, tool-calling agents, and automated CRM/webhook sync.",
  },
  {
    id: "html-email",
    num: "04",
    title: "Email Design Systems & HTML",
    category: "Production Email Engineering",
    iconKey: "email",
    builtinMockupKey: "html-email",
    description:
      "Modular, bulletproof HTML email systems tested across 50+ clients including Outlook 365, Gmail, and Apple Mail Dark Mode. 100% table layout.",
  },
];

const iconForServiceKey = (key?: string): string => {
  if (key === "web-dev") return "web";
  if (key === "saas-dev") return "saas";
  if (key === "ai-automation") return "ai";
  if (key === "html-email") return "email";
  return "custom";
};

// If the user configured `agencyServices` in Sanity Studio, use that list cleanly;
// otherwise render the 4 built-in studio services.
const servicesData: ServiceItem[] =
  Array.isArray(sanityServices) && sanityServices.length > 0
    ? sanityServices.map((s, idx) => {
        const key = s?.serviceKey || "custom";
        const fallback = defaultServices.find((d) => d.id === key);
        const rawImg = s?.mockupImage?.asset?.url || "";
        return {
          id: s?._key || `${key}-${idx}`,
          num: String(idx + 1).padStart(2, "0"),
          title: s?.title || fallback?.title || "Engineering Service",
          category: s?.category || fallback?.category || "Custom Capability",
          iconKey: iconForServiceKey(key),
          builtinMockupKey: fallback ? fallback.builtinMockupKey : "custom",
          description: s?.description || fallback?.description || "",
          customMockupUrl: rawImg ? optimizeSanityImage(rawImg, 1200, 88) : undefined,
          customMockupAlt: s?.mockupImage?.alt || s?.title || "Service mockup preview",
          customMockupCaption: s?.mockupCaption || s?.category || s?.title || "Live Deliverable Preview",
          customMockupBadge: s?.mockupBadge || "Production Ready",
        };
      })
    : defaultServices;

const initialActiveId = servicesData[0]?.id || "web-dev";
---

<section id="services" class="py-16 sm:py-24 bg-[#F4F4F5] text-[#09090B] border-b border-[#E4E4E7] relative overflow-hidden">
  
  <!-- Subtle Architectural Grid -->
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,#E4E4E7_1px,transparent_1px),linear-gradient(to_bottom,#E4E4E7_1px,transparent_1px)] bg-[size:48px_48px] opacity-35"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="max-w-2xl mb-10 sm:mb-14">
      <div class="flex items-center gap-2.5 text-[11px] font-mono font-semibold text-[#5E6AD2] uppercase tracking-[0.18em] mb-3">
        <span class="w-5 h-px bg-[#5E6AD2]"></span>
        <span>01 / Core Capabilities</span>
      </div>
      <h2 class="font-grotesk font-extrabold text-3xl sm:text-4xl lg:text-5xl text-[#09090B] tracking-[-0.035em] leading-[1.08]">
        Focused Engineering, Built for Production.
      </h2>
      <p class="text-sm sm:text-base text-[#52525B] mt-3 leading-relaxed font-sans max-w-xl">
        Core disciplines engineered with strict TypeScript, measurable performance, and zero bloated handoffs.
      </p>
    </div>

    <!-- Main Split Showcase Stage (Left 5 cols, Right 7 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-center">
      
      <!-- Left Column: Services Navigator -->
      <div class="lg:col-span-5 space-y-2.5" role="tablist" aria-label="NovaStack Services">
        {servicesData.map((service) => {
          const isInitialActive = service.id === initialActiveId;

          return (
            <div
              data-service-item={service.id}
              role="tab"
              aria-selected={isInitialActive ? "true" : "false"}
              tabindex="0"
              class={`service-item-wrapper rounded-2xl cursor-pointer select-none transition-all duration-300 ${
                isInitialActive
                  ? "bg-white border border-[#5E6AD2]/40 p-4 sm:p-5 shadow-sm ring-1 ring-[#5E6AD2]/15"
                  : "p-3.5 sm:p-4 border border-transparent hover:bg-white/75 hover:border-[#E4E4E7]"
              }`}
            >
              <div class="flex items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  <div
                    class={`service-icon-badge w-9 h-9 rounded-xl flex items-center justify-center shrink-0 border transition-colors duration-200 ${
                      isInitialActive
                        ? "bg-[#EEF0FB] text-[#5E6AD2] border-[#D5D9F5]"
                        : "bg-white text-[#52525B] border-[#E4E4E7]"
                    }`}
                  >
                    {service.iconKey === "web" && (
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                        <line x1="8" y1="21" x2="16" y2="21"></line>
                        <line x1="12" y1="17" x2="12" y2="21"></line>
                        <path d="m7 8 2 2-2 2"></path>
                        <path d="M12 12h2"></path>
                      </svg>
                    )}

                    {service.iconKey === "saas" && (
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                        <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                        <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                        <path d="M12 12v9"></path>
                      </svg>
                    )}

                    {service.iconKey === "ai" && (
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2v4"></path>
                        <path d="M12 18v4"></path>
                        <path d="M4.93 4.93l2.83 2.83"></path>
                        <path d="M16.24 16.24l2.83 2.83"></path>
                        <path d="M2 12h4"></path>
                        <path d="M18 12h4"></path>
                        <path d="M4.93 19.07l2.83-2.83"></path>
                        <path d="M16.24 7.76l2.83-2.83"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                      </svg>
                    )}

                    {service.iconKey === "email" && (
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                      </svg>
                    )}

                    {service.iconKey === "custom" && (
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                        <polyline points="2 17 12 22 22 17"></polyline>
                        <polyline points="2 12 12 17 22 12"></polyline>
                      </svg>
                    )}
                  </div>

                  <div>
                    <h3 class="font-grotesk font-bold text-sm sm:text-base text-[#09090B] tracking-tight">
                      {service.title}
                    </h3>
                    <span class="text-[10px] font-mono text-[#71717A] block">
                      {service.category}
                    </span>
                  </div>
                </div>

                <span
                  class={`service-num-label text-[11px] font-mono font-semibold transition-colors ${
                    isInitialActive ? "text-[#5E6AD2]" : "text-[#A1A1AA]"
                  }`}
                >
                  {service.num}
                </span>
              </div>

              <div class={`service-details-panel mt-3 pl-12 ${isInitialActive ? "block" : "hidden"}`}>
                <p class="text-xs text-[#52525B] font-sans leading-relaxed">
                  {service.description}
                </p>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Right Column: Sanity Custom Mockup Image OR Built-In Interactive Deliverable Stage -->
      <div class="lg:col-span-7">
        <div
          id="mockup-stage-container"
          class="rounded-[24px] sm:rounded-[28px] border border-[#E4E4E7] bg-white p-4 sm:p-6 shadow-sm relative overflow-hidden min-h-[420px] sm:min-h-[460px] flex items-center justify-center"
        >
          <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(#D4D4D8_1px,transparent_1px)] bg-[size:20px_20px] opacity-40"></div>
          <div class="pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-80 h-80 bg-[#5E6AD2]/[0.06] blur-[90px] rounded-full"></div>

          {servicesData.map((service) => {
            const isInitialActive = service.id === initialActiveId;

            return (
              <div
                data-mockup-panel={service.id}
                class={`mockup-display-panel relative z-10 w-full max-w-xl transition-all duration-400 ease-out ${isInitialActive ? "" : "hidden"}`}
              >
                {/* CASE A: Custom Mockup Image uploaded in Sanity Studio — Rendered Cleanly Without Double Frame */}
                {service.customMockupUrl ? (
                  <div class="mockup-3d-stage select-none">
                    <div class="rounded-2xl overflow-hidden bg-white shadow-[0_18px_42px_-16px_rgba(9,9,11,0.16)] ring-1 ring-black/[0.06]">
                      <img
                        src={service.customMockupUrl}
                        alt={service.customMockupAlt}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-auto block object-contain"
                      />
                    </div>
                  </div>
                ) : service.builtinMockupKey === "web-dev" ? (
                  /* BUILT-IN MOCKUP 1: WEB DESIGN & DEVELOPMENT */
                  <div class="mockup-3d-stage space-y-2.5 select-none">
                    <div class="rounded-2xl bg-white border border-[#E4E4E7] shadow-[0_14px_32px_-12px_rgba(9,9,11,0.12)] overflow-hidden">
                      <div class="px-3.5 py-2 bg-[#FAFAFA] border-b border-[#E4E4E7] flex items-center justify-between gap-2">
                        <div class="flex items-center gap-1.5">
                          <span class="w-2.5 h-2.5 rounded-full bg-zinc-300"></span>
                          <span class="w-2.5 h-2.5 rounded-full bg-zinc-300"></span>
                          <span class="w-2.5 h-2.5 rounded-full bg-zinc-300"></span>
                        </div>
                        <div class="flex-1 max-w-[260px] mx-auto px-3 py-1 rounded-md bg-white border border-[#E4E4E7] text-[10px] font-mono text-[#71717A] flex items-center justify-between">
                          <span class="truncate">https://acme-global.dev</span>
                          <span class="text-emerald-600 font-bold text-[9px]">SSL ✓</span>
                        </div>
                        <div class="text-[9px] font-mono text-[#5E6AD2] bg-[#EEF0FB] px-2 py-0.5 rounded border border-[#D5D9F5] font-bold">
                          Next.js 15
                        </div>
                      </div>

                      <div class="p-3.5 space-y-2.5 bg-gradient-to-b from-white to-[#FAFAFA]">
                        <div class="p-3.5 rounded-xl bg-white border border-[#E4E4E7] space-y-2">
                          <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                              <div class="w-5 h-5 rounded-md bg-[#09090B] flex items-center justify-center text-white text-[9px] font-bold">A</div>
                              <span class="font-grotesk font-bold text-xs text-[#09090B]">Acme Global</span>
                            </div>
                            <span class="text-[9px] font-mono text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full font-bold">● Production Live</span>
                          </div>
                          <div class="space-y-1">
                            <h4 class="font-grotesk font-extrabold text-sm text-[#09090B] leading-tight">
                              Next-Gen Digital Platform Engineered to Scale
                            </h4>
                            <p class="text-[10px] text-[#52525B] font-sans leading-relaxed">
                              Sub-second load times, fluid responsive layout, and headless CMS publishing.
                            </p>
                          </div>
                          <div class="flex items-center gap-2 pt-0.5">
                            <span class="px-2.5 py-1 rounded-md bg-[#5E6AD2] text-white text-[9.5px] font-grotesk font-bold">
                              Explore Platform →
                            </span>
                            <span class="px-2.5 py-1 rounded-md bg-white border border-[#D4D4D8] text-[#09090B] text-[9.5px] font-grotesk font-medium">
                              Live Demo
                            </span>
                          </div>
                        </div>
                      </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-12 gap-2.5 items-stretch">
                      <div class="sm:col-span-7 rounded-2xl bg-white border border-[#E4E4E7] p-3 shadow-xs flex flex-col justify-between space-y-2">
                        <div class="flex items-center justify-between border-b border-[#F4F4F5] pb-1">
                          <span class="text-[9px] font-mono text-[#71717A] uppercase font-bold">Core Web Vitals</span>
                          <span class="text-[9px] font-mono text-emerald-700 font-bold bg-emerald-50 px-1.5 py-0.5 rounded">Passed 100/100</span>
                        </div>
                        <div class="grid grid-cols-4 gap-1.5 text-center">
                          {["Perf", "A11y", "Best", "SEO"].map((metric) => (
                            <div class="space-y-0.5">
                              <div class="w-8 h-8 rounded-full border-2 border-emerald-500 bg-emerald-50 flex items-center justify-center mx-auto text-emerald-700 font-grotesk font-bold text-xs">
                                100
                              </div>
                              <span class="text-[8px] font-mono text-[#71717A] block">{metric}</span>
                            </div>
                          ))}
                        </div>
                      </div>

                      <div class="sm:col-span-5 rounded-2xl bg-[#09090B] border border-white/10 p-3 shadow-xs text-white flex flex-col justify-between space-y-1.5">
                        <div class="flex items-center justify-between">
                          <span class="text-[8.5px] font-mono text-[#A5AEF3] uppercase font-bold tracking-wider">HEADLESS CMS</span>
                          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                        </div>
                        <div>
                          <span class="font-grotesk font-bold text-xs text-white block">Sanity Studio v3</span>
                          <p class="text-[9px] text-[#A1A1AA] font-sans leading-tight mt-0.5">
                            Real-time visual editing with instant edge publish.
                          </p>
                        </div>
                        <div class="pt-0.5 flex items-center justify-between text-[8.5px] font-mono text-[#A1A1AA]">
                          <span>TTFB: &lt;24ms</span>
                          <span class="text-emerald-400 font-bold">Mobile Ready</span>
                        </div>
                      </div>
                    </div>
                  </div>
                ) : service.builtinMockupKey === "saas-dev" ? (
                  /* BUILT-IN MOCKUP 2: SAAS & FULL-STACK DEVELOPMENT */
                  <div class="mockup-3d-stage space-y-2.5 select-none">
                    <div class="rounded-2xl bg-white border border-[#E4E4E7] shadow-[0_14px_32px_-12px_rgba(9,9,11,0.12)] overflow-hidden">
                      <div class="px-3.5 py-2 bg-[#FAFAFA] border-b border-[#E4E4E7] flex items-center justify-between gap-2">
                        <div class="flex items-center gap-1.5">
                          <span class="w-2.5 h-2.5 rounded-full bg-zinc-300"></span>
                          <span class="w-2.5 h-2.5 rounded-full bg-zinc-300"></span>
                          <span class="w-2.5 h-2.5 rounded-full bg-zinc-300"></span>
                        </div>
                        <div class="flex-1 max-w-[260px] mx-auto px-3 py-1 rounded-md bg-white border border-[#E4E4E7] text-[10px] font-mono text-[#71717A] flex items-center justify-between">
                          <span class="truncate">app.cloudscale.io/admin/org</span>
                          <span class="text-emerald-600 font-bold text-[9px]">Postgres 16 ✓</span>
                        </div>
                        <div class="text-[9px] font-mono text-[#5E6AD2] bg-[#EEF0FB] px-2 py-0.5 rounded border border-[#D5D9F5] font-bold">
                          us-east-1
                        </div>
                      </div>

                      <div class="p-3.5 space-y-2.5 bg-gradient-to-b from-white to-[#FAFAFA]">
                        <div class="grid grid-cols-2 gap-2.5">
                          <div class="p-2.5 rounded-xl bg-white border border-[#E4E4E7] space-y-1">
                            <div class="flex items-center justify-between">
                              <span class="text-[9px] font-mono text-[#71717A]">Monthly Revenue</span>
                              <span class="text-[9px] font-mono text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded font-bold">+24.2%</span>
                            </div>
                            <div class="flex items-baseline gap-1.5">
                              <span class="font-grotesk font-extrabold text-lg text-[#09090B]">$42,850</span>
                              <span class="text-[9.5px] font-mono text-[#71717A]">MRR</span>
                            </div>
                            <div class="h-1.5 w-full bg-[#F4F4F5] rounded-full overflow-hidden">
                              <div class="h-full bg-[#5E6AD2] rounded-full w-[82%]"></div>
                            </div>
                          </div>

                          <div class="p-2.5 rounded-xl bg-white border border-[#E4E4E7] space-y-1">
                            <div class="flex items-center justify-between">
                              <span class="text-[9px] font-mono text-[#71717A]">Subscriptions</span>
                              <span class="text-[9px] font-mono text-[#5E6AD2] bg-[#EEF0FB] px-1.5 py-0.5 rounded font-bold">Stripe Live</span>
                            </div>
                            <div class="flex items-baseline gap-1.5">
                              <span class="font-grotesk font-extrabold text-lg text-[#09090B]">1,842</span>
                              <span class="text-[9.5px] font-mono text-[#71717A]">seats</span>
                            </div>
                            <div class="h-1.5 w-full bg-[#F4F4F5] rounded-full overflow-hidden">
                              <div class="h-full bg-emerald-500 rounded-full w-[90%]"></div>
                            </div>
                          </div>
                        </div>

                        <div class="p-3 rounded-xl bg-white border border-[#E4E4E7] space-y-2">
                          <div class="flex items-center justify-between border-b border-[#F4F4F5] pb-1.5">
                            <div class="flex items-center gap-2">
                              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                              <span class="font-grotesk font-bold text-xs text-[#09090B]">Role-Based Access Control (RBAC)</span>
                            </div>
                            <span class="text-[9px] font-mono text-[#71717A] bg-[#F4F4F5] px-2 py-0.5 rounded">org_live_902</span>
                          </div>
                          <div class="space-y-1.5 text-xs font-sans">
                            <div class="flex items-center justify-between p-1.5 px-2 rounded-lg bg-[#FAFAFA] border border-[#E4E4E7]">
                              <div class="flex items-center gap-2">
                                <span class="w-4 h-4 rounded-full bg-[#5E6AD2] text-white flex items-center justify-center text-[8.5px] font-bold">A</span>
                                <span class="font-medium text-[#09090B] text-[11px]">SuperAdmin (Alex Chen)</span>
                              </div>
                              <span class="text-[8.5px] font-mono bg-[#EEF0FB] text-[#5E6AD2] px-1.5 py-0.5 rounded font-bold">Full Access &amp; Billing</span>
                            </div>
                            <div class="flex items-center justify-between p-1.5 px-2 rounded-lg bg-[#FAFAFA] border border-[#E4E4E7]">
                              <div class="flex items-center gap-2">
                                <span class="w-4 h-4 rounded-full bg-[#09090B] text-white flex items-center justify-center text-[8.5px] font-bold">E</span>
                                <span class="font-medium text-[#09090B] text-[11px]">Product Engineer</span>
                              </div>
                              <span class="text-[8.5px] font-mono bg-[#F4F4F5] text-[#52525B] px-1.5 py-0.5 rounded">PostgreSQL R/W · API Keys</span>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-12 gap-2.5 items-stretch">
                      <div class="sm:col-span-7 rounded-2xl bg-[#09090B] border border-white/10 p-3 shadow-xs text-white flex flex-col justify-between space-y-1.5">
                        <div class="flex items-center justify-between">
                          <span class="text-[8.5px] font-mono text-[#A5AEF3] uppercase font-bold tracking-wider">STRIPE WEBHOOK STREAM</span>
                          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        </div>
                        <div class="font-mono text-[9.5px] space-y-1 text-zinc-300">
                          <div class="flex items-center justify-between">
                            <span class="text-emerald-400">● invoice.payment_succeeded</span>
                            <span class="text-zinc-400">$1,400.00</span>
                          </div>
                          <div class="flex items-center justify-between text-zinc-500 text-[9px]">
                            <span>customer.subscription.created</span>
                            <span>200 OK · 1.2s ago</span>
                          </div>
                        </div>
                      </div>

                      <div class="sm:col-span-5 rounded-2xl bg-white border border-[#E4E4E7] p-3 shadow-xs flex flex-col justify-between space-y-1.5">
                        <span class="text-[8.5px] font-mono text-[#71717A] uppercase font-bold">DATABASE</span>
