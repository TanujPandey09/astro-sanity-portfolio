---
export const prerender = false;

import { useSanityClient, groq } from "astro-sanity";
import { fallbackSanityClient } from "../../lib/sanityClient.js";
import ProjectDetails from "../../components/ProjectsLayout/ProjectDetails.astro";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const query = groq`*[_type == "projects" && defined(slug.current)]{
    ...,
    FeatureImage{
      asset->{
        url
      }
    },
    BackgroundImage{
      asset->{
        url
      }
    },
    demoVideo{
      asset->{
        url
      }
    }
  }`;

  let projects: any[] = [];
  try {
    projects = await useSanityClient().fetch(query);
    if (!Array.isArray(projects) || projects.length === 0) {
      projects = await fallbackSanityClient.fetch(query);
    }
  } catch {
    try {
      projects = await fallbackSanityClient.fetch(query);
    } catch {
      projects = [];
    }
  }

  return (projects || [])
    .filter((item) => item?.slug?.current)
    .map((item) => ({
      params: { slug: String(item.slug.current).replace(/^\/+|\/+$/g, "") },
      props: {
        detailsData: item,
      },
    }));
}

const rawSlug = Astro.params.slug || "";
const cleanSlug = rawSlug.replace(/^\/+|\/+$/g, "");

const projectQuery = groq`*[_type == "projects" && slug.current == $slug][0]{
  ...,
  FeatureImage{
    asset->{
      url
    }
  },
  BackgroundImage{
    asset->{
      url
    }
  },
  demoVideo{
    asset->{
      url
    }
  },
}`;

let detailsData: any = Astro.props?.detailsData || null;
if (!detailsData) {
  try {
    detailsData = await useSanityClient().fetch(projectQuery, { slug: cleanSlug });
    if (!detailsData) {
      detailsData = await fallbackSanityClient.fetch(projectQuery, { slug: cleanSlug });
    }
  } catch (err) {
    try {
      detailsData = await fallbackSanityClient.fetch(projectQuery, { slug: cleanSlug });
    } catch (fallbackErr) {
      console.error("Failed to fetch project details:", fallbackErr);
    }
  }
}

if (!detailsData) {
  return Astro.redirect("/projects");
}

// Extract a plain text description from Portable Text for SEO
const projectDescription =
  detailsData?.excerpt?.[0]?.children?.[0]?.text ||
  "View the complete engineering case study for this production platform built with modern web architecture.";

const siteUrl = "https://tanujbuilds.site";
const slug = String(detailsData?.slug?.current || cleanSlug).replace(/^\/+|\/+$/g, "");
const canonicalURL = `${siteUrl}/projects/${slug}`;
const ogImage =
  detailsData?.BackgroundImage?.asset?.url ||
  detailsData?.FeatureImage?.asset?.url;
const demoUrl =
  typeof detailsData?.demoLink === "string"
    ? detailsData.demoLink
    : detailsData?.demoLink?.current;
const githubUrl =
  typeof detailsData?.gitHubLink === "string"
    ? detailsData.gitHubLink
    : detailsData?.gitHubLink?.current;
const gumroadUrl =
  typeof detailsData?.gumroadLink === "string"
    ? detailsData.gumroadLink
    : detailsData?.gumroadLink?.current;

const projectJsonLd = {
  "@type": "SoftwareApplication",
  "@id": `${canonicalURL}#project`,
  name: detailsData?.projectName,
  description: projectDescription,
  applicationCategory: "WebApplication",
  operatingSystem: "Web",
  url: demoUrl || canonicalURL,
  author: { "@type": "Person", "@id": `${siteUrl}/#person`, name: "Tanuj Pandey" },
  publisher: { "@type": "Person", "@id": `${siteUrl}/#person`, name: "Tanuj Pandey" },
  mainEntityOfPage: { "@id": `${canonicalURL}#webpage` },
  ...(ogImage ? { image: ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage}` } : {}),
  ...(githubUrl ? { codeRepository: githubUrl } : {}),
  ...(gumroadUrl
    ? {
        offers: {
          "@type": "Offer",
          url: gumroadUrl,
          availability: "https://schema.org/InStock",
        },
      }
    : {}),
  ...(detailsData?.tags?.length ? { keywords: detailsData.tags.join(", ") } : {}),
  ...(detailsData?._createdAt ? { dateCreated: detailsData._createdAt } : {}),
  ...(detailsData?._updatedAt ? { dateModified: detailsData._updatedAt } : {}),
};

const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Projects", path: "/projects" },
  { name: detailsData?.projectName || "Project", path: `/projects/${slug}` },
];
---

<Layout
  title={`${detailsData?.projectName} — Case Study | Tanuj Pandey`}
  description={projectDescription}
  image={ogImage}
  breadcrumbs={breadcrumbs}
  jsonLd={projectJsonLd}
>
  <ProjectDetails detailsData={detailsData} />
</Layout>
