---
import SectionHeader from "./SectionHeader.astro";

const phases = [
  {
    step: "01",
    name: "Discover",
    tagline: "Architecture & System Scoping",
    desc: "Before touching application code, we define the technical blueprint: data models, relational database schemas, multi-LLM workflows, API contracts, and milestone deliverables. This eliminates mid-sprint pivots and ensures zero architectural ambiguity.",
    thumb: "https://images.unsplash.com/photo-1531403009284-440f080d1e12?auto=format&fit=crop&w=400&q=80"
  },
  {
    step: "02",
    name: "Build",
    tagline: "Full-Stack & AI Engineering",
    desc: "Development proceeds in rapid, transparent weekly cycles. I ship strict TypeScript interfaces, Node.js microservices, and validated AI orchestration pipelines. You receive live staging preview links on every pull request for immediate testing.",
    thumb: "https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=400&q=80"
  },
  {
    step: "03",
    name: "Polish & Scale",
    tagline: "Performance QA & Production Release",
    desc: "Every build undergoes rigorous verification: 99+ Lighthouse performance tuning, mobile responsiveness, RBAC security audits, and zero-downtime CI/CD deployment. Clean documentation and handoff ensure your engineers can scale it effortlessly.",
    thumb: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=400&q=80"
  }
];

const faqs = [
  {
    q: "What is your primary engineering stack?",
    a: "My daily production stack is TypeScript, React.js, Next.js (App Router & SSR), Node.js, Express, PostgreSQL/MongoDB, and Socket.IO. For AI platforms, I orchestrate OpenAI, Gemini, Claude, and Perplexity with structured schema validation and contextual RAG."
  },
  {
    q: "Are you available for full-time remote roles or contract builds?",
    a: "Yes. I work with founders on end-to-end MVP/SaaS builds and collaborate with global engineering teams for senior full-stack and AI engineering roles."
  },
  {
    q: "How fast can a new product go from spec to production?",
    a: "Focused MVPs and AI platforms typically ship to production in 2 to 5 weeks. Architecture and API contracts are finalized in Days 1–3, followed by weekly shippable iterations with live staging previews."
  },
  {
    q: "What do your commercial website templates include?",
    a: "Every template (including Apex Luxury and Lumina Dental) includes the complete Next.js & TypeScript codebase, Tailwind CSS design system, GSAP/Framer animations, 99+ Lighthouse score, and a commercial license for unlimited projects."
  }
];
---

<section id="process" class="py-14 sm:py-16 lg:py-20 border-t border-black/[0.08] bg-canvas relative z-20">
  <div class="w-full max-w-7xl mx-auto">
    
    <!-- 1. UNIFIED SECTION HEADER -->
    <SectionHeader
      eyebrow="05 / Process"
      title="How a Project"
      gradientText="Runs."
      subtitle="A transparent three-stage engineering workflow from architectural scoping to zero-downtime production release."
    />

    <!-- 2. EDITORIAL NUMBERED LEDGER -->
    <div class="border-t border-black/[0.08] divide-y divide-black/[0.08]">
      {phases.map((phase) => (
        <div data-gsap-card class="py-8 sm:py-10 grid grid-cols-1 md:grid-cols-12 gap-5 sm:gap-8 items-start group">
          <!-- Step Number & Title -->
          <div class="md:col-span-3">
            <span class="font-mono text-xs font-semibold tracking-[0.12em] text-[#5E6AD2] block mb-1.5">STEP {phase.step}</span>
            <h3 class="font-grotesk text-2xl sm:text-[26px] font-bold text-[#0F172A] tracking-tight group-hover:text-[#5E6AD2] transition-colors">
              {phase.name}
            </h3>
            <span class="text-xs font-mono text-slate-500 mt-1 block">{phase.tagline}</span>
          </div>

          <!-- Embedded Process Thumbnail -->
          <div class="md:col-span-3">
            <div class="relative w-full aspect-[16/10] rounded-xl overflow-hidden border border-black/[0.08] bg-slate-100">
              <img
                src={phase.thumb}
                alt={phase.name}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover grayscale contrast-110 group-hover:grayscale-0 transition-all duration-500 ease-out group-hover:scale-105"
              />
            </div>
          </div>

          <!-- Description Narrative -->
          <div class="md:col-span-6 flex flex-col justify-center h-full">
            <p class="text-slate-600 font-sans text-sm sm:text-[15px] leading-[1.7]">
              {phase.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- 3. COMPACT COLLABORATION FIT BANNER -->
    <div class="my-12 sm:my-16 rounded-2xl bg-white border border-black/[0.08] p-6 sm:p-8 lg:p-10 shadow-xs grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-center">
      <div class="lg:col-span-4 space-y-2.5">
        <div class="flex items-center gap-2.5">
          <span class="w-5 h-px bg-[#5E6AD2]" aria-hidden="true"></span>
          <span class="text-xs font-mono uppercase tracking-[0.14em] text-[#5E6AD2] font-semibold">Collaboration Fit</span>
        </div>
        <h3 class="font-grotesk text-2xl sm:text-3xl font-bold text-[#0F172A] tracking-tight leading-tight">
          Who I work best with.
        </h3>
      </div>

      <div class="lg:col-span-8 space-y-3 border-t lg:border-t-0 lg:border-l border-black/[0.08] pt-5 lg:pt-0 lg:pl-8">
        <p class="text-slate-700 font-sans text-sm sm:text-base leading-[1.7] font-medium">
          I partner with ambitious founders, early-stage to Series B startups, and product teams that value engineering rigor, clean architecture, and velocity.
        </p>
        <p class="text-slate-600 font-sans text-sm leading-[1.7]">
          Whether you need a complete SaaS platform built from scratch, multi-LLM orchestration integrated into an existing product, or a senior engineer to own and scale your web architecture, I bridge design nuance with backend reliability.
        </p>
      </div>
    </div>

    <!-- 4. FAQ: "What you might ask" (Clean Accordion) -->
    <div id="faq" class="pt-10 sm:pt-12 border-t border-black/[0.08]">
      <div class="mb-6 sm:mb-8">
        <div class="flex items-center gap-2.5 mb-2.5">
          <span class="w-5 h-px bg-[#5E6AD2]" aria-hidden="true"></span>
          <span class="text-xs font-mono uppercase tracking-[0.14em] text-[#5E6AD2] font-semibold">Common Questions</span>
        </div>
        <h3 class="font-grotesk font-bold text-2xl sm:text-3xl md:text-4xl text-[#0F172A] tracking-tight">
          What you might ask.
        </h3>
      </div>

      <div class="border-t border-black/[0.08]" id="faq-accordion">
        {faqs.map((item, idx) => {
          const isFirst = idx === 0;
          return (
            <div 
              class={`faq-item border-b border-black/[0.08] transition-colors ${isFirst ? 'is-open bg-slate-50/60' : 'hover:bg-slate-50/40'}`}
              data-faq-item={idx}
            >
              <button
                type="button"
                aria-expanded={isFirst ? "true" : "false"}
                aria-controls={`faq-panel-${idx}`}
                data-faq-trigger={idx}
                class="w-full text-left py-5 sm:py-6 px-2 sm:px-4 flex items-center justify-between gap-6 cursor-pointer focus:outline-none group"
              >
                <div class="flex items-baseline gap-4 sm:gap-6 min-w-0">
                  <span class="font-mono text-xs text-accent-primary font-bold tabular-nums shrink-0">
                    0{idx + 1}/
                  </span>
                  <span class="font-grotesk font-bold text-base sm:text-lg md:text-xl text-[#0F172A] group-hover:text-accent-primary transition-colors tracking-tight">
                    {item.q}
                  </span>
                </div>
                <div class="w-7 h-7 rounded-full border border-black/10 flex items-center justify-center shrink-0 group-hover:border-accent-primary transition-colors">
                  <span class="faq-icon font-mono text-sm font-semibold text-slate-600 group-hover:text-accent-primary transition-transform duration-300">
                    {isFirst ? '−' : '+'}
                  </span>
                </div>
              </button>

              <div
                id={`faq-panel-${idx}`}
                role="region"
                aria-labelledby={`faq-trigger-${idx}`}
                class={`faq-content px-2 sm:px-4 pb-6 transition-all duration-300 ${isFirst ? 'block' : 'hidden'}`}
              >
                <div class="pl-8 sm:pl-11 pr-4">
                  <p class="text-xs sm:text-sm md:text-base text-slate-600 leading-relaxed font-sans max-w-3xl">
                    {item.a}
                  </p>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- 5. MY GUARANTEE -->
    <div class="mt-16 sm:mt-24 pt-10 sm:pt-14 border-t border-black/[0.08] grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
      <div class="md:col-span-4">
        <h4 class="font-grotesk text-xl font-bold text-[#0F172A] tracking-tight">My Guarantee</h4>
        <span class="text-xs font-mono text-slate-600 mt-1 block">Engineering Integrity</span>
      </div>
      <div class="md:col-span-8 space-y-3 text-sm text-slate-600 font-sans leading-relaxed">
        <p>
          I take complete single-engineer ownership of every architecture I build: direct communication, weekly shippable progress, zero handoff bottlenecks, and strict type-safe code that your team can run and scale with confidence.
        </p>
      </div>
    </div>

  </div>
</section>

<script>
  function setupFaq() {
    const container = document.getElementById('faq-accordion');
    if (!container) return;

    const items = container.querySelectorAll('.faq-item');
    items.forEach((item) => {
      const trigger = item.querySelector('[data-faq-trigger]');
      const content = item.querySelector('.faq-content');
      const icon = item.querySelector('.faq-icon');
      if (!trigger || !content || !icon) return;

      trigger.addEventListener('click', () => {
        const isOpen = item.classList.contains('is-open');

        // Close all items
        items.forEach((other) => {
          other.classList.remove('is-open', 'bg-slate-50/60');
          const otherTrigger = other.querySelector('[data-faq-trigger]');
          const otherContent = other.querySelector('.faq-content');
          const otherIcon = other.querySelector('.faq-icon');
          if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
          if (otherContent) otherContent.classList.add('hidden');
          if (otherIcon) otherIcon.textContent = '+';
        });

        // Toggle clicked item
        if (!isOpen) {
          item.classList.add('is-open', 'bg-slate-50/60');
          trigger.setAttribute('aria-expanded', 'true');
          content.classList.remove('hidden');
          icon.textContent = '−';
        }
      });
    });
  }

  setupFaq();
  document.addEventListener('astro:page-load', setupFaq);
</script>
