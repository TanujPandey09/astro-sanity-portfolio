---
import SectionHeader from "./SectionHeader.astro";

const phases = [
  {
    step: "01",
    cadence: "Days 1 — 3",
    name: "Discover & Architect",
    tagline: "System Scoping & Blueprint",
    desc: "Before writing application code, we lock down the technical blueprint: data models, relational schemas, multi-LLM workflows, API contracts, and milestone deliverables.",
    outputs: ["DB Schema", "API Contracts", "Milestone Plan"],
  },
  {
    step: "02",
    cadence: "Weekly Sprints",
    name: "Build & Ship",
    tagline: "Full-Stack & AI Engineering",
    desc: "Development runs in transparent weekly cycles with strict TypeScript interfaces, Node.js services, validated AI pipelines, and live staging previews on every pull request.",
    outputs: ["Strict TypeScript", "Staging Previews", "AI Pipelines"],
  },
  {
    step: "03",
    cadence: "Launch & Scale",
    name: "Polish & Release",
    tagline: "Performance QA & Handover",
    desc: "Every build undergoes 99+ Lighthouse tuning, mobile responsiveness QA, RBAC security checks, zero-downtime CI/CD deployment, and clean repository documentation.",
    outputs: ["99+ Lighthouse", "Security Audit", "Full Handover"],
  }
];

const faqs = [
  {
    q: "What is your primary engineering stack?",
    a: "My daily production stack is TypeScript, React.js, Next.js (App Router & SSR), Node.js, Express, PostgreSQL/MongoDB, and Socket.IO. For AI platforms, I orchestrate OpenAI, Gemini, Claude, and Perplexity with structured schema validation and contextual RAG."
  },
  {
    q: "Are you available for full-time remote roles or contract builds?",
    a: "Yes. I work with founders on end-to-end MVP/SaaS builds and collaborate with global engineering teams for senior full-stack and AI engineering roles."
  },
  {
    q: "How fast can a new product go from spec to production?",
    a: "Focused MVPs and AI platforms typically ship to production in 2 to 5 weeks. Architecture and API contracts are finalized in Days 1–3, followed by weekly shippable iterations with live staging previews."
  },
  {
    q: "What do your commercial website templates include?",
    a: "Every template (including Apex Luxury and Lumina Dental) includes the complete Next.js & TypeScript codebase, Tailwind CSS design system, GSAP/Framer animations, 99+ Lighthouse score, and a commercial license for unlimited projects."
  }
];
---

<section id="process" class="py-14 sm:py-16 lg:py-20 border-t border-black/[0.08] bg-canvas relative z-20">
  <div class="w-full max-w-7xl mx-auto">
    
    <!-- 1. UNIFIED SECTION HEADER -->
    <SectionHeader
      eyebrow="05 / Process"
      title="How a Project"
      gradientText="Runs."
      subtitle="A transparent three-stage engineering workflow from architectural scoping to zero-downtime production release."
    />

    <!-- 2. ARCHITECTURAL 3-COLUMN PROCESS MATRIX (Zero Stock Photos) -->
    <div data-gsap-card class="rounded-2xl bg-white border border-black/[0.08] overflow-hidden shadow-xs">
      <div class="grid grid-cols-1 lg:grid-cols-3 divide-y lg:divide-y-0 lg:divide-x divide-black/[0.08]">
        {phases.map((phase, idx) => (
          <div class={`p-6 sm:p-8 flex flex-col justify-between gap-6 ${idx === 1 ? "bg-[#F8FAFF]" : "bg-white"}`}>
            <div class="space-y-4">
              <div class="flex items-center justify-between gap-3">
                <span class="inline-flex items-center gap-2 font-mono text-xs font-semibold text-[#5E6AD2]">
                  <span class="w-6 h-6 rounded-lg bg-[#5E6AD2]/10 border border-[#5E6AD2]/20 flex items-center justify-center">
                    {phase.step}
                  </span>
                  <span class="uppercase tracking-[0.12em]">{phase.cadence}</span>
                </span>
                <span class="text-[11px] font-mono text-slate-400">
                  Phase {phase.step}
                </span>
              </div>

              <div>
                <h3 class="font-grotesk text-xl sm:text-2xl font-bold text-[#0F172A] tracking-tight">
                  {phase.name}
                </h3>
                <span class="text-xs font-mono text-slate-500 mt-1 block">{phase.tagline}</span>
              </div>

              <p class="text-sm text-slate-600 font-sans leading-[1.7]">
                {phase.desc}
              </p>
            </div>

            <div class="pt-4 border-t border-black/[0.08] flex flex-wrap gap-1.5">
              {phase.outputs.map((out) => (
                <span class="px-2.5 py-0.5 rounded-full bg-white border border-black/[0.08] text-[11px] font-mono text-slate-700">
                  {out}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Integrated Collaboration Fit Footer Bar -->
      <div class="px-6 sm:px-8 py-5 bg-[#0A0B0E] text-white border-t border-white/10 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div class="space-y-1 max-w-3xl">
          <span class="text-[11px] font-mono uppercase tracking-[0.14em] text-[#828FFF] font-semibold block">
            Collaboration Fit
          </span>
          <p class="text-sm text-slate-200 font-sans leading-relaxed">
            Partnering with founders, Series A–B startups, and product teams that value engineering rigor, clean architecture, and weekly shippable velocity.
          </p>
        </div>
        <button
          type="button"
          data-open-contact
          class="shrink-0 inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white hover:bg-[#5E6AD2] text-[#0A0B0E] hover:text-white font-grotesk font-semibold text-xs uppercase tracking-wider transition-colors cursor-pointer self-start lg:self-auto"
        >
          <span>Discuss a Build</span>
          <span>↗</span>
        </button>
      </div>
    </div>

    <!-- 3. 2-COLUMN FAQ & SINGLE-ENGINEER GUARANTEE -->
    <div id="faq" class="mt-14 sm:mt-16 pt-12 sm:pt-14 border-t border-black/[0.08] grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
      <!-- Left: Sticky Title + Compact Guarantee Card -->
      <div class="lg:col-span-4 lg:sticky lg:top-24 space-y-6">
        <div>
          <div class="flex items-center gap-2.5 mb-2.5">
            <span class="w-5 h-px bg-[#5E6AD2]" aria-hidden="true"></span>
            <span class="text-xs font-mono uppercase tracking-[0.14em] text-[#5E6AD2] font-semibold">Common Questions</span>
          </div>
          <h3 class="font-grotesk font-bold text-2xl sm:text-3xl text-[#0F172A] tracking-tight">
            What you might ask.
          </h3>
        </div>

        <div class="rounded-2xl bg-white border border-black/[0.08] p-5 shadow-xs space-y-2.5">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span class="text-[11px] font-mono uppercase tracking-[0.12em] text-[#0F172A] font-semibold">
              Engineering Guarantee
            </span>
          </div>
          <p class="text-xs sm:text-[13px] text-slate-600 font-sans leading-relaxed">
            Direct single-engineer ownership on every architecture: weekly shippable progress, zero handoff bottlenecks, and strict type-safe code your team can scale with confidence.
          </p>
        </div>
      </div>

      <!-- Right: Crisp Smooth Accordion Card -->
      <div class="lg:col-span-8">
        <div class="rounded-2xl bg-white border border-black/[0.08] divide-y divide-black/[0.08] overflow-hidden shadow-xs" id="faq-accordion">
          {faqs.map((item, idx) => {
            const isFirst = idx === 0;
            return (
              <div 
                class={`faq-item transition-colors ${isFirst ? "is-open bg-[#F8FAFF]" : "hover:bg-slate-50/70"}`}
                data-faq-item={idx}
              >
                <button
                  type="button"
                  aria-expanded={isFirst ? "true" : "false"}
                  aria-controls={`faq-panel-${idx}`}
                  data-faq-trigger={idx}
                  class="w-full text-left py-5 px-5 sm:px-6 flex items-center justify-between gap-4 cursor-pointer focus:outline-none group"
                >
                  <div class="flex items-baseline gap-3.5 min-w-0">
                    <span class="font-mono text-xs text-[#5E6AD2] font-semibold tabular-nums shrink-0">
                      0{idx + 1}
                    </span>
                    <span class="font-grotesk font-bold text-base sm:text-lg text-[#0F172A] group-hover:text-[#5E6AD2] transition-colors tracking-tight">
                      {item.q}
                    </span>
                  </div>
                  <div class="w-7 h-7 rounded-full border border-black/10 bg-white flex items-center justify-center shrink-0 group-hover:border-[#5E6AD2] transition-colors">
                    <span class="faq-icon font-mono text-sm font-semibold text-slate-600 group-hover:text-[#5E6AD2]">
                      {isFirst ? "−" : "+"}
                    </span>
                  </div>
                </button>

                <div
                  id={`faq-panel-${idx}`}
                  role="region"
                  aria-labelledby={`faq-trigger-${idx}`}
                  class="faq-body grid transition-[grid-template-rows] duration-250 ease-out"
                  data-open={isFirst ? "true" : "false"}
                >
                  <div class="overflow-hidden">
                    <div class="px-5 sm:px-6 pb-5 pl-12 sm:pl-[52px]">
                      <p class="text-sm text-slate-600 leading-[1.7] font-sans">
                        {item.a}
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .faq-body {
    grid-template-rows: 0fr;
  }
  .faq-body[data-open="true"] {
    grid-template-rows: 1fr;
  }
</style>

<script>
  function setupFaq() {
    const container = document.getElementById('faq-accordion');
    if (!container) return;

    const items = container.querySelectorAll('.faq-item');
    items.forEach((item) => {
      const trigger = item.querySelector('[data-faq-trigger]');
      const body = item.querySelector('.faq-body');
      const icon = item.querySelector('.faq-icon');
      if (!trigger || !body || !icon || trigger.hasAttribute('data-bound')) return;
      trigger.setAttribute('data-bound', 'true');

      trigger.addEventListener('click', () => {
        const isOpen = item.classList.contains('is-open');

        items.forEach((other) => {
          other.classList.remove('is-open', 'bg-[#F8FAFF]');
          other.classList.add('hover:bg-slate-50/70');
          const otherTrigger = other.querySelector('[data-faq-trigger]');
          const otherBody = other.querySelector('.faq-body');
          const otherIcon = other.querySelector('.faq-icon');
          if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
          if (otherBody) otherBody.setAttribute('data-open', 'false');
          if (otherIcon) otherIcon.textContent = '+';
        });

        if (!isOpen) {
          item.classList.add('is-open', 'bg-[#F8FAFF]');
          item.classList.remove('hover:bg-slate-50/70');
          trigger.setAttribute('aria-expanded', 'true');
          body.setAttribute('data-open', 'true');
          icon.textContent = '−';
        }
      });
    });
  }

  setupFaq();
  document.addEventListener('astro:page-load', setupFaq);
  document.addEventListener('astro:after-swap', setupFaq);
</script>
