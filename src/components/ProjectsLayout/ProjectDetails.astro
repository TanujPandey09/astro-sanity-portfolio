---
const { detailsData } = Astro.props;
import { PortableText } from "astro-portabletext";
import PremiumBackground from "../PremiumBackground.astro";
import PortableTextImage from "../BlogLayout/PortableTextImage.astro";
import { optimizeSanityImage } from "../../lib/optimizeImage";
import { resolveDemoMedia } from "../../lib/videoEmbed";

const components = {
  type: {
    image: PortableTextImage
  }
};

const formattedDate = detailsData?._createdAt
  ? new Date(detailsData._createdAt).toLocaleDateString("en-US", { month: "short", year: "numeric" })
  : "Production";

const posterUrl = detailsData?.BackgroundImage?.asset?.url
  ? optimizeSanityImage(detailsData.BackgroundImage.asset.url, 1600, 85)
  : "";
const demoMedia = resolveDemoMedia(detailsData?.demoVideo?.asset?.url, detailsData?.demoVideoUrl);
---

<div class="relative min-h-screen selection:bg-accent-primary/30 overflow-hidden bg-canvas">
  <PremiumBackground />

  <main class="mx-auto w-full max-w-7xl px-4 md:px-6 lg:px-8 pt-28 pb-16 md:pt-36 md:pb-24 relative z-10">
    <!-- Breadcrumb / Meta -->
    <div class="mb-10 md:mb-14 flex items-center justify-between gap-4" data-aos="fade-down">
       <a href="/projects" class="group inline-flex items-center gap-2.5 text-xs font-mono text-text-muted hover:text-text-primary transition-colors">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 group-hover:-translate-x-1 transition-transform">
            <path d="M19 12H5m7-7-7 7 7 7"/>
          </svg>
          <span>All Case Studies</span>
       </a>
       <span class="text-xs font-mono text-text-dim">Case Study · {formattedDate}</span>
    </div>

    <!-- Project Identity -->
    <section class="max-w-7xl mx-auto mb-16 md:mb-24">
      <div class="flex flex-col gap-6 mb-12 md:mb-16" data-aos="fade-up">
         {detailsData?.category && (
           <span class="inline-flex items-center gap-2 self-start px-3 py-1 rounded-full bg-[#5E6AD2]/10 border border-[#5E6AD2]/25 text-[11px] font-mono uppercase tracking-[0.14em] text-[#5E6AD2] font-semibold">
             {detailsData.category}
           </span>
         )}
         <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-[#0F172A] tracking-tight leading-[1.08] m-0">
           {detailsData?.projectName}
         </h1>

         <!-- Excerpt / Case Study Summary -->
         {detailsData?.excerpt && (
           <div class="max-w-3xl text-base md:text-lg text-slate-600 leading-relaxed">
              <PortableText value={detailsData?.excerpt} components={components} />
           </div>
         )}

         <!-- Action and Tech Stack Row -->
         <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 pt-6 border-t border-black/[0.08]">
            <div class="flex flex-wrap gap-2">
               {detailsData?.tags?.map((tag: string) => (
                  <span class="px-3 py-1 rounded-md bg-slate-100 border border-black/[0.08] text-xs font-mono text-slate-700">
                     {tag}
                  </span>
               ))}
            </div>
            
            <div class="flex flex-wrap gap-3 w-full sm:w-auto">
                {detailsData?.gumroadLink && (
                  <a 
                    href={typeof detailsData.gumroadLink === 'string' ? detailsData.gumroadLink : detailsData.gumroadLink.current} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="px-6 py-3 bg-[#0F172A] text-white font-bold uppercase text-xs tracking-wider rounded-full hover:bg-black transition-all duration-300 text-center shadow-xs"
                  >
                    Get Template ↗
                  </a>
                )}
                {detailsData?.demoLink && (
                  <a 
                    href={typeof detailsData.demoLink === 'string' ? detailsData.demoLink : detailsData.demoLink.current} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="px-6 py-3 bg-[#0F172A] text-white font-bold uppercase text-xs tracking-wider rounded-full hover:bg-black transition-all duration-300 text-center shadow-xs"
                  >
                    Live Application ↗
                  </a>
                )}
                {detailsData?.gitHubLink && (
                  <a 
                    href={typeof detailsData.gitHubLink === 'string' ? detailsData.gitHubLink : detailsData.gitHubLink.current} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="px-6 py-3 bg-slate-100 border border-black/10 text-[#0F172A] font-semibold text-xs uppercase tracking-wider rounded-full hover:bg-slate-200 transition-all duration-300 text-center"
                  >
                    Source Code ↗
                  </a>
                )}
            </div>
         </div>
      </div>

      <!-- Hero Media in Realistic 3D MacBook Pro Studio Stage (Demo Video or Uncropped Screenshot) -->
      <div class="laptop-3d-stage relative rounded-[24px] sm:rounded-[36px] p-6 sm:p-12 md:p-16 bg-gradient-to-b from-[#1C2233] via-[#101422] to-[#0A0D16] border border-black/10 shadow-[0_20px_60px_rgba(0,0,0,0.12)] overflow-hidden">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_30%,rgba(94,106,210,0.22)_0%,transparent_65%)] pointer-events-none"></div>

        {demoMedia && (
          <div class="relative z-20 max-w-5xl mx-auto mb-5 flex flex-wrap items-center justify-between gap-3">
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.08] border border-white/15 text-[11px] font-mono uppercase tracking-[0.14em] text-emerald-300">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              Interactive Product Walkthrough
            </span>
            {posterUrl && (
              <div class="inline-flex items-center p-1 rounded-full bg-white/[0.06] border border-white/15 text-[11px] font-mono">
                <button
                  type="button"
                  data-media-tab="video"
                  class="px-3.5 py-1 rounded-full bg-white text-[#0A0B0E] font-bold transition-all cursor-pointer"
                >
                  Demo Video
                </button>
                <button
                  type="button"
                  data-media-tab="image"
                  class="px-3.5 py-1 rounded-full text-slate-300 hover:text-white transition-all cursor-pointer"
                >
                  Screenshot
                </button>
              </div>
            )}
          </div>
        )}

        <div data-gsap-parallax class="laptop-chassis relative max-w-5xl mx-auto">
          <div class="relative rounded-[16px] sm:rounded-[22px] md:rounded-[26px] bg-[#0E1015] px-2.5 pb-2.5 pt-5 sm:px-3.5 sm:pb-3.5 sm:pt-6 md:px-4 md:pb-4 md:pt-7 shadow-[0_30px_80px_rgba(0,0,0,0.45)] border border-white/15 ring-1 ring-black/60">
            <div class="absolute top-1.5 sm:top-2 left-1/2 -translate-x-1/2 w-14 sm:w-20 md:w-28 h-2.5 sm:h-3 md:h-3.5 bg-[#07080B] rounded-b-md flex items-center justify-center z-30 border-x border-b border-white/[0.06]">
              <span class="w-1.5 h-1.5 rounded-full bg-[#1A1D24] ring-1 ring-white/10"></span>
            </div>
            <div class="relative rounded-[10px] sm:rounded-[14px] md:rounded-[16px] overflow-hidden bg-[#0B0D12] flex items-center justify-center">
              {demoMedia ? (
                <>
                  <div id="stage-video-pane" class="w-full">
                    {demoMedia.kind === "video" ? (
                      <video
                        src={demoMedia.src}
                        poster={posterUrl || undefined}
                        controls
                        autoplay
                        muted
                        loop
                        playsinline
                        preload="metadata"
                        class="w-full h-auto max-h-[620px] object-contain bg-[#0B0D12] block"
                      />
                    ) : (
                      <div class="relative w-full aspect-video bg-[#0B0D12]">
                        <iframe
                          src={demoMedia.src}
                          title={`${detailsData?.projectName || "Project"} Demo Walkthrough`}
                          class="w-full h-full border-0"
                          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
                          allowfullscreen
                        ></iframe>
                      </div>
                    )}
                  </div>
                  {posterUrl && (
                    <img
                      id="stage-image-pane"
                      src={posterUrl}
                      alt={detailsData?.projectName || "Project preview screenshot"}
                      loading="lazy"
                      decoding="async"
                      class="hidden w-full h-auto max-h-[620px] object-contain object-center"
                    />
                  )}
                </>
              ) : (
                posterUrl && (
                  <img 
                    src={posterUrl} 
                    alt={detailsData?.projectName || "Project preview screenshot"}
                    loading="eager"
                    decoding="async"
                    class="w-full h-auto max-h-[620px] object-contain object-center block"
                  />
                )
              )}
              <div class="laptop-glare pointer-events-none absolute inset-0 bg-gradient-to-tr from-transparent via-white/[0.03] to-white/[0.09] mix-blend-overlay"></div>
            </div>
          </div>
          <div class="relative mx-auto w-[104%] -left-[2%] h-3.5 sm:h-5 md:h-6 bg-gradient-to-b from-[#555A64] via-[#32363E] to-[#1E2127] rounded-b-[14px] sm:rounded-b-[20px] shadow-[0_25px_50px_rgba(0,0,0,0.45)] border-t border-white/25">
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-20 sm:w-28 md:w-36 h-1.5 sm:h-2 bg-[#17191E] rounded-b-lg"></div>
          </div>
        </div>
      </div>

      {demoMedia && posterUrl && (
        <script>
          const setupStageMediaTabs = () => {
            const buttons = document.querySelectorAll<HTMLButtonElement>("[data-media-tab]");
            const videoPane = document.getElementById("stage-video-pane");
            const imagePane = document.getElementById("stage-image-pane");
            if (!buttons.length || !videoPane || !imagePane) return;

            buttons.forEach((btn) => {
              if (btn.hasAttribute("data-bound")) return;
              btn.setAttribute("data-bound", "true");
              btn.addEventListener("click", () => {
                const target = btn.getAttribute("data-media-tab");
                const showVideo = target === "video";
                videoPane.classList.toggle("hidden", !showVideo);
                imagePane.classList.toggle("hidden", showVideo);
                imagePane.classList.toggle("block", !showVideo);

                buttons.forEach((b) => {
                  const active = b.getAttribute("data-media-tab") === target;
                  b.classList.toggle("bg-white", active);
                  b.classList.toggle("text-[#0A0B0E]", active);
                  b.classList.toggle("font-bold", active);
                  b.classList.toggle("text-slate-300", !active);
                });
              });
            });
          };

          setupStageMediaTabs();
          document.addEventListener("astro:page-load", setupStageMediaTabs);
        </script>
      )}

      <!-- Optional Headline Metrics Bento Strip -->
      {Array.isArray(detailsData?.headlineMetrics) && detailsData.headlineMetrics.length > 0 && (
        <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {detailsData.headlineMetrics.map((metric: string, idx: number) => (
            <div class="bento-spotlight rounded-2xl bg-white border border-black/[0.08] hover:border-accent-primary/40 p-5 shadow-xs transition-[border-color,box-shadow] duration-300">
              <span class="block text-[10px] font-mono uppercase tracking-[0.16em] text-accent-primary font-bold mb-1.5">
                0{idx + 1}/ IMPACT
              </span>
              <p class="font-grotesk font-bold text-sm sm:text-[15px] text-[#0F172A] leading-snug m-0">
                {metric}
              </p>
            </div>
          ))}
        </div>
      )}
    </section>

    <!-- Project Architecture & Breakdown -->
    <section class="max-w-5xl mx-auto pt-12 md:pt-20 border-t border-black/[0.08]">
       <div class="grid lg:grid-cols-12 gap-10 md:gap-16">
          <div class="lg:col-span-4">
             <div class="rounded-2xl p-1.5 bg-white border border-black/[0.08] shadow-xs lg:sticky lg:top-28">
               <div class="rounded-xl bg-white p-6 space-y-5">
                 <h2 class="text-base font-bold text-[#0F172A] tracking-tight">Project Overview</h2>
                 <div class="space-y-4 text-xs font-mono">
                    <div class="flex items-start justify-between gap-4 py-2 border-b border-black/[0.06]">
                       <span class="text-slate-600 shrink-0">Role</span>
                       <span class="text-[#0F172A] font-medium text-right">{detailsData?.role || "Tanuj Pandey"}</span>
                    </div>
                    <div class="flex items-center justify-between py-2 border-b border-black/[0.06]">
                       <span class="text-slate-600">Timeline</span>
                       <span class="text-[#0F172A] font-medium tabular-nums">{formattedDate}</span>
                    </div>
                    <div class="flex items-center justify-between py-2">
                       <span class="text-slate-600">Status</span>
                       <span class="inline-flex items-center gap-1.5 text-emerald-800 font-medium">
                         <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                         Production
                       </span>
                    </div>
                 </div>
                 <div class="pt-4 border-t border-black/[0.08] space-y-2.5">
                   <button
                     type="button"
                     data-open-contact
                     data-contact-subject={`Similar Build Inquiry: ${detailsData?.projectName || "Case Study"}`}
                     class="w-full py-3 px-4 rounded-full bg-[#0A0B0E] hover:bg-black text-white font-grotesk font-bold text-xs uppercase tracking-wider transition-all cursor-pointer shadow-sm"
                   >
                     Build Something Similar ↗
                   </button>
                   <a
                     href="https://wa.me/919557321978"
                     target="_blank"
                     rel="noopener noreferrer"
                     class="w-full py-2.5 px-4 rounded-full bg-emerald-50 hover:bg-emerald-100 border border-emerald-500/25 text-emerald-900 font-mono font-semibold text-xs text-center block transition-colors"
                   >
                     WhatsApp Tanuj ↗
                   </a>
                 </div>
               </div>
             </div>
          </div>
          
          <div class="lg:col-span-8">
             <div class="prose-custom">
               <PortableText value={detailsData?.projectcontent} components={components} />
             </div>

             <!-- Immediate Case Study Conversion Banner -->
             <div class="mt-14 rounded-3xl bg-[#0A0B0E] text-white p-8 sm:p-10 border border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
               <div>
                 <span class="text-[11px] font-mono uppercase tracking-[0.18em] text-[#828FFF] block mb-2">NEXT STEP</span>
                 <h3 class="font-grotesk font-bold text-xl sm:text-2xl text-white">Want a system like {detailsData?.projectName}?</h3>
                 <p class="text-xs sm:text-sm text-slate-400 mt-1">Direct engineering delivery &amp; reply within 2 hours.</p>
               </div>
               <button
                 type="button"
                 data-open-contact
                 data-contact-subject={`Project Inquiry: ${detailsData?.projectName || "Custom Build"}`}
                 class="shrink-0 px-6 py-3 rounded-full bg-white text-[#0A0B0E] hover:bg-slate-200 font-grotesk font-bold text-xs uppercase tracking-wider transition-all cursor-pointer"
               >
                 Contact Now ↗
               </button>
             </div>
          </div>
       </div>
    </section>
  </main>
</div>

<style>
  .prose-custom {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .prose-custom :global(p) {
    margin-bottom: 1.75rem;
  }
  .prose-custom :global(img) {
    width: 100%;
    height: auto;
    border-radius: 1rem;
    border: 1px solid var(--border-subtle);
    margin-top: 2rem;
    margin-bottom: 2rem;
    max-width: 100%;
  }
  .prose-custom :global(h2) {
    color: var(--text-primary);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.55rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-top: 2.75rem;
    margin-bottom: 1rem;
  }
  .prose-custom :global(h3),
  .prose-custom :global(h4) {
    color: var(--text-primary);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.18rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-top: 1.85rem;
    margin-bottom: 0.75rem;
  }
  .prose-custom :global(code) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85em;
    padding: 0.15rem 0.4rem;
    border-radius: 0.375rem;
    background-color: rgba(94, 106, 210, 0.08);
    color: #5E6AD2;
  }
  .prose-custom :global(blockquote) {
    border-left: 3px solid #5E6AD2;
    padding-left: 1rem;
    color: #334155;
    margin: 1.5rem 0;
  }
  .prose-custom :global(ul) {
    list-style-type: disc;
    list-style-position: inside;
    margin-bottom: 2rem;
  }
  .prose-custom :global(ul > li + li) {
    margin-top: 0.5rem;
  }
  .prose-custom :global(ol) {
    list-style-type: decimal;
    list-style-position: inside;
    margin-bottom: 2rem;
  }
  .prose-custom :global(ol > li + li) {
    margin-top: 0.5rem;
  }
  .prose-custom :global(li) {
    color: var(--text-muted);
    margin-left: 0.5rem;
  }
  .prose-custom :global(li::marker) {
    color: var(--accent-primary);
  }
  .prose-custom :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }
</style>
