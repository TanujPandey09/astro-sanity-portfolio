                </div>

                {item.highlights.length > 0 && (
                  <div class="space-y-2 pt-3 border-t border-[#E4E4E7]">
                    <span class="text-[10px] font-mono uppercase tracking-wider text-[#71717A] font-semibold block">
                      Key Highlights
                    </span>
                    <div class="space-y-1.5 text-xs text-[#27272A] font-sans">
                      {item.highlights.map((feat) => (
                        <div class="flex items-start gap-2">
                          <span class="text-[#5E6AD2] font-bold mt-0.5 select-none">✓</span>
                          <span>{feat}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                <div class="pt-3 space-y-4 border-t border-[#E4E4E7]">
                  {item.stack.length > 0 && (
                    <div class="flex flex-wrap gap-1.5">
                      {item.stack.map((tech: string) => (
                        <span class="text-[10px] font-mono px-2.5 py-1 rounded-md bg-white border border-[#E4E4E7] text-[#52525B] font-medium">
                          {tech}
                        </span>
                      ))}
                    </div>
                  )}

                  <div class="flex flex-wrap items-center gap-3 pt-1">
                    {item.demoUrl && (
                      <a
                        href={item.demoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#09090B] hover:bg-[#5E6AD2] text-white font-grotesk font-bold text-xs uppercase tracking-wider transition-all"
                      >
                        <span>Visit Live Site</span>
                        <span>↗</span>
                      </a>
                    )}

                    <a
                      href={item.caseStudyUrl}
                      class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-full bg-white hover:bg-zinc-100 border border-[#D4D4D8] text-xs font-mono font-semibold text-[#09090B] transition-colors"
                    >
                      <span>Read Case Study ↗</span>
                    </a>

                    {item.demoMedia && (
                      <button
                        type="button"
                        data-open-showreel
                        data-showreel-kind={item.demoMedia.kind}
                        data-showreel-src={item.demoMedia.src}
                        data-showreel-title={item.name}
                        class="inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-full bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-xs font-mono font-semibold text-emerald-800 transition-all cursor-pointer"
                      >
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span>Watch Demo</span>
                      </button>
                    )}
                  </div>
                </div>
              </div>

              <!-- Right Column: Visual Frame (7 cols) -->
              <div class="lg:col-span-7">
                <div class="rounded-xl overflow-hidden border border-[#D4D4D8] bg-white shadow-xs">
                  <div class="px-4 py-2.5 bg-white border-b border-[#E4E4E7] flex items-center justify-between text-[11px] font-mono text-[#71717A]">
                    <div class="flex items-center gap-1.5">
                      <span class="w-2.5 h-2.5 rounded-full bg-zinc-300"></span>
                      <span class="w-2.5 h-2.5 rounded-full bg-zinc-300"></span>
                      <span class="w-2.5 h-2.5 rounded-full bg-zinc-300"></span>
                    </div>
                    <span class="truncate max-w-[220px] text-[#09090B] font-medium bg-[#F4F4F5] px-3 py-0.5 rounded border border-[#E4E4E7]">
                      {item.demoUrl ? item.demoUrl.replace(/^https?:\/\//, "").replace(/\/$/, "") : item.name}
                    </span>
                    <span class="text-[#5E6AD2] font-semibold text-[10px] hidden sm:inline truncate max-w-[160px]">{item.category}</span>
                  </div>

                  <a
                    href={item.demoUrl || item.caseStudyUrl}
                    target={item.demoUrl ? "_blank" : "_self"}
                    rel={item.demoUrl ? "noopener noreferrer" : undefined}
                    class="group block aspect-[16/10] w-full overflow-hidden bg-zinc-100 relative"
                  >
                    {item.demoMedia?.kind === "video" ? (
                      <video
                        src={item.demoMedia.src}
                        poster={item.posterUrl}
                        autoplay
                        muted
                        loop
                        playsinline
                        preload="metadata"
                        class="w-full h-full object-cover object-top"
                      />
                    ) : (
                      <img
                        src={item.posterUrl}
                        alt={item.name}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-103"
                      />
                    )}
                  </a>
                </div>
              </div>

            </div>
          </article>
        ))}
      </div>
    </div>

  </section>
)}

<!-- Fullscreen Showreel Lightbox Modal -->
<div
  id="agency-showreel-modal"
  class="fixed inset-0 z-[90] hidden items-center justify-center bg-black/85 backdrop-blur-md p-4 sm:p-8"
  role="dialog"
  aria-modal="true"
  aria-labelledby="showreel-modal-title"
>
  <div class="relative w-full max-w-5xl rounded-2xl bg-white border border-zinc-200 shadow-2xl overflow-hidden">
    <div class="px-4 sm:px-6 py-3.5 border-b border-zinc-200 flex items-center justify-between gap-4 bg-[#FAFAFA]">
      <div class="flex items-center gap-2.5 min-w-0">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
        <span id="showreel-modal-title" class="font-grotesk font-bold text-sm sm:text-base text-[#09090B] truncate">
          Product Walkthrough
        </span>
      </div>
      <button
        type="button"
        id="close-showreel-modal"
        aria-label="Close showreel player"
        class="px-3 py-1.5 rounded-full bg-[#F4F4F5] hover:bg-zinc-200 text-xs font-mono font-semibold text-[#09090B] cursor-pointer transition-colors"
      >
        Close ✕
      </button>
    </div>
    <div id="showreel-modal-body" class="relative w-full aspect-video bg-[#09090B] flex items-center justify-center"></div>
  </div>
</div>

<style>
  .perspective-container {
    perspective: 1200px;
    transform-style: preserve-3d;
    perspective-origin: center center;
  }

  .screens-3d-stage {
    transform-style: preserve-3d;
    perspective: 1200px;
  }

  .carousel-track-wrapper {
    transform-style: preserve-3d;
  }

  .carousel-track-row1,
  .carousel-track-row2 {
    display: flex;
    width: max-content;
    transform-style: preserve-3d;
  }

  .carousel-card {
    will-change: transform, opacity;
    transform-origin: center bottom;
    transform-style: preserve-3d;
    backface-visibility: hidden;
  }

  @keyframes carouselScrollRow1 {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }

  @keyframes carouselScrollRow2 {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0%); }
  }

  .carousel-track-row1 {
    animation: carouselScrollRow1 45s linear infinite;
  }

  .carousel-track-row2 {
    animation: carouselScrollRow2 45s linear infinite;
  }

  .carousel-track-row1:hover,
  .carousel-track-row2:hover {
    animation-play-state: paused;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let activeMatchMedia: gsap.MatchMedia | null = null;

  const setupCodifyTiltedScroll = () => {
    const stage = document.getElementById("tilted-screens-stage");
    const wrapper = document.getElementById("screens-perspective-wrapper") || stage;
    const cards = gsap.utils.toArray<HTMLElement>(".carousel-card");

    if (!stage || !wrapper) return;

    if (activeMatchMedia) {
      activeMatchMedia.revert();
      activeMatchMedia = null;
    }

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      stage.style.transform = "none";
      if (cards.length) {
        gsap.set(cards, { opacity: 1, scale: 1, clearProps: "all" });
      }
      return;
    }

    activeMatchMedia = gsap.matchMedia();

    activeMatchMedia.add("(min-width: 641px)", () => {
      gsap.set(stage, {
        transformPerspective: 1200,
        transformOrigin: "50% 50%",
      });

      gsap.fromTo(
        stage,
        {
          rotation: 12,
          rotationX: 12,
          rotationY: -12,
          skewX: 0,
          skewY: 0,
          scale: 0.95,
          transformPerspective: 1200,
        },
        {
          rotation: 0,
          rotationX: 0,
          rotationY: 0,
          skewX: 0,
          skewY: 0,
          scale: 1,
          transformPerspective: 1200,
          ease: "none",
          scrollTrigger: {
            id: "agency-tilt-stage-desktop",
            trigger: wrapper,
            start: "top 90%",
            end: "center 45%",
            scrub: 1,
            invalidateOnRefresh: true,
          },
        }
      );

      if (cards.length) {
        gsap.fromTo(
          cards,
          { opacity: 0.8, scale: 0.96 },
          {
            opacity: 1,
            scale: 1,
            ease: "power2.out",
            stagger: 0.03,
            scrollTrigger: {
              id: "agency-tilt-cards-desktop",
              trigger: wrapper,
              start: "top 90%",
              end: "center 45%",
              scrub: 1,
            },
          }
        );
      }
    });

    activeMatchMedia.add("(max-width: 640px)", () => {
      gsap.set(stage, {
        transformPerspective: 1200,
        transformOrigin: "50% 50%",
      });

      gsap.fromTo(
        stage,
        {
          rotation: 8,
          rotationX: 8,
          rotationY: -8,
          skewX: 0,
          skewY: 0,
          scale: 0.92,
          transformPerspective: 1200,
        },
        {
          rotation: 0,
          rotationX: 0,
          rotationY: 0,
          skewX: 0,
          skewY: 0,
          scale: 1,
          transformPerspective: 1200,
          ease: "none",
          scrollTrigger: {
            id: "agency-tilt-stage-mobile",
            trigger: wrapper,
            start: "top 90%",
            end: "center 45%",
            scrub: 1,
            invalidateOnRefresh: true,
          },
        }
      );

      if (cards.length) {
        gsap.fromTo(
          cards,
          { opacity: 0.85, scale: 0.97 },
          {
            opacity: 1,
            scale: 1,
            ease: "power2.out",
            stagger: 0.02,
            scrollTrigger: {
              id: "agency-tilt-cards-mobile",
              trigger: wrapper,
              start: "top 90%",
              end: "center 45%",
              scrub: 1,
            },
          }
        );
      }
    });
  };

  const setupAgencyShowreel = () => {
    const modal = document.getElementById("agency-showreel-modal");
    const body = document.getElementById("showreel-modal-body");
    const titleEl = document.getElementById("showreel-modal-title");
    const closeBtn = document.getElementById("close-showreel-modal");
    const triggers = document.querySelectorAll<HTMLButtonElement>("[data-open-showreel]");

    if (!modal || !body || !titleEl || !closeBtn) return;

    const closeModal = () => {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      body.innerHTML = "";
      document.body.style.overflow = "";
    };

    if (!closeBtn.hasAttribute("data-bound")) {
      closeBtn.setAttribute("data-bound", "true");
      closeBtn.addEventListener("click", closeModal);
      modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
      });
    }

    triggers.forEach((btn) => {
      if (btn.hasAttribute("data-bound")) return;
      btn.setAttribute("data-bound", "true");
      btn.addEventListener("click", () => {
        const kind = btn.getAttribute("data-showreel-kind");
        const src = btn.getAttribute("data-showreel-src");
        const title = btn.getAttribute("data-showreel-title") || "Product Walkthrough";

        if (!src) return;

        titleEl.textContent = title;
        body.innerHTML = "";

        if (kind === "iframe") {
          const iframe = document.createElement("iframe");
          iframe.src = src;
          iframe.className = "w-full h-full border-0";
          iframe.allow = "autoplay; fullscreen; picture-in-picture";
          iframe.setAttribute("allowfullscreen", "true");
          body.appendChild(iframe);
        } else {
          const video = document.createElement("video");
          video.src = src;
          video.controls = true;
          video.autoplay = true;
          video.className = "w-full h-full object-contain";
          body.appendChild(video);
        }

        modal.classList.remove("hidden");
        modal.classList.add("flex");
        document.body.style.overflow = "hidden";
      });
    });
  };

  setupCodifyTiltedScroll();
  setupAgencyShowreel();

  document.addEventListener("astro:page-load", () => {
    setupCodifyTiltedScroll();
    setupAgencyShowreel();
  });

  document.addEventListener("astro:after-swap", () => {
    setupCodifyTiltedScroll();
    setupAgencyShowreel();
  });

  document.addEventListener("astro:before-swap", () => {
    if (activeMatchMedia) {
      activeMatchMedia.revert();
      activeMatchMedia = null;
    }
  });

  window.addEventListener("load", () => {
    ScrollTrigger.refresh();
  });
</script>
