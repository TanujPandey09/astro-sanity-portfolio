---
import SectionHeader from "./SectionHeader.astro";

const services = [
  {
    span: "lg:col-span-7",
    featured: true,
    domain: "Core Architecture",
    title: "Full-Stack SaaS & Web Engineering",
    description: "End-to-end product development from database schema to sub-second React and Next.js interfaces. Built to handle real production traffic, complex role permissions, and clean team handoffs.",
    deliverables: "Shipped Sawt AI, Breeze SaaS, and multi-role healthcare portals",
    stack: ["Next.js / React", "Node.js / Express", "TypeScript", "PostgreSQL / Prisma", "REST & GraphQL"]
  },
  {
    span: "lg:col-span-5",
    featured: true,
    domain: "Applied AI Systems",
    title: "Multi-LLM & Agentic Workflows",
    description: "Production LLM orchestration across OpenAI, Gemini, Claude, and Perplexity with structured output validation, RAG retrieval pipelines, and streaming conversational UIs.",
    deliverables: "Multi-provider fallback routing & brand-safe response validation",
    stack: ["OpenAI / Gemini / Claude", "Contextual RAG", "Vector Search", "Streaming UI"]
  },
  {
    span: "lg:col-span-3",
    featured: false,
    domain: "Low-Latency",
    title: "Real-Time CRM & Event Streams",
    description: "Bi-directional state synchronization, live ticket pipelines, and SLA tracking powered by Socket.IO, WebSockets, and Redis Pub/Sub.",
    stack: ["Socket.IO", "WebSockets", "Redis"]
  },
  {
    span: "lg:col-span-3",
    featured: false,
    domain: "Interface Craft",
    title: "Design Systems & RTL UX",
    description: "Accessible component libraries, bilingual Arabic/English RTL-first layouts, and hardware-accelerated motion that scores 99+ on Lighthouse.",
    stack: ["Tailwind CSS", "GSAP / Motion", "RTL / i18n"]
  },
  {
    span: "lg:col-span-3",
    featured: false,
    domain: "Data Layer",
    title: "Database & Query Optimization",
    description: "High-throughput relational and document schemas, indexing strategies, and headless CMS pipelines with Sanity, Contentful, and Strapi.",
    stack: ["PostgreSQL", "MongoDB", "Sanity CMS"]
  },
  {
    span: "lg:col-span-3",
    featured: false,
    domain: "Monetization & Security",
    title: "Billing, RBAC & Guardrails",
    description: "Subscription lifecycles (Stripe, MyFatoorah), tier-based API metering, webhook idempotency, rate limiting, and audit logging.",
    stack: ["Stripe / MyFatoorah", "RBAC Auth", "Webhooks"]
  }
];
---

<section id="services" class="py-14 sm:py-16 lg:py-20 relative z-20 border-t border-black/[0.08]">
  <div class="w-full">
    
    <SectionHeader 
      eyebrow="02 / Services"
      title="What I Build &" 
      gradientText="Ship to Production." 
      subtitle="Focused on the layers that turn early product ideas into revenue-generating software: resilient backends, multi-LLM intelligence, real-time state, and fast interfaces."
    />

    <!-- Asymmetric 12-Column Engineering Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-5">
      {services.map((item, index) => (
        <div
          data-gsap-card
          class={`bento-spotlight group relative overflow-hidden rounded-2xl bg-white border border-black/[0.08] hover:border-[#5E6AD2]/45 transition-colors duration-200 p-6 flex flex-col justify-between shadow-xs ${item.span}`}
        >
          {item.featured && (
            <div class="absolute top-0 inset-x-0 h-[2px] bg-[#5E6AD2]" aria-hidden="true"></div>
          )}

          <div>
            <!-- Top Row: Domain + Index -->
            <div class="flex items-center justify-between gap-3 mb-4">
              <span class="text-[11px] font-mono uppercase tracking-[0.12em] text-[#5E6AD2] font-semibold">
                {item.domain}
              </span>
              <span class="text-xs font-mono tabular-nums text-slate-400 font-semibold">
                {String(index + 1).padStart(2, "0")}
              </span>
            </div>

            <!-- Title -->
            <h3 class={`font-grotesk ${item.featured ? "text-xl md:text-2xl" : "text-lg"} font-bold text-[#0F172A] tracking-[-0.025em] mb-2.5`}>
              {item.title}
            </h3>

            <!-- Description -->
            <p class="text-sm text-slate-600 font-normal leading-[1.65] mb-4 font-sans">
              {item.description}
            </p>

            {item.deliverables && (
              <p class="text-xs font-mono text-slate-700 font-medium mb-4">
                <span class="text-[#5E6AD2] mr-1.5">→</span>{item.deliverables}
              </p>
            )}
          </div>

          <!-- Tech Chips -->
          <div class="pt-4 border-t border-black/[0.08]">
            <div class="flex flex-wrap gap-1.5">
              {item.stack.map((tech) => (
                <span class="text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-slate-50 border border-black/[0.08] text-slate-700">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
