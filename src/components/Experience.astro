---

<section id="experience" class="relative z-10 border-t border-white/[0.08] py-14 sm:py-20 md:py-24 overflow-hidden">
  <!-- Subtle Ambient Spotlight -->
  <div class="absolute -top-24 left-1/3 w-96 h-96 bg-accent-primary/5 rounded-full blur-[130px] pointer-events-none -z-10"></div>

  <div class="w-full max-w-7xl mx-auto">
    <!-- Editorial Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8 sm:mb-10">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-primary/10 border border-accent-primary/20 mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-primary"></span>
          <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-accent-primary font-semibold">Career Ledger</span>
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-[1.08]">
          Work <span class="text-gradient">Experience</span>
        </h2>
        <p class="mt-2.5 text-text-muted text-sm sm:text-base font-normal leading-relaxed max-w-2xl">
          4+ years shipping commercial SaaS products, multi-role healthcare portals, and production AI systems.
        </p>
      </div>

      <div class="shrink-0 flex items-center gap-3">
        <a
          href="/Resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2.5 pl-4 pr-3 py-2 rounded-full bg-surface-card hover:bg-surface-elevated border border-white/[0.10] hover:border-accent-primary/40 text-xs font-mono font-semibold text-text-primary transition-all shadow-sm"
        >
          <span>Download CV</span>
          <span class="w-5 h-5 rounded-full bg-white/[0.06] group-hover:bg-accent-primary group-hover:text-white flex items-center justify-center text-[10px] text-accent-hover transition-all">↗</span>
        </a>
      </div>
    </div>

    <!-- Framer-Style Double-Bezel Interactive Experience Ledger (Single-Open Accordion = Zero Long Scroll) -->
    <div class="rounded-[22px] sm:rounded-[26px] p-1.5 bg-white/[0.03] border border-white/[0.09] shadow-card">
      <div class="rounded-[17px] sm:rounded-[21px] bg-surface-card border border-white/[0.05] overflow-hidden divide-y divide-white/[0.07]">
        
        <!-- Top Architectural Metadata Strip -->
        <div class="px-4 sm:px-7 py-3 bg-white/[0.015] flex items-center justify-between gap-2 text-[10px] sm:text-[11px] font-mono text-text-dim">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-status-live"></span>
            <span>04 PRODUCTION ROLES · 2022 — 2026</span>
          </div>
          <span class="hidden sm:inline text-text-dim">SELECT ANY ROLE TO EXPAND ARCHITECTURE</span>
          <span class="sm:hidden text-text-dim">TAP ROLE TO EXPAND</span>
        </div>

        <!-- Accordion Rows (All 4 Companies Always Visible; 1 Expanded at a Time) -->
        {experienceData.map((exp, index) => {
          const isFirst = index === 0;
          return (
            <div
              class={`exp-ledger-item group transition-colors duration-300 ${
                isFirst ? "is-open bg-surface-elevated/40" : "hover:bg-white/[0.015]"
              }`}
              data-exp-item={index}
            >
              <!-- Interactive Row Header Button -->
              <button
                type="button"
                aria-expanded={isFirst ? "true" : "false"}
                aria-controls={`exp-drawer-${index}`}
                id={`exp-trigger-${index}`}
                data-exp-trigger={index}
                class="w-full text-left px-4 sm:px-7 py-4 sm:py-5 flex items-center justify-between gap-3 sm:gap-6 cursor-pointer focus:outline-none"
              >
                <!-- Left: Index + Logo + Role + Company -->
                <div class="flex items-center gap-3 sm:gap-4 min-w-0">
                  <span class={`exp-idx hidden xs:inline-flex font-mono text-xs font-bold tabular-nums transition-colors ${
                    isFirst ? "text-accent-hover" : "text-text-dim group-hover:text-text-muted"
                  }`}>
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <!-- Machined Logo Container -->
                  <div class={`w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-white/[0.04] p-2 border transition-all duration-300 shrink-0 flex items-center justify-center overflow-hidden ${
                    isFirst ? "border-accent-primary/40 shadow-[0_0_18px_rgba(94,106,210,0.18)]" : "border-white/10 group-hover:border-white/20"
                  }`}>
                    <img
                      src={exp.logo}
                      alt={exp.company}
                      width="40"
                      height="40"
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-contain"
                      onerror="this.style.display='none'"
                    />
                  </div>

                  <!-- Role & Company Title -->
                  <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
                      <h3 class="text-sm sm:text-lg font-bold text-white tracking-tight truncate">
                        {exp.role}
                      </h3>
                      <span class="text-white/20 hidden sm:inline">·</span>
                      <span class="text-xs sm:text-sm font-mono font-semibold text-accent-hover truncate">
                        {exp.company}
                      </span>
                      {exp.isCurrent ? (
                        <span class="inline-flex items-center gap-1.5 text-[10px] font-mono px-2 py-0.5 rounded-full bg-status-live/10 border border-status-live/25 text-status-live font-medium">
                          <span class="w-1.5 h-1.5 rounded-full bg-status-live animate-pulse"></span>
                          {exp.badge}
                        </span>
                      ) : (
                        <span class="hidden md:inline-flex text-[10px] font-mono px-2 py-0.5 rounded-full bg-white/[0.04] border border-white/[0.08] text-text-muted">
                          {exp.badge}
                        </span>
                      )}
                    </div>

                    <!-- Mobile Subline: Period & Type -->
                    <div class="flex sm:hidden items-center gap-2 mt-0.5 text-[11px] font-mono text-text-dim">
                      <span>{exp.duration}</span>
                      <span>·</span>
                      <span>{exp.type}</span>
                    </div>
                  </div>
                </div>

                <!-- Right: Key Outcome Pill (Desktop) + Duration + Animated Expand Button -->
                <div class="flex items-center gap-3 sm:gap-5 shrink-0">
                  <span class="hidden lg:inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/[0.03] border border-white/[0.07] text-[11px] font-mono text-text-muted">
                    <span class="w-1.5 h-1.5 rounded-full bg-accent-primary"></span>
                    {exp.headlineOutcome}
                  </span>

                  <div class="hidden sm:flex flex-col items-end text-right">
                    <span class="text-xs font-mono font-medium text-text-primary tabular-nums">{exp.duration}</span>
                    <span class="text-[10px] font-mono text-text-dim">{exp.type}</span>
                  </div>

                  <!-- Sleek Framer Circular Plus/Minus Toggle -->
                  <span class={`exp-chevron w-8 h-8 sm:w-9 sm:h-9 rounded-full border flex items-center justify-center transition-all duration-300 ${
                    isFirst
                      ? "bg-accent-primary text-white border-accent-primary rotate-180 shadow-[0_0_15px_rgba(94,106,210,0.4)]"
                      : "bg-white/[0.03] text-text-muted border-white/10 group-hover:border-white/25 group-hover:text-white"
                  }`}>
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  </span>
                </div>
              </button>

              <!-- Smooth CSS Grid Accordion Drawer -->
              <div
                id={`exp-drawer-${index}`}
                role="region"
                aria-labelledby={`exp-trigger-${index}`}
                class={`exp-drawer grid transition-[grid-template-rows,opacity] duration-300 ease-out ${
                  isFirst ? "grid-rows-[1fr] opacity-100" : "grid-rows-[0fr] opacity-0"
                }`}
              >
                <div class="overflow-hidden">
                  <div class="px-4 sm:px-7 pb-5 sm:pb-7 pt-1">
                    <!-- Inner Framer Bento Split -->
                    <div class="grid lg:grid-cols-12 gap-4 sm:gap-5 p-4 sm:p-5 rounded-2xl bg-canvas/60 border border-white/[0.07]">
                      
                      <!-- Left (7 Cols): Executive Summary & 3 Key Engineering Deliverables -->
                      <div class="lg:col-span-7 space-y-3.5 min-w-0">
                        <p class="text-xs sm:text-sm text-text-primary font-medium leading-relaxed">
                          {exp.description}
                        </p>

                        <ul class="space-y-2 pt-2.5 border-t border-white/[0.06]">
                          {exp.highlights.map((point) => (
                            <li class="flex items-start gap-2.5 text-xs sm:text-[13px] text-text-muted leading-relaxed">
                              <span class="w-1.5 h-1.5 rounded-full bg-accent-primary mt-1.5 shrink-0"></span>
                              <span>{point}</span>
                            </li>
                          ))}
                        </ul>
                      </div>

                      <!-- Right (5 Cols): Verified Impact KPIs + Stack + Company Link -->
                      <div class="lg:col-span-5 flex flex-col justify-between gap-4 p-3.5 sm:p-4 rounded-xl bg-surface-card border border-white/[0.06] min-w-0">
                        <div class="space-y-3.5">
                          <!-- 2x1 KPI Bento Tiles -->
                          <div class="grid grid-cols-2 gap-2.5">
                            {exp.kpis.map((kpi) => (
                              <div class="p-2.5 sm:p-3 rounded-lg bg-surface-elevated/80 border border-white/[0.06]">
                                <div class="text-sm sm:text-base font-bold font-mono text-white tracking-tight">
                                  {kpi.value}
                                </div>
                                <div class="text-[10px] font-mono text-text-dim mt-0.5 leading-tight">
                                  {kpi.label}
                                </div>
                              </div>
                            ))}
                          </div>

                          <!-- Core Stack Pills -->
                          <div class="space-y-1.5">
                            <span class="text-[10px] font-mono uppercase tracking-[0.14em] text-text-dim block">Production Stack</span>
                            <div class="flex flex-wrap gap-1.5">
                              {exp.technologies.map((tech) => (
                                <span class="px-2 py-0.5 rounded-md bg-white/[0.04] border border-white/[0.08] text-[11px] font-mono text-text-muted">
                                  {tech}
                                </span>
                              ))}
                            </div>
                          </div>
                        </div>

                        <!-- Footer Link -->
                        <div class="pt-2.5 border-t border-white/[0.06] flex items-center justify-between">
                          <span class="text-[10px] font-mono text-text-dim">{exp.badge}</span>
                          <a
                            href={exp.companyUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-accent-hover hover:text-white transition-colors"
                          >
                            <span>Visit {exp.company}</span>
                            <span>↗</span>
                          </a>
                        </div>
                      </div>

                    </div>
                  </div>
                </div>
              </div>

            </div>
          );
        })}

      </div>
    </div>
  </div>
</section>

<script>
  const initExperienceLedger = () => {
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-exp-item]'));
    const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-exp-trigger]'));

    if (!items.length || !triggers.length) return;

    const openRow = (targetIdx: number) => {
      items.forEach((item, idx) => {
        const trigger = item.querySelector<HTMLButtonElement>('[data-exp-trigger]');
        const drawer = item.querySelector<HTMLElement>('.exp-drawer');
        const chevron = item.querySelector<HTMLElement>('.exp-chevron');
        const idxLabel = item.querySelector<HTMLElement>('.exp-idx');

        const isOpen = idx === targetIdx;

        item.classList.toggle('is-open', isOpen);
        item.classList.toggle('bg-surface-elevated/40', isOpen);
        item.classList.toggle('hover:bg-white/[0.015]', !isOpen);

        if (trigger) {
          trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        }

        if (drawer) {
          drawer.classList.toggle('grid-rows-[1fr]', isOpen);
          drawer.classList.toggle('opacity-100', isOpen);
          drawer.classList.toggle('grid-rows-[0fr]', !isOpen);
          drawer.classList.toggle('opacity-0', !isOpen);
        }

        if (chevron) {
          chevron.classList.toggle('bg-accent-primary', isOpen);
          chevron.classList.toggle('text-white', isOpen);
          chevron.classList.toggle('border-accent-primary', isOpen);
          chevron.classList.toggle('rotate-180', isOpen);
          chevron.classList.toggle('shadow-[0_0_15px_rgba(94,106,210,0.4)]', isOpen);

          chevron.classList.toggle('bg-white/[0.03]', !isOpen);
          chevron.classList.toggle('text-text-muted', !isOpen);
          chevron.classList.toggle('border-white/10', !isOpen);
        }

        if (idxLabel) {
          idxLabel.classList.toggle('text-accent-hover', isOpen);
          idxLabel.classList.toggle('text-text-dim', !isOpen);
        }
      });
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const idx = Number(trigger.getAttribute('data-exp-trigger') || 0);
        const parentItem = items[idx];
        const alreadyOpen = parentItem?.classList.contains('is-open');
        // Keep one open for consistent single-screen height, or toggle if user clicks another row
        if (!alreadyOpen) {
          openRow(idx);
        }
      });
    });
  };

  initExperienceLedger();
  document.addEventListener('astro:after-swap', initExperienceLedger);
</script>
