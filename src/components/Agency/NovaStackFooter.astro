---
// DARK SECTION 2 OF 2: Final CTA Band + Minimalist Studio Footer (--ink #0B111A)
interface Props {
  logoUrl?: string;
  logoAlt?: string;
  brandName?: string;
  logoFullWidth?: boolean;
}

const {
  logoUrl = "",
  logoAlt = "NovaStack Studio Logo",
  brandName = "NovaStack Studio",
  logoFullWidth = false,
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class="bg-[var(--ink)] text-white border-t border-[var(--dark-border)]">
  <!-- Clean Final CTA Band -->
  <div class="ns-container py-16 lg:py-24 border-b border-[var(--dark-border)]">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8">
      <div class="max-w-2xl space-y-4">
        <div class="flex items-center gap-2.5">
          <span class="w-5 h-px bg-[var(--sky-400)]" aria-hidden="true"></span>
          <span class="ns-mono-label text-[var(--sky-400)] font-medium">
            Ready to Build
          </span>
        </div>
        <h2 class="ns-h2 text-white">
          Have a Product Spec Ready to <span class="text-[var(--sky-400)]">Ship?</span>
        </h2>
        <p class="text-base md:text-lg leading-[1.65] text-[var(--dark-muted)] max-w-xl">
          Work directly with Tanuj Pandey on your next website, SaaS build, or AI workflow. Clear scope and estimate in under 24 hours.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-5 shrink-0">
        <a href="#contact" class="ns-btn-primary px-7 py-4 text-base">
          <span>Start a Project</span>
          <span class="ns-arrow" aria-hidden="true">→</span>
        </a>
        <a
          href="mailto:tanujp09@gmail.com"
          class="ns-link-arrow inline-flex items-center gap-1.5 text-sm font-mono text-[var(--dark-muted)] hover:text-white transition-colors"
        >
          <span>tanujp09@gmail.com</span>
          <span class="ns-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Minimal Studio Footer -->
  <div class="ns-container py-10 lg:py-12">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 pb-8 border-b border-[var(--dark-border)]">
      <div class="space-y-2">
        <a href="/agency" class="inline-flex items-center gap-3">
          {logoUrl ? (
            <img
              src={logoUrl}
              alt={logoAlt}
              class={
                logoFullWidth
                  ? "h-8 w-auto max-w-[160px] object-contain"
                  : "h-8 w-8 rounded-[10px] object-contain bg-[var(--ink-2)] border border-[var(--dark-border)] p-1"
              }
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="w-8 h-8 rounded-[10px] bg-[var(--blue-600)] text-white flex items-center justify-center font-semibold text-xs">
              NS
            </div>
          )}
          {!(logoUrl && logoFullWidth) && (
            <span class="font-semibold text-base tracking-[-0.02em] text-white">
              {brandName}
            </span>
          )}
        </a>
        <p class="text-xs font-mono text-[var(--dark-muted)]">
          Independent software engineering studio operated by Tanuj Pandey.
        </p>
      </div>

      <nav class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm font-mono text-[var(--dark-muted)]" aria-label="Footer navigation">
        <a href="#services" class="hover:text-white transition-colors">Services</a>
        <a href="#work" class="hover:text-white transition-colors">Work</a>
        <a href="#process" class="hover:text-white transition-colors">Process</a>
        <a href="#about" class="hover:text-white transition-colors">Founder</a>
        <a href="#models" class="hover:text-white transition-colors">Pricing</a>
        <a href="#contact" class="hover:text-white transition-colors">Contact</a>
        <a href="/" class="text-[var(--sky-400)] hover:text-white transition-colors inline-flex items-center gap-1 font-medium">
          <span>Portfolio</span>
          <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </div>

    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-[var(--dark-muted)]">
      <span>© {currentYear} NovaStack Studio · Tanuj Pandey.</span>
      <div class="flex items-center gap-4">
        <span>Remote Worldwide</span>
        <span aria-hidden="true">·</span>
        <a href="#hero" class="hover:text-white transition-colors">Back to top ↑</a>
      </div>
    </div>
  </div>
</footer>
