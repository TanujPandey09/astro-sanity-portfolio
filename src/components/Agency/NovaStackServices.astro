    idealFor: "Products needing technical foundations that maximize discovery across Google, Perplexity, and AI models."
  },
  {
    id: "uiux-design",
    category: "Interface Craft & Design Systems",
    title: "UI/UX & Product Design",
    summary: "User-centric SaaS interfaces, responsive product prototypes, and modular design systems that make complex workflows feel effortless.",
    deliverables: [
      "SaaS Dashboard & Enterprise Application Design",
      "Interactive Figma Prototypes & User Journey Flows",
