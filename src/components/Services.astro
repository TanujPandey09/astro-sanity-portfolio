---
import SectionHeader from "./SectionHeader.astro";

const services = [
  {
    span: "lg:col-span-7",
    featured: true,
    domain: "Core Architecture",
    title: "Full-Stack SaaS & Web Engineering",
    description: "End-to-end product development from database schema to sub-second React and Next.js interfaces. Built to handle real production traffic, complex role permissions, and clean team handoffs.",
    deliverables: "Shipped Sawt AI, Breeze SaaS, and multi-role healthcare portals",
    stack: ["Next.js / React", "Node.js / Express", "TypeScript", "PostgreSQL / Prisma", "REST & GraphQL"]
  },
  {
    span: "lg:col-span-5",
    featured: true,
    domain: "Applied AI Systems",
    title: "Multi-LLM & Agentic Workflows",
    description: "Production LLM orchestration across OpenAI, Gemini, Claude, and Perplexity with structured output validation, RAG retrieval pipelines, and streaming conversational UIs.",
    deliverables: "Multi-provider fallback routing & brand-safe response validation",
    stack: ["OpenAI / Gemini / Claude", "Contextual RAG", "Vector Search", "Streaming UI"]
  },
  {
    span: "lg:col-span-3",
    featured: false,
    domain: "Low-Latency",
    title: "Real-Time CRM & Event Streams",
    description: "Bi-directional state synchronization, live ticket pipelines, and SLA tracking powered by Socket.IO, WebSockets, and Redis Pub/Sub.",
    stack: ["Socket.IO", "WebSockets", "Redis"]
  },
  {
    span: "lg:col-span-3",
    featured: false,
    domain: "Interface Craft",
    title: "Design Systems & RTL UX",
    description: "Accessible component libraries, bilingual Arabic/English RTL-first layouts, and hardware-accelerated motion that scores 99+ on Lighthouse.",
    stack: ["Tailwind CSS", "GSAP / Motion", "RTL / i18n"]
  },
  {
    span: "lg:col-span-3",
    featured: false,
    domain: "Data Layer",
    title: "Database & Query Optimization",
    description: "High-throughput relational and document schemas, indexing strategies, and headless CMS pipelines with Sanity, Contentful, and Strapi.",
    stack: ["PostgreSQL", "MongoDB", "Sanity CMS"]
  },
  {
    span: "lg:col-span-3",
    featured: false,
    domain: "Monetization & Security",
    title: "Billing, RBAC & Guardrails",
    description: "Subscription lifecycles (Stripe, MyFatoorah), tier-based API metering, webhook idempotency, rate limiting, and audit logging.",
    stack: ["Stripe / MyFatoorah", "RBAC Auth", "Webhooks"]
  }
];
---

<section id="services" class="py-14 sm:py-20 md:py-28 relative z-20 border-t border-border-subtle">
  <div class="w-full">
    
    <SectionHeader 
      title="What I Build &" 
      gradientText="Ship to Production" 
      subtitle="Focused on the four layers that turn early product ideas into revenue-generating software: resilient backends, multi-LLM intelligence, real-time state, and fast interfaces."
    />

    <!-- Asymmetric 12-Column Framer Bento Grid -->
    <div class="mt-8 sm:mt-12 md:mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-4 sm:gap-5">
      {services.map((item, index) => (
        <div 
          class={`group rounded-2xl p-1.5 bg-white/[0.03] border border-white/[0.09] hover:border-border-hover transition-all duration-500 shadow-card flex flex-col justify-between ${item.span}`}
          data-aos="fade-up"
          data-aos-delay={index * 60}
        >
          <div class={`rounded-xl p-6 md:p-7 h-full flex flex-col justify-between border border-white/[0.05] shadow-[inset_0_1px_0_0_rgba(255,255,255,0.08)] ${item.featured ? 'bg-gradient-to-b from-surface-elevated/90 to-surface-card' : 'bg-surface-card'}`}>
            <div>
              <!-- Top Row: Domain Tag -->
              <div class="flex items-center justify-between mb-5">
                <span class="text-[11px] font-mono font-medium text-accent-hover px-2.5 py-0.5 rounded-md bg-accent-primary/10 border border-accent-primary/20">
                  {item.domain}
                </span>
                <span class="text-xs font-mono tabular-nums text-text-dim">{String(index + 1).padStart(2, "0")}</span>
              </div>

              <!-- Title -->
              <h3 class={`${item.featured ? 'text-xl md:text-2xl' : 'text-lg'} font-bold text-text-primary tracking-tight mb-2.5`}>
                {item.title}
              </h3>

              <!-- Description -->
              <p class="text-xs sm:text-sm text-text-muted font-normal leading-relaxed mb-6">
                {item.description}
              </p>
            </div>

            <!-- Tech Chips -->
            <div class="pt-4 border-t border-border-subtle">
              <div class="flex flex-wrap gap-1.5">
                {item.stack.map((tech) => (
                  <span class="text-[10px] font-mono px-2.5 py-1 rounded-md bg-white/[0.03] border border-border-subtle text-text-muted">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
