---
import { optimizeSanityImage } from "../lib/optimizeImage";

const { project, index } = Astro.props;

const projectName = project?.projectName || "Custom Project";
const rawImageUrl = project?.BackgroundImage?.asset?.url;
const imageUrl = optimizeSanityImage(rawImageUrl, 800, 80);
const rawTags = project?.tags || project?.techStack || [];
const tags = Array.isArray(rawTags) && rawTags.length > 0 ? rawTags : ['Full-Stack', 'Production'];
---

<div class="group relative bg-surface-card border border-border-subtle rounded-[2rem] overflow-hidden hover:border-accent-primary/40 transition-all duration-700 hover:-translate-y-2 hover:shadow-ambient" data-aos="fade-up" data-aos-delay={index * 50}>
  <a href={`/projects/${project.slug?.current}`} aria-label={`View project details for ${projectName}`} class="block aspect-[4/3] relative overflow-hidden">
    {imageUrl && (
      <img 
        src={imageUrl} 
        alt={projectName}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-1000 group-hover:scale-110 group-hover:rotate-1"
      />
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-canvas via-canvas/20 to-transparent opacity-90 group-hover:opacity-60 transition-opacity duration-700"></div>
    
    <div class="absolute bottom-6 left-6 right-6 translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
       <div class="flex flex-wrap gap-2 mb-3 opacity-0 group-hover:opacity-100 transition-opacity">
          {tags.slice(0, 2).map((tech: string) => (
            <span class="text-[7px] font-black uppercase tracking-widest px-2 py-1 bg-white/5 border border-border-subtle rounded-full text-text-muted">{tech}</span>
          ))}
       </div>
       <h3 class="text-text-primary uppercase tracking-tighter project-card-title font-sans">{projectName}</h3>
    </div>
  </a>
</div>

<style>
  .project-card-title {
    font-size: clamp(var(--h4-mobile), 1.5vw, var(--h4-desktop));
    font-weight: var(--fw-bold);
  }
</style>
