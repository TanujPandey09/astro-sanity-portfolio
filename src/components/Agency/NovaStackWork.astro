---
// NovaStack Selected Work (Dark Section 1 of 2: --ink #0B111A) + Case Studies (Light Editorial Grid)
// Restores the 3D Tilted-to-Straight Scroll Perspective Project Showcase styled with the current NovaStack Design Tokens & Geist Sans/Mono scale
import { optimizeSanityImage } from "../../lib/optimizeImage";
import { resolveDemoMedia } from "../../lib/videoEmbed";

interface Props {
  sanityProjects?: any[];
  featuredCaseStudies?: any[];
  curatedShowcase?: any[];
}

const {
  sanityProjects = [],
  featuredCaseStudies = [],
  curatedShowcase = [],
} = Astro.props;

const CATEGORY_LABELS: Record<string, string> = {
  "real-estate": "Real Estate & Architecture",
  healthcare: "Healthcare & Medical",
  saas: "SaaS & Tech",
  "ai-automation": "AI & Automation",
  portfolio: "Agency & Portfolio",
  ecommerce: "E-Commerce & Retail",
  dashboard: "Dashboard & Web App",
  fintech: "Fintech & Finance",
  other: "Digital Product",
};

const formatCategory = (raw?: string): string => {
  if (!raw) return "";
  const clean = String(raw).trim();
  return CATEGORY_LABELS[clean.toLowerCase()] || clean;
};

const getProjectImage = (item: any): string =>
  item?.BackgroundImage?.asset?.url ||
  item?.FeatureImage?.asset?.url ||
  item?.thumbnailImage?.asset?.url ||
  (Array.isArray(item?.gallery) && item.gallery[0]?.asset?.url) ||
  "";

const normalizeUrl = (val: any): string => {
  if (!val) return "";
  if (typeof val === "string") return val.trim();
  if (typeof val === "object") {
    const candidate = val.url || val.href || val.current || "";
    return typeof candidate === "string" ? candidate.trim() : "";
  }
  return "";
};

const normalizeText = (val: any, fallback = ""): string => {
  if (typeof val === "string") return val.trim() || fallback;
  if (typeof val === "number") return String(val);
  return fallback;
};

const extractSummary = (rawExcerpt: any, fallbackTagline?: string): string => {
  if (typeof rawExcerpt === "string" && rawExcerpt.trim()) {
    return rawExcerpt.trim();
  }
  if (Array.isArray(rawExcerpt)) {
    const paragraphs = rawExcerpt
      .filter((block: any) => block?._type === "block" && Array.isArray(block.children) && !block.listItem)
      .map((block: any) =>
        block.children
          .map((child: any) => String(child?.text || ""))
          .join("")
          .trim()
      )
      .filter(Boolean);
    if (paragraphs.length > 0) {
      return paragraphs.find((p) => p.length > 35) || paragraphs[0];
    }
  }
  return (
    fallbackTagline ||
    "Production software engineered with clean TypeScript architecture and full ownership."
  );
};

const resolveProjectAccent = (title: string, idx: number): string => {
  const hay = title.toLowerCase();
  if (hay.includes("sawt")) return "#2563EB";
  if (hay.includes("omnexia") || hay.includes("omenixa")) return "#0284C7";
  if (hay.includes("cxisuite")) return "#0D9488";
  if (hay.includes("paper")) return "#38BDF8";

  const fallbacks = ["#2563EB", "#0284C7", "#0D9488", "#3B82F6"];
  return fallbacks[idx % fallbacks.length];
};

interface ShowcaseCard {
  key: string;
  title: string;
  tag: string;
  badge: string;
  liveUrl: string;
  detailUrl: string;
  displayUrlLabel: string;
  img: string;
  demoMedia: ReturnType<typeof resolveDemoMedia>;
}

const mapSanityDocToShowcaseCard = (doc: any, override?: any): ShowcaseCard | null => {
  const rawImg = override?.customImage?.asset?.url || getProjectImage(doc);
  if (!rawImg || typeof rawImg !== "string") return null;

  const isTemplate = doc?._type === "templates" || Boolean(doc?.gumroadLink);
  const title =
    normalizeText(override?.customTitle) ||
    normalizeText(doc?.projectName) ||
    normalizeText(doc?.templateName) ||
    "Untitled Project";

  const slug =
    typeof doc?.slug === "string"
      ? doc.slug.trim()
      : normalizeText(doc?.slug?.current);

  const detailUrl = slug
    ? `${isTemplate ? "/templates/" : "/projects/"}${slug}`
    : "/projects";

  const overrideUrl = normalizeUrl(override?.customUrl);
  const liveUrl = overrideUrl.startsWith("http")
    ? overrideUrl
    : normalizeUrl(doc?.demoLink);

  const displayUrlLabel = liveUrl
    ? liveUrl.replace(/^https?:\/\//, "").replace(/\/$/, "")
    : slug || title;

  const tag =
    normalizeText(override?.customTag) ||
    normalizeText(doc?.agencyHeroTag) ||
    formatCategory(doc?.category) ||
    (Array.isArray(doc?.tags) && normalizeText(doc.tags[0])) ||
    (isTemplate ? "Commercial Template" : "Production Build");

  const badge = isTemplate
    ? normalizeText(doc?.badge, "Commercial Template")
    : normalizeText(doc?.role, "Production Project");

  return {
    key: String(doc?._id || override?._key || slug || title),
    title,
    tag,
    badge,
    liveUrl,
    detailUrl,
    displayUrlLabel,
    img: optimizeSanityImage(rawImg, 1400, 92),
    demoMedia: resolveDemoMedia(doc?.demoVideo?.asset?.url, normalizeUrl(doc?.demoVideoUrl)),
  };
};

// 1. Build 100% Sanity-Driven Tilted Showcase Pool (deduped)
const showcasePool: ShowcaseCard[] = [];
const seenShowcaseKeys = new Set<string>();

for (const entry of curatedShowcase) {
  const doc = entry?.projectRef || {};
  const card = mapSanityDocToShowcaseCard(doc, entry);
  if (card && !seenShowcaseKeys.has(card.key)) {
    seenShowcaseKeys.add(card.key);
    showcasePool.push(card);
  }
}

for (const doc of sanityProjects) {
  const card = mapSanityDocToShowcaseCard(doc);
  if (card && !seenShowcaseKeys.has(card.key)) {
    seenShowcaseKeys.add(card.key);
    showcasePool.push(card);
  }
}

const ensureMinRowLength = (items: ShowcaseCard[], minCount = 4): ShowcaseCard[] => {
  if (!items.length) return [];
  const out = [...items];
  let idx = 0;
  while (out.length < minCount) {
    out.push(items[idx % items.length]);
    idx++;
  }
  return out;
};

const rawRow1 = showcasePool.filter((_, idx) => idx % 2 === 0);
const rawRow2 = showcasePool.filter((_, idx) => idx % 2 === 1);

const baseRow1 = ensureMinRowLength(rawRow1.length ? rawRow1 : showcasePool, 4);
const baseRow2 = ensureMinRowLength(rawRow2.length ? rawRow2 : [...showcasePool].reverse(), 4);

const fullRow1Items = [...baseRow1, ...baseRow1];
const fullRow2Items = [...baseRow2, ...baseRow2];

// 2. Build 100% Sanity-Driven Editorial Case Studies Grid
const autoProjects = (sanityProjects || []).filter(
  (doc) =>
    doc?._type === "projects" &&
    !doc?.gumroadLink &&
    Boolean(doc?.projectName) &&
    Boolean(getProjectImage(doc))
);

const caseStudySource =
  featuredCaseStudies.length > 0 ? featuredCaseStudies : autoProjects;

const caseStudies = caseStudySource.map((doc, idx) => {
  const slug =
    typeof doc?.slug === "string"
      ? doc.slug.trim()
      : normalizeText(doc?.slug?.current);
  const rawImg = getProjectImage(doc);
  const name = normalizeText(doc?.projectName) || normalizeText(doc?.templateName) || "Case Study";
  const stack = Array.isArray(doc?.tags)
    ? doc.tags.filter((t: any) => typeof t === "string" && t.trim()).slice(0, 5)
    : [];
  const demoUrl = normalizeUrl(doc?.demoLink);

  return {
    num: String(idx + 1).padStart(2, "0"),
    name,
    role: normalizeText(doc?.role, "Full-Stack Engineering"),
    category: formatCategory(doc?.category) || stack[0] || "Full-Stack Engineering",
    summary: extractSummary(doc?.excerpt, normalizeText(doc?.tagline)),
    stack,
    demoUrl,
    caseStudyUrl: slug ? `/projects/${slug}` : "/projects",
    posterUrl: rawImg ? optimizeSanityImage(rawImg, 1800, 95) : "",
    demoMedia: resolveDemoMedia(doc?.demoVideo?.asset?.url, normalizeUrl(doc?.demoVideoUrl)),
    accentHex: resolveProjectAccent(name, idx),
  };
});
---

