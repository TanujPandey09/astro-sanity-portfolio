---
// NovaStack Why Us: Matching "Discover Why We Stand Out" with 3 Pastel Bento Cards + Interactive Micro UI Widgets
const differentiators = [
  {
    number: "01",
    tag: "DIRECT COLLABORATION",
    title: "Direct Founder Communication",
    description:
      "Work directly with Tanuj Pandey. No account managers, no junior handoffs, no diluted requirements. Every discussion, technical question, and architectural decision goes directly to the engineer building your product.",
    benefit: "Immediate answers to technical questions & rapid iteration cycles.",
    bgColor: "bg-gradient-to-b from-[#FFFDF5] to-[#FEF3C7]/30",
    borderColor: "border-[#FDE68A]",
    tagColor: "bg-[#FEF3C7] text-[#92400E] border-[#FDE68A]",
    accentDot: "bg-[#D97706]",
    widgetType: "chat"
  },
  {
    number: "02",
    tag: "MODERN ARCHITECTURE",
    title: "Modern React & Next.js Development",
    description:
      "Built with contemporary architectures—Next.js 15, React 19, and strict TypeScript. No legacy template bloat, no obsolete jQuery libraries, and no brittle spaghetti code.",
    benefit: "99+ Core Web Vitals, accessible UI, and clean component systems.",
    bgColor: "bg-gradient-to-b from-[#F0F9FF] to-[#E0F2FE]/40",
    borderColor: "border-[#BAE6FD]",
    tagColor: "bg-[#E0F2FE] text-[#0369A1] border-[#BAE6FD]",
    accentDot: "bg-[#0284C7]",
    widgetType: "code"
  },
  {
    number: "03",
    tag: "100% IP HANDOVER",
    title: "Maintainable Code & Full Ownership",
    description:
      "Full repository transfer, clear documentation, and clean code that any engineer can maintain. You own 100% of the GitHub repository, cloud hosting accounts, and intellectual property from day one.",
    benefit: "Zero proprietary lock-in. Full ownership of your code and assets.",
    bgColor: "bg-gradient-to-b from-[#F0FDF4] to-[#DCFCE7]/40",
    borderColor: "border-[#BBF7D0]",
    tagColor: "bg-[#DCFCE7] text-[#166534] border-[#BBF7D0]",
    accentDot: "bg-[#16A34A]",
    widgetType: "git"
  }
];
---

<section id="why-us" class="py-20 sm:py-28 bg-white text-[#0F172A] border-b border-[#E2E8F0]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <!-- Section Header (Matching "Discover Why We Stand Out") -->
    <div class="text-center max-w-3xl mx-auto mb-14 sm:mb-18">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#EFF6FF] border border-[#BFDBFE] text-[11px] font-mono font-semibold uppercase tracking-[0.16em] text-[#2563EB] mb-3">
        // WHY WORK WITH NOVASTACK
      </span>
      <h2 class="font-grotesk font-extrabold text-3xl sm:text-5xl text-[#0F172A] tracking-[-0.035em] leading-[1.08]">
        Discover why we stand out.
      </h2>
      <p class="text-sm sm:text-base text-[#64748B] mt-3 leading-relaxed font-sans max-w-xl mx-auto">
        Founder-led engineering without the layers, overhead, or misaligned incentives of traditional agencies.
      </p>
    </div>

    <!-- 3 Pastel Bento Cards (Matching Reference Template's Trio Grid) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 items-stretch mb-8">
      {differentiators.map((item) => (
        <div class={`agency-card rounded-2xl sm:rounded-3xl p-6 sm:p-7 border ${item.borderColor} ${item.bgColor} shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between`}>
          <div>
            <!-- Top Tag & Number -->
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class={`text-[10px] font-mono uppercase tracking-wider font-bold px-3 py-1 rounded-full border ${item.tagColor}`}>
                {item.tag}
              </span>
              <span class="font-mono text-xs font-bold text-[#64748B]">
                {item.number}
              </span>
            </div>

            <!-- Micro Interactive UI Widget Preview (Inspired by Reference Template) -->
            <div class="mb-5 rounded-xl bg-white/80 backdrop-blur-xs border border-white/60 p-3.5 shadow-2xs">
              {item.widgetType === "chat" && (
                <div class="space-y-2">
                  <div class="flex items-center gap-2 text-[11px] font-sans">
                    <span class="w-6 h-6 rounded-full bg-[#2563EB] text-white flex items-center justify-center font-bold text-[10px]">TP</span>
                    <span class="bg-[#F1F5F9] px-2.5 py-1 rounded-lg text-[#0F172A] font-medium">Let's review the API architecture on staging today.</span>
                  </div>
                  <div class="flex items-center justify-end gap-2 text-[11px] font-sans">
                    <span class="bg-[#EFF6FF] text-[#1D4ED8] border border-[#BFDBFE] px-2.5 py-1 rounded-lg font-medium">Looks great, staging demo approved! ✓</span>
                  </div>
                </div>
              )}

              {item.widgetType === "code" && (
                <div class="space-y-1.5 font-mono text-[11px]">
                  <div class="flex items-center justify-between text-[#64748B] text-[10px] pb-1 border-b border-slate-100">
                    <span>Component.tsx</span>
                    <span class="text-emerald-600 font-bold">TypeScript Strict</span>
                  </div>
                  <p class="text-[#0F172A] leading-snug">
                    <span class="text-[#2563EB]">export const</span> Page = <span class="text-[#38BDF8]">async</span> () =&gt; &#123; <br />
                    &nbsp;&nbsp;<span class="text-slate-500">// 99+ Core Web Vitals SSR</span>
                  </p>
                </div>
              )}

              {item.widgetType === "git" && (
                <div class="flex items-center justify-between text-xs font-mono">
                  <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                    <span class="font-bold text-[#0F172A]">Repo Handover</span>
                  </div>
                  <span class="text-[10px] bg-emerald-100 text-emerald-800 border border-emerald-200 px-2 py-0.5 rounded-full font-semibold">
                    100% Transfer
                  </span>
                </div>
              )}
            </div>

            <h3 class="font-grotesk font-extrabold text-xl sm:text-2xl text-[#0F172A] tracking-tight mb-2.5">
              {item.title}
            </h3>

            <p class="text-xs sm:text-sm text-[#64748B] leading-relaxed font-sans mb-5">
              {item.description}
            </p>
          </div>

          <div class="pt-4 border-t border-black/5 text-xs font-mono text-[#0F172A]">
            <span class="font-bold text-[#2563EB]">Advantage:</span> {item.benefit}
          </div>
        </div>
      ))}
    </div>

    <!-- 4th Differentiator: Full-Width Feature Banner (Clear Scope & Transparent Milestones) -->
    <div class="agency-card rounded-2xl sm:rounded-3xl p-6 sm:p-8 bg-gradient-to-r from-[#EFF6FF] via-[#F8FAFC] to-[#F0F9FF] border border-[#BFDBFE] shadow-sm">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
        
        <div class="lg:col-span-8 space-y-2">
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full bg-[#2563EB] text-white text-[10px] font-mono font-bold uppercase tracking-wider">
              04 · PREDICTABLE PROCESS
            </span>
            <span class="text-xs font-mono text-[#64748B]">Zero unexpected scope creep</span>
          </div>
          <h3 class="font-grotesk font-extrabold text-xl sm:text-2xl text-[#0F172A] tracking-tight">
            Clear Scope &amp; Transparent Milestones
          </h3>
          <p class="text-xs sm:text-sm text-[#64748B] font-sans leading-relaxed max-w-2xl">
            Every project starts with defined deliverables, fixed quotes, and scheduled milestone reviews. You test working code on a private staging link before moving to the next sprint.
          </p>
        </div>

        <div class="lg:col-span-4 flex flex-col justify-center items-start lg:items-end">
          <div class="p-4 rounded-xl bg-white/90 backdrop-blur-xs border border-[#BFDBFE] w-full text-xs font-mono space-y-1.5 shadow-2xs">
            <div class="flex items-center justify-between">
              <span class="text-[#64748B]">Milestone Sign-Off</span>
              <span class="text-[#2563EB] font-bold">5 Stages</span>
            </div>
            <div class="w-full bg-[#E2E8F0] h-1.5 rounded-full overflow-hidden">
              <div class="bg-[#2563EB] h-full w-full rounded-full"></div>
            </div>
            <span class="text-[10px] text-[#15803D] font-bold block pt-0.5">
              ✓ Tested on live private staging URL
            </span>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>
