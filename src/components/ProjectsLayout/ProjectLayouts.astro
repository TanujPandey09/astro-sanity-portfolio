---
import ProjectItem from "../ProjectItem.astro";
import SectionHeader from "../SectionHeader.astro";
import PremiumBackground from "../PremiumBackground.astro";

interface Props {
  projectData: any[];
}

const { projectData = [] } = Astro.props;
---

<div class="relative min-h-screen selection:bg-accent-primary/30 overflow-hidden">
  <PremiumBackground />

  <main class="container mx-auto px-4 md:px-8 py-24 md:py-32 relative z-10">
    <div class="max-w-7xl mx-auto">
      
      <!-- Section Header -->
      <SectionHeader 
        eyebrow="Portfolio // Showcase"
        title="Complete" 
        gradientText="Projects" 
        subtitle="A comprehensive showcase of production applications, enterprise SaaS platforms, and client deliveries."
      />

      <!-- Bento Grid displaying all projects directly in SSR -->
      <div 
        id="projects-grid" 
        class="mt-12 md:mt-16 grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8"
      >
        {projectData.map((project: any, index: number) => (
          <ProjectItem project={project} index={index} />
        ))}
      </div>

      <!-- Advanced Stats Footer -->
      <div class="mt-20 md:mt-32 stats-grid grid grid-cols-2 lg:grid-cols-4 gap-6 md:gap-10 py-10 md:py-16 border-t border-border-subtle">
         {[
           { label: "Completed Builds", value: `${projectData.length}+` },
           { label: "Commits Pushed", value: "1.2K+" },
           { label: "Success Rate", value: "100%" },
           { label: "Happy Clients", value: "25+" }
         ].map(stat => (
           <div class="space-y-2">
              <p class="text-[9px] md:text-[10px] font-mono uppercase tracking-[0.3em] text-text-dim">{stat.label}</p>
              <h4 class="text-2xl md:text-4xl font-extrabold text-white tracking-tight tabular-nums">{stat.value}</h4>
           </div>
         ))}
      </div>

    </div>
  </main>
</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initStats = () => {
    gsap.from('.stats-grid > div', {
      opacity: 0,
      y: 20,
      duration: 0.8,
      stagger: 0.1,
      ease: "power3.out",
      scrollTrigger: {
        trigger: '.stats-grid',
        start: "top 95%"
      }
    });
  };

  initStats();
  document.addEventListener('astro:after-swap', initStats);
</script>