---
import { useSanityClient, groq } from "astro-sanity";
import { fallbackSanityClient } from "../lib/sanityClient.js";
import ProjectItem from "./ProjectItem.astro";
import BlogItem from "./BlogItem.astro";
import AiChatbot from "./AiChatbot";
import Hero from "./Hero.astro";
import Services from "./Services.astro";
import Experience from "./Experience.astro";
import Contact from "./Contact.astro";
import SectionHeader from "./SectionHeader.astro";
import ProjectCard from "./ProjectCard.astro";
import TemplateCard from "./TemplateCard.astro";

import { fetchAllTemplates } from "../lib/templates";

const query = groq`*[_type == "projects" && !defined(gumroadLink) && !(slug.current in [
  "lumina-dental-premium-dental-website-template",
  "apex-luxury-ultra-luxury-real-estate-and-architectural-web-template"
])]{...,BackgroundImage{asset->{url}},demoVideo{asset->{url}}}`;
const blogquery = groq`*[_type == "blogs"] | order(_createdAt desc) {...,FeatureImage{asset->{url}},BackgroundImage{asset->{url}}}`;
const bannerQuery = groq`*[_type == "herobanner"] | order(_updatedAt desc)[0]{_updatedAt, BackgroundImage{asset->{url}}}`;
const aboutPortraitQuery = groq`*[_type == "about"] | order(_updatedAt desc)[0]{_updatedAt, heroImage{asset->{url}}}`;

const fetchWithFallback = async (groqQuery: string) => {
  try {
    const res = await useSanityClient().fetch(groqQuery);
    if (res && (!Array.isArray(res) || res.length > 0)) return res;
  } catch {}
  try {
    return await fallbackSanityClient.fetch(groqQuery);
  } catch (err) {
    console.warn("Could not fetch from Sanity:", err);
    return null;
  }
};

const [projectResult, blogResult, bannerResult, aboutResult] = await Promise.all([
  fetchWithFallback(query),
  fetchWithFallback(blogquery),
  fetchWithFallback(bannerQuery),
  fetchWithFallback(aboutPortraitQuery),
]);

const projectData = Array.isArray(projectResult) ? projectResult : [];
const blogData = Array.isArray(blogResult) ? blogResult : [];
const aboutUrl = aboutResult?.heroImage?.asset?.url;
const bannerUrl = bannerResult?.BackgroundImage?.asset?.url;
const aboutUpdatedAt = aboutResult?._updatedAt ? Date.parse(aboutResult._updatedAt) : 0;
const bannerUpdatedAt = bannerResult?._updatedAt ? Date.parse(bannerResult._updatedAt) : 0;
const homePortraitUrl =
  aboutUrl && (!bannerUrl || aboutUpdatedAt >= bannerUpdatedAt)
    ? aboutUrl
    : bannerUrl || undefined;

const templatesData = await fetchAllTemplates();
const featuredProjects = projectData.slice(0, 4);
const extraProjects = projectData.slice(4);
---

<div class="relative min-h-screen w-full max-w-[100vw] overflow-x-clip bg-white selection:bg-[#5E6AD2]/20">
  <!-- 1. OBSIDIAN HERO -->
  <Hero portraitUrl={homePortraitUrl} />

  <!-- 2. SELECTED WORK (#FFFFFF Band — Uniform Architectural Browser Frames) -->
  <section id="projects" class="py-16 sm:py-20 bg-white relative z-10">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeader
        eyebrow="01 / Selected Work"
        title="Selected"
        gradientText="Work."
        subtitle="Production SaaS platforms, multi-LLM AI systems, and high-performance web architectures shipped end-to-end."
      />

      <div class="flex flex-col gap-14 sm:gap-20">
        {featuredProjects.map((project, idx) => (
          <ProjectItem project={project} index={idx} />
        ))}
      </div>

      {extraProjects.length > 0 && (
        <div class="mt-12 pt-8 border-t border-black/[0.08]">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
            <div>
              <h3 class="font-grotesk text-lg sm:text-xl font-bold text-[#0F172A] tracking-tight">More Shipped Builds</h3>
              <p class="text-xs sm:text-sm text-slate-500 mt-0.5">Additional client deliveries, internal tools, and web applications.</p>
            </div>
            <div class="flex items-center gap-3">
              <button
                id="expand-repo"
                aria-label="Show all additional projects"
                aria-expanded="false"
                class="group inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-[#FAFAFB] border border-black/10 hover:border-[#5E6AD2] hover:text-[#5E6AD2] text-xs font-mono text-[#0F172A] transition-colors cursor-pointer"
              >
                <span>Show All ({extraProjects.length})</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" id="repo-icon" class="transition-transform duration-300"><path d="m6 9 6 6 6-6"/></svg>
              </button>
              <a
                href="/projects"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#0F172A] hover:bg-[#5E6AD2] text-white text-xs font-mono font-semibold transition-colors"
              >
                <span>Full Archive</span>
                <span>↗</span>
              </a>
            </div>
          </div>

          <div id="repo-grid" class="hidden grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {extraProjects.map((project, index) => (
              <ProjectCard project={project} index={index} />
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- 3. CAPABILITIES, IMPACT & CORE STACK (#FAFAFB Band) -->
  <Services />

  <!-- 4. WORK EXPERIENCE (#FFFFFF Band) -->
  <Experience />

  <!-- 5. COMMERCIAL TEMPLATES (#FFFFFF Gallery Band) -->
  {templatesData && templatesData.length > 0 && (
    <section id="templates" class="py-16 sm:py-20 bg-white border-b border-slate-200/80 relative z-10">
      <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 mb-8 sm:mb-10">
          <div class="max-w-2xl">
            <div class="flex items-center gap-2.5 mb-3">
              <span class="w-5 h-px bg-[#5E6AD2]" aria-hidden="true"></span>
              <span class="text-[11px] sm:text-xs font-mono font-semibold tracking-[0.14em] text-[#5E6AD2] uppercase">
                04 / Commercial Templates
              </span>
            </div>
            <h2 class="font-grotesk font-bold tracking-[-0.03em] leading-[1.08] text-3xl sm:text-4xl lg:text-[44px] text-[#0F172A]">
              Production <span class="text-[#5E6AD2]">Templates.</span>
            </h2>
          </div>

          <a
            href="/templates"
            class="inline-flex items-center gap-2 text-xs font-mono font-semibold text-[#0F172A] hover:text-[#5E6AD2] transition-colors self-start lg:self-auto"
          >
            <span>Browse All Templates</span>
            <span class="text-[#5E6AD2]">→</span>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {templatesData.slice(0, 3).map((template, index) => (
            <TemplateCard template={template} index={index} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 6. ENGINEERING WRITING (#EEF1FA Cool Indigo-Tinted Editorial Band) -->
  <section id="blogs" class="py-16 sm:py-20 bg-[#EEF1FA] border-b border-[#5E6AD2]/15 relative z-10">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 mb-8 sm:mb-10">
        <div class="max-w-2xl">
          <div class="flex items-center gap-2.5 mb-3">
            <span class="w-5 h-px bg-[#5E6AD2]" aria-hidden="true"></span>
            <span class="text-[11px] sm:text-xs font-mono font-semibold tracking-[0.14em] text-[#5E6AD2] uppercase">
              05 / Engineering Writing
            </span>
          </div>
          <h2 class="font-grotesk font-bold tracking-[-0.03em] leading-[1.08] text-3xl sm:text-4xl lg:text-[44px] text-[#0F172A]">
            Engineering <span class="text-[#5E6AD2]">Writing.</span>
          </h2>
        </div>

        <a
          href="/blogs"
          class="inline-flex items-center gap-2 text-xs font-mono font-semibold text-[#0F172A] hover:text-[#5E6AD2] transition-colors self-start lg:self-auto"
        >
          <span>Read All Articles</span>
          <span class="text-[#5E6AD2]">→</span>
        </a>
      </div>

      <div class="rounded-2xl bg-white border border-black/[0.08] overflow-hidden shadow-sm">
        {blogData?.slice(0, 4).map((blog, index) => (
          <BlogItem blog={blog} index={index} />
        ))}
      </div>
    </div>
  </section>

  <!-- 6. DIRECT CONTACT (#FFFFFF Band) -->
  <Contact />
</div>

<AiChatbot client:load />

<script>
  const setupRepoExpand = () => {
    const expandBtn = document.getElementById('expand-repo');
    const repoGrid = document.getElementById('repo-grid');
    const repoIcon = document.getElementById('repo-icon');

    if (!expandBtn || !repoGrid || expandBtn.dataset.bound === 'true') return;
    expandBtn.dataset.bound = 'true';

    expandBtn.addEventListener('click', () => {
      const willExpand = repoGrid.classList.contains('hidden');
      repoGrid.classList.toggle('hidden', !willExpand);
      repoGrid.classList.toggle('grid', willExpand);
      repoIcon?.classList.toggle('rotate-180', willExpand);

      expandBtn.setAttribute('aria-expanded', String(willExpand));
      const labelSpan = expandBtn.querySelector('span');
      if (labelSpan) {
        const countMatch = labelSpan.textContent?.match(/\(\d+\)/)?.[0] || '';
        labelSpan.textContent = willExpand ? 'Collapse List' : `Show All ${countMatch}`.trim();
      }
    });
  };

  setupRepoExpand();
  document.addEventListener('astro:page-load', setupRepoExpand);
  document.addEventListener('astro:after-swap', setupRepoExpand);
</script>
