---
import SectionHeader from "./SectionHeader.astro";

const projectScopes = [
  "Full-Stack SaaS MVP",
  "AI / Multi-LLM System",
  "Full-Time Senior Role",
  "Template Customization"
];
---

<section id="contact" class="py-14 sm:py-16 lg:py-20 relative z-10 bg-canvas border-t border-black/[0.08]">
  <div class="w-full max-w-7xl mx-auto">
    
    <!-- Unified Section Header -->
    <SectionHeader
      eyebrow="08 / Direct Contact · Replies < 2 Hours"
      title="Let’s Work"
      gradientText="Together."
      subtitle="Have a product to launch, an AI system to engineer, or a senior role to fill? Reach me directly on WhatsApp, copy my email, or send a quick brief below."
    />

    <div class="grid lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
      
      <!-- Left Column: High-Contrast Obsidian Direct Channels Card -->
      <div class="lg:col-span-5 min-w-0 flex">
        <div data-gsap-card class="w-full rounded-2xl bg-[#0A0B0E] text-white border border-white/10 p-6 sm:p-8 flex flex-col justify-between space-y-8 shadow-xl relative overflow-hidden">
          <div class="absolute -top-24 -right-24 w-64 h-64 rounded-full bg-[radial-gradient(circle,rgba(94,106,210,0.28)_0%,transparent_70%)] pointer-events-none"></div>

          <div class="space-y-6 relative z-10">
            <!-- Instant WhatsApp Action Card -->
            <a
              href="https://wa.me/919557321978?text=Hi%20Tanuj%2C%20I%20saw%20your%20portfolio%20and%20would%20like%20to%20discuss%20working%20together."
              target="_blank"
              rel="noopener noreferrer"
              class="group block p-5 rounded-2xl bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-400/25 hover:border-emerald-400/50 transition-all"
            >
              <div class="flex items-center justify-between gap-3">
                <div>
                  <span class="text-[10px] font-mono uppercase tracking-[0.16em] text-emerald-400 font-bold block">FASTEST RESPONSE · LIVE</span>
                  <span class="font-grotesk font-bold text-lg text-white block mt-1">Message on WhatsApp</span>
                  <span class="text-xs font-mono text-slate-300 tabular-nums">+91 95573 21978</span>
                </div>
                <span class="w-11 h-11 rounded-full bg-emerald-500 text-[#0A0B0E] flex items-center justify-center font-bold text-base group-hover:scale-105 transition-transform shrink-0">
                  ↗
                </span>
              </div>
            </a>

            <!-- Direct Email with One-Click Copy -->
            <div class="p-5 bg-white/[0.04] border border-white/10 rounded-2xl space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-mono uppercase tracking-[0.12em] text-slate-300">DIRECT EMAIL</span>
                <span class="text-[10px] font-mono text-emerald-400 bg-emerald-500/10 border border-emerald-400/25 px-2.5 py-0.5 rounded-full">Active</span>
              </div>
              <div class="flex items-center justify-between gap-3">
                <a href="mailto:tanujp09@gmail.com" class="text-sm sm:text-base font-mono font-semibold text-white hover:text-[#828FFF] transition-colors truncate">
                  tanujp09@gmail.com
                </a>
                <button
                  type="button"
                  id="contact-copy-email"
                  data-email="tanujp09@gmail.com"
                  class="shrink-0 inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-white hover:bg-slate-200 text-[#0A0B0E] text-xs font-mono font-bold rounded-full transition-all active:scale-95 cursor-pointer"
                >
                  <span id="contact-copy-text">Copy</span>
                </button>
              </div>
            </div>

            <!-- Phone & Location Details -->
            <div class="space-y-3 pt-1">
              <a href="tel:+919557321978" class="flex items-center gap-4 group/link p-3 hover:bg-white/[0.04] rounded-xl transition-colors">
                <div class="w-10 h-10 bg-white/[0.06] border border-white/10 rounded-xl flex items-center justify-center text-slate-300 group-hover/link:border-[#5E6AD2] group-hover/link:text-white transition-all shrink-0">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </div>
                <div>
                  <p class="text-[10px] font-mono uppercase tracking-[0.12em] text-slate-300">Direct Call</p>
                  <p class="text-sm text-white font-semibold group-hover/link:text-[#828FFF] transition-colors tabular-nums">+91 9557321978</p>
                </div>
              </a>

              <div class="flex items-center gap-4 p-3">
                <div class="w-10 h-10 bg-white/[0.06] border border-white/10 rounded-xl flex items-center justify-center text-slate-300 shrink-0">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                </div>
                <div>
                  <p class="text-[10px] font-mono uppercase tracking-[0.12em] text-slate-300">Base &amp; Timezone</p>
                  <p class="text-sm text-white font-semibold">Uttarakhand, India · IST (UTC+5:30)</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Bottom Social Row -->
          <div class="pt-6 border-t border-white/10 flex items-center justify-between gap-3 relative z-10">
            <span class="text-xs font-mono uppercase tracking-[0.1em] text-slate-300">CONNECT</span>
            <div class="flex gap-2.5">
              <a href="https://github.com/TanujPandey09" target="_blank" rel="noopener noreferrer" aria-label="GitHub Profile" class="px-4 py-2 bg-white/[0.06] border border-white/10 hover:bg-white hover:text-[#0A0B0E] text-xs font-mono text-white rounded-full transition-all inline-flex items-center gap-2">
                <span>GitHub</span>
                <span>↗</span>
              </a>
              <a href="https://linkedin.com/in/tanujdev" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn Profile" class="px-4 py-2 bg-white/[0.06] border border-white/10 hover:bg-white hover:text-[#0A0B0E] text-xs font-mono text-white rounded-full transition-all inline-flex items-center gap-2">
                <span>LinkedIn</span>
                <span>↗</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Clean Editorial Inquiry Form -->
      <div class="lg:col-span-7 min-w-0 flex">
        <div data-gsap-card class="w-full rounded-2xl bg-white border border-black/[0.08] p-6 sm:p-8 shadow-xs flex flex-col justify-between">
          <div>
            <!-- Quick Scope Chips -->
            <div class="mb-7 pb-6 border-b border-black/[0.08]">
              <span class="text-[11px] font-mono uppercase tracking-[0.14em] text-slate-500 font-semibold block mb-3">
                WHAT ARE WE BUILDING? (TAP TO PRE-FILL)
              </span>
              <div class="flex flex-wrap gap-2" id="contact-scope-pills">
                {projectScopes.map((scope) => (
                  <button
                    type="button"
                    data-scope={scope}
                    class="contact-scope-pill px-4 py-2 rounded-full text-xs font-mono font-medium bg-slate-100 hover:bg-slate-200 border border-black/[0.06] text-slate-700 transition-all cursor-pointer"
                  >
                    {scope}
                  </button>
                ))}
              </div>
            </div>

            <form id="contactForm" class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <!-- Honeypot -->
              <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
                <label for="contact-company-website">Company website</label>
                <input id="contact-company-website" type="text" name="company_website" tabindex="-1" autocomplete="off" />
              </div>

              <div class="space-y-2">
                <label for="contact-name" class="block text-xs font-grotesk font-semibold uppercase tracking-[0.06em] text-slate-700">Your Name*</label>
                <input id="contact-name" type="text" name="from_name" required placeholder="Alex Rivera" class="w-full bg-slate-50 border border-black/10 rounded-xl px-4 py-3.5 text-[#0F172A] placeholder:text-slate-400 focus:bg-white focus:outline-none focus:border-accent-primary transition-all text-sm" />
              </div>

              <div class="space-y-2">
                <label for="contact-email" class="block text-xs font-grotesk font-semibold uppercase tracking-[0.06em] text-slate-700">Work Email*</label>
                <input id="contact-email" type="email" name="from_email" required placeholder="alex@vanguard.dev" class="w-full bg-slate-50 border border-black/10 rounded-xl px-4 py-3.5 text-[#0F172A] placeholder:text-slate-400 focus:bg-white focus:outline-none focus:border-accent-primary transition-all text-sm" />
              </div>

              <div class="md:col-span-2 space-y-2">
                <label for="contact-subject" class="block text-xs font-grotesk font-semibold uppercase tracking-[0.06em] text-slate-700">Project Scope or Role*</label>
                <input id="contact-subject" type="text" name="subject" required placeholder="Full-Stack SaaS Build / Engineering Role" class="w-full bg-slate-50 border border-black/10 rounded-xl px-4 py-3.5 text-[#0F172A] placeholder:text-slate-400 focus:bg-white focus:outline-none focus:border-accent-primary transition-all text-sm" />
              </div>

              <div class="md:col-span-2 space-y-2">
                <label for="contact-message" class="block text-xs font-grotesk font-semibold uppercase tracking-[0.06em] text-slate-700">Project Details*</label>
                <textarea id="contact-message" name="message" required rows="4" placeholder="Share your timeline, tech stack, or goals..." class="w-full bg-slate-50 border border-black/10 rounded-xl px-4 py-3.5 text-[#0F172A] placeholder:text-slate-400 focus:bg-white focus:outline-none focus:border-accent-primary transition-all resize-none text-sm"></textarea>
              </div>

              <div class="md:col-span-2 pt-3 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <span class="text-xs font-mono text-slate-500">Direct inbox delivery · Zero automated bots</span>
                <button type="submit" class="magnetic-btn group relative inline-flex items-center justify-center gap-3 px-8 py-4 bg-[#0A0B0E] hover:bg-black text-white font-grotesk font-bold text-xs uppercase tracking-[0.06em] rounded-full transition-all duration-300 active:scale-[0.98] cursor-pointer shadow-lg">
                  <span>Send Message</span>
                  <span class="text-xs font-bold transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
                </button>
              </div>
            </form>
          </div>
          <div id="form-status" class="mt-5 text-center text-xs font-mono hidden"></div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import { trackEvent } from '../lib/analytics';

  const setupContactSection = () => {
    const form = document.getElementById('contactForm') as HTMLFormElement | null;
    const status = document.getElementById('form-status');
    const copyBtn = document.getElementById('contact-copy-email');
    const copyText = document.getElementById('contact-copy-text');
    const subjectInput = document.getElementById('contact-subject') as HTMLInputElement | null;

    // Quick-scope chips
    document.querySelectorAll('.contact-scope-pill').forEach((pill) => {
      if (pill.hasAttribute('data-bound')) return;
      pill.setAttribute('data-bound', 'true');
      pill.addEventListener('click', () => {
        const val = pill.getAttribute('data-scope') || '';
        document.querySelectorAll('.contact-scope-pill').forEach((p) => {
          p.classList.remove('bg-[#0A0B0E]', 'text-white', 'border-[#0A0B0E]');
          p.classList.add('bg-slate-100', 'text-slate-700');
        });
        pill.classList.remove('bg-slate-100', 'text-slate-700');
        pill.classList.add('bg-[#0A0B0E]', 'text-white', 'border-[#0A0B0E]');
        if (subjectInput) subjectInput.value = val;
      });
    });

    if (copyBtn && !copyBtn.hasAttribute('data-bound')) {
      copyBtn.setAttribute('data-bound', 'true');
      copyBtn.addEventListener('click', async () => {
        const email = copyBtn.getAttribute('data-email') || 'tanujp09@gmail.com';
        try {
          await navigator.clipboard.writeText(email);
          if (copyText) {
            copyText.textContent = 'Copied ✓';
            setTimeout(() => {
              copyText.textContent = 'Copy';
            }, 2000);
          }
        } catch {
          window.location.href = `mailto:${email}`;
        }
      });
    }

    const showStatus = (msg: string, isError = false) => {
      if (!status) return;
      status.textContent = msg;
      status.className = `mt-5 text-center text-xs font-mono p-3.5 rounded-xl ${isError ? 'bg-red-50 text-red-700 border border-red-200' : 'bg-emerald-50 text-emerald-800 border border-emerald-200'}`;
      status.classList.remove('hidden');
      setTimeout(() => status.classList.add('hidden'), 5000);
    };

    if (form && !form.hasAttribute('data-bound')) {
      form.setAttribute('data-bound', 'true');
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
        if (!submitBtn) return;
        const originalText = submitBtn.innerHTML;
        
        submitBtn.disabled = true;
        submitBtn.innerHTML = `<span class="px-4">Sending...</span>`;

        try {
          const resp = await fetch('/api/contact', {
            method: 'POST',
            body: new FormData(form)
          });

          if (resp.ok) {
            showStatus('Message received. I will reply within 2–24 hours.');
            trackEvent('generate_lead', { method: 'contact_form' });
            form.reset();
          } else {
            const errorData = await resp.json().catch(() => ({}));
            throw new Error(errorData.message || 'Submission failed');
          }
        } catch (error) {
          console.error('Submit Error:', error);
          const msg = error instanceof Error && error.message && error.message !== 'Submission failed'
            ? error.message
            : 'Could not send message. Please email tanujp09@gmail.com or message on WhatsApp.';
          showStatus(msg, true);
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalText;
        }
      });
    }
  };

  setupContactSection();
  document.addEventListener('astro:after-swap', setupContactSection);
  document.addEventListener('astro:page-load', setupContactSection);
</script>
