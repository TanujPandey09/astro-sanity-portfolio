---
// NovaStack Dedicated Agency Header: Sleek Dark Obsidian Glass Bar
interface Props {
  logoUrl?: string;
  logoAlt?: string;
  brandName?: string;
  tagline?: string;
  logoFullWidth?: boolean;
}

const {
  logoUrl = "",
  logoAlt = "NovaStack Logo",
  brandName = "NovaStack",
  tagline = "AI & Digital Studio",
  logoFullWidth = false,
} = Astro.props;
---

<header class="sticky top-0 z-50 w-full bg-[#090A0F]/80 backdrop-blur-xl border-b border-white/[0.08] transition-all duration-300" id="agency-header">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 sm:h-[72px] items-center justify-between gap-4">

      <!-- Brand Logo / Wordmark -->
      <div class="flex items-center">
        <a href="/agency" class="group flex items-center gap-2.5 text-decoration-none">
          {logoUrl ? (
            <img
              src={logoUrl}
              alt={logoAlt}
              class={logoFullWidth ? "h-8 sm:h-9 w-auto max-w-[170px] object-contain" : "h-8 sm:h-9 w-8 sm:w-9 rounded-xl object-contain bg-white/[0.04] border border-white/15 p-1 group-hover:border-[#5E6AD2] transition-colors"}
              loading="eager"
              decoding="async"
            />
          ) : (
            <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-white/[0.07] border border-white/15 text-white flex items-center justify-center font-grotesk font-extrabold text-sm sm:text-base shadow-sm group-hover:border-[#5E6AD2] transition-colors">
              N<span class="text-[#828FFF]">S</span>
            </div>
          )}
          {!(logoUrl && logoFullWidth) && (
            <div class="flex flex-col">
              <span class="font-grotesk font-bold text-base sm:text-lg tracking-tight text-white">
                {brandName}<span class="text-[#828FFF]">.</span>
              </span>
              <span class="text-[9px] font-mono uppercase tracking-[0.14em] text-slate-300 -mt-0.5 hidden sm:block">
                {tagline}
              </span>
            </div>
          )}
        </a>
      </div>

      <!-- Desktop Navigation Links -->
      <nav aria-label="Agency Navigation" class="hidden lg:flex items-center gap-6 xl:gap-7">
        <a href="#services" class="text-[11px] font-grotesk font-semibold uppercase tracking-[0.08em] text-slate-300 hover:text-white transition-colors">
          Services
        </a>
        <a href="#capabilities" class="text-[11px] font-grotesk font-semibold uppercase tracking-[0.08em] text-slate-300 hover:text-white transition-colors">
          Capabilities
        </a>
        <a href="#work" class="text-[11px] font-grotesk font-semibold uppercase tracking-[0.08em] text-slate-300 hover:text-white transition-colors">
          Work
        </a>
        <a href="#why-us" class="text-[11px] font-grotesk font-semibold uppercase tracking-[0.08em] text-slate-300 hover:text-white transition-colors">
          Why Us
        </a>
        <a href="#process" class="text-[11px] font-grotesk font-semibold uppercase tracking-[0.08em] text-slate-300 hover:text-white transition-colors">
          Process
        </a>
        <a href="#models" class="text-[11px] font-grotesk font-semibold uppercase tracking-[0.08em] text-slate-300 hover:text-white transition-colors">
          Engagement
        </a>
        <a href="#faq" class="text-[11px] font-grotesk font-semibold uppercase tracking-[0.08em] text-slate-300 hover:text-white transition-colors">
          FAQ
        </a>
      </nav>

      <!-- Right Action Items -->
      <div class="flex items-center gap-2.5 sm:gap-3">
        <a
          href="/"
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-white/15 bg-white/[0.04] hover:bg-white/[0.09] text-[11px] font-mono text-slate-300 hover:text-white transition-all"
          title="Return to Tanuj Pandey's Personal Portfolio & Engineer Profile"
        >
          <span>Portfolio</span>
          <span class="text-slate-400">↗</span>
        </a>

        <a
          href="#contact"
          class="inline-flex items-center justify-center gap-2 px-4 sm:px-5 py-2 sm:py-2.5 rounded-full bg-white hover:bg-slate-200 text-[#090A0F] font-grotesk font-bold text-xs uppercase tracking-wider shadow-sm transition-all active:scale-[0.98]"
        >
          <span>Start a Project</span>
          <span>→</span>
        </a>

        <!-- Mobile Menu Toggle -->
        <button
          type="button"
          id="agency-menu-toggle"
          aria-expanded="false"
          aria-controls="agency-mobile-menu"
          aria-label="Toggle navigation menu"
          class="lg:hidden inline-flex items-center justify-center p-2 rounded-lg text-slate-300 hover:text-white hover:bg-white/10 focus:outline-none"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" id="agency-menu-open-icon">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" id="agency-menu-close-icon">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Drawer -->
  <div id="agency-mobile-menu" class="hidden lg:hidden border-t border-white/10 bg-[#0D0F17] px-4 pt-3 pb-6 shadow-2xl">
    <nav class="flex flex-col space-y-2">
      <a href="#services" class="agency-mobile-link px-3 py-2 text-sm font-grotesk font-semibold uppercase tracking-wider text-slate-300 hover:text-white hover:bg-white/5 rounded-lg">Services</a>
      <a href="#capabilities" class="agency-mobile-link px-3 py-2 text-sm font-grotesk font-semibold uppercase tracking-wider text-slate-300 hover:text-white hover:bg-white/5 rounded-lg">Capabilities</a>
      <a href="#work" class="agency-mobile-link px-3 py-2 text-sm font-grotesk font-semibold uppercase tracking-wider text-slate-300 hover:text-white hover:bg-white/5 rounded-lg">Featured Work</a>
      <a href="#why-us" class="agency-mobile-link px-3 py-2 text-sm font-grotesk font-semibold uppercase tracking-wider text-slate-300 hover:text-white hover:bg-white/5 rounded-lg">Why NovaStack</a>
      <a href="#process" class="agency-mobile-link px-3 py-2 text-sm font-grotesk font-semibold uppercase tracking-wider text-slate-300 hover:text-white hover:bg-white/5 rounded-lg">Development Process</a>
      <a href="#models" class="agency-mobile-link px-3 py-2 text-sm font-grotesk font-semibold uppercase tracking-wider text-slate-300 hover:text-white hover:bg-white/5 rounded-lg">Engagement Models</a>
      <a href="#faq" class="agency-mobile-link px-3 py-2 text-sm font-grotesk font-semibold uppercase tracking-wider text-slate-300 hover:text-white hover:bg-white/5 rounded-lg">FAQ</a>
      <div class="pt-3 border-t border-white/10 flex flex-col gap-2">
        <a href="/" class="px-3 py-2 text-xs font-mono text-slate-400 hover:text-white">
          ← Back to Personal Portfolio (Tanuj Pandey)
        </a>
        <a href="#contact" class="agency-mobile-link w-full text-center px-4 py-2.5 rounded-full bg-white text-[#090A0F] font-grotesk font-bold text-xs uppercase tracking-wider">
          Start a Project →
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const initAgencyHeader = () => {
    const toggleBtn = document.getElementById('agency-menu-toggle');
    const mobileMenu = document.getElementById('agency-mobile-menu');
    const openIcon = document.getElementById('agency-menu-open-icon');
    const closeIcon = document.getElementById('agency-menu-close-icon');
    const mobileLinks = document.querySelectorAll('.agency-mobile-link');

    if (!toggleBtn || !mobileMenu) return;

    const toggle = () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
      openIcon?.classList.toggle('hidden');
      closeIcon?.classList.toggle('hidden');
    };

    toggleBtn.addEventListener('click', toggle);
    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        if (!mobileMenu.classList.contains('hidden')) {
          toggle();
        }
      });
    });
  };

  initAgencyHeader();
  document.addEventListener('astro:after-swap', initAgencyHeader);
</script>
