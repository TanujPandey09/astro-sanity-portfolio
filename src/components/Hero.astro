---
// Editorial Hero: Obsidian Canvas + Linear Indigo Interactive Dot Grid & Threads + 3D Portrait Anchor
import { optimizePortraitImage } from "../lib/optimizeImage";
import PortfolioThreadsCanvas from "./Effects/PortfolioThreadsCanvas.astro";

interface Props {
  portraitUrl?: string;
}

const { portraitUrl } = Astro.props;
const heroPortrait = optimizePortraitImage(portraitUrl, "home");
const currentYear = new Date().getFullYear();
---

<section id="hero" class="relative w-full overflow-hidden bg-[#0A0B0E] text-white pt-20 sm:pt-24 md:pt-24 pb-10 sm:pb-12 md:pb-14 border-b border-white/[0.08]">
  <!-- 1. INTERACTIVE DOT GRID + LINEAR INDIGO THREADS + 3D PORTRAIT TILT -->
  <PortfolioThreadsCanvas />

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- 2. TOP WORDMARK & HEADER ROW -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-5 sm:pb-6 border-b border-white/[0.08]" data-gsap-hero="wordmark">
      <div>
        <span class="block text-[11px] font-mono uppercase tracking-[0.2em] text-[#828FFF] mb-2">
          PORTFOLIO · {currentYear}
        </span>
        <h1 class="font-grotesk font-extrabold text-[2.85rem] xs:text-[3.5rem] sm:text-[4.6rem] md:text-[5.5rem] lg:text-[6.25rem] text-white tracking-[-0.05em] leading-[0.88] select-none">
          Tanuj<br />Pandey
        </h1>
      </div>

      <div class="md:text-right space-y-2 pb-2">
        <div class="flex md:justify-end items-center gap-2 text-xs sm:text-sm font-mono font-medium uppercase tracking-[0.12em] text-slate-300">
          <span class="relative inline-flex h-5 sm:h-6 overflow-hidden align-middle">
            <span id="hero-rotating-role" class="inline-block text-[#828FFF] font-semibold transition-all duration-300">
              Full-Stack Architect
            </span>
          </span>
          <span class="text-slate-500">·</span>
          <span>AI Engineer</span>
        </div>
        <div class="flex md:justify-end items-center gap-3 text-xs font-mono text-slate-300">
          <span class="inline-flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#10B981] animate-pulse"></span>
            <span class="rb-shiny-emerald">AVAILABLE FOR SELECT PROJECTS</span>
          </span>
          <span class="text-slate-400">·</span>
          <span id="local-clock" class="tabular-nums">-- : -- IST</span>
        </div>

        <!-- Live Active & Past Visitor Telemetry -->
        <div
          id="visitor-telemetry-pill"
          class="flex md:justify-end items-center flex-wrap gap-2 pt-1 text-[11px] font-mono text-slate-300"
          aria-live="polite"
        >
          <span class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-white/[0.04] border border-white/10">
            <span class="relative flex h-1.5 w-1.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-[#10B981]"></span>
            </span>
            <span id="visitor-active-count" class="text-white font-semibold tabular-nums">--</span>
            <span class="text-slate-400">Active Now</span>
          </span>

          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#5E6AD2]/10 border border-[#5E6AD2]/30">
            <span id="visitor-total-count" class="text-[#828FFF] font-semibold tabular-nums">--</span>
            <span class="text-slate-300">Past Visits</span>
          </span>
        </div>
      </div>
    </div>

    <!-- 3. HUMAN PORTRAIT ANCHOR + EDITORIAL STATEMENT -->
    <div class="py-7 sm:py-9 md:py-10 grid grid-cols-1 md:grid-cols-12 gap-6 sm:gap-10 items-center border-b border-white/[0.08]" data-gsap-hero="bio">
      <!-- Real Photograph Portrait Card (Option 3: 3D Tilted Interactive Card) -->
      <div class="md:col-span-4 lg:col-span-4 [perspective:1000px]" data-gsap-hero="portrait">
        <div
          id="hero-portrait-tilt"
          class="relative w-full max-w-[270px] sm:max-w-[300px] md:max-w-[310px] lg:max-w-[330px] rounded-[24px] overflow-hidden border border-white/15 hover:border-[#828FFF]/50 bg-gradient-to-b from-white/12 to-white/[0.02] p-2 shadow-2xl group transition-all duration-300 ease-out will-change-transform"
          style="transform-style: preserve-3d;"
        >
          <div class="relative w-full aspect-[4/5] rounded-[20px] overflow-hidden bg-slate-900">
            <img
              src={heroPortrait}
              alt="Tanuj Pandey - Full-Stack Architect & AI Engineer"
              width="900"
              height="1125"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.03]"
            />
            <!-- Specular 3D Light Glare Tracking -->
            <div
              id="hero-portrait-sheen"
              class="pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
              style="background: radial-gradient(280px circle at var(--tilt-x, 50%) var(--tilt-y, 30%), rgba(130, 143, 255, 0.22), transparent 65%);"
            ></div>
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
            <div
              class="pointer-events-none absolute inset-x-3.5 bottom-3.5 flex items-center justify-between gap-2 px-3 py-2 rounded-xl bg-black/45 backdrop-blur-md border border-white/15 transition-transform duration-300"
              style="transform: translateZ(20px);"
            >
              <span class="text-[10px] font-mono uppercase tracking-[0.14em] text-white font-semibold">Tanuj Pandey</span>
              <span class="text-[10px] font-mono text-emerald-300 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                Dehradun · IN
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Bold Conversational Statement -->
      <div class="md:col-span-8 lg:col-span-8 space-y-5 sm:space-y-6">
        <h2 class="rb-blur-text font-grotesk font-semibold text-xl sm:text-2xl md:text-3xl lg:text-[2.35rem] text-white leading-[1.16] tracking-[-0.03em] max-w-3xl">
          I have been designing and building websites and web apps for the past 4+ years. My focus is on crafting <span class="rb-shiny-indigo">scalable full-stack architectures</span>, production AI systems, and high-performance digital experiences.
        </h2>

        <!-- Instant Conversion CTAs (Zero-Scroll Direct Contact) -->
        <div class="flex flex-wrap items-center gap-3 sm:gap-3.5 pt-2">
          <button
            type="button"
            data-open-contact
            class="magnetic-btn group inline-flex items-center gap-2.5 px-6 sm:px-7 py-3 rounded-full bg-white text-[#0A0B0E] font-grotesk font-bold text-xs uppercase tracking-[0.06em] hover:bg-slate-200 transition-all duration-300 shadow-lg active:scale-95 cursor-pointer"
          >
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Contact Now</span>
            <span class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 font-bold">↗</span>
          </button>

          <a
            href="https://wa.me/919557321978?text=Hi%20Tanuj%2C%20I%20saw%20your%20portfolio%20and%20want%20to%20connect."
            target="_blank"
            rel="noopener noreferrer"
            class="magnetic-btn group inline-flex items-center gap-2 px-5 sm:px-6 py-3 rounded-full bg-emerald-500/15 border border-emerald-400/30 text-emerald-300 hover:bg-emerald-500/25 hover:text-white font-grotesk font-semibold text-xs uppercase tracking-[0.06em] transition-all duration-300 active:scale-95"
          >
            <span>WhatsApp</span>
            <span class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 font-bold">↗</span>
          </a>

          <button
            type="button"
            id="hero-copy-email"
            data-email="tanujp09@gmail.com"
            class="group inline-flex items-center gap-2 px-5 py-3 rounded-full bg-white/[0.07] border border-white/15 text-slate-200 hover:bg-white/15 hover:text-white font-mono text-xs transition-all duration-300 cursor-pointer active:scale-95"
            title="Copy tanujp09@gmail.com"
          >
            <span id="hero-copy-label">tanujp09@gmail.com</span>
            <span class="text-[10px] text-[#828FFF] uppercase font-bold tracking-wider">Copy</span>
          </button>

          <a
            href="#projects"
            class="group inline-flex items-center gap-2 px-4 py-3 rounded-full text-slate-300 hover:text-white font-grotesk font-semibold text-xs uppercase tracking-[0.06em] transition-colors"
          >
            <span>Selected Work</span>
            <span class="transition-transform group-hover:translate-y-0.5">↓</span>
          </a>
        </div>
      </div>
    </div>

    <!-- 4. TWO-COLUMN SPLIT: "What changed recently" -->
    <div class="pt-6 sm:pt-8 grid grid-cols-1 md:grid-cols-12 gap-5 sm:gap-8 items-start" data-gsap-hero="retrospective">
      <div class="md:col-span-4">
        <h3 class="font-grotesk text-xl sm:text-2xl font-bold text-white tracking-tight">
          What changed recently
        </h3>
        <span class="text-xs font-mono text-slate-300 mt-1 block">Engineering Evolution</span>
      </div>

      <div class="md:col-span-8 space-y-4 text-sm sm:text-base text-slate-200 font-sans leading-relaxed">
        <p>
          Over the past year, my work evolved from building isolated frontend components into end-to-end full-stack architectures: multi-LLM orchestration pipelines across OpenAI, Gemini, Claude, and Perplexity with zero-fallback drift, real-time Node.js microservices with Socket.IO state synchronization, and commercial Next.js website templates optimized for 99+ Lighthouse performance.
        </p>
        <p class="text-slate-300 text-xs sm:text-sm">
          Currently engineering high-throughput SaaS platforms, AI microservices, and design systems for ambitious founders and product teams worldwide.
        </p>
      </div>
    </div>

  </div>
</section>

<script>
  const initHeroClock = () => {
    const clockEl = document.getElementById('local-clock');
    if (clockEl) {
      const fmt = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Asia/Kolkata',
        hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false,
      });
      const tick = () => { clockEl.textContent = `${fmt.format(new Date())} IST`; };
      tick();
      const w = window as any;
      if (w.__heroClock) clearInterval(w.__heroClock);
      w.__heroClock = setInterval(tick, 1000);
    }

    const copyBtn = document.getElementById('hero-copy-email');
    const copyLabel = document.getElementById('hero-copy-label');
    if (copyBtn && !copyBtn.hasAttribute('data-bound')) {
      copyBtn.setAttribute('data-bound', 'true');
      copyBtn.addEventListener('click', async () => {
        const email = copyBtn.getAttribute('data-email') || 'tanujp09@gmail.com';
        try {
          await navigator.clipboard.writeText(email);
          if (copyLabel) {
            copyLabel.textContent = 'Copied tanujp09@gmail.com ✓';
            setTimeout(() => { copyLabel.textContent = email; }, 2200);
          }
        } catch {
          window.location.href = `mailto:${email}`;
        }
      });
    }
  };

  const initVisitorTelemetry = () => {
    const activeEl = document.getElementById('visitor-active-count');
    const totalEl = document.getElementById('visitor-total-count');
    if (!activeEl || !totalEl) return;

    const w = window as any;
    if (w.__visitorHeartbeat) clearInterval(w.__visitorHeartbeat);

    const numFmt = new Intl.NumberFormat('en-US');
    const storageKeyId = 'tp_visitor_sid';
    const storageKeyCounted = 'tp_visitor_counted';

    let sessionId = '';
    let isNewSession = false;
    try {
      sessionId = sessionStorage.getItem(storageKeyId) || '';
      if (!sessionId) {
        sessionId =
          typeof crypto !== 'undefined' && crypto.randomUUID
            ? crypto.randomUUID().replace(/-/g, '').slice(0, 20)
            : `${Date.now().toString(36)}${Math.random().toString(36).slice(2, 10)}`;
        sessionStorage.setItem(storageKeyId, sessionId);
      }
      if (!sessionStorage.getItem(storageKeyCounted)) {
        isNewSession = true;
      }
    } catch {
      sessionId = `s${Date.now().toString(36)}`;
    }

    const updateDom = (data: { active?: number; total?: number }) => {
      if (typeof data.active === 'number') {
        activeEl.textContent = numFmt.format(Math.max(1, data.active));
      }
      if (typeof data.total === 'number') {
        totalEl.textContent = numFmt.format(Math.max(1, data.total));
      }
    };

    const sendHeartbeat = async (markNew: boolean) => {
      try {
        const res = await fetch('/api/visitors', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionId, action: 'heartbeat', isNewSession: markNew }),
        });
        if (!res.ok) return;
        const json = await res.json();
        updateDom(json);
        if (markNew) {
          isNewSession = false;
          try {
            sessionStorage.setItem(storageKeyCounted, '1');
          } catch {}
        }
      } catch {}
    };

    sendHeartbeat(isNewSession);
    w.__visitorHeartbeat = setInterval(() => {
      if (document.visibilityState !== 'hidden') {
        sendHeartbeat(false);
      }
    }, 35_000);

    w.__visitorSendHeartbeat = () => sendHeartbeat(false);
    if (!w.__visitorLifecycleBound) {
      w.__visitorLifecycleBound = true;
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible' && typeof w.__visitorSendHeartbeat === 'function') {
          w.__visitorSendHeartbeat();
        }
      });
      window.addEventListener('pagehide', () => {
        const sid = (() => {
          try {
            return sessionStorage.getItem(storageKeyId) || '';
          } catch {
            return '';
          }
        })();
        if (!sid || typeof navigator.sendBeacon !== 'function') return;
        const blob = new Blob([JSON.stringify({ sessionId: sid, action: 'leave' })], {
          type: 'application/json',
        });
        navigator.sendBeacon('/api/visitors', blob);
      });
    }
  };

  const initPortraitTiltAndRoles = () => {
    const tiltCard = document.getElementById('hero-portrait-tilt');
    const sheenEl = document.getElementById('hero-portrait-sheen');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (tiltCard && !reduceMotion && tiltCard.dataset.tiltBound !== 'true') {
      tiltCard.dataset.tiltBound = 'true';
      tiltCard.addEventListener('pointermove', (e: PointerEvent) => {
        if (window.innerWidth < 768) return;
        const rect = tiltCard.getBoundingClientRect();
        const px = (e.clientX - rect.left) / rect.width;
        const py = (e.clientY - rect.top) / rect.height;
        const rotateY = (px - 0.5) * 14;
        const rotateX = (0.5 - py) * 12;
        tiltCard.style.transform = `rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) scale3d(1.015, 1.015, 1.015)`;
        if (sheenEl) {
          sheenEl.style.setProperty('--tilt-x', `${(px * 100).toFixed(1)}%`);
          sheenEl.style.setProperty('--tilt-y', `${(py * 100).toFixed(1)}%`);
        }
      });
      tiltCard.addEventListener('pointerleave', () => {
        tiltCard.style.transform = 'rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
      });
    }

    const roleEl = document.getElementById('hero-rotating-role');
    if (roleEl && !reduceMotion) {
      const roles = [
        'Full-Stack Architect',
        'Multi-LLM AI Engineer',
        'Next.js Systems Lead',
        'SaaS Product Builder',
      ];
      const w = window as any;
      if (w.__heroRoleInterval) clearInterval(w.__heroRoleInterval);
      let idx = 0;
      w.__heroRoleInterval = setInterval(() => {
        idx = (idx + 1) % roles.length;
        roleEl.style.opacity = '0';
        roleEl.style.transform = 'translateY(-8px)';
        setTimeout(() => {
          roleEl.textContent = roles[idx];
          roleEl.style.opacity = '1';
          roleEl.style.transform = 'translateY(0px)';
        }, 200);
      }, 2800);
    }
  };

  initHeroClock();
  initVisitorTelemetry();
  initPortraitTiltAndRoles();
  document.addEventListener('astro:page-load', () => {
    initHeroClock();
    initVisitorTelemetry();
    initPortraitTiltAndRoles();
  });
</script>

<style>
  @keyframes rbShineSweep {
    0% { background-position: 140% center; }
    100% { background-position: -140% center; }
  }

  @keyframes rbBlurIn {
    from {
      opacity: 0.25;
      filter: blur(8px);
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0);
    }
  }

  .rb-blur-text {
    animation: rbBlurIn 0.85s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .rb-shiny-indigo {
    background: linear-gradient(110deg, #ffffff 30%, #828fff 48%, #5e6ad2 54%, #ffffff 72%);
    background-size: 240% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: rbShineSweep 5.5s linear infinite;
  }

  .rb-shiny-emerald {
    background: linear-gradient(110deg, #34d399 30%, #ffffff 50%, #34d399 70%);
    background-size: 240% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: rbShineSweep 4.8s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .rb-blur-text {
      animation: none;
      opacity: 1;
      filter: none;
      transform: none;
    }
    .rb-shiny-indigo,
    .rb-shiny-emerald {
      animation: none;
      background: none;
      color: inherit;
    }
    .rb-shiny-indigo { color: #828FFF; }
    .rb-shiny-emerald { color: #34D399; }
  }
</style>
