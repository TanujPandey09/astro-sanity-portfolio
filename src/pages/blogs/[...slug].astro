---
export const prerender = false;

import { useSanityClient, groq } from "astro-sanity";
import { fallbackSanityClient } from "../../lib/sanityClient.js";
import BlogDetails from "../../components/BlogLayout/BlogDetails.astro";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const query = groq`*[_type == "blogs" && defined(slug.current)] | order(_createdAt desc) {
    ...,
    image{
      asset->{
        url
      }
    },
    FeatureImage{
      asset->{
        url
      }
    },
    BackgroundImage{
      asset->{
        url
      }
    }
  }`;

  let blogs: any[] = [];
  try {
    blogs = await useSanityClient().fetch(query);
    if (!Array.isArray(blogs) || blogs.length === 0) {
      blogs = await fallbackSanityClient.fetch(query);
    }
  } catch {
    try {
      blogs = await fallbackSanityClient.fetch(query);
    } catch {
      blogs = [];
    }
  }

  return (blogs || [])
    .filter((item) => item?.slug?.current)
    .map((item) => ({
      params: { slug: String(item.slug.current).replace(/^\/+|\/+$/g, "") },
      props: {
        detailsData: item,
        blogData: blogs,
      },
    }));
}

const rawSlug = Astro.params.slug || "";
const cleanSlug = rawSlug.replace(/^\/+|\/+$/g, "");

const allBlogsQuery = groq`*[_type == "blogs"] | order(_createdAt desc) {
  ...,
  image{
    asset->{
      url
    }
  },
  FeatureImage{
    asset->{
      url
    }
  },
  BackgroundImage{
    asset->{
      url
    }
  }
}`;

let blogData: any[] = Array.isArray(Astro.props?.blogData) ? Astro.props.blogData : [];
if (blogData.length === 0) {
  try {
    blogData = await useSanityClient().fetch(allBlogsQuery);
    if (!Array.isArray(blogData) || blogData.length === 0) {
      blogData = await fallbackSanityClient.fetch(allBlogsQuery);
    }
  } catch (err) {
    try {
      blogData = await fallbackSanityClient.fetch(allBlogsQuery);
    } catch (fallbackErr) {
      console.error("Failed to fetch blog post data:", fallbackErr);
      blogData = [];
    }
  }
}

const detailsData =
  Astro.props?.detailsData ||
  blogData.find(
    (item) =>
      String(item?.slug?.current || "").replace(/^\/+|\/+$/g, "") === cleanSlug
  ) ||
  blogData.find((item) => item?.slug?.current === rawSlug);

if (!detailsData) {
  return Astro.redirect("/blogs");
}

// Extract description for SEO
const blogDescription =
  detailsData?.excerpt
    ?.map((b: any) => b?.children?.map((c: any) => c?.text).join(""))
    .filter(Boolean)
    .join(" ") ||
  detailsData?.blogcontent
    ?.map((b: any) => b?.children?.map((c: any) => c?.text).join(""))
    .filter(Boolean)
    .join(" ")
    .slice(0, 160) ||
  "Read this technical deep dive and engineering guide by Tanuj Pandey.";

const siteUrl = "https://tanujbuilds.site";
const slug = String(detailsData?.slug?.current || cleanSlug).replace(/^\/+|\/+$/g, "");
const canonicalURL = `${siteUrl}/blogs/${slug}`;
const ogImage =
  detailsData?.BackgroundImage?.asset?.url ||
  detailsData?.FeatureImage?.asset?.url ||
  detailsData?.image?.asset?.url;
const publishedTime = detailsData?._createdAt;
const modifiedTime = detailsData?._updatedAt;

const blogJsonLd = {
  "@type": "BlogPosting",
  "@id": `${canonicalURL}#article`,
  headline: detailsData?.projectName || "Engineering Article",
  description: blogDescription,
  ...(publishedTime ? { datePublished: publishedTime } : {}),
  ...(modifiedTime ? { dateModified: modifiedTime } : {}),
  author: { "@type": "Person", "@id": `${siteUrl}/#person`, name: "Tanuj Pandey" },
  publisher: { "@type": "Person", "@id": `${siteUrl}/#person`, name: "Tanuj Pandey" },
  mainEntityOfPage: { "@id": `${canonicalURL}#webpage` },
  ...(ogImage ? { image: ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage}` } : {}),
  ...(detailsData?.Category ? { articleSection: detailsData.Category } : {}),
  ...(detailsData?.tags?.length ? { keywords: detailsData.tags.join(", ") } : {}),
};

const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blogs" },
  { name: detailsData?.projectName || "Article", path: `/blogs/${slug}` },
];
---

<Layout
  title={`${detailsData?.projectName || "Blog Article"} | Tanuj Pandey`}
  description={blogDescription}
  image={ogImage}
  type="article"
  article={{
    publishedTime,
    modifiedTime,
    author: "Tanuj Pandey",
    section: detailsData?.Category,
    tags: detailsData?.tags,
  }}
  breadcrumbs={breadcrumbs}
  jsonLd={blogJsonLd}
>
  <BlogDetails detailsData={detailsData} blogData={blogData} />
</Layout>
