---
// NovaStack Engagement Models: Unified Obsidian Monochrome + Linear Indigo (#5E6AD2)
// Tightened copy (no duplicate summary+description), crisp SVG icons (no OS emojis)
const models = [
  {
    id: "fixed-scope",
    highlighted: false,
    badge: "Fixed-Scope Sprint",
    timeline: "2–6 Weeks",
    billingType: "Milestone-Gated",
    title: "Fixed-Scope Build",
    description:
      "Defined specs, fixed investment, and milestone-gated delivery. Ideal for marketing sites, SaaS MVPs, and custom email design systems.",
    bestFor: "Startups & businesses with clear launch goals.",
    highlights: [
      "Written technical scope & milestone roadmap",
      "Private staging reviews before each sign-off",
      "100% repository & IP handover at launch",
      "14-day post-launch warranty included",
    ],
    ctaText: "Request a Fixed Quote",
    ctaHref: "#contact",
  },
  {
    id: "freelance-support",
    highlighted: true,
    badge: "Embedded Capacity",
    taglineBadge: "MOST POPULAR FOR AGENCIES",
    timeline: "Immediate Start",
    billingType: "Weekly Sprints",
    title: "Dedicated Engineering",
    description:
      "Senior React, Next.js, and full-stack reinforcement without hiring delays. I plug directly into your GitHub, Linear, and Slack to ship overdue milestones.",
    bestFor: "Digital agencies, studios & fast-moving product teams.",
    highlights: [
      "Direct GitHub, Linear/Jira & Slack integration",
      "High-velocity Next.js 15, React 19 & TypeScript",
      "Daily async updates & Loom walkthroughs",
      "Flexible weekly sprints—scale up or pause anytime",
    ],
    ctaText: "Check Availability",
    ctaHref: "#contact",
  },
  {
    id: "ongoing-collaboration",
    highlighted: false,
    badge: "Monthly Retainer",
    timeline: "Month-to-Month",
    billingType: "Flexible",
    title: "Technical Partnership",
    description:
      "Continuous feature iterations, API integrations, performance audits, and active maintenance for live software products—with zero long-term lock-in.",
    bestFor: "Post-launch SaaS founders iterating on live products.",
    highlights: [
      "Direct channel via Slack, WhatsApp, or email",
      "Continuous feature sprints & third-party API sync",
      "Core Web Vitals audits & dependency maintenance",
      "Transparent task board & cancel-anytime terms",
    ],
    ctaText: "Discuss Partnership",
    ctaHref: "#contact",
  },
];
---

<section id="models" class="py-18 sm:py-24 bg-[#F4F4F5] text-[#09090B] border-b border-[#E4E4E7]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2.5 text-[11px] font-mono font-semibold text-[#5E6AD2] uppercase tracking-[0.18em] mb-3">
        <span class="w-4 h-px bg-[#5E6AD2]"></span>
        <span>05 / Engagement Models</span>
        <span class="w-4 h-px bg-[#5E6AD2]"></span>
      </div>
      <h2 class="font-grotesk font-extrabold text-3xl sm:text-5xl text-[#09090B] tracking-[-0.035em] leading-[1.08]">
        Transparent Models. <br class="hidden sm:inline" />
        Zero Vendor Lock-In.
      </h2>
      <p class="text-sm sm:text-base text-[#52525B] mt-3 leading-relaxed font-sans max-w-xl mx-auto">
        Fixed-scope milestones or flexible weekly sprints—structured around working software, never open-ended retainers.
      </p>
    </div>

    <!-- 3 Engagement Cards (Obsidian Centerpiece with Clean Hairline Contrast) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-7 items-stretch mb-8 sm:mb-10">
      {models.map((model) => (
        <div
          class={`agency-card rounded-2xl sm:rounded-3xl p-6 sm:p-8 flex flex-col justify-between transition-all duration-300 relative ${
            model.highlighted
              ? "bg-[#09090B] text-white border-2 border-[#5E6AD2] shadow-[0_24px_60px_-20px_rgba(9,9,11,0.45)] lg:-translate-y-2 z-10"
              : "bg-white text-[#09090B] border border-[#E4E4E7] shadow-2xs hover:border-[#5E6AD2]/40 hover:shadow-md"
          }`}
        >
          {model.highlighted && (
            <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-3.5 py-1 rounded-full bg-[#5E6AD2] text-white text-[9.5px] font-mono font-bold uppercase tracking-wider shadow-sm flex items-center gap-1.5 whitespace-nowrap">
              <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
              <span>{model.taglineBadge}</span>
            </div>
          )}

          <div>
            <!-- Top Badges Row -->
            <div class="flex items-center justify-between gap-2 mb-5">
              <span
                class={`text-[10px] font-mono uppercase tracking-wider font-bold px-2.5 py-1 rounded-md ${
                  model.highlighted
                    ? "bg-[#5E6AD2]/20 text-[#A5AEF3] border border-[#5E6AD2]/40"
                    : "bg-[#EEF0FB] text-[#5E6AD2] border border-[#D5D9F5]"
                }`}
              >
                {model.badge}
              </span>
              <span
                class={`text-[10px] font-mono font-medium px-2.5 py-0.5 rounded-md ${
                  model.highlighted
                    ? "bg-white/5 text-[#A1A1AA] border border-white/10"
                    : "bg-[#F4F4F5] text-[#52525B] border border-[#E4E4E7]"
                }`}
              >
                {model.timeline}
              </span>
            </div>

            <h3 class={`font-grotesk font-extrabold text-2xl tracking-tight mb-2.5 ${model.highlighted ? "text-white" : "text-[#09090B]"}`}>
              {model.title}
            </h3>

            <p class={`text-xs sm:text-sm leading-relaxed font-sans mb-5 ${model.highlighted ? "text-[#A1A1AA]" : "text-[#52525B]"}`}>
              {model.description}
            </p>

            <!-- Best For Box -->
            <div class={`p-3 rounded-xl mb-5 text-xs font-sans ${model.highlighted ? "bg-[#111215] border border-white/10 text-zinc-200" : "bg-[#F4F4F5] border border-[#E4E4E7] text-[#09090B]"}`}>
              <span class={`text-[9.5px] font-mono uppercase tracking-wider block mb-0.5 font-bold ${model.highlighted ? "text-[#71717A]" : "text-[#71717A]"}`}>
                Best For
              </span>
              <span>{model.bestFor}</span>
            </div>

            <!-- Highlights Checklist -->
            <ul class="space-y-2.5 text-xs font-sans mb-7">
              {model.highlights.map((item) => (
                <li class="flex items-start gap-2.5">
                  <span
                    class={`w-4 h-4 rounded-full flex items-center justify-center shrink-0 text-[10px] font-bold mt-0.5 ${
                      model.highlighted
                        ? "bg-[#5E6AD2]/25 text-[#A5AEF3]"
                        : "bg-[#EEF0FB] text-[#5E6AD2]"
                    }`}
                  >
                    ✓
                  </span>
                  <span class={model.highlighted ? "text-zinc-200" : "text-[#27272A]"}>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- CTA Button -->
          <div class={`pt-4 border-t ${model.highlighted ? "border-white/10" : "border-[#F4F4F5]"}`}>
            <a
              href={model.ctaHref}
              class={`w-full inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-full font-grotesk font-bold text-xs uppercase tracking-wider transition-all active:scale-98 ${
                model.highlighted
                  ? "bg-[#5E6AD2] hover:bg-[#4E5AC2] text-white"
                  : "bg-[#09090B] hover:bg-[#5E6AD2] text-white"
              }`}
            >
              <span>{model.ctaText}</span>
              <span>→</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Crisp 3-Pillar Assurance Seal (Monochrome SVG Icons — Zero OS Emojis) -->
    <div class="rounded-2xl bg-white border border-[#E4E4E7] p-5 sm:p-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 divide-y md:divide-y-0 md:divide-x divide-[#E4E4E7]">
        <div class="flex items-start gap-3 pt-3 md:pt-0">
          <div class="w-8 h-8 rounded-lg bg-[#EEF0FB] text-[#5E6AD2] border border-[#D5D9F5] flex items-center justify-center shrink-0">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <div>
            <h4 class="font-grotesk font-bold text-xs text-[#09090B]">Full Repository &amp; IP Ownership</h4>
            <p class="text-[11px] text-[#52525B] font-sans mt-0.5">Code, DNS, and cloud infrastructure live in your own accounts from day one.</p>
          </div>
        </div>

        <div class="flex items-start gap-3 pt-4 md:pt-0 md:pl-5">
          <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-200 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <div>
            <h4 class="font-grotesk font-bold text-xs text-[#09090B]">Staging-Verified Milestones</h4>
            <p class="text-[11px] text-[#52525B] font-sans mt-0.5">Review live builds on a private staging URL before approving milestone releases.</p>
          </div>
        </div>

        <div class="flex items-start gap-3 pt-4 md:pt-0 md:pl-5">
          <div class="w-8 h-8 rounded-lg bg-[#F4F4F5] text-[#09090B] border border-[#E4E4E7] flex items-center justify-center shrink-0">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="4 17 10 11 4 5"></polyline>
              <line x1="12" x2="20" y1="19" y2="19"></line>
            </svg>
          </div>
          <div>
            <h4 class="font-grotesk font-bold text-xs text-[#09090B]">Zero Account Managers</h4>
            <p class="text-[11px] text-[#52525B] font-sans mt-0.5">Speak directly with the senior engineer designing and shipping your product.</p>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
