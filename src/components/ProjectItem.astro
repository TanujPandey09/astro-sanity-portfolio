---
import { optimizeSanityImage } from "../lib/optimizeImage";

const { project, index } = Astro.props;

const projectName = project?.projectName || "Custom SaaS Product";

let excerpt = "Production-ready digital systems built for reliability and performance.";
if (Array.isArray(project?.excerpt)) {
  const textBlocks = project.excerpt
    .flatMap((b: any) => b?.children?.map((c: any) => c?.text) || [])
    .filter((t: string) => t && t.trim().length > 0 && !t.includes('🚀'));
  if (textBlocks.length > 0) {
    excerpt = textBlocks.sort((a: string, b: string) => b.length - a.length)[0];
  }
} else if (typeof project?.excerpt === 'string') {
  excerpt = project.excerpt;
}

const rawImageUrl = project?.BackgroundImage?.asset?.url || "/img/custom-project.webp";
const imageUrl = optimizeSanityImage(rawImageUrl, 1200, 80);

const rawTags = project?.tags || project?.techStack || [];
const tags = Array.isArray(rawTags) && rawTags.length > 0 ? rawTags : ['Full-Stack', 'Production', 'SaaS'];

// Bento layout spans
const bentoIndex = index % 4;
let bentoGridClasses = "col-span-1 ";
if (bentoIndex === 0) {
  bentoGridClasses += "md:col-span-2 md:row-span-2 min-h-[500px] md:min-h-[580px] flex flex-col";
} else if (bentoIndex === 1) {
  bentoGridClasses += "md:col-span-1 md:row-span-1 min-h-[300px] md:min-h-[340px] flex flex-col";
} else if (bentoIndex === 2) {
  bentoGridClasses += "md:col-span-1 md:row-span-1 min-h-[300px] md:min-h-[340px] flex flex-col";
} else {
  bentoGridClasses += "md:col-span-3 md:row-span-1 min-h-[280px] md:min-h-[320px] flex flex-col";
}
---

{bentoIndex === 3 ? (
  /* Wide Horizontal Bento Card */
  <div class={`project-item group rounded-2xl p-1.5 bg-white/[0.04] border border-white/10 hover:border-accent-primary/50 transition-all duration-500 shadow-card ${bentoGridClasses}`} data-aos="fade-up" data-aos-delay={index * 80}>
    <div class="rounded-xl bg-surface-card h-full w-full overflow-hidden grid grid-cols-1 md:grid-cols-12 border border-white/[0.05] shadow-[inset_0_1px_0_0_rgba(255,255,255,0.08)]">
      <!-- Text Side -->
      <a href={`/projects/${project.slug?.current}`} class="md:col-span-7 p-7 md:p-9 flex flex-col justify-between z-10 w-full h-full cursor-pointer">
        <div>
          <div class="flex items-center justify-between mb-6">
            <div class="flex flex-wrap gap-2">
              {tags.slice(0, 3).map((tech: string) => (
                <span class="text-[10px] font-mono px-2.5 py-1 rounded-md bg-white/[0.06] border border-white/10 text-text-muted">
                  {tech}
                </span>
              ))}
            </div>
            <span class="text-xs font-mono font-medium text-text-dim">/ 0{index + 1}</span>
          </div>

          <h3 class="text-xl md:text-2xl font-bold text-text-primary tracking-tight transition-colors group-hover:text-white">
            {projectName}
          </h3>
          <p class="mt-3 text-sm text-text-muted font-normal leading-relaxed max-w-xl">
            {excerpt}
          </p>
        </div>

        <div class="mt-6 flex items-center gap-2 text-xs font-mono font-medium text-accent-primary group-hover:text-accent-hover transition-colors">
          <span>View Case Study</span>
          <span class="transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-0.5">↗</span>
        </div>
      </a>

      <!-- Image Side -->
      <div class="md:col-span-5 relative overflow-hidden w-full h-full min-h-[220px] border-t md:border-t-0 md:border-l border-border-subtle bg-surface-elevated">
        {imageUrl ? (
          <img 
            src={imageUrl} 
            alt={projectName}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 opacity-90 group-hover:opacity-100"
          />
        ) : (
          <div class="w-full h-full bg-surface-elevated"></div>
        )}
      </div>
    </div>
  </div>
) : (
  /* Standard / Focus Vertical Bento Card */
  <div class={`project-item group rounded-2xl p-1.5 bg-white/[0.04] border border-white/10 hover:border-accent-primary/50 transition-all duration-500 shadow-card ${bentoGridClasses}`} data-aos="fade-up" data-aos-delay={index * 80}>
    <div class="rounded-xl bg-surface-card h-full w-full overflow-hidden flex flex-col justify-between border border-white/[0.05] shadow-[inset_0_1px_0_0_rgba(255,255,255,0.08)]">
      <!-- Image Container -->
      <div class={`relative overflow-hidden w-full ${bentoIndex === 0 ? 'h-[58%]' : 'h-[48%]'} border-b border-border-subtle bg-surface-elevated`}>
        {imageUrl ? (
          <img 
            src={imageUrl} 
            alt={projectName}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 opacity-90 group-hover:opacity-100"
          />
        ) : (
          <div class="w-full h-full bg-surface-elevated"></div>
        )}
      </div>

      <!-- Text Container -->
      <a href={`/projects/${project.slug?.current}`} class="p-6 md:p-8 flex-1 flex flex-col justify-between z-10 cursor-pointer">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="flex flex-wrap gap-1.5">
              {tags.slice(0, 3).map((tech: string) => (
                <span class="text-[10px] font-mono px-2 py-0.5 rounded-md bg-white/[0.04] border border-border-subtle text-text-muted">
                  {tech}
                </span>
              ))}
            </div>
            <span class="text-xs font-mono font-medium text-text-dim">/ 0{index + 1}</span>
          </div>

          <h3 class="text-lg md:text-xl font-bold text-text-primary tracking-tight transition-colors">
            {projectName}
          </h3>
          <p class="mt-2 text-xs md:text-sm text-text-muted font-normal leading-relaxed line-clamp-2">
            {excerpt}
          </p>
        </div>

        <div class="mt-4 flex items-center gap-2 text-xs font-mono font-medium text-accent-primary group-hover:text-white transition-colors">
          <span>View Case Study</span>
          <span class="transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-0.5">↗</span>
        </div>
      </a>
    </div>
  </div>
)}

<style>
  .project-item {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s;
  }
  .project-item:hover {
    transform: translateY(-4px);
  }
</style>
