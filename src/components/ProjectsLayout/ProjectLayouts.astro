---
import ProjectItem from "../ProjectItem.astro";
import SectionHeader from "../SectionHeader.astro";
import PremiumBackground from "../PremiumBackground.astro";

interface Props {
  projectData: any[];
}

const { projectData = [] } = Astro.props;
---

<div class="relative min-h-screen selection:bg-accent-primary/30 overflow-hidden">
  <PremiumBackground />

  <main class="mx-auto w-full max-w-7xl px-4 md:px-6 lg:px-8 py-24 md:py-32 relative z-10">
    <div class="max-w-7xl mx-auto">
      
      <!-- Section Header -->
      <SectionHeader 
        eyebrow="Portfolio // Showcase"
        title="Complete" 
        gradientText="Projects" 
        subtitle="A comprehensive showcase of production applications, enterprise SaaS platforms, and client deliveries."
      />

      <!-- Bento Grid displaying all projects directly in SSR -->
      <div 
        id="projects-grid" 
        class="mt-12 md:mt-16 grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8"
      >
        {projectData.map((project: any, index: number) => (
          <ProjectItem project={project} index={index} />
        ))}
      </div>

      <!-- Closing Note -->
      <div class="mt-20 md:mt-28 py-10 md:py-14 border-t border-border-subtle flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="space-y-2">
          <p class="text-[11px] font-mono uppercase tracking-[0.3em] text-text-dim">Portfolio // Index</p>
          <p class="text-xl md:text-2xl font-semibold text-text-primary tracking-tight max-w-xl">
            {projectData.length} production builds, shipped end to end.
          </p>
        </div>
        <a href="/#contact" class="group inline-flex items-center gap-3 text-[11px] font-mono uppercase tracking-[0.3em] text-text-muted hover:text-white transition-colors">
          Start a project
          <span class="w-8 h-8 rounded-full border border-border-subtle flex items-center justify-center group-hover:border-border-hover transition-colors">↗</span>
        </a>
      </div>

    </div>
  </main>
</div>