---
import SectionHeader from "./SectionHeader.astro";

const experienceData = [
  {
    role: "Full Stack Developer",
    company: "Cxisuite",
    duration: "Sep 2025 — Present",
    period: "[2025 — PRESENT]",
    type: "Remote",
    isCurrent: true,
    badge: "Current Role",
    headlineOutcome: "Sawt AI & Multi-LLM SaaS",
    companyUrl: "https://cxisuite.com/",
    description: "Architected and shipped Sawt AI, a bilingual Arabic/English AI survey SaaS for the Saudi market, alongside real-time CRM and mobile platforms.",
    highlights: [
      "Integrated multi-LLM pipelines (GPT, Gemini, Grok, Perplexity) with response validation and MyFatoorah subscription billing, webhooks, and tier access control.",
      "Engineered role-based auth, rate limiting, audit logging, and a real-time CRM using Socket.IO with live SLA tracking.",
      "Contributed React Native mobile and web release workflows for Thaddi, an Arabic-first football prediction platform."
    ],
    kpis: [
      { value: "4+ LLMs", label: "Orchestrated in Production" },
      { value: "Real-Time", label: "Socket.IO CRM & Billing" }
    ],
    technologies: ["React.js", "Next.js", "Node.js", "TypeScript", "React Native", "Socket.IO", "PostgreSQL", "OpenAI / Gemini"],
    logo: "https://cxisuite.com/assets/logo1_1757929917544-2LY1vMCS.png",
  },
  {
    role: "Frontend Developer",
    company: "Nasya IT",
    duration: "Feb 2025 — Jul 2025",
    period: "[FEB — JUL 2025]",
    type: "Remote",
    isCurrent: false,
    badge: "Solo Ownership",
    headlineOutcome: "Multi-Role Healthcare SaaS",
    companyUrl: "https://www.nasyait.com/",
    description: "Solely owned the frontend architecture of a multi-role healthcare SaaS (Super Admin, Doctor, Patient, Clinic) from UI design through production release.",
    highlights: [
      "Built 3 role-based authentication portals and 10+ CRUD modules covering patient records, appointment scheduling, and clinic operations.",
      "Developed interactive medical dashboards with reactive filters, charting, and exportable reports connected to Node.js and MongoDB APIs.",
      "Shipped the complete frontend autonomously from zero to production without dedicated designer or QA support."
    ],
    kpis: [
      { value: "10+ Modules", label: "Healthcare CRUD & Charts" },
      { value: "4 Portals", label: "Admin, Doctor, Patient, Clinic" }
    ],
    technologies: ["React.js", "Node.js", "MongoDB", "REST APIs", "Tailwind CSS"],
    logo: "https://media.licdn.com/dms/image/v2/C4D0BAQHRS2pkyIQ-RQ/company-logo_200_200/company-logo_200_200/0/1630577732820/nasyait_logo?e=1763596800&v=beta&t=CGXPjRheeE9w7-_LqT0R1QXLenCDi8JQWjVejhUlBRg",
  },
  {
    role: "React Developer",
    company: "Techmatys",
    duration: "May 2024 — Dec 2024",
    period: "[MAY — DEC 2024]",
    type: "Onsite",
    isCurrent: false,
    badge: "Enterprise EdTech",
    headlineOutcome: "Moodle LMS & React Dashboards",
    companyUrl: "https://www.linkedin.com/company/techmatys/",
    description: "Engineered and customized Moodle-based LMS frontends and reusable React.js dashboard systems for institutional student, teacher, and admin workflows.",
    highlights: [
      "Built academic management modules for attendance tracking, grading assessments, course scheduling, and institutional reporting.",
      "Integrated REST APIs and accelerated dashboard load times via route-level code splitting and lazy loading.",
      "Standardized reusable UI component patterns across student and administrative portals."
    ],
    kpis: [
      { value: "3 Roles", label: "Student, Teacher & Admin UI" },
      { value: "Code-Split", label: "Lazy-Loaded LMS Bundles" }
    ],
    technologies: ["React.js", "Moodle LMS", "REST APIs", "Ant Design", "JavaScript (ES6+)"],
    logo: "/img/techmatys.jfif",
  },
  {
    role: "Frontend Developer",
    company: "Scube.co",
    duration: "Jan 2022 — Feb 2024",
    period: "[2022 — 2024]",
    type: "Remote",
    isCurrent: false,
    badge: "Core Web Vitals",
    headlineOutcome: "50% Faster Next.js SaaS",
    companyUrl: "https://www.scube.co/",
    description: "Built the production frontend of Breeze SaaS using Next.js (SSR/SSG) and TypeScript, integrating GraphQL and headless CMS pipelines.",
    highlights: [
      "Optimized Core Web Vitals (LCP, CLS, TTFB) via next/image optimization, code splitting, and edge caching strategies.",
      "Delivered a 50% improvement in page load speed and a 20% increase in user engagement across production web properties.",
      "Architected headless CMS content pipelines across Sanity.io, Contentful, and Strapi."
    ],
    kpis: [
      { value: "50% Faster", label: "Core Web Vitals & LCP" },
      { value: "+20% Lift", label: "Production User Engagement" }
    ],
    technologies: ["Next.js", "TypeScript", "GraphQL", "Sanity.io", "Contentful", "Strapi"],
    logo: "/img/SCUBE.webp",
  },
];
---

<section id="experience" class="relative z-10 border-t border-white/[0.10] py-16 sm:py-24 md:py-28 overflow-hidden">
  <div class="w-full max-w-7xl mx-auto">
    
    <SectionHeader 
      eyebrow="CAREER TIMELINE"
      title="Work" 
      gradientText="Experience" 
      subtitle="4+ years shipping commercial SaaS products, multi-role healthcare portals, and production AI systems."
    />

    <!-- Rushes HUD Interactive Experience Ledger (Complete Data + Zero Long Scroll) -->
    <div data-gsap-card class="bento-spotlight relative rounded-[22px] bg-surface-card border border-white/[0.12] overflow-hidden divide-y divide-white/[0.10] shadow-[0_24px_60px_rgba(0,0,0,0.55)]">
      <!-- 4 Corner HUD Viewfinder Crosshairs -->
      <span class="pointer-events-none absolute top-2.5 left-2.5 w-4 h-[1px] bg-white/35 z-20"></span>
      <span class="pointer-events-none absolute top-2.5 left-2.5 w-[1px] h-4 bg-white/35 z-20"></span>
      <span class="pointer-events-none absolute top-2.5 right-2.5 w-4 h-[1px] bg-white/35 z-20"></span>
      <span class="pointer-events-none absolute top-2.5 right-2.5 w-[1px] h-4 bg-white/35 z-20"></span>

      <!-- Top HUD Metadata Strip -->
      <div class="px-4 sm:px-7 py-3.5 bg-white/[0.02] flex flex-wrap items-center justify-between gap-3 text-[11px] font-mono text-[#94A3B8]">
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-[#10B981] animate-pulse shadow-[0_0_8px_rgba(16,185,129,0.8)]"></span>
          <span class="text-[#F8FAFC] font-medium">[ 04 PRODUCTION ROLES · 2022 — 2026 ]</span>
        </div>
        <div class="flex items-center gap-4">
          <span class="hidden sm:inline text-[#94A3B8]">CLICK ANY ROLE TO INSPECT DELIVERABLES</span>
          <a
            href="/Resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-white hover:bg-slate-100 text-[#0B0F17] font-grotesk font-bold text-[11px] uppercase tracking-[0.04em] shadow-[0_0_15px_rgba(255,255,255,0.2)] transition-all"
          >
            <span>DOWNLOAD CV</span>
            <span>↗</span>
          </a>
        </div>
      </div>

      <!-- Accordion Rows (All 4 Companies Always Visible; Full Highlights & KPIs Inside) -->
      {experienceData.map((exp, index) => {
        const isFirst = index === 0;
        return (
          <div
            class={`exp-ledger-item group transition-colors duration-300 ${
              isFirst ? "is-open bg-surface-elevated/40" : "hover:bg-white/[0.02]"
            }`}
            data-exp-item={index}
          >
            <!-- Interactive Row Header Button -->
            <button
              type="button"
              aria-expanded={isFirst ? "true" : "false"}
              aria-controls={`exp-drawer-${index}`}
              id={`exp-trigger-${index}`}
              data-exp-trigger={index}
              class="w-full text-left px-4 sm:px-7 py-4 sm:py-5 flex items-center justify-between gap-3 sm:gap-6 cursor-pointer focus:outline-none"
            >
              <!-- Left: Index + Logo + Role + Company -->
              <div class="flex items-center gap-3 sm:gap-4 min-w-0">
                <span class={`exp-idx hidden xs:inline-flex font-mono text-xs font-bold tabular-nums transition-colors ${
                  isFirst ? "text-accent-primary" : "text-[#64748B] group-hover:text-[#94A3B8]"
                }`}>
                  {String(index + 1).padStart(2, "0")}/
                </span>

                <!-- Company Logo -->
                <div class={`relative w-10 h-10 sm:w-11 sm:h-11 rounded-lg bg-white/[0.04] p-2 border transition-all duration-300 shrink-0 flex items-center justify-center overflow-hidden ${
                  isFirst ? "border-accent-primary/50" : "border-white/10 group-hover:border-white/25"
                }`}>
                  <span class="absolute inset-0 flex items-center justify-center font-grotesk text-xs font-bold text-[#94A3B8] select-none" aria-hidden="true">
                    {exp.company.slice(0, 2).toUpperCase()}
                  </span>
                  <img
                    src={exp.logo}
                    alt={exp.company}
                    width="40"
                    height="40"
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                    class="relative w-full h-full object-contain bg-[#111726]"
                    onerror="this.style.display='none'"
                  />
                </div>

                <!-- Role & Company Title -->
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-1.5 sm:gap-2.5">
                    <h3 class="font-grotesk text-base sm:text-xl font-bold text-[#F8FAFC] tracking-[-0.03em] truncate">
                      {exp.role}
                    </h3>
                    <span class="text-white/20 hidden sm:inline">·</span>
                    <span class="text-xs sm:text-sm font-mono font-semibold text-[#38BDF8] truncate">
                      {exp.company}
                    </span>
                    {exp.isCurrent ? (
                      <span class="inline-flex items-center gap-1.5 text-[10px] font-mono px-2 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-[#10B981] font-medium">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#10B981] animate-pulse"></span>
                        {exp.badge}
                      </span>
                    ) : (
                      <span class="hidden md:inline-flex text-[10px] font-mono px-2 py-0.5 bg-white/[0.04] border border-white/[0.08] text-[#94A3B8]">
                        [ {exp.badge} ]
                      </span>
                    )}
                  </div>

                  <!-- Mobile Subline: Period & Type -->
                  <div class="flex sm:hidden items-center gap-2 mt-0.5 text-[11px] font-mono text-[#64748B]">
                    <span>{exp.duration}</span>
                    <span>·</span>
                    <span>{exp.type}</span>
                  </div>
                </div>
              </div>

              <!-- Right: Key Outcome Pill (Desktop) + Duration + Circular Toggle -->
              <div class="flex items-center gap-3 sm:gap-5 shrink-0">
                <span class="hidden lg:inline-flex items-center gap-1.5 px-3 py-1 bg-white/[0.03] border border-white/[0.08] text-[11px] font-mono text-[#94A3B8]">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#38BDF8]"></span>
                  {exp.headlineOutcome}
                </span>

                <div class="hidden sm:flex flex-col items-end text-right">
                  <span class="text-xs font-mono font-medium text-[#F8FAFC] tabular-nums">{exp.duration}</span>
                  <span class="text-[10px] font-mono text-[#64748B]">{exp.type}</span>
                </div>

                <span class={`exp-chevron w-9 h-9 sm:w-10 sm:h-10 rounded-full border flex items-center justify-center transition-all duration-300 ${
                  isFirst
                    ? "bg-accent-primary text-white border-accent-primary rotate-180"
                    : "bg-white/[0.04] text-[#94A3B8] border-white/15 group-hover:border-white/30 group-hover:text-white"
                }`}>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </div>
            </button>

            <!-- Accordion Drawer with Full Highlights, KPIs & Tech Stack -->
            <div
              id={`exp-drawer-${index}`}
              role="region"
              aria-labelledby={`exp-trigger-${index}`}
              class={`exp-drawer grid transition-[grid-template-rows,opacity] duration-300 ease-out ${
                isFirst ? "grid-rows-[1fr] opacity-100" : "grid-rows-[0fr] opacity-0"
              }`}
            >
              <div class="overflow-hidden">
                <div class="px-4 sm:px-7 pb-6 sm:pb-7 pt-1">
                  <div class="grid lg:grid-cols-12 gap-5 p-4 sm:p-6 bg-canvas border border-white/[0.10]">
                    
                    <!-- Left (7 Cols): Executive Summary & 3 Key Engineering Deliverables -->
                    <div class="lg:col-span-7 space-y-3.5 min-w-0">
                      <p class="text-xs sm:text-sm text-text-primary font-medium leading-relaxed">
                        {exp.description}
                      </p>

                      <ul class="space-y-2.5 pt-3 border-t border-white/[0.08]">
                        {exp.highlights.map((point) => (
                          <li class="flex items-start gap-2.5 text-xs sm:text-[13px] text-text-muted leading-relaxed">
                            <span class="w-1.5 h-1.5 rounded-full bg-accent-primary mt-1.5 shrink-0"></span>
                            <span>{point}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <!-- Right (5 Cols): Verified Impact KPIs + Stack + Company Link -->
                    <div class="lg:col-span-5 flex flex-col justify-between gap-4 p-4 bg-surface-card border border-white/[0.08] min-w-0">
                      <div class="space-y-4">
                        <!-- 2x1 KPI Bento Tiles -->
                        <div class="grid grid-cols-2 gap-2.5">
                          {exp.kpis.map((kpi) => (
                            <div class="p-3 bg-surface-elevated border border-white/[0.08]">
                              <div class="text-sm sm:text-base font-bold font-grotesk text-white tracking-tight">
                                {kpi.value}
                              </div>
                              <div class="text-[10px] font-mono text-text-dim mt-0.5 leading-tight">
                                {kpi.label}
                              </div>
                            </div>
                          ))}
                        </div>

                        <!-- Core Stack Pills -->
                        <div class="space-y-1.5">
                          <span class="text-[10px] font-mono uppercase tracking-[0.14em] text-text-dim block">[ PRODUCTION STACK ]</span>
                          <div class="flex flex-wrap gap-1.5">
                            {exp.technologies.map((tech) => (
                              <span class="px-2 py-0.5 bg-white/[0.04] border border-white/[0.10] text-[11px] font-mono text-text-muted">
                                {tech}
                              </span>
                            ))}
                          </div>
                        </div>
                      </div>

                      <!-- Footer Link -->
                      <div class="pt-3 border-t border-white/[0.08] flex items-center justify-between">
                        <span class="text-[10px] font-mono uppercase text-text-dim">{exp.period}</span>
                        <a
                          href={exp.companyUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1.5 text-xs font-grotesk font-semibold uppercase tracking-[0.04em] text-accent-hover hover:text-white transition-colors"
                        >
                          <span>VISIT {exp.company.toUpperCase()}</span>
                          <span>↗</span>
                        </a>
                      </div>
                    </div>

                  </div>
                </div>
              </div>
            </div>

          </div>
        );
      })}
    </div>

  </div>
</section>

<script>
  const initExperienceLedger = () => {
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-exp-item]'));
    const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-exp-trigger]'));

    if (!items.length || !triggers.length) return;

    const openRow = (targetIdx: number) => {
      items.forEach((item, idx) => {
        const trigger = item.querySelector<HTMLButtonElement>('[data-exp-trigger]');
        const drawer = item.querySelector<HTMLElement>('.exp-drawer');
        const chevron = item.querySelector<HTMLElement>('.exp-chevron');
        const idxLabel = item.querySelector<HTMLElement>('.exp-idx');

        const isOpen = idx === targetIdx;

        item.classList.toggle('is-open', isOpen);
        item.classList.toggle('bg-surface-elevated/40', isOpen);
        item.classList.toggle('hover:bg-white/[0.02]', !isOpen);

        if (trigger) {
          trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        }

        if (drawer) {
          drawer.classList.toggle('grid-rows-[1fr]', isOpen);
          drawer.classList.toggle('opacity-100', isOpen);
          drawer.classList.toggle('grid-rows-[0fr]', !isOpen);
          drawer.classList.toggle('opacity-0', !isOpen);
        }

        if (chevron) {
          chevron.classList.toggle('bg-accent-primary', isOpen);
          chevron.classList.toggle('text-white', isOpen);
          chevron.classList.toggle('border-accent-primary', isOpen);
          chevron.classList.toggle('rotate-180', isOpen);

          chevron.classList.toggle('bg-white/[0.04]', !isOpen);
          chevron.classList.toggle('text-text-muted', !isOpen);
          chevron.classList.toggle('border-white/15', !isOpen);
        }

        if (idxLabel) {
          idxLabel.classList.toggle('text-accent-hover', isOpen);
          idxLabel.classList.toggle('text-text-dim', !isOpen);
        }
      });
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const idx = Number(trigger.getAttribute('data-exp-trigger') || 0);
        const parentItem = items[idx];
        const alreadyOpen = parentItem?.classList.contains('is-open');
        if (!alreadyOpen) {
          openRow(idx);
        }
      });
    });
  };

  initExperienceLedger();
  document.addEventListener('astro:after-swap', initExperienceLedger);
</script>
