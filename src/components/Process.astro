---
import SectionHeader from "./SectionHeader.astro";

const phases = [
  {
    step: "01",
    tag: "Days 1 - 3",
    title: "Scope & System Design",
    desc: "Map user roles, relational database schemas, API contracts, and milestone deliverables before writing application code."
  },
  {
    step: "02",
    tag: "Core Sprints",
    title: "Full-Stack & AI Build",
    desc: "Ship typed React/Next.js interfaces, Node.js services, and validated multi-LLM or real-time Socket.IO workflows in weekly increments."
  },
  {
    step: "03",
    tag: "Pre-Launch",
    title: "Performance & Security QA",
    desc: "Tune Core Web Vitals for 99+ Lighthouse scores, enforce RBAC permissions, rate limits, and end-to-end payment webhook testing."
  },
  {
    step: "04",
    tag: "Handoff",
    title: "Production Release",
    desc: "Deploy zero-downtime CI/CD pipelines, configure monitoring and audit logs, and deliver clean documentation for your team."
  }
];

const guarantees = [
  {
    label: "Single-Engineer Ownership",
    text: "I handle database modeling, backend APIs, LLM orchestration, and frontend UI directly so features ship without handoff bottlenecks."
  },
  {
    label: "Async-First Communication",
    text: "Clear written updates, staging preview links on every PR, and direct Slack or GitHub collaboration with founders and product leads."
  },
  {
    label: "Production-Ready Codebase",
    text: "Strict TypeScript, modular component architecture, and clean Git history designed so future engineers can onboard in hours."
  }
];

const faqs = [
  {
    q: "What is your core tech stack for production SaaS & AI builds?",
    a: "My daily production stack is TypeScript, React.js, Next.js (App Router & SSR), Node.js, Express, PostgreSQL/MongoDB, and Socket.IO. For AI systems, I orchestrate OpenAI, Google Gemini, Anthropic Claude, and Perplexity APIs with structured output validation and RAG pipelines."
  },
  {
    q: "Are you available for full-time remote roles as well as freelance SaaS builds?",
    a: "Yes. I am open to both senior Full-Stack / Frontend / AI Engineering roles with global product teams and fixed-scope SaaS or MVP builds for founders."
  },
  {
    q: "How fast can a new SaaS MVP or AI web application go from spec to production?",
    a: "Focused MVPs and AI workflows typically ship to production in 2 to 5 weeks. We start with database schema and API contracts in Days 1–3, followed by weekly shippable sprints with live staging previews."
  },
  {
    q: "What is included when I purchase one of your commercial website templates?",
    a: "Every template (such as Apex Luxury or Lumina Dental) includes the complete Next.js & TypeScript source code, Tailwind CSS design tokens, GSAP/Framer Motion animations, 99+ Lighthouse optimization, and a commercial license for unlimited client or personal projects."
  }
];
---

<section id="process" class="py-16 sm:py-24 md:py-28 border-t border-white/[0.10] bg-canvas relative z-20">
  <div class="w-full">
    
    <SectionHeader 
      eyebrow="DEVELOPMENT PROCESS"
      title="How Projects Go From" 
      gradientText="Spec to Production" 
      subtitle="A predictable four-stage execution pipeline built for startup speed and production reliability."
    />

    <!-- 4-Step Horizontal Execution Pipeline with Developer HUD Framing -->
    <div class="mt-8 sm:mt-12 relative">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 relative z-10">
        {phases.map((phase) => (
          <div data-gsap-card class="bento-spotlight group relative rounded-[20px] bg-[#111726] border border-white/[0.10] hover:border-accent-primary/40 transition-all duration-500 p-6 flex flex-col justify-between shadow-[0_18px_45px_rgba(0,0,0,0.5)]">
            <span class="pointer-events-none absolute top-3 left-3 w-3.5 h-[1px] bg-white/40 group-hover:bg-accent-primary transition-colors"></span>
            <span class="pointer-events-none absolute top-3 left-3 w-[1px] h-3.5 bg-white/40 group-hover:bg-accent-primary transition-colors"></span>

            <div>
              <div class="flex items-center justify-between mb-6">
                <div class="w-9 h-9 bg-[#0B0F17] border border-white/15 group-hover:border-accent-primary flex items-center justify-center font-mono text-xs font-bold text-[#F8FAFC] group-hover:text-accent-primary transition-colors tabular-nums">
                  {phase.step}/
                </div>
                <span class="text-[11px] font-mono uppercase tracking-[0.06em] text-[#64748B] px-2.5 py-0.5 bg-white/[0.03] border border-white/[0.08]">
                  [ {phase.tag} ]
                </span>
              </div>

              <h3 class="font-grotesk text-lg font-bold text-[#F8FAFC] tracking-[-0.03em] mb-2.5">
                {phase.title}
              </h3>
              <p class="text-xs sm:text-sm text-[#94A3B8] leading-relaxed">
                {phase.desc}
              </p>
            </div>

            <div class="mt-6 pt-3.5 border-t border-white/[0.08] flex items-center justify-between text-[11px] font-mono text-[#64748B]">
              <span>STAGE {phase.step}</span>
              <span class="text-accent-primary group-hover:translate-x-0.5 transition-transform font-bold">→</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Client Core Benefits Bar -->
    <div class="mt-8 bg-[#111726] border border-white/[0.10] p-6 md:p-8 grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 divide-y md:divide-y-0 md:divide-x divide-white/[0.10]">
      {guarantees.map((benefit, idx) => (
        <div class={`space-y-2 ${idx > 0 ? 'pt-5 md:pt-0 md:pl-8' : ''}`}>
          <div class="flex items-center gap-2">
            <span class="rec-dot"></span>
            <h4 class="font-grotesk text-sm font-bold text-[#F8FAFC] tracking-tight uppercase">{benefit.label}</h4>
          </div>
          <p class="text-xs sm:text-sm text-[#94A3B8] leading-relaxed">{benefit.text}</p>
        </div>
      ))}
    </div>

    <!-- FAQ Hairline Accordion -->
    <div id="faq" class="mt-16 sm:mt-24 pt-12 border-t border-white/[0.10]">
      <div class="inline-flex items-center gap-2.5 px-3.5 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/30 mb-4 shadow-[0_0_12px_rgba(94,106,210,0.15)]">
        <span class="w-1.5 h-1.5 rounded-full bg-accent-primary animate-pulse shadow-[0_0_8px_rgba(94,106,210,0.8)]"></span>
        <span class="text-xs font-mono font-semibold uppercase tracking-[0.08em] text-indigo-300">// FREQUENTLY ASKED</span>
      </div>
      <h3 class="font-grotesk font-bold text-2xl sm:text-3xl md:text-4xl text-[#F8FAFC] tracking-[-0.04em] mb-8">
        Frequently Asked <span class="text-text-dim">Questions</span>
      </h3>

      <div class="border-t border-white/[0.14]" id="faq-accordion">
        {faqs.map((item, idx) => {
          const isFirst = idx === 0;
          return (
            <div 
              class={`faq-item border-b border-white/[0.14] transition-colors ${isFirst ? 'is-open bg-white/[0.015]' : 'hover:bg-white/[0.01]'}`}
              data-faq-item={idx}
            >
              <button
                type="button"
                aria-expanded={isFirst ? "true" : "false"}
                aria-controls={`faq-panel-${idx}`}
                data-faq-trigger={idx}
                class="w-full text-left py-5 sm:py-6 px-2 sm:px-4 flex items-center justify-between gap-6 cursor-pointer focus:outline-none group"
              >
                <div class="flex items-baseline gap-4 sm:gap-6 min-w-0">
                  <span class="font-mono text-xs text-[#38BDF8] font-bold tabular-nums shrink-0">
                    0{idx + 1}/
                  </span>
                  <h4 class="font-grotesk font-bold text-base sm:text-lg md:text-xl text-[#F8FAFC] group-hover:text-white tracking-[-0.025em] leading-snug">
                    {item.q}
                  </h4>
                </div>

                <span class={`faq-icon shrink-0 w-9 h-9 rounded-full border flex items-center justify-center transition-all duration-300 ${
                  isFirst 
                    ? 'bg-accent-primary border-accent-primary text-white rotate-45' 
                    : 'bg-white/[0.04] border-white/15 text-[#F8FAFC] group-hover:border-white/35'
                }`}>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                    <path d="M12 5v14M5 12h14" />
                  </svg>
                </span>
              </button>

              <div 
                id={`faq-panel-${idx}`}
                class={`faq-drawer grid transition-[grid-template-rows,opacity] duration-300 ease-out ${
                  isFirst ? 'grid-rows-[1fr] opacity-100' : 'grid-rows-[0fr] opacity-0'
                }`}
              >
                <div class="overflow-hidden">
                  <p class="pb-6 pl-9 sm:pl-12 pr-4 sm:pr-14 text-xs sm:text-sm text-[#94A3B8] leading-relaxed max-w-3xl">
                    {item.a}
                  </p>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>

  </div>
</section>

<script>
  const setupFaqAccordion = () => {
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-faq-item]'));
    const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-faq-trigger]'));
    if (!items.length || !triggers.length) return;

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const targetIdx = Number(trigger.getAttribute('data-faq-trigger') || 0);
        const clickedItem = items[targetIdx];
        const isCurrentlyOpen = clickedItem?.classList.contains('is-open');

        items.forEach((item, idx) => {
          const btn = item.querySelector<HTMLButtonElement>('[data-faq-trigger]');
          const drawer = item.querySelector<HTMLElement>('.faq-drawer');
          const icon = item.querySelector<HTMLElement>('.faq-icon');
          const shouldOpen = idx === targetIdx ? !isCurrentlyOpen : false;

          item.classList.toggle('is-open', shouldOpen);
          item.classList.toggle('bg-white/[0.015]', shouldOpen);
          btn?.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');

          if (drawer) {
            drawer.classList.toggle('grid-rows-[1fr]', shouldOpen);
            drawer.classList.toggle('opacity-100', shouldOpen);
            drawer.classList.toggle('grid-rows-[0fr]', !shouldOpen);
            drawer.classList.toggle('opacity-0', !shouldOpen);
          }

          if (icon) {
            icon.classList.toggle('bg-accent-primary', shouldOpen);
            icon.classList.toggle('border-accent-primary', shouldOpen);
            icon.classList.toggle('text-white', shouldOpen);
            icon.classList.toggle('rotate-45', shouldOpen);
            icon.classList.toggle('bg-white/[0.04]', !shouldOpen);
            icon.classList.toggle('border-white/15', !shouldOpen);
          }
        });
      });
    });
  };

  setupFaqAccordion();
  document.addEventListener('astro:after-swap', setupFaqAccordion);
</script>
