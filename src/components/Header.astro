---
import { useSanityClient, groq } from "astro-sanity";

const query = groq`*[_type == "sideBar"]{
  ...,
  sideMenus[]->
}`;

let sideBar = null;
try {
  const result = await useSanityClient().fetch(query);
  sideBar = result?.[0] || null;
} catch (err) {
  console.warn("Could not fetch sidebar/header from Sanity:", err);
}

const defaultMenus = [
  { menuName: "Home", menuLink: { current: "/" } },
  { menuName: "Projects", menuLink: { current: "/projects" } },
  { menuName: "Templates", menuLink: { current: "/templates" } },
  { menuName: "Agency", menuLink: { current: "/agency" } },
  { menuName: "About", menuLink: { current: "/about" } },
  { menuName: "Blog", menuLink: { current: "/blogs" } }
];

const rawMenus = (sideBar?.sideMenus && sideBar.sideMenus.length > 0)
  ? [...sideBar.sideMenus]
  : defaultMenus;

const hasTemplates = rawMenus.some((item) => {
  const name = (item.menuName || "").toLowerCase();
  const link = (typeof item.menuLink === "string" ? item.menuLink : item.menuLink?.current || "").toLowerCase();
  return name === "templates" || link.includes("templates");
});

if (!hasTemplates) {
  const projIdx = rawMenus.findIndex((item) => {
    const name = (item.menuName || "").toLowerCase();
    const link = (typeof item.menuLink === "string" ? item.menuLink : item.menuLink?.current || "").toLowerCase();
    return name.includes("project") || link.includes("project");
  });
  if (projIdx !== -1) {
    rawMenus.splice(projIdx + 1, 0, { menuName: "Templates", menuLink: { current: "/templates" } });
  } else {
    rawMenus.push({ menuName: "Templates", menuLink: { current: "/templates" } });
  }
}

const hasAgency = rawMenus.some((item) => {
  const name = (item.menuName || "").toLowerCase();
  const link = (typeof item.menuLink === "string" ? item.menuLink : item.menuLink?.current || "").toLowerCase();
  return name === "agency" || link.includes("agency");
});

if (!hasAgency) {
  const tplIdx = rawMenus.findIndex((item) => {
    const name = (item.menuName || "").toLowerCase();
    const link = (typeof item.menuLink === "string" ? item.menuLink : item.menuLink?.current || "").toLowerCase();
    return name.includes("template") || link.includes("template");
  });
  if (tplIdx !== -1) {
    rawMenus.splice(tplIdx + 1, 0, { menuName: "Agency", menuLink: { current: "/agency" } });
  } else {
    rawMenus.push({ menuName: "Agency", menuLink: { current: "/agency" } });
  }
}

const menuItems = rawMenus;
---

<header class="fixed top-0 inset-x-0 w-full max-w-[100vw] overflow-x-clip z-50 transition-all duration-500 pointer-events-none" id="main-header">
  <div class="absolute inset-0 header-bg transition-all duration-500"></div>

  <nav aria-label="Main Navigation" class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 py-4 md:py-5 flex items-center justify-between gap-4 transition-all duration-500 relative z-10 pointer-events-auto box-border" id="nav-container">
    <!-- LEFT: Monogram & Wordmark -->
    <div class="shrink-0 flex items-center">
      <a href="/" aria-label="Tanuj Pandey - Home" class="group inline-flex items-center gap-2.5 shrink-0">
        <div class="relative w-8 h-8 rounded-md flex items-center justify-center border border-white/15 bg-[#111726] group-hover:border-accent-primary transition-all duration-300 overflow-hidden">
          <img src="/favicon.svg" alt="Tanuj Pandey Logo" class="w-full h-full object-cover" width="32" height="32" />
        </div>
        <span class="font-grotesk font-bold text-sm sm:text-base tracking-[-0.03em] text-[#F8FAFC]">
          TANUJ PANDEY<span class="text-accent-primary drop-shadow-[0_0_12px_rgba(94,106,210,0.8)]">.</span>
        </span>
      </a>
    </div>

    <!-- CENTER: Floating Glass Island Navigation (Desktop) -->
    <div class="hidden md:flex items-center justify-center gap-6 lg:gap-8 px-6 py-2 rounded-full bg-[#111726]/90 backdrop-blur-xl border border-white/[0.12] shadow-[0_4px_25px_rgba(0,0,0,0.6)]" id="desktop-nav-menu">
      {menuItems.map((menuItem) => {
        const rawLabel = menuItem.menuName || "Link";
        const label = rawLabel.toUpperCase();
        return (
          <a
            href={menuItem.menuLink?.current || menuItem.menuLink || "/"}
            class="nav-link group relative py-1 text-[12px] font-grotesk font-bold tracking-[0.06em] text-text-muted hover:text-[#F8FAFC] transition-colors"
          >
            <span class="rushes-roll">
              <span class="rushes-roll-track">
                <span>{label}</span>
                <span class="text-[#F8FAFC]">{label}</span>
              </span>
            </span>
            <span class="nav-active-line absolute -bottom-0.5 left-0 right-0 h-[1.5px] bg-accent-primary scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"></span>
          </a>
        );
      })}
    </div>

    <!-- RIGHT: Magnetic Pill CTA (Desktop) & Minimalist 2-Bar Toggle (Mobile) -->
    <div class="shrink-0 flex justify-end items-center gap-3">
      <a
        href="/#contact"
        aria-label="Get in touch with Tanuj Pandey"
        class="magnetic-btn hidden md:inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-white hover:bg-slate-100 text-[#0B0F17] font-grotesk font-bold text-xs uppercase tracking-[0.04em] rounded-full transition-all duration-300 group shadow-[0_0_20px_rgba(255,255,255,0.2)] hover:shadow-[0_0_25px_rgba(255,255,255,0.35)]"
      >
        <span class="rushes-roll">
          <span class="rushes-roll-track">
            <span>GET IN TOUCH</span>
            <span>GET IN TOUCH</span>
          </span>
        </span>
        <span class="text-xs transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 font-bold">↗</span>
      </a>

      <button
        id="mobile-trigger"
        class="md:hidden shrink-0 w-10 h-10 rounded-full bg-white/[0.04] border border-white/10 flex flex-col items-center justify-center gap-1.5 group transition-all hover:border-accent-primary/60 active:scale-95 cursor-pointer overflow-hidden"
        aria-label="Toggle Menu"
        aria-expanded="false"
      >
        <div class="w-5 h-[2px] bg-text-primary transition-all duration-300 origin-center" id="bar-1"></div>
        <div class="w-5 h-[2px] bg-text-primary transition-all duration-300 origin-center" id="bar-2"></div>
      </button>
    </div>
  </nav>

  <!-- Full-Screen Mobile Overlay -->
  <div id="mobile-overlay" class="fixed inset-0 bg-canvas/98 backdrop-blur-2xl z-[100] hidden flex-col justify-between pointer-events-auto opacity-0 transition-all duration-500 px-6 py-24">
    <div class="flex items-center justify-between border-b border-white/10 pb-4">
      <div class="inline-flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-accent-primary animate-pulse"></span>
        <span class="text-xs font-mono font-semibold uppercase tracking-[0.06em] text-accent-hover">// NAVIGATION</span>
      </div>
      <button id="close-overlay" aria-label="Close navigation menu" class="text-xs font-grotesk font-semibold uppercase tracking-[0.08em] text-text-muted hover:text-white transition-colors cursor-pointer">
        [ Close ]
      </button>
    </div>

    <div class="flex flex-col space-y-3 my-auto py-8">
      {menuItems.map((menuItem, index) => {
        const rawLabel = menuItem.menuName || "Link";
        const label = rawLabel.charAt(0).toUpperCase() + rawLabel.slice(1);
        return (
          <a
            href={menuItem.menuLink?.current || menuItem.menuLink || "/"}
            class="mobile-nav-link group flex items-baseline justify-between border-b border-white/[0.08] py-3.5 text-3xl sm:text-4xl font-grotesk font-bold text-text-primary capitalize tracking-[-0.03em] hover:text-accent-hover transition-all"
            style={`animation-delay: ${index * 0.06}s`}
          >
            <span>{label}</span>
            <span class="text-xs font-mono text-text-dim group-hover:text-accent-primary">0{index + 1}/</span>
          </a>
        );
      })}
    </div>

    <div class="flex flex-col gap-4 pt-4 border-t border-white/10">
      <a href="/#contact" aria-label="Get in touch with Tanuj Pandey" class="w-full py-3.5 bg-accent-primary hover:bg-accent-hover text-white rounded-full font-grotesk font-semibold text-xs uppercase tracking-[0.06em] text-center transition-all">
        Get In Touch
      </a>
      <div class="flex items-center justify-between text-[11px] font-mono text-text-dim">
        <span>Tanuj Pandey.</span>
        <span>India &amp; Worldwide</span>
      </div>
    </div>
  </div>
</header>

<style>
  header .header-bg {
    background: transparent;
    border-bottom: 1px solid transparent;
  }

  #main-header.scrolled .header-bg {
    background: rgba(11, 15, 23, 0.88);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .nav-link.active {
    color: #FAFAFA !important;
  }

  .nav-link.active .nav-active-line {
    transform: scaleX(1) !important;
  }

  .mobile-nav-link.active {
    color: var(--accent-hover, #828FFF) !important;
  }

  @keyframes slideReveal {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  #mobile-overlay.active-menu .mobile-nav-link {
    animation: slideReveal 0.4s forwards cubic-bezier(0.16, 1, 0.3, 1);
  }

  #mobile-overlay.active-menu {
    opacity: 1;
    transform: translateY(0);
  }

  #mobile-trigger.is-open #bar-1 {
    transform: translateY(4px) rotate(45deg);
  }
  #mobile-trigger.is-open #bar-2 {
    transform: translateY(-4px) rotate(-45deg);
  }
</style>

<script>
  function setupHeader() {
    const header = document.getElementById('main-header');
    const trigger = document.getElementById('mobile-trigger');
    const overlay = document.getElementById('mobile-overlay');
    const closeBtn = document.getElementById('close-overlay');
    const navItems = document.querySelectorAll('.nav-link');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');
    const navContainer = document.getElementById('nav-container');

    if (!header || !navContainer) return;

    const handleScroll = () => {
      if (window.scrollY > 36) {
        header.classList.add('scrolled');
        navContainer.classList.remove('md:py-5');
        navContainer.classList.add('md:py-3.5');
      } else {
        header.classList.remove('scrolled');
        navContainer.classList.remove('md:py-3.5');
        navContainer.classList.add('md:py-5');
      }
    };
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    const openMenu = () => {
      if (!overlay || !trigger) return;
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');
      trigger.classList.add('is-open');
      trigger.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(() => {
        overlay.classList.add('active-menu');
      });
      document.body.style.overflow = 'hidden';
    };

    const closeMenu = () => {
      if (!overlay || !trigger) return;
      overlay.classList.remove('active-menu');
      trigger.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
      setTimeout(() => {
        overlay.classList.add('hidden');
        overlay.classList.remove('flex');
      }, 320);
      document.body.style.overflow = '';
    };

    if (trigger) {
      const newTrigger = trigger.cloneNode(true) as HTMLElement;
      trigger.parentNode?.replaceChild(newTrigger, trigger);
      newTrigger.addEventListener('click', () => {
        if (overlay?.classList.contains('active-menu')) {
          closeMenu();
        } else {
          openMenu();
        }
      });
    }

    closeBtn?.addEventListener('click', closeMenu);
    mobileLinks.forEach(link => link.addEventListener('click', closeMenu));
    overlay?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));

    const onKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && overlay?.classList.contains('active-menu')) {
        closeMenu();
      }
    };
    document.addEventListener('keydown', onKeyDown);

    const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
    const allLinks = [...navItems, ...mobileLinks];

    allLinks.forEach(item => {
      item.classList.remove('active');
      const rawHref = item.getAttribute('href') || '';
      const href = rawHref.replace(/\/$/, '') || '/';

      if (href === currentPath) {
        item.classList.add('active');
      } else if (href !== '/' && currentPath.startsWith(href)) {
        item.classList.add('active');
      }
    });
  }

  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
</script>
