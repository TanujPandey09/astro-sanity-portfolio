---
// Cinematic hero: dark slate backdrop, optional desktop-only background video
const disciplines = [
  { num: "01/", label: "FULL-STACK SAAS PLATFORMS" },
  { num: "02/", label: "MULTI-LLM & AI AGENTS" },
  { num: "03/", label: "HIGH-THROUGHPUT BACKENDS" },
  { num: "04/", label: "REACT 19 & NEXT.JS APPS" },
];

const heroVideo = "https://videos.pexels.com/video-files/3129957/3129957-hd_1920_1080_25fps.mp4";
---

<section id="hero" class="min-h-[100dvh] flex flex-col justify-between relative overflow-hidden pt-24 sm:pt-28 md:pt-32 pb-8 md:pb-12 bg-[#0B0F17]">
  <!-- Clean Cinematic Video Backdrop (#0B0F17 deep slate base) -->
  <div class="absolute inset-0 -z-10 overflow-hidden bg-[#0B0F17]">
    <!-- Source is attached by script only on desktop, without reduced-motion or data-saver -->
    <video
      id="hero-bg-video"
      data-src={heroVideo}
      loop
      muted
      playsinline
      preload="none"
      aria-hidden="true"
      class="w-full h-full object-cover object-center opacity-0 mix-blend-screen scale-105 will-change-transform transition-opacity duration-700"
    ></video>

    <!-- Developer Precision Scrims: Linear Top/Bottom Fade to Pure #0B0F17 -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#0B0F17]/85 via-transparent to-[#0B0F17]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_40%,rgba(11,15,23,0.85)_100%)]"></div>

    <!-- HUD Corner Viewfinder Markers on Hero Frame -->
    <div class="pointer-events-none absolute inset-6 sm:inset-10 z-10 hidden sm:block">
      <span class="absolute top-0 left-0 w-8 h-[1px] bg-white/30"></span>
      <span class="absolute top-0 left-0 w-[1px] h-8 bg-white/30"></span>
      <span class="absolute top-0 right-0 w-8 h-[1px] bg-white/30"></span>
      <span class="absolute top-0 right-0 w-[1px] h-8 bg-white/30"></span>
      <span class="absolute bottom-0 left-0 w-8 h-[1px] bg-white/30"></span>
      <span class="absolute bottom-0 left-0 w-[1px] h-8 bg-white/30"></span>
      <span class="absolute bottom-0 right-0 w-8 h-[1px] bg-white/30"></span>
      <span class="absolute bottom-0 right-0 w-[1px] h-8 bg-white/30"></span>
    </div>
  </div>

  <!-- 1. TOP STATUS BAR: Developer Live Beacon + SMPTE Live Timecode + Sys Status -->
  <div class="w-full flex flex-wrap items-center justify-between gap-3 border-b border-white/[0.10] pb-4 relative z-20" data-gsap-hero="topbar">
    <div class="inline-flex items-center gap-2.5 px-3.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 shadow-[0_0_15px_rgba(16,185,129,0.2)]">
      <span class="w-2 h-2 rounded-full bg-[#10B981] animate-pulse shadow-[0_0_8px_rgba(16,185,129,0.8)]"></span>
      <span class="text-xs font-mono font-semibold text-[#F8FAFC] tracking-[0.04em] uppercase">
        AVAILABLE FOR SELECT PROJECTS // FULL-STACK &amp; AI
      </span>
    </div>

    <div class="flex items-center gap-3 text-xs font-mono text-[#94A3B8]">
      <span class="hidden sm:inline px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.10] text-[#F8FAFC] font-medium uppercase tracking-[0.04em]">
        TANUJ PANDEY // FULL-STACK &amp; AI
      </span>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-[#111726] border border-white/[0.12] text-[#38BDF8] font-mono font-semibold shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-[#10B981] animate-ping"></span>
        <span id="local-clock" class="tabular-nums" title="My local time (IST, UTC+5:30)">-- : -- : -- IST</span>
      </div>
    </div>
  </div>

  <!-- 2. CENTER VIEWPORT: Dominant Wordmark + Cinematic Headline -->
  <div class="relative my-auto py-10 sm:py-14 md:py-20 w-full z-20">
    <div class="w-full sm:px-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/[0.05] border border-white/[0.12] text-xs font-mono text-[#94A3B8] mb-5 tracking-[0.06em] uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-[#5E6AD2]"></span>
        <span>FULL-STACK &amp; AI ENGINEER FOR HIRE</span>
      </div>

      <div
        data-gsap-hero="wordmark"
        class="font-grotesk font-bold text-[#F8FAFC] tracking-[-0.055em] leading-[0.88] text-[3.4rem] xs:text-[4.4rem] sm:text-[6.2rem] md:text-[7.8rem] lg:text-[9.5rem] select-none mb-4 sm:mb-6 drop-shadow-[0_4px_30px_rgba(0,0,0,0.8)]"
      >
        Tanuj Pandey<span class="text-[#5E6AD2] drop-shadow-[0_0_25px_rgba(94,106,210,0.7)]">.</span>
      </div>

      <h1
        data-gsap-hero="headline"
        class="font-grotesk font-extrabold text-[#F8FAFC] leading-[1.06] tracking-[-0.035em] text-2xl sm:text-4xl md:text-5xl lg:text-6xl max-w-5xl"
      >
        Engineering Scalable SaaS &amp; <span class="text-gradient">Production AI Systems.</span>
      </h1>
    </div>
  </div>

  <!-- 3. BOTTOM SPLIT BAR: Value Proposition + Framer Pill CTAs + Numbered Disciplines -->
  <div class="w-full pt-6 border-t border-white/[0.10] grid grid-cols-1 lg:grid-cols-12 gap-8 items-end relative z-20" data-gsap-hero="bottombar">
    <div class="lg:col-span-7 flex flex-col items-start gap-5">
      <p class="text-sm sm:text-base md:text-lg text-[#94A3B8] leading-relaxed font-normal max-w-2xl">
        I help startups and product teams take SaaS and AI products from idea to production: multi-LLM features, real-time Node.js backends, and fast React &amp; Next.js interfaces. 4+ years of commercial experience.
      </p>

      <div class="w-full sm:w-auto flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <!-- Developer Primary CTA: Crisp White with Deep Slate Text -->
        <a
          href="#projects"
          aria-label="View Selected Work projects"
          class="magnetic-btn group inline-flex items-center justify-center gap-3 h-11 px-7 rounded-full bg-white hover:bg-slate-100 text-[#0B0F17] font-grotesk font-bold text-xs uppercase tracking-[0.05em] transition-all duration-300 shadow-[0_0_25px_rgba(255,255,255,0.25)] hover:shadow-[0_0_35px_rgba(255,255,255,0.4)] whitespace-nowrap active:scale-95"
        >
          <span class="rushes-roll">
            <span class="rushes-roll-track">
              <span>SELECTED WORK</span>
              <span>SELECTED WORK</span>
            </span>
          </span>
          <span class="text-xs leading-none transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 font-bold">↗</span>
        </a>

        <!-- Developer Secondary CTA: #111726 Bento Slate Card with Hairline White Border -->
        <a
          href="/templates"
          aria-label="Explore Commercial Templates"
          class="magnetic-btn group inline-flex items-center justify-center gap-2.5 h-11 px-6 rounded-full bg-[#111726] border border-white/[0.15] hover:border-[#5E6AD2]/60 hover:bg-[#1A2236] text-[#F8FAFC] hover:text-[#38BDF8] font-grotesk font-semibold text-xs uppercase tracking-[0.05em] transition-all duration-300 shadow-sm whitespace-nowrap active:scale-95"
        >
          <span class="rushes-roll">
            <span class="rushes-roll-track">
              <span>TEMPLATES</span>
              <span>TEMPLATES</span>
            </span>
          </span>
          <span class="text-[#38BDF8] text-xs leading-none transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 font-bold">↗</span>
        </a>

        <!-- Developer Tertiary CTA: Outline Pill -->
        <a
          href="#contact"
          aria-label="Start a Project with Tanuj Pandey"
          class="magnetic-btn group inline-flex items-center justify-center gap-2 h-11 px-6 rounded-full bg-white/[0.03] border border-white/[0.12] hover:border-white/30 text-[#94A3B8] hover:text-[#F8FAFC] font-grotesk font-semibold text-xs uppercase tracking-[0.05em] transition-all duration-300 whitespace-nowrap active:scale-95"
        >
          <span class="rushes-roll">
            <span class="rushes-roll-track">
              <span>GET IN TOUCH</span>
              <span>GET IN TOUCH</span>
            </span>
          </span>
          <span class="text-xs leading-none transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
        </a>
      </div>
    </div>

    <!-- Bottom Right: Numbered Disciplines + Proof Metrics -->
    <div class="lg:col-span-5 flex flex-col items-start lg:items-end justify-end space-y-2.5">
      {disciplines.map((item) => (
        <div class="inline-flex items-center gap-2.5 text-xs sm:text-[13px] font-grotesk font-medium tracking-[0.02em]">
          <span class="text-[#38BDF8] font-mono font-bold">{item.num}</span>
          <span class="text-[#F8FAFC] font-semibold">{item.label}</span>
        </div>
      ))}

      <!-- Compact Inline Proof Strip with Developer Electric Sky Numbers -->
      <div class="pt-3 mt-2 border-t border-white/[0.10] flex flex-wrap items-center gap-4 sm:gap-6 text-xs font-mono text-[#94A3B8]">
        <div>
          <span class="text-[#38BDF8] font-extrabold text-sm drop-shadow-[0_0_8px_rgba(56,189,248,0.4)]" data-counter="4" data-suffix="+ Yrs">4+ Yrs</span>
          <span class="text-[#94A3B8] ml-1 font-normal">Experience</span>
        </div>
        <span class="text-white/20">·</span>
        <div>
          <span class="text-[#38BDF8] font-extrabold text-sm drop-shadow-[0_0_8px_rgba(56,189,248,0.4)]" data-counter="10" data-suffix="+">10+</span>
          <span class="text-[#94A3B8] ml-1 font-normal">SaaS Builds</span>
        </div>
        <span class="text-white/20">·</span>
        <div>
          <span class="text-[#38BDF8] font-extrabold text-sm drop-shadow-[0_0_8px_rgba(56,189,248,0.4)]" data-counter="99" data-suffix="+">99+</span>
          <span class="text-[#94A3B8] ml-1 font-normal">Lighthouse</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const initHero = () => {
    // Background video: only on desktop, no reduced-motion, no data-saver.
    // Everyone else keeps the static dark backdrop (faster LCP, less data).
    const bgVideo = document.getElementById('hero-bg-video') as HTMLVideoElement | null;
    if (bgVideo && !bgVideo.getAttribute('src')) {
      const conn = (navigator as any).connection;
      const allowVideo =
        window.matchMedia('(min-width: 768px)').matches &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
        !(conn && (conn.saveData || /(^|-)2g$/.test(conn.effectiveType || '')));
      if (allowVideo) {
        const attach = () => {
          bgVideo.src = bgVideo.dataset.src || '';
          bgVideo.addEventListener('canplay', () => {
            bgVideo.classList.remove('opacity-0');
            bgVideo.classList.add('opacity-25');
            bgVideo.play().catch(() => {});
          }, { once: true });
          bgVideo.load();
        };
        // Wait until the page is idle so the video never competes with first paint
        if ('requestIdleCallback' in window) {
          (window as any).requestIdleCallback(attach, { timeout: 2500 });
        } else {
          setTimeout(attach, 1200);
        }
      }
    }

    // Live local-time clock (IST) so clients can see my current working hours
    const clockEl = document.getElementById('local-clock');
    if (clockEl) {
      const fmt = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Asia/Kolkata',
        hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false,
      });
      const tick = () => { clockEl.textContent = `${fmt.format(new Date())} IST`; };
      tick();
      const w = window as any;
      if (w.__heroClock) clearInterval(w.__heroClock);
      w.__heroClock = setInterval(tick, 1000);
    }
  };

  initHero();
  document.addEventListener('astro:page-load', initHero);
</script>
