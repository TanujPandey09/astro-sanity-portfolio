---
// High-End Design Engineering Hero Component
---

<section id="hero" class="min-h-[calc(100vh-4.5rem)] flex flex-col justify-center relative overflow-hidden pt-16 md:pt-20 pb-8">
  <div class="container mx-auto px-4 md:px-8 relative z-20">
    <div class="max-w-5xl mx-auto text-center flex flex-col items-center relative">
      
      <!-- Subtle Ambient Hero Spotlight Halo -->
      <div class="absolute -top-10 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-accent-primary/20 blur-[100px] pointer-events-none -z-10 rounded-full"></div>

      <!-- Eyebrow: Minimalist Availability Beacon -->
      <div class="mb-4 inline-flex items-center gap-2.5 px-4 py-1.5 rounded-xl bg-surface-card/90 border border-white/12 backdrop-blur-md shadow-sm transition-all hover:border-accent-primary/40" data-aos="fade-up">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="text-[11px] font-mono uppercase tracking-[0.2em] text-text-primary font-medium">Available for New Projects</span>
        <span class="text-white/20">•</span>
        <span class="text-[11px] font-mono text-text-muted">Full-Stack Engineer</span>
      </div>

      <!-- Main Headline: Editorial Design Engineering -->
      <div class="mb-4 max-w-4xl" data-aos="fade-up" data-aos-delay="100">
        <h1 class="hero-title font-extrabold text-white leading-[1.1] tracking-[-0.035em] text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-sans">
          Engineering Scalable Systems <br class="hidden sm:inline"/>
          <span class="text-gradient">& High-Fidelity Products.</span>
        </h1>
      </div>

      <!-- Subheadline: Crisp, zero AI-fluff, under 20 words -->
      <div class="max-w-2xl mb-6 mx-auto" data-aos="fade-up" data-aos-delay="200">
        <p class="text-sm sm:text-base text-text-muted leading-relaxed font-normal">
          Full Stack Developer with 4 years of experience building scalable SaaS platforms, robust React & Node.js architectures, and production AI workflows.
        </p>
      </div>

      <!-- Island CTAs: Nested Trailing Icon Architecture -->
      <div class="flex flex-wrap gap-3.5 items-center justify-center mb-8" data-aos="fade-up" data-aos-delay="300">
        <!-- Primary Action -->
        <a 
          href="#projects" 
          aria-label="View Selected Work projects"
          class="group relative inline-flex items-center gap-3 pl-6 pr-2.5 py-2.5 rounded-xl bg-white text-zinc-950 font-bold text-xs uppercase tracking-widest hover:bg-zinc-200 transition-all duration-300 shadow-[0_0_25px_rgba(255,255,255,0.18)] active:scale-[0.98]"
        >
          <span>Selected Work</span>
          <span class="w-7 h-7 rounded-lg bg-zinc-950 text-white flex items-center justify-center transition-transform duration-300 group-hover:scale-110 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 17L17 7H7M17 7V17"/>
            </svg>
          </span>
        </a>

        <!-- Secondary Action -->
        <a 
          href="#contact" 
          aria-label="Get in Touch with Tanuj Pandey"
          class="inline-flex items-center px-6 py-3 rounded-xl bg-surface-card/90 border border-white/12 hover:border-accent-primary/60 hover:bg-surface-elevated text-text-primary font-bold text-xs uppercase tracking-widest transition-all duration-300 active:scale-[0.98] shadow-sm"
        >
          <span>Get in Touch</span>
        </a>
      </div>

      <!-- Double-Bezel Architectural Proof Matrix -->
      <div class="w-full max-w-4xl p-2 rounded-2xl bg-white/[0.04] border border-white/12 backdrop-blur-md shadow-card" data-aos="fade-up" data-aos-delay="400">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-2.5">
          
          <div class="p-4 md:p-5 rounded-xl bg-surface-card border border-border-subtle text-center hover:border-accent-primary/40 transition-all group">
            <div class="text-2xl md:text-3xl font-extrabold text-text-primary font-mono tracking-tight mb-1 group-hover:text-accent-primary transition-colors">4+ Years</div>
            <div class="text-[10px] font-mono uppercase tracking-wider text-text-muted">Engineering Depth</div>
          </div>

          <div class="p-4 md:p-5 rounded-xl bg-surface-card border border-border-subtle text-center hover:border-accent-primary/40 transition-all group">
            <div class="text-2xl md:text-3xl font-extrabold text-text-primary font-mono tracking-tight mb-1 group-hover:text-accent-primary transition-colors">Full-Stack</div>
            <div class="text-[10px] font-mono uppercase tracking-wider text-text-muted">React · Node · Astro</div>
          </div>

          <div class="p-4 md:p-5 rounded-xl bg-surface-card border border-border-subtle text-center hover:border-accent-primary/40 transition-all group">
            <div class="text-2xl md:text-3xl font-extrabold text-text-primary font-mono tracking-tight mb-1 group-hover:text-accent-primary transition-colors">Production</div>
            <div class="text-[10px] font-mono uppercase tracking-wider text-text-muted">SaaS & AI Platforms</div>
          </div>

          <div class="p-4 md:p-5 rounded-xl bg-surface-card border border-border-subtle text-center hover:border-accent-primary/40 transition-all group">
            <div class="text-2xl md:text-3xl font-extrabold text-text-primary font-mono tracking-tight mb-1 group-hover:text-accent-primary transition-colors">99+</div>
            <div class="text-[10px] font-mono uppercase tracking-wider text-text-muted">Lighthouse Velocity</div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  let heroAnimated = false;
  const animateHero = () => {
    if (heroAnimated) return;
    heroAnimated = true;
    gsap.from('.hero-title', {
      y: 40,
      opacity: 0,
      duration: 1.2,
      ease: "power3.out"
    });
  };

  window.addEventListener('portfolio-loaded', animateHero);
  if (document.readyState === 'complete') {
    setTimeout(animateHero, 50);
  } else {
    window.addEventListener('load', animateHero, { once: true });
  }
</script>
