---
import { useSanityClient, groq } from "astro-sanity";
import { fallbackSanityClient } from "../lib/sanityClient.js";
import AboutLayout from "../components/About/AboutLayout.astro";
import Layout from "../layouts/Layout.astro";

const query = groq`*[_type == "about"]{
  ...,
  heroImage{
    asset->{
      url
    }
  },
}`;

let aboutData = [];
try {
  aboutData = await useSanityClient().fetch(query);
  if (!Array.isArray(aboutData) || aboutData.length === 0) {
    aboutData = await fallbackSanityClient.fetch(query);
  }
} catch (err) {
  aboutData = await fallbackSanityClient.fetch(query);
}

const skillquery = groq`*[_type == "skillsSection"] {
  ...,
  logoCase[]-> {
    Logo {
      ...,
      asset-> {
        ...,
        url,
      },
    }
  }
}`;

let skillData = [];
try {
  skillData = await useSanityClient().fetch(skillquery);
  if (!Array.isArray(skillData) || skillData.length === 0) {
    skillData = await fallbackSanityClient.fetch(skillquery);
  }
} catch (err) {
  skillData = await fallbackSanityClient.fetch(skillquery);
}
---

<div>
  <Layout
    title="About | Tanuj Pandey"
    description="Learn more about Tanuj Pandey's professional journey, technical expertise, and passion for building scalable web applications."
    schemaType="AboutPage"
    breadcrumbs={[{ name: "Home", path: "/" }, { name: "About", path: "/about" }]}
  >
    <AboutLayout aboutData={aboutData} skillData={skillData} />
  </Layout>
</div>
