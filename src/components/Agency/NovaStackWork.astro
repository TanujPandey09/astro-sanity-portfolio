                  </span>
                </div>
              </a>
            </div>

            <!-- Right Editorial Dossier -->
            <div class="p-6 sm:p-7 lg:p-8 border-t lg:border-t-0 lg:border-l border-[var(--border)] flex flex-col justify-between gap-6 bg-[var(--surface)]">
              <div class="space-y-4">
                <div class="flex items-center justify-between gap-3">
                  <div class="flex items-center gap-2.5 min-w-0">
                    <span class="font-mono text-2xl sm:text-[26px] font-semibold leading-none tracking-[-0.03em] text-[var(--blue-600)]">
                      {flagshipCase.num}
                    </span>
                    <span class="h-4 w-px bg-[var(--border)]" aria-hidden="true"></span>
                    <span class="ns-mono-label text-[var(--muted)] font-medium truncate">
                      {flagshipCase.category}
                    </span>
                  </div>
                  <span class="text-xs font-mono text-[var(--muted)] shrink-0">
                    {flagshipCase.role}
                  </span>
                </div>

                <h3 class="text-2xl sm:text-[28px] lg:text-[32px] font-semibold tracking-[-0.025em] leading-[1.15] text-[var(--ink)]">
                  <a
                    href={flagshipCase.caseStudyUrl}
                    class="hover:text-[var(--blue-600)] transition-colors"
                  >
                    {flagshipCase.name}
                  </a>
                </h3>

                <p class="text-[15px] sm:text-base leading-[1.68] text-[var(--muted)]">
                  {flagshipCase.summary}
                </p>

                {flagshipCase.stack.length > 0 && (
                  <div class="pt-1 flex flex-wrap gap-1.5">
                    {flagshipCase.stack.slice(0, 4).map((tech) => (
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[var(--bg)] border border-[var(--border)] text-xs font-mono text-[var(--muted)]">
                        <span
                          class="w-1.5 h-1.5 rounded-full shrink-0"
                          style={`background-color: ${flagshipCase.accentHex};`}
                          aria-hidden="true"
                        ></span>
                        <span>{tech}</span>
                      </span>
                    ))}
                  </div>
                )}
              </div>

              <div class="pt-5 border-t border-[var(--border)] flex flex-wrap items-center justify-between gap-3">
                <a
                  href={flagshipCase.caseStudyUrl}
                  class="ns-btn-primary !h-10 !px-4 !text-sm !rounded-[10px]"
                >
                  <span>Read Case Study</span>
                  <span aria-hidden="true">→</span>
                </a>

                <div class="flex items-center gap-4">
                  {flagshipCase.demoMedia && (
                    <button
                      type="button"
                      data-open-showreel
                      data-showreel-kind={flagshipCase.demoMedia.kind}
                      data-showreel-src={flagshipCase.demoMedia.src}
                      data-showreel-title={flagshipCase.name}
                      class="text-xs font-mono font-medium text-[var(--blue-600)] hover:text-[var(--blue-700)] transition-colors cursor-pointer"
                    >
                      Watch Demo
                    </button>
                  )}
                  {flagshipCase.demoUrl && (
                    <a
                      href={flagshipCase.demoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-xs font-mono font-medium text-[var(--muted)] hover:text-[var(--blue-600)] transition-colors"
                    >
                      Live Site ↗
                    </a>
                  )}
                </div>
              </div>
            </div>
          </div>
        </article>
      )}

      <!-- TIER 2: INTERACTIVE INDEX LEDGER + STICKY BROWSER PREVIEW STAGE -->
      {ledgerCases.length > 0 && (
        <div
          id="ns-case-ledger-stage"
          class="mt-8 lg:mt-10 grid grid-cols-1 lg:grid-cols-[minmax(0,1.06fr)_minmax(0,0.94fr)] gap-7 lg:gap-9 items-start"
        >
          <!-- Left: Architectural Interactive Case Study Ledger -->
          <div class="border-t border-[var(--border)]">
            {ledgerCases.map((item, idx) => (
              <article
                class="ns-case-card ns-ledger-row group relative border-b border-[var(--border)] transition-colors duration-200"
                data-ledger-index={idx}
                data-active={idx === 0 ? "true" : "false"}
                data-case-name={item.name}
                data-case-num={item.num}
                data-case-role={item.role}
                data-case-host={item.displayHost}
                data-case-url={item.caseStudyUrl}
                data-case-live={item.demoUrl || ""}
                data-case-accent={item.accentHex}
                data-case-demo-kind={item.demoMedia?.kind || ""}
                data-case-demo-src={item.demoMedia?.src || ""}
              >
                <!-- Left Active Accent Indicator (Desktop) -->
                <span
                  class="ns-ledger-bar hidden lg:block absolute left-0 top-0 bottom-0 w-[3px] transition-opacity duration-200"
                  style={`background-color: ${item.accentHex};`}
                  aria-hidden="true"
                ></span>

                <div class="py-5 sm:py-6 lg:px-5 flex flex-col gap-3.5">
                  <!-- Top Metadata Line -->
                  <div class="flex items-center justify-between gap-3">
                    <div class="flex items-center gap-2.5 min-w-0">
                      <span class="ns-ledger-num font-mono text-xs font-semibold tracking-[0.06em] text-[var(--muted)] transition-colors">
                        {item.num}
                      </span>
                      <span
                        class="w-1.5 h-1.5 rounded-full shrink-0"
                        style={`background-color: ${item.accentHex};`}
                        aria-hidden="true"
                      ></span>
                      <span class="text-[11px] font-mono uppercase tracking-[0.12em] text-[var(--muted)] truncate">
                        {item.category}
                      </span>
                    </div>
                    <span class="text-xs font-mono text-[var(--muted)] shrink-0">
                      {item.role}
                    </span>
                  </div>

                  <!-- Title + Summary -->
                  <div class="space-y-1.5">
                    <h3 class="text-xl sm:text-[22px] font-semibold tracking-[-0.02em] leading-[1.22] text-[var(--ink)]">
                      <a
                        href={item.caseStudyUrl}
                        class="ns-ledger-title inline-flex items-center gap-2 hover:text-[var(--blue-600)] transition-colors"
                      >
                        <span>{item.name}</span>
                        <span class="text-sm font-normal text-[var(--blue-600)] opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200 hidden lg:inline" aria-hidden="true">
                          →
                        </span>
                      </a>
                    </h3>
                    <p class="text-[15px] leading-[1.6] text-[var(--muted)] line-clamp-2">
                      {item.summary}
                    </p>
                  </div>

                  <!-- Mobile & Tablet Inline Browser Preview (< lg) -->
                  <a
                    href={item.caseStudyUrl}
                    class="lg:hidden block rounded-[12px] bg-[var(--bg)] border border-[var(--border)] overflow-hidden mt-1"
                  >
                    <div class="px-3 py-2 border-b border-[var(--border)] bg-[var(--surface)] flex items-center justify-between gap-2">
                      <div class="flex items-center gap-1" aria-hidden="true">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#CBD5E1]"></span>
                        <span class="w-1.5 h-1.5 rounded-full bg-[#CBD5E1]"></span>
                        <span class="w-1.5 h-1.5 rounded-full bg-[#CBD5E1]"></span>
                      </div>
                      <span class="text-[11px] font-mono text-[var(--muted)] truncate">
                        {item.displayHost}
                      </span>
                      <span class="text-[11px] font-mono text-[var(--blue-600)] shrink-0">
                        {item.num}
                      </span>
                    </div>
                    <div class="aspect-[16/10] w-full overflow-hidden bg-[var(--bg)]">
                      <img
                        src={item.posterUrl}
                        alt={item.name}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover object-top"
                      />
                    </div>
                  </a>

                  <!-- Bottom Stack Pills + Actions -->
                  <div class="pt-1 flex flex-wrap items-center justify-between gap-3">
                    <div class="flex flex-wrap gap-1.5">
                      {item.stack.slice(0, 3).map((tech) => (
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-[var(--bg)] border border-[var(--border)] text-[11px] font-mono text-[var(--muted)]">
                          {tech}
                        </span>
                      ))}
                    </div>

                    <div class="flex items-center gap-4 shrink-0">
                      {item.demoMedia && (
                        <button
                          type="button"
                          data-open-showreel
                          data-showreel-kind={item.demoMedia.kind}
                          data-showreel-src={item.demoMedia.src}
                          data-showreel-title={item.name}
                          class="text-xs font-mono font-medium text-[var(--blue-600)] hover:text-[var(--blue-700)] transition-colors cursor-pointer"
                        >
                          Demo
                        </button>
                      )}
                      {item.demoUrl && (
                        <a
                          href={item.demoUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-xs font-mono font-medium text-[var(--muted)] hover:text-[var(--blue-600)] transition-colors"
                        >
                          Live ↗
                        </a>
                      )}
                      <a
                        href={item.caseStudyUrl}
                        class="ns-link-arrow inline-flex items-center gap-1 text-sm font-medium text-[var(--blue-600)]"
                      >
                        <span>Details</span>
                        <span class="ns-arrow" aria-hidden="true">→</span>
                      </a>
                    </div>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <!-- Right: Sticky Browser Preview Stage (Desktop lg+) -->
          <div class="hidden lg:block lg:sticky lg:top-24">
            <div class="rounded-[16px] bg-[var(--bg)] border border-[var(--border)] p-3">
              <div class="rounded-[12px] bg-[var(--surface)] border border-[var(--border)] overflow-hidden">
                <!-- Dynamic Browser Top Bar -->
                <div class="px-4 py-2.5 border-b border-[var(--border)] bg-[var(--surface)] flex items-center justify-between gap-3">
                  <div class="flex items-center gap-1.5 shrink-0" aria-hidden="true">
                    <span class="w-2 h-2 rounded-full bg-[#CBD5E1]"></span>
                    <span class="w-2 h-2 rounded-full bg-[#CBD5E1]"></span>
                    <span class="w-2 h-2 rounded-full bg-[#CBD5E1]"></span>
                  </div>
                  <span
                    id="ns-preview-host"
                    class="text-[11px] font-mono text-[var(--muted)] truncate"
                  >
                    {ledgerCases[0].displayHost}
                  </span>
                  <span class="inline-flex items-center gap-1.5 text-[11px] font-mono font-medium text-[var(--ink)] shrink-0">
                    <span
                      id="ns-preview-dot"
                      class="w-1.5 h-1.5 rounded-full"
                      style={`background-color: ${ledgerCases[0].accentHex};`}
                      aria-hidden="true"
                    ></span>
                    <span id="ns-preview-num">{ledgerCases[0].num}</span>
                    <span class="text-[var(--muted)]">/ {String(caseStudies.length).padStart(2, "0")}</span>
                  </span>
                </div>

                <!-- Cross-Fading Stacked 16:10 Preview Canvas -->
                <a
                  id="ns-preview-image-link"
                  href={ledgerCases[0].caseStudyUrl}
                  class="block relative aspect-[16/10] w-full overflow-hidden bg-[var(--bg)] group/stage"
                >
                  {ledgerCases.map((item, idx) => (
                    <img
                      src={item.posterUrl}
                      alt={item.name}
                      loading="lazy"
                      decoding="async"
                      data-preview-img={idx}
                      class={`absolute inset-0 w-full h-full object-cover object-top transition-all duration-300 ease-out ${
                        idx === 0 ? "opacity-100 scale-100" : "opacity-0 scale-[1.015] pointer-events-none"
                      }`}
                    />
                  ))}
                  <span
                    class="pointer-events-none absolute bottom-3.5 right-3.5 w-9 h-9 rounded-full bg-[var(--surface)] border border-[var(--border)] text-[var(--ink)] group-hover/stage:bg-[var(--blue-600)] group-hover/stage:border-[var(--blue-600)] group-hover/stage:text-white flex items-center justify-center text-sm font-medium opacity-0 translate-y-1.5 group-hover/stage:opacity-100 group-hover/stage:translate-y-0 transition-all duration-200 ease-out"
                    aria-hidden="true"
                  >
                    ↗
                  </span>
                </a>

                <!-- Dynamic Stage Caption & Actions -->
                <div class="px-5 py-4 border-t border-[var(--border)] bg-[var(--surface)] flex items-center justify-between gap-4">
                  <div class="min-w-0">
                    <p
                      id="ns-preview-title"
                      class="text-base font-semibold tracking-[-0.015em] text-[var(--ink)] truncate"
                    >
                      {ledgerCases[0].name}
                    </p>
                    <p
                      id="ns-preview-role"
                      class="text-xs font-mono text-[var(--muted)] truncate mt-0.5"
                    >
                      {ledgerCases[0].role}
                    </p>
                  </div>

                  <div class="flex items-center gap-3 shrink-0">
                    <button
                      type="button"
                      id="ns-preview-demo-btn"
                      data-open-showreel
                      data-showreel-kind={ledgerCases[0].demoMedia?.kind || ""}
                      data-showreel-src={ledgerCases[0].demoMedia?.src || ""}
                      data-showreel-title={ledgerCases[0].name}
                      class={`text-xs font-mono font-medium text-[var(--blue-600)] hover:text-[var(--blue-700)] transition-colors cursor-pointer ${
                        ledgerCases[0].demoMedia ? "" : "hidden"
                      }`}
                    >
                      Demo
                    </button>
                    <a
                      id="ns-preview-cta"
                      href={ledgerCases[0].caseStudyUrl}
                      class="ns-link-arrow inline-flex items-center gap-1.5 px-3.5 py-2 rounded-[10px] bg-[var(--ink)] hover:bg-[var(--blue-600)] text-white text-xs font-medium transition-colors"
                    >
                      <span>Case Study</span>
                      <span class="ns-arrow" aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  </section>
)}

<!-- Fullscreen Showreel Lightbox Modal -->
<div
  id="agency-showreel-modal"
  class="fixed inset-0 z-[90] hidden items-center justify-center bg-[#0B111A]/85 p-4 sm:p-8"
  role="dialog"
  aria-modal="true"
  aria-labelledby="showreel-modal-title"
>
  <div class="relative w-full max-w-5xl rounded-[16px] bg-[var(--surface)] border border-[var(--border)] overflow-hidden">
    <div class="px-5 py-3.5 border-b border-[var(--border)] flex items-center justify-between gap-4 bg-[var(--bg)]">
      <div class="flex items-center gap-2.5 min-w-0">
        <span class="w-2 h-2 rounded-full bg-[var(--blue-600)] shrink-0"></span>
        <span id="showreel-modal-title" class="font-semibold text-base text-[var(--ink)] truncate">
          Product Walkthrough
        </span>
      </div>
      <button
        type="button"
        id="close-showreel-modal"
        aria-label="Close showreel player"
        class="px-3.5 py-1.5 rounded-[10px] bg-[var(--surface)] border border-[var(--border)] hover:border-[var(--blue-600)] text-xs font-mono font-medium text-[var(--ink)] cursor-pointer transition-colors"
      >
        Close ✕
      </button>
    </div>
    <div id="showreel-modal-body" class="relative w-full aspect-video bg-[var(--ink)] flex items-center justify-center"></div>
  </div>
</div>

<style>
  .perspective-container {
    perspective: 1200px;
    transform-style: preserve-3d;
    perspective-origin: center center;
  }

  .screens-3d-stage {
    transform-style: preserve-3d;
    perspective: 1200px;
  }

  .carousel-track-wrapper {
    transform-style: preserve-3d;
  }

  .carousel-track-row1,
  .carousel-track-row2 {
    display: flex;
    width: max-content;
    transform-style: preserve-3d;
  }

  .carousel-card {
    will-change: transform, opacity;
    transform-origin: center bottom;
    transform-style: preserve-3d;
    backface-visibility: hidden;
  }

  @keyframes carouselScrollRow1 {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }

  @keyframes carouselScrollRow2 {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0%); }
  }

  .carousel-track-row1 {
    animation: carouselScrollRow1 45s linear infinite;
  }

  .carousel-track-row2 {
    animation: carouselScrollRow2 45s linear infinite;
  }

  .carousel-track-row1:hover,
  .carousel-track-row2:hover {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track-row1,
    .carousel-track-row2 {
      animation: none;
    }
  }

  /* Interactive Case Study Ledger Row — architectural hairline style (overrides generic card box) */
  .ns-ledger-row {
    border: 0 !important;
    border-bottom: 1px solid var(--border) !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    background-color: transparent !important;
    transform: none !important;
    transition: background-color 200ms ease !important;
  }

  .ns-ledger-row .ns-ledger-bar {
    opacity: 0;
  }

  @media (min-width: 1024px) {
    .ns-ledger-row[data-active="true"] {
      background-color: #F8FAFF !important;
    }

    .ns-ledger-row[data-active="true"] .ns-ledger-bar {
      opacity: 1;
    }

    .ns-ledger-row[data-active="true"] .ns-ledger-num {
      color: var(--blue-600);
    }

    .ns-ledger-row[data-active="true"] .ns-ledger-title {
      color: var(--blue-600);
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let activeMatchMedia: gsap.MatchMedia | null = null;

  const setupTiltedProjectScroll = () => {
    const stage = document.getElementById("tilted-screens-stage");
    const wrapper = document.getElementById("screens-perspective-wrapper") || stage;
    const cards = gsap.utils.toArray<HTMLElement>(".carousel-card");

    if (!stage || !wrapper) return;

    if (activeMatchMedia) {
      activeMatchMedia.revert();
      activeMatchMedia = null;
    }

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      stage.style.transform = "none";
      if (cards.length) {
        gsap.set(cards, { opacity: 1, scale: 1, clearProps: "all" });
      }
      return;
    }

    activeMatchMedia = gsap.matchMedia();

    activeMatchMedia.add("(min-width: 641px)", () => {
      gsap.set(stage, {
        transformPerspective: 1200,
        transformOrigin: "50% 50%",
      });

      gsap.fromTo(
        stage,
        {
          rotation: 12,
          rotationX: 12,
          rotationY: -12,
          scale: 0.95,
          transformPerspective: 1200,
        },
        {
          rotation: 0,
          rotationX: 0,
          rotationY: 0,
          scale: 1,
          transformPerspective: 1200,
          ease: "none",
          scrollTrigger: {
            id: "agency-tilt-stage-desktop",
            trigger: wrapper,
            start: "top 90%",
            end: "center 45%",
            scrub: 1,
            invalidateOnRefresh: true,
          },
        }
      );

      if (cards.length) {
        gsap.fromTo(
          cards,
          { opacity: 0.85, scale: 0.96 },
          {
            opacity: 1,
            scale: 1,
            ease: "power2.out",
            stagger: 0.03,
            scrollTrigger: {
              id: "agency-tilt-cards-desktop",
              trigger: wrapper,
              start: "top 90%",
              end: "center 45%",
              scrub: 1,
            },
          }
        );
      }
    });

    activeMatchMedia.add("(max-width: 640px)", () => {
      gsap.set(stage, {
        transformPerspective: 1200,
        transformOrigin: "50% 50%",
      });

      gsap.fromTo(
        stage,
        {
          rotation: 8,
          rotationX: 8,
          rotationY: -8,
          scale: 0.92,
          transformPerspective: 1200,
        },
        {
          rotation: 0,
          rotationX: 0,
          rotationY: 0,
          scale: 1,
          transformPerspective: 1200,
          ease: "none",
          scrollTrigger: {
            id: "agency-tilt-stage-mobile",
            trigger: wrapper,
            start: "top 90%",
            end: "center 45%",
            scrub: 1,
            invalidateOnRefresh: true,
          },
        }
      );
    });
  };

  const setupAgencyShowreel = () => {
    const modal = document.getElementById("agency-showreel-modal");
    const body = document.getElementById("showreel-modal-body");
    const titleEl = document.getElementById("showreel-modal-title");
    const closeBtn = document.getElementById("close-showreel-modal");
    const triggers = document.querySelectorAll<HTMLButtonElement>("[data-open-showreel]");

    if (!modal || !body || !titleEl || !closeBtn) return;

    const closeModal = () => {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      body.innerHTML = "";
      document.body.style.overflow = "";
    };

    if (!closeBtn.hasAttribute("data-bound")) {
      closeBtn.setAttribute("data-bound", "true");
      closeBtn.addEventListener("click", closeModal);
      modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !modal.classList.contains("hidden")) {
          closeModal();
        }
      });
    }

    triggers.forEach((btn) => {
      if (btn.hasAttribute("data-bound")) return;
      btn.setAttribute("data-bound", "true");
      btn.addEventListener("click", () => {
        const kind = btn.getAttribute("data-showreel-kind");
        const src = btn.getAttribute("data-showreel-src");
        const title = btn.getAttribute("data-showreel-title") || "Product Walkthrough";

        if (!src) return;

        titleEl.textContent = title;
        body.innerHTML = "";

        if (kind === "iframe") {
          const iframe = document.createElement("iframe");
          iframe.src = src;
          iframe.className = "w-full h-full border-0";
          iframe.allow = "autoplay; fullscreen; picture-in-picture";
          iframe.setAttribute("allowfullscreen", "true");
          body.appendChild(iframe);
        } else {
          const video = document.createElement("video");
          video.src = src;
          video.controls = true;
          video.autoplay = true;
          video.className = "w-full h-full object-contain";
          body.appendChild(video);
        }

        modal.classList.remove("hidden");
        modal.classList.add("flex");
        document.body.style.overflow = "hidden";
      });
    });
  };

  const setupCaseStudyLedger = () => {
    const stage = document.getElementById("ns-case-ledger-stage");
    if (!stage) return;

    const rows = Array.from(stage.querySelectorAll<HTMLElement>(".ns-ledger-row"));
    const imgs = Array.from(stage.querySelectorAll<HTMLImageElement>("[data-preview-img]"));
    const hostEl = document.getElementById("ns-preview-host");
    const dotEl = document.getElementById("ns-preview-dot");
    const numEl = document.getElementById("ns-preview-num");
    const titleEl = document.getElementById("ns-preview-title");
    const roleEl = document.getElementById("ns-preview-role");
    const imgLinkEl = document.getElementById("ns-preview-image-link") as HTMLAnchorElement | null;
    const ctaEl = document.getElementById("ns-preview-cta") as HTMLAnchorElement | null;
    const demoBtn = document.getElementById("ns-preview-demo-btn") as HTMLButtonElement | null;

    if (!rows.length) return;

    const activateIndex = (targetIdx: number) => {
      const activeRow = rows[targetIdx];
      if (!activeRow) return;

      rows.forEach((row, i) => {
        row.setAttribute("data-active", i === targetIdx ? "true" : "false");
      });

      imgs.forEach((img, i) => {
        if (i === targetIdx) {
          img.classList.remove("opacity-0", "scale-[1.015]", "pointer-events-none");
          img.classList.add("opacity-100", "scale-100");
        } else {
          img.classList.add("opacity-0", "scale-[1.015]", "pointer-events-none");
          img.classList.remove("opacity-100", "scale-100");
        }
      });

      const name = activeRow.getAttribute("data-case-name") || "";
      const num = activeRow.getAttribute("data-case-num") || "";
      const role = activeRow.getAttribute("data-case-role") || "";
      const host = activeRow.getAttribute("data-case-host") || "";
      const url = activeRow.getAttribute("data-case-url") || "/projects";
      const accent = activeRow.getAttribute("data-case-accent") || "#2563EB";
      const demoKind = activeRow.getAttribute("data-case-demo-kind") || "";
      const demoSrc = activeRow.getAttribute("data-case-demo-src") || "";

      if (hostEl) hostEl.textContent = host;
      if (numEl) numEl.textContent = num;
      if (dotEl) dotEl.style.backgroundColor = accent;
      if (titleEl) titleEl.textContent = name;
      if (roleEl) roleEl.textContent = role;
      if (imgLinkEl) imgLinkEl.href = url;
      if (ctaEl) ctaEl.href = url;

      if (demoBtn) {
        if (demoSrc) {
          demoBtn.classList.remove("hidden");
          demoBtn.setAttribute("data-showreel-kind", demoKind);
          demoBtn.setAttribute("data-showreel-src", demoSrc);
          demoBtn.setAttribute("data-showreel-title", name);
        } else {
          demoBtn.classList.add("hidden");
          demoBtn.setAttribute("data-showreel-src", "");
        }
      }
    };

    rows.forEach((row, idx) => {
      if (row.hasAttribute("data-ledger-bound")) return;
      row.setAttribute("data-ledger-bound", "true");
      row.addEventListener("mouseenter", () => activateIndex(idx));
      row.addEventListener("focusin", () => activateIndex(idx));
    });
  };

  setupTiltedProjectScroll();
  setupAgencyShowreel();
  setupCaseStudyLedger();

  document.addEventListener("astro:page-load", () => {
    setupTiltedProjectScroll();
    setupAgencyShowreel();
    setupCaseStudyLedger();
  });

  document.addEventListener("astro:after-swap", () => {
    setupTiltedProjectScroll();
    setupAgencyShowreel();
    setupCaseStudyLedger();
  });

  document.addEventListener("astro:before-swap", () => {
    if (activeMatchMedia) {
      activeMatchMedia.revert();
      activeMatchMedia = null;
    }
  });

  window.addEventListener("load", () => {
    ScrollTrigger.refresh();
  });
</script>
