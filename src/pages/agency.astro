---
export const prerender = false;

import { useSanityClient, groq } from "astro-sanity";
import { fallbackSanityClient } from "../lib/sanityClient.js";
import { optimizeSanityImage } from "../lib/optimizeImage";
import Layout from "../layouts/Layout.astro";
import NovaStackHeader from "../components/Agency/NovaStackHeader.astro";
import NovaStackHero from "../components/Agency/NovaStackHero.astro";
import NovaStackServices from "../components/Agency/NovaStackServices.astro";
import NovaStackWork from "../components/Agency/NovaStackWork.astro";
import NovaStackProcess from "../components/Agency/NovaStackProcess.astro";
import NovaStackModels from "../components/Agency/NovaStackModels.astro";
import NovaStackFounder from "../components/Agency/NovaStackFounder.astro";
import NovaStackFAQ from "../components/Agency/NovaStackFAQ.astro";
import NovaStackContact from "../components/Agency/NovaStackContact.astro";
import NovaStackFooter from "../components/Agency/NovaStackFooter.astro";

const agencyQuery = groq`*[_type == "agencySettings"] | order(_updatedAt desc)[0]{
  brandName,
  tagline,
  logoFullWidth,
  logo{
    alt,
    asset->{url}
  },
  featuredCaseStudies[]->{
    _id,
    _type,
    projectName,
    "slug": slug.current,
    excerpt,
    category,
    tags,
    role,
    demoLink,
    gumroadLink,
    headlineMetrics,
    agencyHeroTag,
    BackgroundImage{ asset->{ url } },
    FeatureImage{ asset->{ url } },
    demoVideo{ asset->{ url } },
    demoVideoUrl
  },
  agencyServices[]{
    _key,
    serviceKey,
    title,
    category,
    description,
    mockupCaption,
    mockupBadge,
    mockupImage{
      alt,
      asset->{url}
    }
  },
  heroFanProjects[]{
    _key,
    customTitle,
    customTag,
    customUrl,
    customImage{
      asset->{url}
    },
    projectRef->{
      _id,
      _type,
      projectName,
      templateName,
      "slug": slug.current,
      category,
      tags,
      role,
      demoLink,
      BackgroundImage{ asset->{url} },
      FeatureImage{ asset->{url} },
      thumbnailImage{ asset->{url} },
      gallery[]{ asset->{url} },
      demoVideo{ asset->{url} },
      demoVideoUrl
    }
  }
}`;

const agencyProjectsQuery = groq`*[_type in ["projects", "templates"]] | order(_createdAt desc){
  _id,
  _type,
  projectName,
  templateName,
  "slug": slug.current,
  tagline,
  excerpt,
  category,
  tags,
  role,
  badge,
  demoLink,
  gumroadLink,
  headlineMetrics,
  showInAgencyHero,
  agencyHeroTag,
  BackgroundImage{ asset->{ url } },
  FeatureImage{ asset->{ url } },
  thumbnailImage{ asset->{ url } },
  gallery[]{ asset->{ url } },
  demoVideo{ asset->{ url } },
  demoVideoUrl
}`;

const aboutQuery = groq`*[_type == "about"] | order(_updatedAt desc)[0]{
  heroImage{
    asset->{ url }
  }
}`;

let agencySettings: any = null;
let agencyProjects: any[] = [];
let aboutData: any = null;

try {
  const [settingsRes, projectsRes, aboutRes] = await Promise.all([
    useSanityClient().fetch(agencyQuery),
    useSanityClient().fetch(agencyProjectsQuery),
    useSanityClient().fetch(aboutQuery),
  ]);
  agencySettings = settingsRes;
  agencyProjects = Array.isArray(projectsRes) ? projectsRes : [];
  aboutData = aboutRes;
  if (!agencySettings) {
    agencySettings = await fallbackSanityClient.fetch(agencyQuery);
  }
  if (!agencyProjects.length) {
    agencyProjects = (await fallbackSanityClient.fetch(agencyProjectsQuery)) || [];
  }
  if (!aboutData) {
    aboutData = await fallbackSanityClient.fetch(aboutQuery);
  }
} catch {
  try {
    const [settingsRes, projectsRes, aboutRes] = await Promise.all([
      fallbackSanityClient.fetch(agencyQuery),
      fallbackSanityClient.fetch(agencyProjectsQuery),
      fallbackSanityClient.fetch(aboutQuery),
    ]);
    agencySettings = settingsRes;
    agencyProjects = Array.isArray(projectsRes) ? projectsRes : [];
    aboutData = aboutRes;
  } catch {}
}

const rawLogoUrl = agencySettings?.logo?.asset?.url;
const agencyLogoUrl = rawLogoUrl ? optimizeSanityImage(rawLogoUrl, 360, 90) : "";
const agencyLogoAlt = agencySettings?.logo?.alt || "NovaStack Logo";
const agencyBrandName = agencySettings?.brandName || "NovaStack Studio";
const agencyTagline = agencySettings?.tagline || "Founder-Led Studio";
const agencyLogoFullWidth = Boolean(agencySettings?.logoFullWidth);

const rawFounderImg = aboutData?.heroImage?.asset?.url;
const founderPortraitUrl = rawFounderImg ? optimizeSanityImage(rawFounderImg, 400, 85) : "";

const sanityServices = Array.isArray(agencySettings?.agencyServices)
  ? agencySettings.agencyServices
  : [];
const sanityFeaturedCaseStudies = Array.isArray(agencySettings?.featuredCaseStudies)
  ? agencySettings.featuredCaseStudies.filter(Boolean)
  : [];
const sanityCuratedShowcase = Array.isArray(agencySettings?.heroFanProjects)
  ? agencySettings.heroFanProjects.filter(Boolean)
  : [];

const siteUrl = "https://tanujbuilds.site";
const canonicalURL = `${siteUrl}/agency`;

const pageTitle = "NovaStack Studio — From Complex Ideas to Powerful Digital Products | Websites, SaaS & AI Development";
const pageDescription = "NovaStack Studio is an independent, founder-led software development studio operated by Tanuj Pandey. We design and build modern websites, scalable SaaS platforms, AI-powered applications, and custom HTML email templates.";

const agencyJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "ProfessionalService"],
      "@id": `${canonicalURL}#organization`,
      "name": agencyBrandName,
      "alternateName": ["NovaStack Studio", "NovaStack Digital Development Studio"],
      "url": canonicalURL,
      "logo": agencyLogoUrl || `${siteUrl}/favicon.svg`,
      "image": `${siteUrl}/og-image-dark.png`,
      "description": pageDescription,
      "slogan": "From Complex Ideas to Powerful Digital Products.",
      "email": "tanujp09@gmail.com",
      "telephone": "+919557321978",
      "founder": {
        "@type": "Person",
        "@id": `${siteUrl}/#person`,
        "name": "Tanuj Pandey",
        "jobTitle": "Founder & Full-Stack Developer",
        "url": siteUrl,
      },
      "knowsAbout": [
        "Web Design & Development",
        "SaaS & Full-Stack Development",
        "AI Integrations & Automation",
        "Custom HTML Email Templates",
        "React.js and Next.js Development",
        "Node.js & PostgreSQL APIs"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "NovaStack Studio Services",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Web Design & Development" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "SaaS & Full-Stack Development" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "AI Integrations & Automation" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Custom HTML Email Templates" } }
        ]
      }
    }
  ]
};

const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Agency", path: "/agency" },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  schemaType="WebPage"
  breadcrumbs={breadcrumbs}
  jsonLd={agencyJsonLd}
  hideDefaultHeader={true}
  hideDefaultFooter={true}
  isAgency={true}
>
  <!-- Dedicated Agency Container: Obsidian Monochrome (#09090B / #FFFFFF / #F4F4F5) + Linear Indigo (#5E6AD2) -->
  <div class="agency-page w-full min-h-screen bg-white text-[#09090B] font-sans selection:bg-[#5E6AD2]/15 selection:text-[#09090B]">
    <!-- Top Scroll Progress Bar -->
    <div id="agency-scroll-progress" class="fixed top-0 left-0 h-[2px] w-0 bg-[#5E6AD2] z-[60] pointer-events-none transition-[width] duration-75"></div>

    <!-- Section 1: Navigation Header -->
    <NovaStackHeader
      logoUrl={agencyLogoUrl}
      logoAlt={agencyLogoAlt}
      brandName={agencyBrandName}
      tagline={agencyTagline}
      logoFullWidth={agencyLogoFullWidth}
    />

    <!-- Main Content Flow (Focused Non-Repetitive Agency Structure) -->
    <main id="agency-main-content">
      <!-- Section 1: Hero Section (Clean High-End Positioning + Architecture Showcase + Marquee) -->
      <NovaStackHero />

      <!-- Section 2: Core Services (Sanity-Configurable Services & Custom Mockups + Interactive Fallbacks) -->
      <NovaStackServices sanityServices={sanityServices} />

      <!-- Section 3: Selected Work & Case Studies (100% Sanity-Driven) -->
      <NovaStackWork
        sanityProjects={agencyProjects}
        featuredCaseStudies={sanityFeaturedCaseStudies}
        curatedShowcase={sanityCuratedShowcase}
      />

      <!-- Section 4: Process (5-Step Milestone-Gated Delivery Flow) -->
      <NovaStackProcess />

      <!-- Section 5: Founder Spotlight (Tanuj Pandey — Direct Founder Collaboration) -->
      <NovaStackFounder portraitUrl={founderPortraitUrl} />

      <!-- Section 6: Engagement Models (Fixed-Scope, Freelance Support, Ongoing Collaboration) -->
      <NovaStackModels />

      <!-- Section 7: FAQ (Client Objections Resolved in Compact Accordion) -->
      <NovaStackFAQ />

      <!-- Section 8: Contact / Project Discussion (High-Converting Inquiry Form) -->
      <NovaStackContact />
    </main>

    <!-- Footer: Minimalist Footer -->
    <NovaStackFooter
      logoUrl={agencyLogoUrl}
      logoAlt={agencyLogoAlt}
      brandName={agencyBrandName}
      logoFullWidth={agencyLogoFullWidth}
    />
  </div>
</Layout>

<style is:global>
  /* Ensure smooth scrolling across anchor navigation under sticky navbar */
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 84px;
  }

  /* Accessible focus indicators in Linear Indigo */
  .agency-page *:focus-visible {
    outline: 2px solid #5E6AD2 !important;
    outline-offset: 2px !important;
  }

  /* Tactile Elevation on Cards */
  .agency-page #agency-main-content .agency-card,
  .agency-page #agency-main-content .codify-card {
    position: relative;
    overflow: hidden;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease;
    will-change: transform;
  }

  .agency-page #agency-main-content .agency-card:hover,
  .agency-page #agency-main-content .codify-card:hover {
    transform: translateY(-3px);
  }

  /* Subtle Mouse-Follow Spotlight Glow */
  .agency-page #agency-main-content .agency-card::after,
  .agency-page #agency-main-content .codify-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      360px circle at var(--agency-spot-x, 50%) var(--agency-spot-y, 50%),
      rgba(94, 106, 210, 0.055),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .agency-page #agency-main-content .agency-card:hover::after,
  .agency-page #agency-main-content .codify-card:hover::after {
    opacity: 1;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initAgencyProductionMotion() {
    const root = document.getElementById('agency-main-content');
    if (!root) return;

    const w = window as any;

    // 1. Top Progress Hairline
    const progressEl = document.getElementById('agency-scroll-progress');
    if (w.__agencyScrollProgressHandler) {
      window.removeEventListener('scroll', w.__agencyScrollProgressHandler);
    }
    w.__agencyScrollProgressHandler = () => {
      if (!progressEl) return;
      const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      const pct = Math.min(100, Math.max(0, (window.scrollY / maxScroll) * 100));
      progressEl.style.width = `${pct.toFixed(1)}%`;
    };
    window.addEventListener('scroll', w.__agencyScrollProgressHandler, { passive: true });
    w.__agencyScrollProgressHandler();

    // 2. Global Agency Spotlight Cursor Tracking on all Section Cards
    root.querySelectorAll<HTMLElement>('.agency-card, .codify-card').forEach((card) => {
      if (card.dataset.agencySpotBound === 'true') return;
      card.dataset.agencySpotBound = 'true';
      card.addEventListener('pointermove', (e: PointerEvent) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--agency-spot-x', `${e.clientX - rect.left}px`);
        card.style.setProperty('--agency-spot-y', `${e.clientY - rect.top}px`);
      });
    });

    // 3. Kill prior agency heading/stagger ScrollTriggers cleanly (preserve work section 3D tilt)
    ScrollTrigger.getAll().forEach((trigger) => {
      const id = String(trigger.vars?.id || '');
      if (id.startsWith('agency-heading-') || id.startsWith('agency-stagger-')) {
        trigger.kill();
      }
    });

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;

    // 4. Section Heading Reveals (Codify Spring Motion)
    const sectionHeaders = Array.from(root.querySelectorAll('section [class*="max-w-"]')) as HTMLElement[];
    sectionHeaders.forEach((header, idx) => {
      const heading = header.querySelector('h2');
      if (!heading) return;

      gsap.fromTo(
        heading,
        { y: 32, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.75,
          ease: 'power3.out',
          clearProps: 'transform,opacity',
          scrollTrigger: {
            id: `agency-heading-${idx}`,
            trigger: heading,
            start: 'top 90%',
            once: true,
          },
        }
      );
    });

    // 5. Staggered Card Reveals per Section (Matched to Live DOM Selectors)
    const sectionContainers = [
      '#case-studies article',
      '#process .process-step-card',
      '#about .agency-card',
      '#models .agency-card',
      '#faq .agency-card',
      '#contact .agency-card',
    ];

    sectionContainers.forEach((selector, idx) => {
      const elements = Array.from(root.querySelectorAll(selector)) as HTMLElement[];
      if (!elements.length) return;

      elements.forEach((el, cardIdx) => {
        gsap.fromTo(
          el,
          { y: 36, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 0.8,
            delay: cardIdx * 0.08,
            ease: 'power3.out',
            clearProps: 'transform,opacity',
            scrollTrigger: {
              id: `agency-stagger-${idx}-${cardIdx}`,
              trigger: el,
              start: 'top 92%',
              once: true,
            },
          }
        );
      });
    });

    ScrollTrigger.refresh();
  }

  initAgencyProductionMotion();
  document.addEventListener('astro:page-load', initAgencyProductionMotion);
  document.addEventListener('astro:after-swap', initAgencyProductionMotion);
</script>
