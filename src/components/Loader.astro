---
// Bulletproof, Ultra-Reliable Magnificent Portfolio Intro Loader
---

<div id="tp-preloader" class="fixed inset-0 z-[99999] bg-canvas flex flex-col items-center justify-center overflow-hidden select-none">
  <!-- Subtle Ambient Core Glow -->
  <div class="absolute w-[500px] h-[500px] rounded-full bg-accent-glow blur-[140px] pointer-events-none -z-10"></div>
  <div class="absolute w-[300px] h-[300px] rounded-full bg-accent-primary/5 blur-[100px] pointer-events-none -z-10"></div>

  <!-- Central Holographic Brand Emblem -->
  <div class="loader-content flex flex-col items-center relative z-10 transition-all duration-300">
    
    <!-- Outer Dual-Spin Orbital Ring -->
    <div class="relative w-24 h-24 flex items-center justify-center mb-8">
      <!-- Spinning Track -->
      <div class="absolute inset-0 rounded-full border border-white/5"></div>
      <div class="absolute inset-0 rounded-full border border-transparent border-t-accent-primary border-b-white/20 animate-spin" style="animation-duration: 1.4s;"></div>
      <div class="absolute inset-2 rounded-full border border-transparent border-l-accent-primary/30 border-r-transparent animate-spin" style="animation-duration: 2.2s; animation-direction: reverse;"></div>

      <!-- Machined Inner Core -->
      <div class="relative w-14 h-14 rounded-2xl bg-surface-card border border-white/[0.15] flex items-center justify-center shadow-2xl shadow-black overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-t from-accent-primary/20 via-transparent to-white/5"></div>
        <span class="text-white font-black text-xl tracking-tighter relative z-10 font-sans">TP</span>
        <span class="absolute top-1.5 right-1.5 w-1.5 h-1.5 rounded-full bg-status-live" style="box-shadow: 0 0 6px rgba(16, 185, 129, 0.5);"></span>
      </div>
    </div>

    <!-- Identity & Progress Telemetry -->
    <div class="text-center space-y-3 w-64 sm:w-72">
      <div class="flex items-center justify-between text-[11px] font-mono uppercase tracking-[0.25em] text-text-dim px-1">
        <span>Tanuj Pandey</span>
        <span id="loader-percent" class="font-bold text-white tracking-widest tabular-nums text-xs">0%</span>
      </div>

      <!-- Laser Progress Bar with CSS animation fallback -->
      <div class="h-[2px] w-full bg-white/[0.08] rounded-full overflow-hidden relative">
        <div 
          id="loader-progress-bar" 
          class="laser-beam absolute top-0 left-0 h-full bg-accent-primary rounded-full" style="box-shadow: 0 0 10px rgba(94, 106, 210, 0.45);"
        ></div>
      </div>

      <!-- Micro Status Line -->
      <p id="loader-status" class="text-[11px] font-mono uppercase tracking-[0.2em] text-accent-primary font-medium">
        Initializing Core...
      </p>
    </div>

  </div>
</div>

<style>
  /* CSS-Driven Hardware Acceleration: Runs even if JS is delayed */
  .laser-beam {
    width: 0%;
    animation: fillLaser 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fillLaser {
    0% { width: 0%; }
    35% { width: 48%; }
    75% { width: 85%; }
    100% { width: 100%; }
  }

  /* Curtain exit animation triggerable via class */
  #tp-preloader.curtain-exit .loader-content {
    opacity: 0;
    transform: translateY(-20px) scale(0.96);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #tp-preloader.curtain-exit {
    transform: translateY(-100%);
    transition: transform 0.4s cubic-bezier(0.77, 0, 0.175, 1);
    pointer-events: none;
  }

  html.preloader-done #tp-preloader {
    display: none !important;
  }
</style>

<script is:inline>
  (function() {
    function initPreloader() {
      const preloader = document.getElementById('tp-preloader');
      if (!preloader) return;

      // 1. Instant remove if already visited in this browser session
      try {
        if (sessionStorage.getItem('tp_intro_loaded') || document.documentElement.classList.contains('preloader-done')) {
          preloader.remove();
          document.documentElement.classList.add('preloader-done');
          window.dispatchEvent(new Event('portfolio-loaded'));
          return;
        }
      } catch (e) {}

      // 2. Non-blocking intro: never lock scroll or gate content
      const percentEl = document.getElementById('loader-percent');
      const statusEl = document.getElementById('loader-status');

      const statuses = [
        "Initializing Core...",
        "Compiling Modules...",
        "Syncing Interfaces...",
        "Systems Operational"
      ];

      const startTime = Date.now();
      const targetDuration = 280;

      const timer = setInterval(function() {
        const elapsed = Date.now() - startTime;
        const progress = Math.min(Math.round((elapsed / targetDuration) * 100), 100);

        if (percentEl) {
          percentEl.textContent = progress + '%';
        }

        if (statusEl) {
          const idx = Math.min(Math.floor((progress / 100) * statuses.length), statuses.length - 1);
          statusEl.textContent = statuses[idx];
        }

        if (progress >= 100) {
          clearInterval(timer);
          dismissLoader();
        }
      }, 25);

      function dismissLoader() {
        clearInterval(timer);
        try {
          sessionStorage.setItem('tp_intro_loaded', 'true');
        } catch (e) {}

        document.documentElement.classList.add('preloader-done');
        preloader.classList.add('curtain-exit');
        window.dispatchEvent(new Event('portfolio-loaded'));

        // Clean removal after curtain animation finishes
        setTimeout(function() {
          if (preloader && preloader.parentNode) {
            preloader.parentNode.removeChild(preloader);
          }
        }, 500);
      }

      // 3. Hard safety fallback (max 700ms)
      setTimeout(function() {
        clearInterval(timer);
        if (preloader && preloader.parentNode) {
          preloader.classList.add('curtain-exit');
          setTimeout(function() {
            if (preloader && preloader.parentNode) preloader.parentNode.removeChild(preloader);
          }, 400);
        }
      }, 700);

      // 4. Astro View Transitions lifecycle hooks - never get stuck on navigation
      document.addEventListener('astro:before-swap', function() {
        clearInterval(timer);
        if (preloader && preloader.parentNode) preloader.parentNode.removeChild(preloader);
      }, { once: true });
    }

    // Run on initial load
    initPreloader();

    // Clean up if Astro swaps
    document.addEventListener('astro:after-swap', function() {
      const lingering = document.getElementById('tp-preloader');
      if (lingering) lingering.remove();
    });
  })();
</script>
