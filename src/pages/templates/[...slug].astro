---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import PremiumBackground from "../../components/PremiumBackground.astro";
import PortableTextImage from "../../components/BlogLayout/PortableTextImage.astro";
import TemplateCard from "../../components/TemplateCard.astro";
import { PortableText } from "astro-portabletext";
import { fetchAllTemplates, fetchTemplateBySlug, type TemplateItem } from "../../lib/templates";
import { optimizeSanityImage } from "../../lib/optimizeImage";
import { resolveDemoMedia } from "../../lib/videoEmbed";

export async function getStaticPaths() {
  const templates = await fetchAllTemplates();
  return (templates || [])
    .filter((t) => t?.slug?.current)
    .map((template) => ({
      params: { slug: String(template.slug.current).replace(/^\/+|\/+$/g, "") },
      props: { template },
    }));
}

const rawSlug = Astro.params.slug || "";
const cleanSlug = rawSlug.replace(/^\/+|\/+$/g, "");
const template: TemplateItem | null =
  Astro.props?.template || (await fetchTemplateBySlug(cleanSlug));

if (!template) {
  return Astro.redirect("/templates", 301);
}

const allTemplates = await fetchAllTemplates();
const otherTemplates = (allTemplates || []).filter((t) => t.slug?.current !== template.slug?.current);

const siteUrl = "https://tanujbuilds.site";
const slug = template.slug.current;
const canonicalURL = `${siteUrl}/templates/${slug}`;

const rawImageUrl = template.imageUrl || "/og-image-dark.png";
const ogImage = rawImageUrl.includes("cdn.sanity.io")
  ? optimizeSanityImage(rawImageUrl, 1200, 80)
  : rawImageUrl;
const demoMedia = resolveDemoMedia(template.demoVideoUrl);

const priceNumeric = template.price?.replace(/[^0-9.]/g, "") || "49";

const resolvedProductImage = ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage.startsWith("/") ? "" : "/"}${ogImage}`;

const productJsonLd = {
  "@type": "Product",
  "@id": `${canonicalURL}#product`,
  name: template.templateName,
  description: template.tagline || "Production-ready website template engineered with modern web architecture.",
  image: [resolvedProductImage],
  url: canonicalURL,
  sku: slug,
  category: "SoftwareApplication",
  brand: {
    "@type": "Brand",
    name: "Tanuj Builds",
  },
  offers: {
    "@type": "Offer",
    price: priceNumeric,
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    url: template.gumroadLink || canonicalURL,
    seller: {
      "@type": "Organization",
      name: "Tanuj Builds",
    },
    hasMerchantReturnPolicy: {
      "@type": "MerchantReturnPolicy",
      applicableCountry: "US",
      returnPolicyCategory: "https://schema.org/MerchantReturnNotPermitted",
    },
    shippingDetails: {
      "@type": "OfferShippingDetails",
      shippingRate: {
        "@type": "MonetaryAmount",
        value: "0",
        currency: "USD",
      },
      shippingDestination: {
        "@type": "DefinedRegion",
        addressCountry: "US",
      },
      deliveryTime: {
        "@type": "ShippingDeliveryTime",
        handlingTime: {
          "@type": "QuantitativeValue",
          minValue: 0,
          maxValue: 0,
          unitCode: "DAY",
        },
        transitTime: {
          "@type": "QuantitativeValue",
          minValue: 0,
          maxValue: 0,
          unitCode: "DAY",
        },
      },
    },
  },
  ...(template.tags?.length ? { keywords: template.tags.join(", ") } : {}),
  ...(template._createdAt ? { releaseDate: template._createdAt } : {}),
};

const faqJsonLd = {
  "@type": "FAQPage",
  "@id": `${canonicalURL}#faq`,
  mainEntity: [
    {
      "@type": "Question",
      name: `Can I use ${template.templateName} for commercial client projects?`,
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, the included commercial license grants full rights to build and deploy unlimited websites for both personal usage and paying client projects."
      }
    },
    {
      "@type": "Question",
      name: `How do I receive updates for ${template.templateName}?`,
      acceptedAnswer: {
        "@type": "Answer",
        text: "When updates, dependency upgrades, or bug fixes are published, Gumroad automatically emails you with instant access to the updated source code bundle."
      }
    },
    {
      "@type": "Question",
      name: "Can I hire Tanuj Pandey for custom setup or feature integration?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, you can contact Tanuj Pandey directly at tanujp09@gmail.com for installation assistance, custom backend/CMS integration, or bespoke full-stack development."
      }
    }
  ]
};

const pageKeywords = [
  template.templateName,
  `${template.category || "Website"} Next.js Template`,
  `${template.category || "Modern"} React Template`,
  ...(template.tags || ["Next.js", "React", "TypeScript", "Tailwind CSS"]),
  "Commercial Website Template",
  "Tanuj Pandey"
];

const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Templates", path: "/templates" },
  { name: template.templateName, path: `/templates/${slug}` },
];

const portableTextComponents = {
  type: {
    image: PortableTextImage,
  },
};
---

<Layout
  title={`${template.templateName} — ${template.category || "Next.js & React"} Website Template | Tanuj Pandey`}
  description={template.tagline || `Download ${template.templateName}, a production-ready Next.js & React website template by Tanuj Pandey with 99+ Lighthouse performance and commercial license.`}
  image={ogImage}
  keywords={pageKeywords}
  breadcrumbs={breadcrumbs}
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <div class="relative min-h-screen selection:bg-accent-primary/30 overflow-hidden bg-canvas">
    <PremiumBackground />

    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 pt-28 sm:pt-32 md:pt-36 pb-20 md:pb-28 relative z-10">
      
      <!-- Top Navigation & Breadcrumb -->
      <div class="mb-8 sm:mb-12 flex flex-wrap items-center justify-between gap-4">
        <a 
          href="/templates" 
          class="group inline-flex items-center gap-2.5 text-xs font-mono text-slate-600 hover:text-black transition-colors"
        >
          <span class="w-6 h-6 rounded-full bg-slate-100 border border-black/10 flex items-center justify-center group-hover:border-accent-primary transition-colors text-xs text-[#0F172A]">
            ←
          </span>
          <span>Back to All Templates</span>
        </a>

        <div class="flex items-center gap-2 text-xs font-mono">
          <span class="px-2.5 py-1 rounded-full text-[10px] uppercase tracking-wider bg-slate-100 border border-black/10 text-slate-800 font-semibold">
            Commercial License Included
          </span>
          {template.badge && (
            <span class="px-2.5 py-1 rounded-full text-[10px] uppercase tracking-wider bg-accent-primary/10 border border-accent-primary/30 text-accent-primary font-bold">
              {template.badge}
            </span>
          )}
        </div>
      </div>

      <!-- Hero Header Section -->
      <section class="max-w-5xl mb-12 sm:mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 border border-indigo-500/20 text-[#5E6AD2] text-xs font-mono font-semibold mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-primary"></span>
          <span>COMMERCIAL CODEBASE // {template.category?.toUpperCase() || "WEB PLATFORM"}</span>
        </div>

        <h1 class="font-grotesk font-extrabold text-3xl sm:text-5xl lg:text-6xl text-[#0F172A] tracking-tight leading-[1.08] mb-5">
          {template.templateName}
        </h1>

        <p class="text-base sm:text-lg text-slate-600 font-normal leading-relaxed max-w-3xl mb-7 font-sans">
          {template.tagline}
        </p>

        <!-- Tech Stack Pills -->
        <div class="flex flex-wrap gap-2 mb-8">
          {template.tags?.map((tag: string) => (
            <span class="px-3 py-1 rounded-md text-xs font-mono bg-slate-100 border border-black/[0.08] text-slate-700">
              {tag}
            </span>
          ))}
        </div>

        <!-- Hero Actions Bar -->
        <div class="flex flex-wrap items-center gap-4 pt-6 border-t border-black/[0.08]">
          <!-- Pricing -->
          <div class="flex items-baseline gap-2 mr-3 font-mono">
            <span class="text-3xl sm:text-4xl font-extrabold text-[#0F172A] tracking-tight">{template.price}</span>
            {template.originalPrice && (
              <span class="text-sm line-through text-slate-400">{template.originalPrice}</span>
            )}
          </div>

          <!-- Gumroad Button -->
          {template.gumroadLink && (
            <a 
              href={template.gumroadLink}
              target="_blank"
              rel="noopener noreferrer"
              class="group/btn inline-flex items-center gap-2 px-7 py-3.5 rounded-full text-xs font-grotesk font-bold uppercase tracking-wider bg-[#0F172A] hover:bg-black text-white transition-all duration-300 shadow-md active:scale-95"
            >
              <span>Get on Gumroad</span>
              <span class="text-xs transition-transform duration-300 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5">↗</span>
            </a>
          )}

          <!-- Live Interactive Preview Button -->
          {template.demoLink && (
            <a 
              href={template.demoLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full text-xs font-grotesk font-semibold uppercase tracking-wider bg-white hover:bg-slate-50 text-[#0F172A] border border-black/10 hover:border-accent-primary/60 transition-all shadow-xs active:scale-95"
            >
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>Live Interactive Preview</span>
              <span class="text-xs">↗</span>
            </a>
          )}

          <!-- GitHub Source Code Button -->
          {template.gitHubLink && (
            <a 
              href={template.gitHubLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-3.5 rounded-full text-xs font-mono uppercase tracking-wider bg-slate-100 border border-black/10 text-slate-700 hover:text-black hover:bg-slate-200 transition-colors"
            >
              <span>GitHub Preview</span>
              <span>↗</span>
            </a>
          )}
        </div>
      </section>

      <!-- Main Showcase Mockup (3D Hardware & Browser Frame in Studio Stage) -->
      <section class="mb-16 md:mb-24">
        <div class="laptop-3d-stage rounded-[24px] sm:rounded-[36px] p-5 sm:p-10 md:p-14 bg-gradient-to-b from-[#1C2233] via-[#101422] to-[#0A0D16] border border-black/10 shadow-[0_25px_70px_rgba(0,0,0,0.14)] overflow-hidden relative">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_30%,rgba(94,106,210,0.22)_0%,transparent_65%)] pointer-events-none"></div>
          <div data-gsap-parallax class="laptop-chassis relative rounded-2xl bg-[#F8FAFC] overflow-hidden border border-white/15 shadow-[0_30px_80px_rgba(0,0,0,0.45)] will-change-transform">
            
            <!-- Browser Header Bar -->
            <div class="px-4 py-3 bg-slate-50 border-b border-black/[0.08] flex items-center justify-between text-xs font-mono">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-slate-300"></span>
                <span class="w-3 h-3 rounded-full bg-slate-300"></span>
                <span class="w-3 h-3 rounded-full bg-slate-300"></span>
              </div>
              <div class="flex items-center gap-2 px-4 py-1 rounded-md bg-white border border-black/10 text-[11px] text-slate-600 max-w-sm truncate text-center hidden sm:flex shadow-2xs">
                <svg class="w-3 h-3 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 2a4 4 0 00-4 4v2H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-1V6a4 4 0 00-4-4zm2 6V6a2 2 0 10-4 0v2h4z" clip-rule="evenodd" />
                </svg>
                <span class="truncate">{template.demoLink || `https://tanujbuilds.site/demo/${slug}`}</span>
              </div>
              <div class="text-[10px] font-mono text-emerald-800 font-semibold bg-emerald-50 border border-emerald-500/30 px-2 py-0.5 rounded">
                100% Responsive · 99+ Score
              </div>
            </div>

            <!-- Preview Video or Image -->
            <div class="relative w-full aspect-[16/9] md:aspect-[16/9] bg-[#0B0D12] overflow-hidden flex items-center justify-center">
              {demoMedia ? (
                demoMedia.kind === "video" ? (
                  <video
                    src={demoMedia.src}
                    poster={ogImage || undefined}
                    controls
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    data-gsap-screen
                    class="w-full h-full object-contain bg-[#0B0D12]"
                  />
                ) : (
                  <iframe
                    src={demoMedia.src}
                    title={`${template.templateName} Demo Walkthrough`}
                    class="w-full h-full border-0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
                    allowfullscreen
                  ></iframe>
                )
              ) : (
                ogImage && (
                  <img 
                    src={ogImage} 
                    alt={`${template.templateName} high-resolution preview`}
                    data-gsap-screen
                    class="w-full h-full object-cover object-top"
                    loading="eager"
                    decoding="async"
                  />
                )
              )}
              <div class="laptop-glare pointer-events-none absolute inset-0 bg-gradient-to-tr from-transparent via-white/[0.04] to-white/[0.12] mix-blend-overlay"></div>
            </div>

          </div>
        </div>
      </section>

      <!-- 2-Column Split: Content & Capabilities vs. Sticky Purchase Card -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">
        
        <!-- LEFT: Product Deep Dive (8 Cols) -->
        <div class="lg:col-span-8 space-y-14">
          
          <!-- Key Highlights Grid -->
          {template.highlights && template.highlights.length > 0 && (
            <section class="space-y-6">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 border border-black/10 text-xs font-mono text-accent-primary">
                // ARCHITECTURE &amp; CAPABILITIES
              </div>
              <h2 class="text-2xl sm:text-3xl font-bold font-grotesk text-[#0F172A] tracking-tight">
                Key Features &amp; Performance Highlights
              </h2>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-6">
                {template.highlights.map((highlight: string) => (
                  <div class="p-5 rounded-2xl bg-white border border-black/[0.08] hover:border-accent-primary/40 transition-all flex items-start gap-3.5 shadow-xs">
                    <div class="w-6 h-6 rounded-full bg-accent-primary/10 text-accent-primary flex items-center justify-center shrink-0 mt-0.5 text-xs font-bold">
                      ✓
                    </div>
                    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-sans font-normal">
                      {highlight}
                    </p>
                  </div>
                ))}
              </div>
            </section>
          )}

          <!-- Package Contents / What's in the Box -->
          {template.included && template.included.length > 0 && (
            <section class="space-y-6 pt-10 border-t border-black/[0.08]">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 border border-black/10 text-xs font-mono text-accent-primary">
                // PACKAGE CONTENTS
              </div>
              <h2 class="text-2xl sm:text-3xl font-bold font-grotesk text-[#0F172A] tracking-tight">
                What's Included in Your Download
              </h2>

              <div class="rounded-2xl p-6 sm:p-7 bg-white border border-black/[0.08] space-y-3.5 shadow-xs">
                {template.included.map((item: string) => (
                  <div class="flex items-center gap-3 text-xs sm:text-sm text-[#0F172A] font-sans">
                    <svg class="w-4 h-4 text-emerald-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    <span>{item}</span>
                  </div>
                ))}
              </div>
            </section>
          )}

          <!-- Detailed Template Breakdown / PortableText -->
          {template.content && (
            <section class="space-y-6 pt-10 border-t border-black/[0.08]">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 border border-black/10 text-xs font-mono text-accent-primary">
                // DETAILED SPECIFICATION
              </div>
              <h2 class="text-2xl sm:text-3xl font-bold font-grotesk text-[#0F172A] tracking-tight">
                Design &amp; Engineering Details
              </h2>
              <div class="template-portable-text leading-relaxed text-slate-700 text-sm sm:text-base space-y-4">
                <PortableText value={template.content} components={portableTextComponents} />
              </div>
            </section>
          )}

          <!-- FAQ Accordion for Licensing -->
          <section class="space-y-6 pt-10 border-t border-black/[0.08]">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 border border-black/10 text-xs font-mono text-accent-primary">
              // LICENSING &amp; SUPPORT
            </div>
            <h2 class="text-2xl sm:text-3xl font-bold font-grotesk text-[#0F172A] tracking-tight">
              Frequently Asked Questions
            </h2>

            <div class="space-y-4 mt-6">
              <div class="rounded-2xl p-6 bg-white border border-black/[0.08] shadow-xs">
                <h3 class="text-sm sm:text-base font-bold font-grotesk text-[#0F172A] mb-2">Can I use this template for commercial client projects?</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-sans">
                  Yes, absolutely. The included commercial license grants you full rights to build and deploy unlimited websites for both personal usage and paying client projects with zero recurring royalties.
                </p>
              </div>

              <div class="rounded-2xl p-6 bg-white border border-black/[0.08] shadow-xs">
                <h3 class="text-sm sm:text-base font-bold font-grotesk text-[#0F172A] mb-2">How do I receive updates?</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-sans">
                  When updates, dependency upgrades, or bug fixes are published, Gumroad automatically sends you an email with instant access to the updated zip bundle.
                </p>
              </div>

              <div class="rounded-2xl p-6 bg-white border border-black/[0.08] shadow-xs">
                <h3 class="text-sm sm:text-base font-bold font-grotesk text-[#0F172A] mb-2">Need help with setup or custom feature development?</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-sans">
                  You can contact me directly at <a href="mailto:tanujp09@gmail.com" class="text-accent-primary hover:underline font-semibold">tanujp09@gmail.com</a>. I offer support for installation questions and can be hired for custom integrations.
                </p>
              </div>
            </div>
          </section>

        </div>

        <!-- RIGHT: Sticky Purchase Box (4 Cols) -->
        <div class="lg:col-span-4">
          <div class="sticky top-28 rounded-2xl p-6 sm:p-7 bg-white border border-black/[0.08] shadow-xl space-y-6">
            
            <div class="space-y-2">
              <span class="text-[10px] font-mono uppercase tracking-wider text-slate-500 block">[ COMMERCIAL LICENSE ]</span>
              <div class="flex items-baseline justify-between font-mono">
                <span class="text-4xl font-extrabold text-[#0F172A]">{template.price}</span>
                {template.originalPrice && (
                  <span class="text-sm line-through text-slate-400">{template.originalPrice}</span>
                )}
              </div>
              <p class="text-xs text-emerald-700 font-mono font-medium">One-time payment • Lifetime access</p>
            </div>

            <div class="pt-4 border-t border-black/[0.08] space-y-3">
              {template.gumroadLink ? (
                <a 
                  href={template.gumroadLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group/btn w-full py-3.5 px-4 rounded-xl text-xs font-grotesk font-bold uppercase tracking-wider bg-[#0F172A] hover:bg-black text-white transition-all duration-300 shadow-md flex items-center justify-center gap-2 active:scale-95"
                >
                  <span>Buy on Gumroad</span>
                  <span class="text-xs transition-transform duration-300 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5">↗</span>
                </a>
              ) : (
                <a 
                  href="/#contact"
                  class="w-full py-3.5 px-4 rounded-xl text-xs font-grotesk font-bold uppercase tracking-wider bg-[#0F172A] hover:bg-black text-white text-center block"
                >
                  Contact For Purchase
                </a>
              )}

              {template.demoLink && (
                <a 
                  href={template.demoLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full py-3 px-4 rounded-xl text-xs font-grotesk font-semibold bg-slate-100 border border-black/10 text-[#0F172A] hover:bg-slate-200 transition-colors flex items-center justify-center gap-2"
                >
                  <span>Live Interactive Demo</span>
                  <span class="text-xs">↗</span>
                </a>
              )}

              <button
                type="button"
                data-open-contact
                data-contact-subject={`Customize / Deploy ${template.templateName}`}
                class="w-full py-3 px-4 rounded-xl text-xs font-mono font-semibold bg-indigo-50 hover:bg-indigo-100 border border-[#5E6AD2]/30 text-[#5E6AD2] transition-colors flex items-center justify-center gap-2 cursor-pointer"
              >
                <span>Hire Tanuj to Customize</span>
                <span class="text-xs">↗</span>
              </button>
            </div>

            <!-- Guarantee Checklist -->
            <div class="pt-5 border-t border-black/[0.08] space-y-2.5 text-xs text-slate-600 font-mono">
              <div class="flex items-center gap-2.5">
                <span class="text-emerald-600 font-bold">✓</span>
                <span>Instant Zip Download after checkout</span>
              </div>
              <div class="flex items-center gap-2.5">
                <span class="text-emerald-600 font-bold">✓</span>
                <span>Complete TypeScript &amp; React code</span>
              </div>
              <div class="flex items-center gap-2.5">
                <span class="text-emerald-600 font-bold">✓</span>
                <span>Tailwind CSS design token system</span>
              </div>
              <div class="flex items-center gap-2.5">
                <span class="text-emerald-600 font-bold">✓</span>
                <span>Quickstart setup guide &amp; documentation</span>
              </div>
              <div class="flex items-center gap-2.5">
                <span class="text-emerald-600 font-bold">✓</span>
                <span>Direct developer support response</span>
              </div>
            </div>

            <!-- Author Signature -->
            <div class="pt-5 border-t border-black/[0.08] flex items-center gap-3">
              <div class="w-9 h-9 rounded-full bg-accent-primary/10 border border-accent-primary/30 flex items-center justify-center text-xs font-bold text-accent-primary shrink-0">
                TP
              </div>
              <div>
                <p class="text-xs font-semibold text-[#0F172A]">Created by Tanuj Pandey</p>
                <p class="text-[10px] text-slate-500 font-mono">Full Stack Engineer &amp; Template Author</p>
              </div>
            </div>

          </div>
        </div>

      </div>

      <!-- Other Templates Showcase -->
      {otherTemplates && otherTemplates.length > 0 && (
        <section class="mt-24 md:mt-32 pt-16 border-t border-black/[0.08]">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-10">
            <div>
              <p class="text-[11px] font-mono uppercase tracking-[0.25em] text-accent-primary mb-1">// MORE DIGITAL ASSETS</p>
              <h2 class="text-2xl sm:text-3xl font-bold font-grotesk text-[#0F172A]">
                Explore Other Commercial Templates
              </h2>
            </div>
            <a href="/templates" class="text-xs font-mono text-slate-600 hover:text-black transition-colors">
              View All Templates ({allTemplates.length}) →
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-7xl mx-auto">
            {otherTemplates.map((other, idx) => (
              <TemplateCard template={other} index={idx} />
            ))}
          </div>
        </section>
      )}

    </div>
  </div>
</Layout>
