---
// NovaStack Process Section: Aligned Editorial Header + Scroll-Driven Framer Motion Timeline
// Note: No overflow-hidden on section so sticky sidebar works and headings never clip
import ProcessTimeline, { type ProcessStep } from "./ProcessTimeline";

const steps: ProcessStep[] = [
  {
    step: "01",
    phase: "Alignment",
    title: "Discovery",
    summary: "Align on goals, scope, and constraints.",
    description:
      "Review your product objectives, target users, technical constraints, and launch priorities before writing a line of code.",
    deliverable: "Written scope spec & fixed milestone schedule",
  },
  {
    step: "02",
    phase: "Architecture",
    title: "Technical Planning",
    summary: "Lock the stack, schema, and deliverables.",
    description:
      "Select the optimal architecture, design data models and API contracts, and map clear weekly checkpoints.",
    deliverable: "Architecture plan & itemized deliverables list",
  },
  {
    step: "03",
    phase: "Interface",
    title: "UI/UX Design",
    summary: "Craft responsive, high-clarity layouts.",
    description:
      "Design clean, accessible user flows focused on readability, mobile responsiveness, and conversion.",
    deliverable: "Interactive prototype & responsive UI specs",
  },
  {
    step: "04",
    phase: "Engineering",
    title: "Sprint Development",
    summary: "Build, test, and deploy to private staging.",
    description:
      "Ship clean, type-safe code with continuous staging previews and asynchronous Loom walkthroughs.",
    deliverable: "Hands-on testing on your private staging URL",
  },
  {
    step: "05",
    phase: "Handover",
    title: "Production Launch",
    summary: "Deploy live and transfer full ownership.",
    description:
      "Deploy directly to your cloud accounts, verify DNS and analytics, and hand over 100% of the repository.",
    deliverable: "Live production domain & full repository transfer",
  },
];
---

<section id="process" class="ns-section bg-[var(--bg)] text-[var(--ink)] border-b border-[var(--border)]">
  <div class="ns-container">
    <!-- Split Layout: Sticky Left Heading + Assurance (5 cols) & Scroll-Driven Timeline (7 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
      <!-- Left Sticky Column (Aligned cleanly to container left edge) -->
      <div class="lg:col-span-5 lg:sticky lg:top-24 space-y-5">
        <div class="space-y-3">
          <div class="flex items-center gap-2.5">
            <span class="w-5 h-px bg-[var(--blue-600)]" aria-hidden="true"></span>
            <span class="ns-mono-label text-[var(--blue-600)] font-medium">
              03 / Process
            </span>
          </div>

          <h2 class="ns-h2 text-[var(--ink)]">
            A Clear 5-Step <span class="text-[var(--blue-600)]">Sprint</span> Timeline.
          </h2>

          <p class="ns-body">
            Working software deployed to a private staging URL at every milestone—so you inspect and sign off before moving forward.
          </p>
        </div>

        <div class="rounded-[16px] bg-[var(--surface)] border border-[var(--border)] p-6 space-y-4">
          <span class="ns-mono-label text-[var(--ink)] font-semibold block">
            Milestone-Gated Execution
          </span>
          <p class="text-base leading-[1.65] text-[var(--muted)]">
            Every stage produces a tangible deliverable you verify directly on staging. Invoices tie strictly to signed checkpoints.
          </p>
          <ul class="space-y-2.5 pt-3 border-t border-[var(--border)] text-sm font-mono text-[var(--ink)]">
            <li class="flex items-center gap-2.5">
              <span class="text-[var(--blue-600)] font-semibold" aria-hidden="true">✓</span>
              <span>Written scope before code</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-[var(--blue-600)] font-semibold" aria-hidden="true">✓</span>
              <span>Weekly staging links &amp; Looms</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-[var(--blue-600)] font-semibold" aria-hidden="true">✓</span>
              <span>100% repo transfer at launch</span>
            </li>
          </ul>
        </div>

        <div class="pt-1">
          <a href="#contact" class="ns-btn-primary px-6 py-3.5 text-base">
            <span>Start Your Project</span>
            <span class="ns-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Scroll-Driven Vertical Timeline -->
      <div class="lg:col-span-7">
        <ProcessTimeline client:visible steps={steps} />
      </div>
    </div>
  </div>
</section>
