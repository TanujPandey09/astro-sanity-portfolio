---
// NovaStack Trusted Capabilities: Clean Neutral Background + Brand Blue (#2563EB)
const capabilities = [
  {
    name: "React & React 19",
    tagline: "Component Architecture & State Management",
    description: "Component-driven user interfaces, Server Components, optimistic UI updates, and sub-second rendering for complex web applications.",
    details: "React 19 Server Actions, Context API, Redux Toolkit, and hook architecture.",
    tag: "UI LIBRARY"
  },
  {
    name: "Next.js 15",
    tagline: "App Router, SSR, SSG & Edge Delivery",
    description: "Production web applications leveraging App Router, dynamic server-side rendering, incremental static regeneration, and Core Web Vitals optimization.",
    details: "App Router, Server Actions, Middleware, Edge Functions, Image Optimization.",
    tag: "WEB FRAMEWORK"
  },
  {
    name: "TypeScript",
    tagline: "Strict Static Contracts & Safety",
    description: "Strict compile-time type safety preventing runtime regressions across large codebases, shared client/server interfaces, and clean handoffs.",
    details: "Generic typing, Zod schema validation, API contract safety, and zero `any` policy.",
    tag: "LANGUAGE"
  },
  {
    name: "Node.js & Socket.IO",
    tagline: "Asynchronous APIs & Event Streaming",
    description: "Scalable backend services, RESTful APIs, real-time bi-directional WebSockets via Socket.IO, and background queue workers.",
    details: "Express, Fastify, Redis Pub/Sub, idempotency locks, and event-driven patterns.",
    tag: "BACKEND RUNTIME"
  },
  {
    name: "PostgreSQL",
    tagline: "Relational Schemas & ACID Compliance",
    description: "Production relational databases with strict schema design, optimized indexing, migration pipelines, and Prisma / Drizzle ORMs.",
    details: "Multi-tenant modeling, JSONB indexing, connection pooling, and automated migrations.",
    tag: "DATABASE"
  },
  {
    name: "React Native",
    tagline: "Single Codebase for iOS & Android",
    description: "Native-speed mobile applications with shared business logic, offline sync, push notifications, and device hardware integration.",
    details: "Expo EAS workflows, Native Modules, reanimated gestures, and mobile user flows.",
    tag: "MOBILE DEV"
  },
  {
    name: "LLM APIs & AI Orchestration",
    tagline: "OpenAI, Claude & Gemini Integrations",
    description: "Production LLM integration with API failover, function calling, structured JSON output validation, and custom assistance workflows.",
    details: "OpenAI, Anthropic Claude, Google Gemini, structured schemas, and token optimization.",
    tag: "AI INTEGRATION"
  },
  {
    name: "Custom HTML Email Templates",
    tagline: "Table-Based Cross-Client Compatibility",
    description: "Custom, responsive HTML email templates designed and coded for reliable rendering across Gmail, Outlook, Apple Mail, and mobile clients.",
    details: "Table-based markup, inline CSS, client rendering workarounds, and clean source code.",
    tag: "EMAIL DEV"
  },
  {
    name: "Headless CMS (Sanity Studio)",
    tagline: "Real-Time Content Modeling & Workflows",
    description: "Headless CMS modeling with custom editorial schemas, real-time previewing, GROQ querying, and seamless Next.js & Astro integration.",
    details: "Custom Studio v3 desks, webhook revalidation, and global CDN asset delivery.",
    tag: "HEADLESS CMS"
  }
];
---

<section id="capabilities" class="py-20 sm:py-28 bg-[#F3F1EC] text-[#121212] border-b border-[#E9E6DF]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <!-- Section Header (Cobalt Styling) -->
    <div class="max-w-3xl mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#E3E6FF] border border-[#CCD2FF] text-[11px] font-mono font-semibold text-[#2B2BEE] uppercase tracking-[0.16em] mb-3">
        // PRODUCTION STACK
      </div>
      <h2 class="font-grotesk font-extrabold text-3xl sm:text-5xl text-[#121212] tracking-[-0.035em] leading-[1.06]">
        Built on battle-tested open standards.
      </h2>
      <p class="text-sm sm:text-base text-[#6F6E69] mt-3 leading-relaxed font-sans">
        Zero proprietary lock-in. Every digital product is engineered with industry-standard TypeScript, React, Next.js, and Node.js so you own the codebase forever.
      </p>
    </div>

    <!-- 9 Capabilities Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
      {capabilities.map((item, index) => (
        <div class="agency-card group rounded-[28px] p-6 sm:p-7 bg-white border border-[#E9E6DF] shadow-[0_4px_20px_rgba(18,18,18,0.04)] flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-mono font-semibold tracking-wider bg-[#FAF9F6] border border-[#E9E6DF] text-[#121212] uppercase">
                {item.tag}
              </span>
              <span class="text-xs font-mono font-bold text-[#6F6E69] tabular-nums">
                0{index + 1}/
              </span>
            </div>

            <h3 class="font-grotesk font-bold text-xl text-[#121212] tracking-tight group-hover:text-[#2B2BEE] transition-colors">
              {item.name}
            </h3>
            <p class="text-xs font-mono font-semibold text-[#2B2BEE] mt-1 mb-3">
              {item.tagline}
            </p>

            <p class="text-xs sm:text-sm text-[#6F6E69] leading-relaxed font-sans mb-4">
              {item.description}
            </p>
          </div>

          <div class="pt-4 border-t border-[#E9E6DF]">
            <span class="block text-[11px] font-mono text-[#6F6E69]">
              <strong class="text-[#121212] font-semibold font-sans">Scope:</strong> {item.details}
            </span>
          </div>
        </div>
      ))}
    </div>

    <!-- 100% Client IP Ownership Banner -->
    <div class="agency-card mt-10 sm:mt-12 rounded-[28px] p-5 sm:p-6 bg-white border border-[#E9E6DF] shadow-2xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-[radial-gradient(120%_80%_at_50%_0%,_#4B4BFF_0%,_#2B2BEE_40%,_#1C1CC4_85%)] text-white flex items-center justify-center font-mono font-bold text-sm shrink-0 shadow-xs">
          &lt;/&gt;
        </div>
        <div>
          <h4 class="font-grotesk font-bold text-sm text-[#121212]">100% Client Codebase &amp; IP Ownership</h4>
          <p class="text-xs text-[#6F6E69] font-sans mt-0.5">All repositories, credentials, database schemas, and email template files belong exclusively to your business.</p>
        </div>
      </div>
      <a href="#contact" class="inline-flex items-center gap-1.5 text-xs font-mono font-bold text-[#2B2BEE] hover:text-[#1C1CC4] transition-colors whitespace-nowrap">
        <span>Start a Project</span>
        <span>→</span>
      </a>
    </div>

  </div>
</section>
