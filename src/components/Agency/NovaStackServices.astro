---

<section id="services" class="py-16 sm:py-20 md:py-28 bg-[#FAFAFA] border-b border-slate-200/80">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-white border border-slate-200 text-xs font-mono font-semibold text-slate-700 uppercase tracking-wider mb-3 shadow-2xs">
        // AGENCY SERVICES
      </div>
      <h2 class="font-grotesk font-extrabold text-3xl sm:text-4xl md:text-5xl text-slate-900 tracking-[-0.03em] leading-tight">
        Six Core Disciplines. Zero Hand-Off Friction.
      </h2>
      <p class="text-base sm:text-lg text-slate-600 mt-4 leading-relaxed font-sans">
        NovaStack offers full lifecycle product development across six specialized categories. We do not make vague promises or outsource overseas; every deliverable is built directly by our dedicated engineering team.
      </p>
    </div>

    <!-- 6 Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {services.map((service, idx) => (
        <div 
          class="group rounded-2xl bg-white border border-slate-200 hover:border-slate-300 p-6 sm:p-8 transition-all duration-300 shadow-xs hover:shadow-md flex flex-col justify-between"
          id={`service-${service.id}`}
        >
          <div>
            <!-- Top Index & Category Badge -->
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="text-[10px] font-mono uppercase tracking-wider font-semibold text-[#0284C7] bg-sky-50 border border-sky-100 px-2.5 py-0.5 rounded">
                {service.category}
              </span>
              <span class="text-xs font-mono font-bold text-slate-400 tabular-nums">
                0{idx + 1}/
              </span>
            </div>

            <!-- Service Title -->
            <h3 class="font-grotesk font-bold text-xl sm:text-2xl text-slate-900 tracking-tight group-hover:text-[#0284C7] transition-colors mb-3">
              {service.title}
            </h3>

            <!-- Summary -->
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-sans mb-6">
              {service.summary}
            </p>

            <!-- Deliverables List -->
            <div class="mb-6 space-y-2">
              <span class="text-[11px] font-mono uppercase tracking-wider text-slate-500 font-semibold block mb-2">
                Deliverables:
              </span>
              <ul class="space-y-1.5 text-xs text-slate-700 font-sans">
                {service.deliverables.map((item) => (
                  <li class="flex items-start gap-2">
                    <span class="text-[#0284C7] font-bold mt-0.5 select-none font-mono">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Bottom: Tech Chips & Action -->
          <div class="pt-5 border-t border-slate-100 space-y-4">
            <div>
              <span class="text-[10px] font-mono text-slate-400 uppercase tracking-wider block mb-1.5">
                Primary Technologies:
              </span>
              <div class="flex flex-wrap gap-1.5">
                {service.techStack.map((tech) => (
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-50 border border-slate-200/80 text-slate-600">
                    {tech}
                  </span>
                ))}
              </div>
            </div>

            <div class="pt-1 flex items-center justify-between">
              <span class="text-[11px] font-mono text-slate-500">
                Fixed-Scope or Retainer
              </span>
              <a
                href={`#contact?service=${encodeURIComponent(service.title)}`}
                class="inline-flex items-center gap-1 text-xs font-grotesk font-bold text-slate-900 group-hover:text-[#0284C7] transition-colors"
              >
                <span>Inquire</span>
                <span>→</span>
              </a>
            </div>
          </div>

        </div>
      ))}
    </div>

    <!-- SEO & GEO Responsibility Note -->
    <div class="mt-8 p-4 rounded-xl bg-white border border-slate-200 text-xs text-slate-600 flex items-start gap-3">
      <span class="text-[#0284C7] font-mono font-bold mt-0.5 text-sm">ⓘ</span>
      <p class="leading-relaxed">
        <strong class="text-slate-800 font-semibold">SEO &amp; GEO Transparency Policy:</strong> NovaStack engineers strict technical crawlability, structured schema markup, fast TTFB, and contextual knowledge graphs. We do not make misleading claims regarding guaranteed #1 rankings, instant traffic, or guaranteed AI model mentions, as organic ranking algorithms remain third-party proprietary systems.
      </p>
    </div>

  </div>
</section>

