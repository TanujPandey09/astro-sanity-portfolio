---
import SectionHeader from "./SectionHeader.astro";

const services = [
  {
    span: "lg:col-span-7",
    featured: true,
    domain: "Core Architecture",
    title: "Full-Stack SaaS & Web Engineering",
    description: "End-to-end product development from database schema to sub-second React and Next.js interfaces. Built to handle real production traffic, complex role permissions, and clean team handoffs.",
    deliverables: "Shipped Sawt AI, Breeze SaaS, and multi-role healthcare portals",
    stack: ["Next.js / React", "Node.js / Express", "TypeScript", "PostgreSQL / Prisma", "REST & GraphQL"]
  },
  {
    span: "lg:col-span-5",
    featured: true,
    domain: "Applied AI Systems",
    title: "Multi-LLM & Agentic Workflows",
    description: "Production LLM orchestration across OpenAI, Gemini, Claude, and Perplexity with structured output validation, RAG retrieval pipelines, and streaming conversational UIs.",
    deliverables: "Multi-provider fallback routing & brand-safe response validation",
    stack: ["OpenAI / Gemini / Claude", "Contextual RAG", "Vector Search", "Streaming UI"]
  },
  {
    span: "lg:col-span-3",
    featured: false,
    domain: "Low-Latency",
    title: "Real-Time CRM & Event Streams",
    description: "Bi-directional state synchronization, live ticket pipelines, and SLA tracking powered by Socket.IO, WebSockets, and Redis Pub/Sub.",
    stack: ["Socket.IO", "WebSockets", "Redis"]
  },
  {
    span: "lg:col-span-3",
    featured: false,
    domain: "Interface Craft",
    title: "Design Systems & RTL UX",
    description: "Accessible component libraries, bilingual Arabic/English RTL-first layouts, and hardware-accelerated motion that scores 99+ on Lighthouse.",
    stack: ["Tailwind CSS", "GSAP / Motion", "RTL / i18n"]
  },
  {
    span: "lg:col-span-3",
    featured: false,
    domain: "Data Layer",
    title: "Database & Query Optimization",
    description: "High-throughput relational and document schemas, indexing strategies, and headless CMS pipelines with Sanity, Contentful, and Strapi.",
    stack: ["PostgreSQL", "MongoDB", "Sanity CMS"]
  },
  {
    span: "lg:col-span-3",
    featured: false,
    domain: "Monetization & Security",
    title: "Billing, RBAC & Guardrails",
    description: "Subscription lifecycles (Stripe, MyFatoorah), tier-based API metering, webhook idempotency, rate limiting, and audit logging.",
    stack: ["Stripe / MyFatoorah", "RBAC Auth", "Webhooks"]
  }
];
---

<section id="services" class="py-16 sm:py-24 md:py-28 relative z-20 border-t border-white/[0.10]">
  <div class="w-full">
    
    <SectionHeader 
      eyebrow="SERVICES"
      title="What I Build &" 
      gradientText="Ship to Production" 
      subtitle="Focused on the layers that turn early product ideas into revenue-generating software: resilient backends, multi-LLM intelligence, real-time state, and fast interfaces."
    />

    <!-- Developer HUD Asymmetric 12-Column Grid with All 6 Service Domains -->
    <div class="mt-8 sm:mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-5">
      {services.map((item, index) => (
        <div
          data-gsap-card
          class={`bento-spotlight group relative rounded-[20px] bg-[#111726] border border-white/[0.10] hover:border-accent-primary/40 transition-all duration-500 p-6 md:p-7 flex flex-col justify-between shadow-[0_18px_45px_rgba(0,0,0,0.5)] ${item.span}`}
        >
          <!-- Developer HUD Corner Crosshairs -->
          <span class="pointer-events-none absolute top-3 left-3 w-4 h-[1px] bg-white/40 group-hover:bg-accent-primary transition-colors"></span>
          <span class="pointer-events-none absolute top-3 left-3 w-[1px] h-4 bg-white/40 group-hover:bg-accent-primary transition-colors"></span>
          <span class="pointer-events-none absolute bottom-3 right-3 w-4 h-[1px] bg-white/40 group-hover:bg-accent-primary transition-colors"></span>
          <span class="pointer-events-none absolute bottom-3 right-3 w-[1px] h-4 bg-white/40 group-hover:bg-accent-primary transition-colors"></span>

          <div>
            <!-- Top Row: Domain Tag + Index -->
            <div class="flex items-center justify-between mb-5">
              <span class="text-[11px] font-mono uppercase tracking-[0.08em] px-2.5 py-0.5 rounded-full bg-white/[0.04] border border-white/[0.10] text-[#F8FAFC]">
                [ {item.domain} ]
              </span>
              <span class="text-xs font-mono tabular-nums text-[#38BDF8] font-bold">{String(index + 1).padStart(2, "0")}/</span>
            </div>

            <!-- Title -->
            <h3 class={`font-grotesk ${item.featured ? 'text-xl md:text-2xl' : 'text-lg'} font-bold text-[#F8FAFC] tracking-[-0.03em] mb-2.5`}>
              {item.title}
            </h3>

            <!-- Description -->
            <p class="text-xs sm:text-sm text-[#94A3B8] font-normal leading-relaxed mb-4">
              {item.description}
            </p>

            {item.deliverables && (
              <p class="text-[11px] font-mono text-[#38BDF8] mb-5">
                → {item.deliverables}
              </p>
            )}
          </div>

          <!-- Tech Chips -->
          <div class="pt-4 border-t border-white/[0.08]">
            <div class="flex flex-wrap gap-1.5">
              {item.stack.map((tech) => (
                <span class="text-[10px] font-mono uppercase tracking-[0.04em] px-2.5 py-1 rounded bg-white/[0.04] border border-white/[0.08] text-[#94A3B8]">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
