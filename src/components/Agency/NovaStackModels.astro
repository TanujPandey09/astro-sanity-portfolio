---
// NovaStack Engagement Models: Unified Architectural 3-Column Studio Matrix
// Single crisp white frame with 1px hairline dividers, subtle tint on recommended tier, inline "Best for" (no nested boxes), and integrated bottom assurance bar
import {
  PiRocketLaunchDuotone,
  PiUsersThreeDuotone,
  PiHandshakeDuotone,
  PiCheckCircleDuotone,
  PiShieldCheckDuotone,
  PiGitBranchDuotone,
  PiUserCheckDuotone,
} from "react-icons/pi";

const models = [
  {
    id: "fixed-scope",
    num: "01",
    highlighted: false,
    tag: "Fixed-Scope",
    timeline: "2–6 Weeks",
    pricePrefix: "Starting at",
    price: "$1,500",
    priceUnit: "USD / project",
    title: "Fixed-Scope Build",
    description:
      "Defined specs, fixed investment, and milestone-gated delivery for marketing sites, SaaS MVPs, and HTML email systems.",
    bestFor: "Startups & businesses with clear launch goals.",
    highlights: [
      "Written technical scope & milestone roadmap",
      "Private staging reviews before each sign-off",
      "100% repository & IP handover at launch",
      "14-day post-launch warranty included",
    ],
    ctaText: "Request a Fixed Quote",
    ctaHref: "#contact",
  },
  {
    id: "freelance-support",
    num: "02",
    highlighted: true,
    tag: "Most Popular",
    timeline: "Immediate Start",
    pricePrefix: "Starting at",
    price: "$2,500",
    priceUnit: "USD / month",
    title: "Dedicated Engineering",
    description:
      "Senior React, Next.js, and full-stack capacity without hiring delays—plugged directly into your GitHub, Linear, and Slack.",
    bestFor: "Digital agencies, studios & fast-moving product teams.",
    highlights: [
      "Direct GitHub, Linear/Jira & Slack integration",
      "High-velocity Next.js, React & TypeScript builds",
      "Daily async updates & Loom walkthroughs",
      "Flexible weekly sprints—scale or pause anytime",
    ],
    ctaText: "Check Availability",
    ctaHref: "#contact",
  },
  {
    id: "ongoing-collaboration",
    num: "03",
    highlighted: false,
    tag: "Retainer",
    timeline: "Month-to-Month",
    pricePrefix: "Starting at",
    price: "$1,200",
    priceUnit: "USD / month",
    title: "Technical Partnership",
    description:
      "Continuous feature iterations, API integrations, performance audits, and active maintenance with zero long-term lock-in.",
    bestFor: "Post-launch SaaS founders iterating on live products.",
    highlights: [
      "Direct channel via Slack, WhatsApp, or email",
      "Continuous feature sprints & API integrations",
      "Core Web Vitals audits & dependency updates",
      "Transparent task board & cancel-anytime terms",
    ],
    ctaText: "Discuss Partnership",
    ctaHref: "#contact",
  },
];

const guarantees = [
  "100% Repository & IP Ownership",
  "Staging-Verified Milestones",
  "Direct Founder Execution",
];
---

<section id="models" class="ns-section bg-[var(--bg)] text-[var(--ink)] border-b border-[var(--border)]">
  <div class="ns-container">
    <!-- Section Header -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 mb-8 lg:mb-10">
      <div class="max-w-2xl">
        <div class="flex items-center gap-2.5 mb-2.5">
          <span class="w-5 h-px bg-[var(--blue-600)]" aria-hidden="true"></span>
          <span class="ns-mono-label text-[var(--blue-600)] font-medium">
            05 / Engagement Models
          </span>
        </div>
        <h2 class="ns-h2 text-[var(--ink)]">
          Transparent Models. <span class="text-[var(--blue-600)]">Zero Lock-In.</span>
        </h2>
      </div>

      <p class="ns-body max-w-md">
        Fixed-scope milestones or flexible weekly sprints—structured around working software on staging.
      </p>
    </div>

    <!-- Unified Architectural Matrix Frame (Zero Card-Inside-Card Clutter) -->
    <div class="ns-reveal rounded-[16px] bg-[var(--surface)] border border-[var(--border)] overflow-hidden">
      <div class="grid grid-cols-1 lg:grid-cols-3 divide-y lg:divide-y-0 lg:divide-x divide-[var(--border)]">
        {models.map((model) => (
          <article
            class={`p-6 sm:p-7 flex flex-col justify-between gap-6 transition-colors duration-200 ${
              model.highlighted ? "bg-[#F8FAFF]" : "bg-[var(--surface)]"
            }`}
          >
            <div class="space-y-5">
              <!-- Top Meta Row -->
              <div class="flex items-center justify-between gap-2">
                <span class="text-xs font-mono text-[var(--muted)]">
                  {model.num} · {model.timeline}
                </span>
                <span
                  class={`px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium ${
                    model.highlighted
                      ? "bg-[var(--blue-50)] text-[var(--blue-700)]"
                      : "bg-[var(--bg)] text-[var(--muted)] border border-[var(--border)]"
                  }`}
                >
                  {model.tag}
                </span>
              </div>

              <!-- Title & Concise Summary -->
              <div class="space-y-2.5">
                <div class="flex items-center gap-3">
                  <div class={`w-9 h-9 rounded-xl flex items-center justify-center shrink-0 border ${
                    model.highlighted
                      ? "bg-[var(--blue-50)] border-[var(--blue-600)]/20 text-[var(--blue-600)]"
                      : "bg-[var(--bg)] border-[var(--border)] text-[var(--blue-600)]"
                  }`}>
                    {model.id === "fixed-scope" && <PiRocketLaunchDuotone className="w-5 h-5" />}
                    {model.id === "freelance-support" && <PiUsersThreeDuotone className="w-5 h-5" />}
                    {model.id === "ongoing-collaboration" && <PiHandshakeDuotone className="w-5 h-5" />}
                  </div>
                  <h3 class="text-xl sm:text-2xl font-semibold tracking-[-0.02em] text-[var(--ink)]">
                    {model.title}
                  </h3>
                </div>
                <p class="text-[15px] leading-[1.6] text-[var(--muted)]">
                  {model.description}
                </p>
              </div>

              <!-- Transparent USD Starting Anchor -->
              <div class="pt-1 flex items-baseline gap-2">
                <span class="text-[11px] font-mono uppercase tracking-[0.08em] text-[var(--muted)]">
                  {model.pricePrefix}
                </span>
                <span class="text-2xl sm:text-3xl font-semibold tracking-[-0.03em] text-[var(--ink)] tabular-nums">
                  {model.price}
                </span>
                <span class="text-xs font-mono text-[var(--muted)]">
                  {model.priceUnit}
                </span>
              </div>

              <!-- Clean Inline "Best For" Line (No Nested Box) -->
              <div class="py-3 border-y border-[var(--border)]">
                <p class="text-sm text-[var(--ink)] leading-snug">
                  <span class="font-mono text-[11px] uppercase tracking-[0.06em] text-[var(--blue-600)] font-semibold mr-2">
                    Best for:
                  </span>
                  <span>{model.bestFor}</span>
                </p>
              </div>

              <!-- Clean Deliverables List -->
              <ul class="space-y-2.5 text-[15px] leading-[1.55] text-[var(--muted)]">
                {model.highlights.map((item) => (
                  <li class="flex items-start gap-2.5">
                    <PiCheckCircleDuotone
                      className="w-4 h-4 text-[var(--blue-600)] shrink-0 mt-1"
                      aria-hidden="true"
                    />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Action CTA -->
            <div class="pt-2">
              <a
                href={model.ctaHref}
                class={
                  model.highlighted
                    ? "ns-btn-primary w-full py-3.5 px-5 text-sm sm:text-base"
                    : "ns-link-arrow w-full inline-flex items-center justify-center gap-2 py-3.5 px-5 rounded-[12px] bg-[var(--surface)] border border-[var(--border)] hover:border-[var(--blue-600)] hover:text-[var(--blue-600)] text-sm sm:text-base font-medium text-[var(--ink)] transition-colors duration-150"
                }
              >
                <span>{model.ctaText}</span>
                <span class="ns-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Integrated Slim Assurance Footer Strip -->
      <div class="px-6 sm:px-7 py-4 bg-[var(--bg)] border-t border-[var(--border)] flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <span class="ns-mono-label text-[var(--muted)] shrink-0">
          Included on every engagement
        </span>
        <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs sm:text-sm font-mono text-[var(--ink)]">
          <li class="inline-flex items-center gap-2">
            <PiShieldCheckDuotone className="w-4 h-4 text-[var(--blue-600)] shrink-0" aria-hidden="true" />
            <span>{guarantees[0]}</span>
          </li>
          <li class="inline-flex items-center gap-2">
            <PiGitBranchDuotone className="w-4 h-4 text-[var(--blue-600)] shrink-0" aria-hidden="true" />
            <span>{guarantees[1]}</span>
          </li>
          <li class="inline-flex items-center gap-2">
            <PiUserCheckDuotone className="w-4 h-4 text-[var(--blue-600)] shrink-0" aria-hidden="true" />
            <span>{guarantees[2]}</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
