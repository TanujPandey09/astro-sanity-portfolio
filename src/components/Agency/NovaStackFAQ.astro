---
// NovaStack FAQ: Unified Monochrome + Linear Indigo (#5E6AD2), Consistent Founder-Led Voice
const faqs = [
  {
    question: "What kind of projects do you take on?",
    answer:
      "I partner with startups, digital agencies, and product teams across four core areas: custom marketing websites (Next.js, Astro, Sanity CMS), full-stack SaaS applications (MVPs, portals, RBAC, Stripe billing), applied AI workflows (RAG pipelines, autonomous agents, LLM APIs), and production HTML email design systems.",
  },
  {
    question: "Who actually builds the product?",
    answer:
      "Every architectural decision, UI implementation, and backend integration is written directly by founder Tanuj Pandey. You communicate directly in Slack, WhatsApp, or email with the engineer shipping your commits—never an account manager or outsourced junior team.",
  },
  {
    question: "How are milestones and payments structured?",
    answer:
      "Fixed-scope projects follow a 5-step milestone roadmap: Discovery, Technical Planning, UI/UX Design, Sprint Development, and Launch. Before coding starts, we lock a written scope and milestone schedule. You test working code on a private staging URL at each checkpoint before approving the next invoice.",
  },
  {
    question: "Do I own 100% of the source code and accounts?",
    answer:
      "Yes. All repositories, cloud hosting accounts (Vercel, Netlify, AWS, Neon), and Sanity CMS workspaces belong directly to your organization. On final sign-off, 100% intellectual property transfers cleanly with zero proprietary lock-in.",
  },
  {
    question: "How do custom HTML email design systems work?",
    answer:
      "I design and hand-code modular, table-based HTML email kits using inline CSS and Outlook VML fallbacks—tested across 50+ clients including Outlook 365, Gmail, and Apple Mail Dark Mode. Deliverables arrive as clean, reusable HTML ready for Klaviyo, Mailchimp, HubSpot, SendGrid, or Resend. (Campaign sending and list management stay with your team.)",
  },
];
---

<section id="faq" class="py-20 sm:py-28 bg-white text-[#09090B] border-b border-[#E4E4E7] relative overflow-hidden">
  
  <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-14">
      <div class="inline-flex items-center gap-2.5 text-[11px] font-mono font-semibold text-[#5E6AD2] uppercase tracking-[0.18em] mb-3">
        <span class="w-4 h-px bg-[#5E6AD2]"></span>
        <span>06 / FAQ</span>
        <span class="w-4 h-px bg-[#5E6AD2]"></span>
      </div>
      <h2 class="font-grotesk font-extrabold text-3xl sm:text-5xl text-[#09090B] tracking-[-0.035em] leading-tight">
        Common Questions.
      </h2>
      <p class="text-sm sm:text-base text-[#52525B] mt-3 font-sans">
        Straight answers on scope, engineering workflow, and ownership.
      </p>
    </div>

    <!-- Accordion List -->
    <div class="space-y-3" id="faq-accordion-group">
      {faqs.map((faq, index) => {
        const isFirst = index === 0;
        return (
          <div class="agency-card rounded-2xl overflow-hidden bg-[#F4F4F5] border border-[#E4E4E7] hover:border-[#D4D4D8] transition-colors">
            <button
              type="button"
              id={`faq-btn-${index}`}
              aria-expanded={isFirst ? "true" : "false"}
              aria-controls={`faq-answer-${index}`}
              class="faq-trigger group w-full text-left px-6 py-5 flex items-center justify-between gap-4 cursor-pointer focus:outline-none"
            >
              <span class="font-grotesk font-bold text-base sm:text-lg text-[#09090B] group-hover:text-[#5E6AD2] transition-colors tracking-tight pr-2">
                {faq.question}
              </span>
              <span
                class={`faq-chevron w-8 h-8 rounded-full border flex items-center justify-center shrink-0 transition-all duration-300 ${
                  isFirst
                    ? "rotate-180 bg-[#5E6AD2] text-white border-[#5E6AD2]"
                    : "bg-white text-[#52525B] border-[#D4D4D8]"
                }`}
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </button>

            <div
              id={`faq-answer-${index}`}
              role="region"
              aria-labelledby={`faq-btn-${index}`}
              class={`px-6 pb-6 text-xs sm:text-sm text-[#52525B] font-sans leading-relaxed border-t border-[#E4E4E7] pt-4 bg-white/70 ${
                isFirst ? "" : "hidden"
              }`}
            >
              <p>{faq.answer}</p>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>

<script>
  const setupAgencyFAQ = () => {
    const container = document.getElementById("faq-accordion-group");
    if (!container || container.dataset.bound === "true") return;
    container.dataset.bound = "true";

    const triggers = container.querySelectorAll<HTMLButtonElement>(".faq-trigger");

    triggers.forEach((btn) => {
      btn.addEventListener("click", () => {
        const expanded = btn.getAttribute("aria-expanded") === "true";
        const answerId = btn.getAttribute("aria-controls");
        const answer = document.getElementById(answerId || "");
        const chevron = btn.querySelector(".faq-chevron");

        if (expanded) {
          btn.setAttribute("aria-expanded", "false");
          answer?.classList.add("hidden");
          chevron?.classList.remove("rotate-180", "bg-[#5E6AD2]", "text-white", "border-[#5E6AD2]");
          chevron?.classList.add("bg-white", "text-[#52525B]", "border-[#D4D4D8]");
        } else {
          triggers.forEach((otherBtn) => {
            if (otherBtn !== btn) {
              otherBtn.setAttribute("aria-expanded", "false");
              const otherAnswerId = otherBtn.getAttribute("aria-controls");
              document.getElementById(otherAnswerId || "")?.classList.add("hidden");
              const otherChevron = otherBtn.querySelector(".faq-chevron");
              otherChevron?.classList.remove("rotate-180", "bg-[#5E6AD2]", "text-white", "border-[#5E6AD2]");
              otherChevron?.classList.add("bg-white", "text-[#52525B]", "border-[#D4D4D8]");
            }
          });

          btn.setAttribute("aria-expanded", "true");
          answer?.classList.remove("hidden");
          chevron?.classList.add("rotate-180", "bg-[#5E6AD2]", "text-white", "border-[#5E6AD2]");
          chevron?.classList.remove("bg-white", "text-[#52525B]", "border-[#D4D4D8]");
        }
      });
    });
  };

  setupAgencyFAQ();
  document.addEventListener("astro:page-load", setupAgencyFAQ);
</script>
