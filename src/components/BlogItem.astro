---
import { optimizeSanityImage } from "../lib/optimizeImage";

const { blog, index } = Astro.props;
const blogImageUrl = optimizeSanityImage(blog.FeatureImage?.asset?.url || blog.BackgroundImage?.asset?.url, 480, 82);
const blogTitle = blog.title || blog.projectName || "Technical Article";
const readTime = blog.estimatedReadTime || "5 min read";
const categoryLabel = blog.Category || "Engineering";
const formattedDate = blog._createdAt
  ? new Date(blog._createdAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
  : "Recent";
---

<article class="group border-b border-black/[0.08] last:border-b-0 hover:bg-[#F8FAFF] transition-colors duration-200">
  <a
    href={`/blogs/${blog.slug?.current}`}
    data-cursor-text="READ ARTICLE ↗"
    aria-label={`Read article: ${blogTitle}`}
    class="py-5 sm:py-6 px-5 sm:px-7 flex flex-col sm:flex-row sm:items-center justify-between gap-4 sm:gap-6"
  >
    <div class="flex items-start sm:items-center gap-4 sm:gap-5 flex-1 min-w-0">
      <span class="font-mono text-xs text-[#5E6AD2] font-semibold tabular-nums shrink-0 mt-1 sm:mt-0">
        {String(index + 1).padStart(2, "0")}
      </span>

      {blogImageUrl && (
        <div class="hidden md:block w-28 aspect-[16/10] overflow-hidden border border-black/[0.08] bg-slate-100 rounded-lg shrink-0">
          <img 
            src={blogImageUrl} 
            alt={blogTitle}
            width="112"
            height="70"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-400 group-hover:scale-105"
          />
        </div>
      )}

      <div class="space-y-1.5 min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-2 text-[11px] font-mono text-slate-500">
          <span class="px-2 py-0.5 rounded-full bg-[#5E6AD2]/[0.08] text-[#5E6AD2] font-semibold uppercase tracking-[0.06em]">
            {categoryLabel}
          </span>
          <time datetime={blog._createdAt}>{formattedDate}</time>
          <span>·</span>
          <span>{readTime}</span>
        </div>
        
        <h3 class="font-grotesk text-lg sm:text-xl font-bold text-[#0F172A] group-hover:text-[#5E6AD2] transition-colors tracking-[-0.025em] leading-snug truncate">
          {blogTitle}
        </h3>
      </div>
    </div>

    <div class="flex items-center justify-between sm:justify-end gap-3 pl-7 sm:pl-0 shrink-0">
      <span class="text-xs font-mono font-semibold uppercase tracking-[0.06em] text-slate-600 group-hover:text-[#5E6AD2] transition-colors">
        Read
      </span>
      <div class="w-9 h-9 rounded-full bg-slate-100 border border-black/[0.08] group-hover:bg-[#5E6AD2] group-hover:border-[#5E6AD2] group-hover:text-white flex items-center justify-center transition-colors duration-200">
        <span class="text-xs font-bold">↗</span>
      </div>
    </div>
  </a>
</article>
