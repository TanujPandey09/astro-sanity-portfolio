---
// NovaStack Agency Hero: Deep Obsidian Canvas, Option 2 Monochrome Silk Wave, Centered Display, 5-Card Arc & Spotlight Proof Cards
import SilkWaveCanvas from "../Effects/SilkWaveCanvas.astro";

const fanCards = [
  {
    title: "Habot Enterprise",
    tag: "B2B SaaS",
    img: "https://cdn.sanity.io/images/fqd3bez7/production/2ce01332eb1f37c21197a65b9723c429873b54d1-1348x635.png?w=720&auto=format&q=85",
    tilt: "lg:-rotate-12 lg:translate-y-10",
    borderAccent: "border-white/15"
  },
  {
    title: "Template Architecture",
    tag: "Next.js 15",
    img: "https://cdn.sanity.io/images/fqd3bez7/production/fbe9b67497b5d77fb4822116a0b3b31db990eed4-1825x853.png?w=720&auto=format&q=85",
    tilt: "lg:-rotate-6 lg:translate-y-3",
    borderAccent: "border-indigo-400/25"
  },
  {
    title: "Apex Luxury Platform",
    tag: "Flagship",
    img: "https://cdn.sanity.io/images/fqd3bez7/production/9e3002b16f302b12708b1fa01238a73cda1c4919-1672x941.png?w=820&auto=format&q=85",
    tilt: "lg:scale-105 z-20",
    borderAccent: "border-white/30"
  },
  {
    title: "Omnexia Real-Time CRM",
    tag: "Socket.IO",
    img: "https://cdn.sanity.io/images/fqd3bez7/production/a789384b9bb85b4c62ff3abd42a14259ff219699-1815x717.png?w=720&auto=format&q=85",
    tilt: "lg:rotate-6 lg:translate-y-3",
    borderAccent: "border-indigo-400/25"
  },
  {
    title: "Executive Analytics",
    tag: "AI Telemetry",
    img: "https://cdn.sanity.io/images/fqd3bez7/production/cff0d5b6d2c8144035c77a26fd7616a85a437e7e-1365x1186.png?w=720&auto=format&q=85",
    tilt: "lg:rotate-12 lg:translate-y-10",
    borderAccent: "border-white/15"
  }
];
---

<section id="hero" class="relative w-full overflow-hidden bg-[#090A0F] text-white pt-14 sm:pt-18 md:pt-20 pb-16 sm:pb-20 border-b border-white/[0.08]">
  <!-- Option 2: Dark Monochrome Linear Indigo Silk Wave -->
  <SilkWaveCanvas />

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <!-- 1. CENTERED HERO HEADER -->
    <div class="max-w-4xl mx-auto text-center space-y-6">
      <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-white/[0.05] border border-white/10 text-[11px] font-mono uppercase tracking-[0.16em] text-slate-300">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>NOVASTACK STUDIO · AI &amp; FULL-STACK ENGINEERING</span>
      </div>

      <h1 class="rb-agency-blur-in font-grotesk font-extrabold text-white tracking-[-0.045em] text-4xl xs:text-5xl sm:text-6xl md:text-[4.5rem] lg:text-[5.25rem] leading-[0.98]">
        We engineer products<br />
        shaped by <span class="rb-agency-shiny-indigo">perception.</span>
      </h1>

      <p class="text-sm sm:text-base md:text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto font-sans">
        NovaStack builds full-stack web applications, mobile platforms, and deterministic AI workflows for ambitious founders and global product teams.
      </p>

      <!-- Dual Action Bar -->
      <div class="pt-2 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
        <a
          href="#contact"
          class="inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-full bg-white hover:bg-slate-200 text-[#090A0F] font-grotesk font-bold text-xs sm:text-sm uppercase tracking-wider shadow-[0_10px_30px_rgba(255,255,255,0.12)] transition-all active:scale-95"
        >
          <span>Start a Project</span>
          <span>→</span>
        </a>
        <a
          href="#work"
          class="inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-full bg-white/[0.06] hover:bg-white/[0.12] border border-white/15 text-white font-grotesk font-semibold text-xs sm:text-sm uppercase tracking-wider transition-all"
        >
          <span>See Case Studies</span>
          <span class="text-slate-400">↓</span>
        </a>
      </div>
    </div>

    <!-- 2. SIGNATURE 5-CARD FANNED SHOWCASE ARC (Pixel-Perfect Reference Match) -->
    <div class="mt-14 sm:mt-20 mb-16 sm:mb-24 relative">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4 lg:gap-5 items-center max-w-6xl mx-auto px-2">
        {fanCards.map((card, idx) => {
          const dir = idx < 2 ? 'left' : idx === 2 ? 'center' : 'right';
          return (
          <div
            data-agency-dir={dir}
            class={`group relative rounded-2xl overflow-hidden bg-[#12151F] border ${card.borderAccent} shadow-[0_24px_60px_rgba(0,0,0,0.65)] transition-all duration-500 hover:rotate-0 hover:translate-y-0 hover:scale-[1.06] hover:z-30 hover:border-[#828FFF]/70 ${card.tilt} ${idx === 4 ? 'col-span-2 sm:col-span-1 max-w-[260px] mx-auto w-full sm:max-w-none' : ''}`}
          >
            <div class="aspect-[4/3] w-full overflow-hidden bg-[#0F121A] relative">
              <img
                src={card.img}
                alt={card.title}
                loading={idx < 3 ? "eager" : "lazy"}
                decoding="async"
                class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
              />
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#090A0F]/90 via-transparent to-transparent"></div>
            </div>
            <div class="px-3.5 py-2.5 flex items-center justify-between gap-2 bg-[#0D0F17]/95 border-t border-white/[0.08]">
              <span class="text-[11px] font-grotesk font-semibold text-white truncate">{card.title}</span>
              <span class="text-[9px] font-mono uppercase tracking-wider text-[#828FFF] shrink-0">{card.tag}</span>
            </div>
          </div>
        );})}
      </div>
    </div>

    <!-- 3. HIGH-CONTRAST EDITORIAL MANIFESTO STATEMENT (Matches Reference Mid-Hero Block) -->
    <div class="pt-10 sm:pt-14 pb-12 sm:pb-16 border-t border-white/[0.08] max-w-4xl mx-auto text-center" data-agency-dir="center">
      <p class="font-grotesk font-semibold text-xl sm:text-2xl md:text-[2rem] leading-[1.35] tracking-[-0.02em] text-slate-400">
        <span class="text-white">Built with senior engineering teams and shipped globally,</span>
        {" "}NovaStack helps startups and enterprises engineer{" "}
        <span class="text-white">high-converting web platforms, custom SaaS products,</span>
        {" "}and{" "}
        <span class="text-white">production AI automation systems</span>
        {" "}that compound revenue — with{" "}
        <span class="text-white">100% codebase ownership</span>
        {" "}from day one.
      </p>
    </div>

    <!-- 4. COMPACT METRIC PROOF STRIP (React Bits Spotlight Card Tracking in Linear Indigo) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 max-w-5xl mx-auto">
      <div data-agency-dir="left" class="rb-spotlight-card rounded-2xl bg-white/[0.03] border border-white/[0.08] p-4 sm:p-5">
        <div class="flex items-center justify-between text-[10px] font-mono text-slate-300 mb-1">
          <span>API LATENCY</span>
          <span class="text-emerald-400 font-semibold">P99</span>
        </div>
        <div class="text-2xl sm:text-3xl font-bold font-grotesk text-white tabular-nums">
          <span data-count-target="38" data-count-suffix=" ms">38 ms</span>
        </div>
        <div class="text-[11px] font-mono text-slate-400 mt-1">Edge Cached &amp; SSR Ready</div>
      </div>

      <div data-agency-dir="left" class="rb-spotlight-card rounded-2xl bg-white/[0.03] border border-white/[0.08] p-4 sm:p-5">
        <div class="flex items-center justify-between text-[10px] font-mono text-slate-300 mb-1">
          <span>LLM PIPELINES</span>
          <span class="text-[#828FFF] font-semibold">MULTI-MODEL</span>
        </div>
        <div class="text-2xl sm:text-3xl font-bold font-grotesk text-white tabular-nums">
          <span data-count-target="4" data-count-suffix=" Providers">4 Providers</span>
        </div>
        <div class="text-[11px] font-mono text-slate-400 mt-1">OpenAI · Claude · Gemini · RAG</div>
      </div>

      <div data-agency-dir="right" class="rb-spotlight-card rounded-2xl bg-white/[0.03] border border-white/[0.08] p-4 sm:p-5">
        <div class="flex items-center justify-between text-[10px] font-mono text-slate-300 mb-1">
          <span>SCOPING SLA</span>
          <span class="text-emerald-400 font-semibold">DIRECT</span>
        </div>
        <div class="text-2xl sm:text-3xl font-bold font-grotesk text-white tabular-nums">
          &lt; <span data-count-target="24" data-count-suffix="h">24h</span>
        </div>
        <div class="text-[11px] font-mono text-slate-400 mt-1">Senior Architect Review</div>
      </div>

      <div data-agency-dir="right" class="rb-spotlight-card rounded-2xl bg-white/[0.03] border border-white/[0.08] p-4 sm:p-5">
        <div class="flex items-center justify-between text-[10px] font-mono text-slate-300 mb-1">
          <span>CODE OWNERSHIP</span>
          <span class="text-emerald-400 font-semibold">VERIFIED</span>
        </div>
        <div class="text-2xl sm:text-3xl font-bold font-grotesk text-white tabular-nums">
          <span data-count-target="100" data-count-suffix="% IP">100% IP</span>
        </div>
        <div class="text-[11px] font-mono text-slate-400 mt-1">Zero Lock-In Transfer</div>
      </div>
    </div>

  </div>
</section>

<style>
  @keyframes rbAgencyBlur {
    from {
      opacity: 0.25;
      filter: blur(8px);
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0);
    }
  }

  @keyframes rbAgencyShine {
    0% { background-position: 140% center; }
    100% { background-position: -140% center; }
  }

  .rb-agency-blur-in {
    animation: rbAgencyBlur 0.85s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .rb-agency-shiny-indigo {
    background: linear-gradient(110deg, #828fff 28%, #ffffff 48%, #5e6ad2 58%, #828fff 76%);
    background-size: 240% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: rbAgencyShine 5s linear infinite;
  }

  .rb-spotlight-card {
    position: relative;
    overflow: hidden;
    transition: border-color 0.3s ease;
  }

  .rb-spotlight-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      260px circle at var(--spot-x, 50%) var(--spot-y, 50%),
      rgba(94, 106, 210, 0.2),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }

  .rb-spotlight-card:hover {
    border-color: rgba(130, 143, 255, 0.45);
  }

  .rb-spotlight-card:hover::before {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .rb-agency-blur-in {
      animation: none;
      opacity: 1;
      filter: none;
      transform: none;
    }
    .rb-agency-shiny-indigo {
      animation: none;
      background: none;
      color: #828FFF;
    }
  }
</style>

<script>
  const bindSpotlightCards = () => {
    document.querySelectorAll<HTMLElement>('.rb-spotlight-card').forEach((card) => {
      if (card.dataset.spotBound === 'true') return;
      card.dataset.spotBound = 'true';
      card.addEventListener('pointermove', (e: PointerEvent) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--spot-x', `${e.clientX - rect.left}px`);
        card.style.setProperty('--spot-y', `${e.clientY - rect.top}px`);
      });
    });
  };

  bindSpotlightCards();
  document.addEventListener('astro:page-load', bindSpotlightCards);
</script>
