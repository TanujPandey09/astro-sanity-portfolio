---
import { optimizeSanityImage } from "../lib/optimizeImage";
import { resolveDemoMedia } from "../lib/videoEmbed";
import { PiArrowUpRightBold, PiPlayCircleDuotone } from "react-icons/pi";

interface Props {
  project: any;
  index: number;
}

const { project, index } = Astro.props;

const projectName = project?.projectName || "Custom SaaS Product";

let excerpt = "End-to-end production architecture built for speed, reliability, and scale.";
if (Array.isArray(project?.excerpt)) {
  const textBlocks = project.excerpt
    .flatMap((b: any) => b?.children?.map((c: any) => c?.text) || [])
    .filter((t: string) => t && t.trim().length > 0 && !t.includes("🚀"));
  if (textBlocks.length > 0) {
    excerpt = textBlocks.sort((a: string, b: string) => b.length - a.length)[0];
  }
} else if (typeof project?.excerpt === "string") {
  excerpt = project.excerpt;
}

const rawImageUrl =
  project?.BackgroundImage?.asset?.url ||
  project?.FeatureImage?.asset?.url ||
  "/img/custom-project.webp";
const imageUrl = optimizeSanityImage(rawImageUrl, 2000, 100);

const rawTags = project?.tags || project?.techStack || [];
const tags = Array.isArray(rawTags) && rawTags.length > 0 ? rawTags : ["Full-Stack", "TypeScript", "SaaS"];
const primaryStack = tags.slice(0, 4).join(" · ");

const slug = project?.slug?.current || "";
const projectUrl = slug ? `/projects/${slug}` : "/projects";
const demoUrl =
  typeof project?.demoLink === "string"
    ? project.demoLink
    : project?.demoLink?.current || "";
const demoMedia = resolveDemoMedia(project?.demoVideo?.asset?.url, project?.demoVideoUrl);
const num = String(index + 1).padStart(2, "0");
const category = project?.category || tags[0] || "Full-Stack Engineering";

// Cohesive alternating Framer Studio Pedestals (Obsidian Dark ↔ Architectural Chalk Studio)
const isDarkStage = index % 2 === 1;
---

<article class="project-showcase group w-full" data-gsap-card>
  <!-- 1. FRAMER-STYLE FULL-WIDTH CINEMATIC STUDIO STAGE -->
  <div class="relative">
    <a
      href={projectUrl}
      data-cursor-text="VIEW CASE STUDY ↗"
      class={`laptop-3d-stage relative block w-full rounded-[22px] sm:rounded-[30px] overflow-hidden px-4 py-6 sm:px-8 sm:py-10 md:px-12 md:py-12 transition-shadow duration-500 border ${
        isDarkStage
          ? "bg-gradient-to-b from-[#151926] via-[#0E111B] to-[#0A0B0E] border-black/15 shadow-[0_20px_60px_-20px_rgba(10,11,14,0.35)] hover:shadow-[0_32px_80px_-20px_rgba(10,11,14,0.48)]"
          : "bg-gradient-to-b from-[#F4F6FA] via-[#EDF0F7] to-[#E6EAF3] border-black/[0.08] shadow-[0_14px_44px_-20px_rgba(15,23,42,0.12)] hover:shadow-[0_28px_70px_-20px_rgba(15,23,42,0.2)]"
      }`}
    >
      <!-- Subtle Architectural Studio Ambient Light (Strictly Linear Indigo / White, Zero Glitch) -->
      {isDarkStage ? (
        <div
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_18%,rgba(94,106,210,0.22)_0%,transparent_64%)]"
          aria-hidden="true"
        ></div>
      ) : (
        <div
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_0%,rgba(255,255,255,0.9)_0%,transparent_65%)]"
          aria-hidden="true"
        ></div>
      )}

      <!-- Subtle Top-Left Index Watermark Inside Stage -->
      <div class="relative z-10 w-full mx-auto mb-4 sm:mb-5 flex items-center justify-between">
        <span class={`text-[11px] font-mono uppercase tracking-[0.14em] font-semibold ${isDarkStage ? "text-[#828FFF]" : "text-[#5E6AD2]"}`}>
          {num} · {category}
        </span>
        <span class={`text-[11px] font-mono hidden sm:inline ${isDarkStage ? "text-slate-400" : "text-slate-500"}`}>
          {project?.role || "Lead Full-Stack Engineer"}
        </span>
      </div>

      <!-- MacBook Pro Hardware Mockup Inside Framer Studio Stage (100% Full-Width Uncropped) -->
      <div data-gsap-parallax class="laptop-chassis relative z-10 w-full mx-auto px-1 sm:px-2">
        <div class="transition-transform duration-500 ease-out group-hover:scale-[1.008]">
          <!-- Anodized Dark Display Lid & Bezel -->
          <div class="relative rounded-[16px] sm:rounded-[22px] md:rounded-[26px] bg-[#0E1015] px-2 pb-2 pt-4 sm:px-3 sm:pb-3 sm:pt-5 md:px-3.5 md:pb-3.5 md:pt-6 shadow-[0_30px_80px_rgba(0,0,0,0.45)] border border-white/15 ring-1 ring-black/60">
            <!-- Top Camera Notch -->
            <div class="absolute top-1 sm:top-1.5 left-1/2 -translate-x-1/2 w-14 sm:w-20 md:w-28 h-2.5 sm:h-3 md:h-3.5 bg-[#07080B] rounded-b-md flex items-center justify-center z-30 border-x border-b border-white/[0.06]">
              <span class="w-1.5 h-1.5 rounded-full bg-[#1A1D24] ring-1 ring-white/10"></span>
            </div>

            <!-- Inner Screen Viewport (Full Width, Natural Aspect Ratio, Zero Width Cropping) -->
            <div class="relative w-full rounded-[10px] sm:rounded-[14px] md:rounded-[16px] overflow-hidden bg-[#0B0D12]">
              {imageUrl && (
                <img
                  src={imageUrl}
                  alt={projectName}
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                  class="w-full h-auto block"
                />
              )}
            </div>
          </div>

          <!-- Metallic Aluminum MacBook Base & Hinge Lip -->
          <div class="relative mx-auto w-[103%] -left-[1.5%] h-3.5 sm:h-5 md:h-6 bg-gradient-to-b from-[#555A64] via-[#32363E] to-[#1E2127] rounded-b-[14px] sm:rounded-b-[20px] shadow-[0_25px_50px_rgba(0,0,0,0.45)] border-t border-white/25">
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-20 sm:w-28 md:w-36 h-1.5 sm:h-2 bg-[#17191E] rounded-b-lg"></div>
          </div>
        </div>
      </div>
    </a>

    <!-- On-Demand Demo Video Button (Sibling of <a> for valid HTML) -->
    {demoMedia && (
      <button
        type="button"
        data-open-demo-modal
        data-demo-kind={demoMedia.kind}
        data-demo-src={demoMedia.src}
        data-demo-poster={imageUrl || ""}
        data-demo-title={`${projectName} — Demo Walkthrough`}
        class="absolute bottom-5 right-5 sm:bottom-7 sm:right-7 z-30 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#0A0B0E]/90 hover:bg-[#5E6AD2] border border-white/20 text-xs font-mono font-semibold text-white transition-colors cursor-pointer shadow-lg"
      >
        <PiPlayCircleDuotone className="w-4 h-4 text-[#828FFF]" />
        <span>Watch Demo</span>
      </button>
    )}
  </div>

  <!-- 2. MINIMALIST FRAMER 3-PART EDITORIAL METADATA STRIP -->
  <div class="mt-5 sm:mt-6 pt-5 border-t border-black/[0.08] grid grid-cols-1 md:grid-cols-12 gap-4 items-start md:items-center">
    <!-- Left: Project Name -->
    <div class="md:col-span-4">
      <a href={projectUrl} class="group/title inline-block">
        <h3 class="font-grotesk text-2xl sm:text-3xl font-bold text-[#0F172A] tracking-[-0.03em] leading-tight transition-colors group-hover/title:text-[#5E6AD2]">
          {projectName}
        </h3>
      </a>
    </div>

    <!-- Center: Clean Summary + Mono Stack -->
    <div class="md:col-span-5">
      <p class="text-sm sm:text-[15px] text-slate-600 font-sans leading-relaxed line-clamp-2">
        {excerpt}
      </p>
      <span class="block mt-1.5 font-mono text-[11px] uppercase tracking-[0.08em] text-slate-500">
        {primaryStack}
      </span>
    </div>

    <!-- Right: Direct Actions -->
    <div class="md:col-span-3 flex flex-wrap md:justify-end items-center gap-4">
      {demoUrl && (
        <a
          href={demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-xs font-mono font-medium text-slate-500 hover:text-[#5E6AD2] transition-colors"
        >
          <span>Live</span>
          <PiArrowUpRightBold className="w-3.5 h-3.5" />
        </a>
      )}
      <a
        href={projectUrl}
        class="group/btn inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-[#0F172A] hover:bg-[#5E6AD2] text-white font-grotesk font-semibold text-xs uppercase tracking-[0.06em] transition-colors"
      >
        <span>View Project</span>
        <PiArrowUpRightBold className="w-3.5 h-3.5 transition-transform duration-200 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5" />
      </a>
    </div>
  </div>
</article>
