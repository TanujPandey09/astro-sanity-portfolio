---
// NovaStack Dedicated Agency Header
---

<header class="sticky top-0 z-50 w-full bg-white/90 backdrop-blur-md border-b border-slate-200/80 transition-all duration-300" id="agency-header">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 sm:h-20 items-center justify-between gap-4">
      
      <!-- Brand Logo / Wordmark -->
      <div class="flex items-center gap-3">
        <a href="/agency" class="group flex items-center gap-2.5 text-decoration-none">
          <!-- Geometric Studio Monogram -->
          <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg bg-slate-900 text-white flex items-center justify-center font-grotesk font-extrabold text-base sm:text-lg shadow-sm group-hover:bg-[#0284C7] transition-colors">
            N<span class="text-[#38BDF8]">S</span>
          </div>
          <div class="flex flex-col">
            <span class="font-grotesk font-extrabold text-lg sm:text-xl tracking-tight text-slate-900 group-hover:text-slate-950 transition-colors">
              NovaStack<span class="text-[#0284C7]">.</span>
            </span>
            <span class="text-[9px] font-mono uppercase tracking-[0.12em] text-slate-500 font-semibold -mt-1 hidden sm:block">
              AI &amp; Digital Studio
            </span>
          </div>
        </a>

        <!-- Target Markets Pill -->
        <span class="hidden xl:inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-slate-100 text-[10px] font-mono text-slate-600 border border-slate-200">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          USA · UK · UAE · AUS · IND
        </span>
      </div>

      <!-- Desktop Navigation Links -->
      <nav aria-label="Agency Navigation" class="hidden lg:flex items-center gap-6 xl:gap-8">
        <a href="#services" class="text-xs font-grotesk font-semibold uppercase tracking-wider text-slate-600 hover:text-slate-900 transition-colors">
          Services
        </a>
        <a href="#capabilities" class="text-xs font-grotesk font-semibold uppercase tracking-wider text-slate-600 hover:text-slate-900 transition-colors">
          Capabilities
        </a>
        <a href="#work" class="text-xs font-grotesk font-semibold uppercase tracking-wider text-slate-600 hover:text-slate-900 transition-colors">
          Work
        </a>
        <a href="#why-us" class="text-xs font-grotesk font-semibold uppercase tracking-wider text-slate-600 hover:text-slate-900 transition-colors">
          Why Us
        </a>
        <a href="#process" class="text-xs font-grotesk font-semibold uppercase tracking-wider text-slate-600 hover:text-slate-900 transition-colors">
          Process
        </a>
        <a href="#models" class="text-xs font-grotesk font-semibold uppercase tracking-wider text-slate-600 hover:text-slate-900 transition-colors">
          Engagement
        </a>
        <a href="#faq" class="text-xs font-grotesk font-semibold uppercase tracking-wider text-slate-600 hover:text-slate-900 transition-colors">
          FAQ
        </a>
      </nav>

      <!-- Right Action Items -->
      <div class="flex items-center gap-3">
        <!-- Link to Founder's Personal Portfolio -->
        <a 
          href="/" 
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 bg-slate-50 hover:bg-slate-100 text-xs font-mono text-slate-600 hover:text-slate-900 transition-all"
          title="Return to Tanuj Pandey's Personal Portfolio & Engineer Profile"
        >
          <span>Personal Portfolio</span>
          <span class="text-slate-400">↗</span>
        </a>

        <!-- Primary CTA: Start a Project -->
        <a
          href="#contact"
          class="inline-flex items-center justify-center gap-2 px-4 sm:px-5 py-2 sm:py-2.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-white font-grotesk font-semibold text-xs uppercase tracking-wider shadow-sm hover:shadow transition-all active:scale-[0.98]"
        >
          <span>Start a Project</span>
          <span class="text-[#38BDF8]">→</span>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          type="button"
          id="agency-menu-toggle"
          aria-expanded="false"
          aria-controls="agency-mobile-menu"
          aria-label="Toggle navigation menu"
          class="lg:hidden inline-flex items-center justify-center p-2 rounded-lg text-slate-700 hover:text-slate-900 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-slate-900"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" id="agency-menu-open-icon">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" id="agency-menu-close-icon">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Drawer -->
  <div id="agency-mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-6 shadow-xl">
    <nav class="flex flex-col space-y-3">
      <a href="#services" class="agency-mobile-link px-3 py-2 text-sm font-grotesk font-semibold uppercase tracking-wider text-slate-700 hover:bg-slate-50 rounded-md">
        Services
      </a>
      <a href="#capabilities" class="agency-mobile-link px-3 py-2 text-sm font-grotesk font-semibold uppercase tracking-wider text-slate-700 hover:bg-slate-50 rounded-md">
        Capabilities
      </a>
      <a href="#work" class="agency-mobile-link px-3 py-2 text-sm font-grotesk font-semibold uppercase tracking-wider text-slate-700 hover:bg-slate-50 rounded-md">
        Featured Work
      </a>
      <a href="#why-us" class="agency-mobile-link px-3 py-2 text-sm font-grotesk font-semibold uppercase tracking-wider text-slate-700 hover:bg-slate-50 rounded-md">
        Why NovaStack
      </a>
      <a href="#process" class="agency-mobile-link px-3 py-2 text-sm font-grotesk font-semibold uppercase tracking-wider text-slate-700 hover:bg-slate-50 rounded-md">
        Development Process
      </a>
      <a href="#models" class="agency-mobile-link px-3 py-2 text-sm font-grotesk font-semibold uppercase tracking-wider text-slate-700 hover:bg-slate-50 rounded-md">
        Engagement Models
      </a>
      <a href="#faq" class="agency-mobile-link px-3 py-2 text-sm font-grotesk font-semibold uppercase tracking-wider text-slate-700 hover:bg-slate-50 rounded-md">
        Frequently Asked Questions
      </a>
      <div class="pt-3 border-t border-slate-100 flex flex-col gap-2">
        <a href="/" class="px-3 py-2 text-xs font-mono text-slate-600 hover:text-slate-900">
          ← Back to Personal Portfolio (Tanuj Pandey)
        </a>
        <a href="#contact" class="agency-mobile-link w-full text-center px-4 py-2.5 rounded-lg bg-slate-900 text-white font-grotesk font-bold text-xs uppercase tracking-wider">
          Start a Project →
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const initAgencyHeader = () => {
    const toggleBtn = document.getElementById('agency-menu-toggle');
    const mobileMenu = document.getElementById('agency-mobile-menu');
    const openIcon = document.getElementById('agency-menu-open-icon');
    const closeIcon = document.getElementById('agency-menu-close-icon');
    const mobileLinks = document.querySelectorAll('.agency-mobile-link');

    if (!toggleBtn || !mobileMenu) return;

    const toggle = () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
      openIcon?.classList.toggle('hidden');
      closeIcon?.classList.toggle('hidden');
    };

    toggleBtn.addEventListener('click', toggle);

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        if (!mobileMenu.classList.contains('hidden')) {
          toggle();
        }
      });
    });
  };

  initAgencyHeader();
  document.addEventListener('astro:after-swap', initAgencyHeader);
</script>

