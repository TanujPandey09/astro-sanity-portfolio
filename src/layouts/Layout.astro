---
import Header from "../components/Header.astro";
import Loader from "../components/Loader.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article" | "profile";
  noindex?: boolean;
  schemaType?: "WebPage" | "ProfilePage" | "CollectionPage" | "AboutPage";
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    section?: string;
    tags?: string[];
  };
  breadcrumbs?: Array<{ name: string; path: string }>;
  jsonLd?: Record<string, any> | Record<string, any>[];
}
const siteUrl = "https://tanujbuilds.site";
const defaultDescription = "Tanuj Pandey is a professional Full Stack Engineer with 4+ years of experience building secure, performant web products, interactive user interfaces, scalable backend systems, and AI workflows.";
const defaultOgImage = `${siteUrl}/og-image-dark.png`;

const { 
  title, 
  description = defaultDescription,
  image = defaultOgImage,
  type,
  noindex = false,
  schemaType,
  article,
  breadcrumbs,
  jsonLd,
} = Astro.props;

const pathname = Astro.url.pathname;
const isHome = pathname === "/" || pathname === "";
const canonicalPath = pathname === "/" || pathname === "" ? "/" : pathname.replace(/\/+$/, "");
const canonicalURL = new URL(canonicalPath, siteUrl).href;

// Ensure og:image is always an absolute URL and sized for social previews
const resolvedImage = image.startsWith('http') ? image : `${siteUrl}${image.startsWith('/') ? '' : '/'}${image}`;
const isSanityImage = resolvedImage.includes('cdn.sanity.io');
const ogImage = isSanityImage
  ? `${resolvedImage}${resolvedImage.includes('?') ? '&' : '?'}fm=jpg&fit=crop&w=1200&h=630&q=80`
  : resolvedImage;
const resolvedImagePath = resolvedImage.split('?')[0];
const hasKnownImageDimensions = isSanityImage || resolvedImagePath === `${siteUrl}/og-image-dark.png`;
const ogImageType = isSanityImage
  ? 'image/jpeg'
  : /\.png$/i.test(resolvedImagePath)
    ? 'image/png'
    : /\.webp$/i.test(resolvedImagePath)
      ? 'image/webp'
      : 'image/jpeg';
const ogType = type ?? (pathname.startsWith('/blogs/') && pathname !== '/blogs/' ? 'article' : 'website');
const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const personId = `${siteUrl}/#person`;
const websiteId = `${siteUrl}/#website`;
const webpageId = `${canonicalURL}#webpage`;
const additionalNodes = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const primaryNode = additionalNodes.find((node: any) => node?.['@id'] && node?.['@type'] !== 'BreadcrumbList');
const pageSchemaType = schemaType || (isHome ? 'ProfilePage' : 'WebPage');
const pageSchema = {
  "@type": pageSchemaType,
  "@id": webpageId,
  "url": canonicalURL,
  "name": title,
  "description": description,
  "isPartOf": { "@id": websiteId },
  "inLanguage": "en-US",
  ...(primaryNode
    ? { mainEntity: { "@id": primaryNode['@id'] } }
    : pageSchemaType === 'ProfilePage'
      ? { mainEntity: { "@id": personId } }
      : { about: { "@id": personId } }),
};
const breadcrumbSchema = breadcrumbs?.length
  ? {
      "@type": "BreadcrumbList",
      "@id": `${canonicalURL}#breadcrumb`,
      itemListElement: breadcrumbs.map((crumb, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: crumb.name,
        item: new URL(crumb.path, siteUrl).href,
      })),
    }
  : null;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      "name": "Tanuj Pandey",
      "alternateName": ["Tanuj", "Tanuj Builds"],
      "jobTitle": "Full Stack Engineer & AI Solutions Architect",
      "description": "Full Stack Engineer with 4+ years of professional experience building high-performance web applications, scalable APIs, and intelligent AI chatbot workflows.",
      "url": siteUrl,
      "image": defaultOgImage,
      "email": "mailto:tanujp09@gmail.com",
      "nationality": "Indian",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Pauri Garhwal",
        "addressRegion": "Uttarakhand",
        "addressCountry": "India"
      },
      "sameAs": [
        "https://github.com/TanujPandey09",
        "https://linkedin.com/in/tanujdev",
        "https://x.com/TanujPandey",
        siteUrl
      ],
      "knowsAbout": [
        "Full Stack Web Development",
        "Astro.js Modern Architecture",
        "React.js & Next.js",
        "Node.js Backend Engineering",
        "TypeScript & JavaScript",
        "Python",
        "PostgreSQL & Database Design",
        "Sanity CMS Headless Modeling",
        "Tailwind CSS Design Systems",
        "AI Agent & Chatbot Integrations",
        "REST & GraphQL APIs",
        "Web Performance & Core Web Vitals Optimization"
      ],
      "makesOffer": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Custom Full Stack Web Application Development",
            "description": "High-velocity web product architecture with modern stacks (Astro, Next.js, React, Node.js)."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "AI Integration & Intelligent Agent Solutions",
            "description": "Seamless integration of LLMs, conversational assistants, and OpenAI workflows into web applications."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Headless CMS & Content Modeling",
            "description": "Enterprise-ready Sanity CMS integrations with instant previews and live content delivery."
          }
        }
      ]
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      "url": siteUrl,
      "name": "Tanuj Pandey | Full Stack Engineer & AI Solutions Architect",
      "description": "Official portfolio of Tanuj Pandey featuring full stack web engineering projects, technical case studies, and modern web applications.",
      "publisher": { "@id": personId },
      "inLanguage": "en-US"
    },
    pageSchema,
    ...(breadcrumbSchema ? [breadcrumbSchema] : []),
    ...additionalNodes,
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
        <!-- Core SEO & Search Indexing -->
    <meta name="keywords" content="Tanuj Pandey, Full Stack Engineer, AI Solutions Architect, React Developer, Astro, Next.js, Node.js, TypeScript, Sanity CMS, Python, Portfolio, Web Developer Pauri Garhwal Uttarakhand, Software Engineer Portfolio" />
    <meta name="author" content="Tanuj Pandey" />
    <meta name="creator" content="Tanuj Pandey" />
    <meta name="publisher" content="Tanuj Pandey" />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <meta name="bingbot" content={robotsContent} />
    <meta name="theme-color" content="#09090B" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title="Tanuj Pandey — Blog" href={`${siteUrl}/rss.xml`} />
    <link rel="manifest" href="/manifest.webmanifest" />
    {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION} />
    )}
    {import.meta.env.PUBLIC_BING_SITE_VERIFICATION && (
      <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_SITE_VERIFICATION} />
    )}
    
    <!-- Open Graph (OG) / Social Media Previews (LinkedIn, WhatsApp, Facebook) -->
    <meta property="og:site_name" content="Tanuj Pandey | Full Stack Engineer" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    {hasKnownImageDimensions && <meta property="og:image:width" content="1200" />}
    {hasKnownImageDimensions && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_US" />
    {article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
    {article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
    {article?.author && <meta property="article:author" content={article.author} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    
    <!-- Twitter / X Card Previews -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="twitter:creator" content="@TanujPandey" />
    <meta name="twitter:site" content="@TanujPandey" />

    <!-- Official Brand Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    
    <!-- Google Fonts Preconnect & Optimized Async Link -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" />
    </noscript>
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />

    <!-- Structured Data: JSON-LD for Search Engines & AI Engines (AEO / GEO) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

    <!-- Dynamic Web Analytics (GA4, SPA-aware) -->
    {import.meta.env.PUBLIC_GA_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_ID}`} is:inline></script>
        <script
          is:inline
          data-ga-id={import.meta.env.PUBLIC_GA_ID}
          set:html={`
(function () {
  var id = document.currentScript && document.currentScript.getAttribute("data-ga-id");
  if (!id) return;
  window.dataLayer = window.dataLayer || [];
  window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
  gtag("js", new Date());
  gtag("config", id, { send_page_view: false });
  if (window.__gaTrackingBound) return;
  window.__gaTrackingBound = true;
  document.addEventListener("astro:page-load", function () {
    gtag("event", "page_view", {
      page_location: window.location.href,
      page_path: window.location.pathname + window.location.search,
      page_title: document.title
    });
  });
  document.addEventListener("click", function (event) {
    var target = event.target;
    var link = target && target.closest ? target.closest('a[href^="http"]') : null;
    if (!link || link.hostname === window.location.hostname) return;
    gtag("event", "outbound_click", { link_url: link.href, link_domain: link.hostname });
  });
})();
`}
        ></script>
      </>
    )}
    <!-- Prevent Loader flash on repeat visits / navigation -->
    <script is:inline>
      try {
        if (sessionStorage.getItem('tp_intro_loaded')) {
          document.documentElement.classList.add('preloader-done');
        }
      } catch (e) {}
    </script>
  </head>

  <body>
    <!-- Accessibility Skip Link -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:px-4 focus:py-2 focus:bg-white focus:text-black focus:font-bold focus:rounded-full focus:shadow-xl">
      Skip to main content
    </a>

    <!-- Magnificent Lightweight Intro Loader (Home page only) -->
    {isHome && <Loader />}

    <!-- Top Navigation Header -->
    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
    <div class="cursor"></div>
    <div class="cursor2"></div>
  </body>
</html>

<style is:global>
  @import 'aos/dist/aos.css';

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  *:focus-visible {
    outline: 2px solid var(--accent-primary, #5E6AD2);
    outline-offset: 4px;
    border-radius: 4px;
  }

  body {
    overflow-x: hidden;
    height: 100%;
    width: 100%;
  }

  /* Custom Minimalist Scrollbar */
  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  ::-webkit-scrollbar-track {
    background: var(--canvas-bg, #09090B);
  }
  ::-webkit-scrollbar-thumb {
    background: var(--border-hover, rgba(255, 255, 255, 0.16));
    border-radius: 6px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--accent-primary, #5E6AD2);
  }

  :root {
    /* Linear Indigo & Obsidian Monochrome Tokens - neutral obsidian, one accent */
    --canvas-bg-rgb: 9 9 11;
    --surface-card-rgb: 17 18 21;
    --surface-elevated-rgb: 24 25 30;
    --text-primary-rgb: 250 250 250;
    --accent-primary-rgb: 94 106 210;
    --status-live-rgb: 16 185 129;

    --canvas-bg: rgb(var(--canvas-bg-rgb));
    --surface-card: rgb(var(--surface-card-rgb));
    --surface-elevated: rgb(var(--surface-elevated-rgb));
    --border-subtle: rgba(255, 255, 255, 0.07);
    --border-hover: rgba(255, 255, 255, 0.16);
    --text-primary: rgb(var(--text-primary-rgb));
    --text-muted: #9B9CA4;
    --text-dim: #82848F;
    --accent-primary: rgb(var(--accent-primary-rgb));
    --accent-hover: #828FFF;
    --accent-glow: rgba(94, 106, 210, 0.15);
    --status-live: rgb(var(--status-live-rgb));

    /* Legacy Fallback Mappings */
    --primary-color: var(--accent-primary);
    --secondary-color: var(--accent-primary);
    --accent-color: var(--accent-primary);
    --bg-dark: var(--surface-card);
    --bg-deep: var(--canvas-bg);
    --border-color: var(--border-subtle);

    /* Headings - Mobile */
    --h1-mobile: 2.25rem;      
    --h2-mobile: 1.75rem;   
    --h3-mobile: 1.5rem;    
    --h4-mobile: 1.25rem;   
    --h5-mobile: 1.125rem;  
    --h6-mobile: 1rem;      

    /* Paragraph - Mobile */
    --p-mobile: 0.95rem;       
    --small-mobile: 0.85rem; 
    --xs-mobile: 0.75rem;   

    /* Desktop Sizes */
    --h1-desktop: 4rem;   
    --h2-desktop: 2.75rem;   
    --h3-desktop: 2rem;     
    --h4-desktop: 1.5rem;   
    --h5-desktop: 1.25rem;  
    --h6-desktop: 1rem;     

    --p-desktop: 1.05rem;  
    --small-desktop: 0.95rem;  
    --xs-desktop: 0.85rem; 

    /* Line Heights */
    --line-height-tight: 1.15;
    --line-height-normal: 1.6;
    --line-height-relaxed: 1.75;
    --line-height-loose: 2;

    /* Letter Spacing */
    --letter-spacing-tight: -0.03em;
    --letter-spacing-normal: 0;
    --letter-spacing-wide: 0.05em;
    --letter-spacing-wider: 0.1em;

    /* Font Weights */
    --fw-light: 300;
    --fw-normal: 400;
    --fw-medium: 500;
    --fw-semibold: 600;
    --fw-bold: 700;
    --fw-black: 900;
  }

  /* Global Typography Reset */
  html {
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    scroll-behavior: smooth;
  }

  body {
    overflow-x: hidden;
    background-color: var(--bg-deep);
    color: var(--text-muted);
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    font-size: var(--p-mobile);
    line-height: var(--line-height-normal);
  }

  h1, h2, h3, h4, h5, h6 {
    color: var(--text-primary);
    font-family: 'Space Grotesk', sans-serif;
    font-weight: var(--fw-black);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
  }

  h1 { font-size: var(--h1-mobile); }
  h2 { font-size: var(--h2-mobile); }
  h3 { font-size: var(--h3-mobile); }
  h4 { font-size: var(--h4-mobile); }
  h5 { font-size: var(--h5-mobile); }
  h6 { font-size: var(--h6-mobile); }

  p {
    font-size: var(--p-mobile);
    line-height: var(--line-height-relaxed);
    color: var(--text-muted);
  }

  @media (min-width: 1024px) {
    body { font-size: var(--p-desktop); }
    h1 { font-size: var(--h1-desktop); }
    h2 { font-size: var(--h2-desktop); }
    h3 { font-size: var(--h3-desktop); }
    h4 { font-size: var(--h4-desktop); }
    h5 { font-size: var(--h5-desktop); }
    h6 { font-size: var(--h6-desktop); }
    p { font-size: var(--p-desktop); }
  }

  .cursor {
    width: 25px;
    height: 25px;
    border-radius: 100%;
    border: 1px solid var(--primary-color);
    transition: all 150ms ease-out;
    position: fixed;
    pointer-events: none;
    left: 0;
    top: 0;
    transform: translate(-50%, -50%);
    z-index: 9999;
  }

  .cursor2 {
    width: 8px;
    height: 8px;
    border-radius: 100%;
    background-color: var(--primary-color);
    position: fixed;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 9999;
    transition: width 0.3s, height 0.3s, background-color 0.3s;
  }

  .hover {
    background-color: var(--accent-glow);
    border-color: var(--accent-primary);
    width: 60px;
    height: 60px;
  }

  .cursorinnerhover {
    width: 4px;
    height: 4px;
    background-color: white;
  }

  /* Text Gradients - Refined Silver Sheen */
  .text-gradient {
    background: linear-gradient(135deg, #FFFFFF 30%, #D4D4D8 70%, #A1A1AA 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Premium Card (Glassmorphism & Depth) */
  .glass-card {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.10);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.08), 0 8px 32px -4px rgba(0, 0, 0, 0.5);
    border-radius: 2rem;
  }

  .bg-surface-card {
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.06), 0 8px 24px -4px rgba(0, 0, 0, 0.4);
  }

  @media only screen and (max-width: 1024px) {
    .cursor, .cursor2 {
      display: none !important;
    }
  }

 
  @media only screen and (max-width: 768px) {
    body {
      background: var(--bg-deep);
      background-repeat: no-repeat;
      height: 100%;
      animation: none; /* Disable animation on mobile devices */
    }

    /* Add additional mobile styles if needed */

    /* ....Projects Cards */

    /* .....Blog details */

    .blog-content a {
      color: var(--accent-color);
    }

    .blog-content a:hover {
      color: var(--bg2);
      transition: all ease-in 0.5s;
      text-decoration: underline;
    }
  }
</style>

<script>
  import Lenis from 'lenis';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import AOS from 'aos';

  gsap.registerPlugin(ScrollTrigger);

  // Initialize AOS locally
  AOS.init({ once: true, duration: 600, disable: 'mobile' });

  // When AOS is disabled (mobile) it strips the [data-aos] attributes once and
  // never enables its MutationObserver. After a ClientRouter navigation the
  // freshly swapped-in [data-aos] nodes would therefore stay at opacity:0
  // (the hero included) and only JS-driven sections would ever appear.
  // Re-sync on every page load so new nodes always resolve to a visible state.
  const isAOSDisabled = () =>
    window.matchMedia('(max-width: 767px)').matches ||
    /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);

  const syncAOS = () => {
    if (isAOSDisabled()) {
      document.querySelectorAll('[data-aos]').forEach((el) => {
        el.removeAttribute('data-aos');
        el.removeAttribute('data-aos-delay');
        el.removeAttribute('data-aos-duration');
        el.removeAttribute('data-aos-easing');
      });
    } else {
      AOS.refreshHard();
    }
  };

  syncAOS();
  document.addEventListener('astro:after-swap', syncAOS);
  document.addEventListener('astro:page-load', syncAOS);

  // Initialize Lenis smooth scroll
  const lenis = new Lenis({
    duration: 1.2,
    easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    orientation: 'vertical',
    gestureOrientation: 'vertical',
    smoothWheel: true,
  });

  // Sync ScrollTrigger with Lenis
  lenis.on('scroll', ScrollTrigger.update);

  gsap.ticker.add((time) => {
    lenis.raf(time * 1000);
  });

  gsap.ticker.lagSmoothing(0);

  // Intercept anchor clicks for #contact and /#contact for smooth local scroll
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const link = target.closest('a');
    if (!link) return;

    const href = link.getAttribute('href');
    if (!href) return;

    if (href === '#contact' || (href === '/#contact' && (window.location.pathname === '/' || window.location.pathname === ''))) {
      const contactSection = document.getElementById('contact');
      if (contactSection) {
        e.preventDefault();
        lenis.scrollTo(contactSection, {
          duration: 1.5,
          offset: -50,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t))
        });
      }
    }
  });

  // Handle hash scrolling on page load/navigation
  const checkHashAndScroll = () => {
    if (window.location.hash === '#contact') {
      const contactSection = document.getElementById('contact');
      if (contactSection) {
        setTimeout(() => {
          lenis.scrollTo(contactSection, {
            duration: 1.5,
            offset: -50,
            immediate: false
          });
        }, 400); // Wait for animations to settle
      }
    }
  };

  window.addEventListener('load', checkHashAndScroll);
  document.addEventListener('astro:after-swap', checkHashAndScroll);

  // If not on homepage, dispatch portfolio-loaded immediately to trigger header/nav animations
  window.addEventListener('load', () => {
    window.dispatchEvent(new Event('portfolio-loaded'));
  });

  document.addEventListener('astro:after-swap', () => {
    window.dispatchEvent(new Event('portfolio-loaded'));
  });

  let cursor = document.querySelector(".cursor");
  let cursorinner = document.querySelector(".cursor2");

  const initCursor = () => {
    cursor = document.querySelector(".cursor");
    cursorinner = document.querySelector(".cursor2");
    
    // Hide cursor on mobile
    if (window.innerWidth < 1024) {
      if (cursor) (cursor as HTMLElement).style.display = 'none';
      if (cursorinner) (cursorinner as HTMLElement).style.display = 'none';
    }
  };

  initCursor();
  document.addEventListener('astro:after-swap', initCursor);

  let mouseX = 0;
  let mouseY = 0;

  document.addEventListener("mousemove", (e) => {
    mouseX = e.clientX;
    mouseY = e.clientY;
    if (!cursor || !cursorinner) return;

    gsap.to(cursor, {
      x: mouseX,
      y: mouseY,
      duration: 0.5,
      ease: "power2.out"
    });

    gsap.to(cursorinner, {
      x: mouseX,
      y: mouseY,
      duration: 0.1
    });
  });

  document.addEventListener("mousedown", () => {
    if (!cursor || !cursorinner) return;
    gsap.to(cursor, { scale: 0.8, duration: 0.3 });
    gsap.to(cursorinner, { scale: 2, duration: 0.3 });
  });

  document.addEventListener("mouseup", () => {
    if (!cursor || !cursorinner) return;
    gsap.to(cursor, { scale: 1, duration: 0.3 });
    gsap.to(cursorinner, { scale: 1, duration: 0.3 });
  });

  // Use event delegation for hover states
  document.addEventListener("mouseover", (e) => {
    const target = (e.target as HTMLElement).closest("a, button, .group, [data-hover-glow]");
    if (target && cursor && cursorinner) {
      gsap.to(cursor, { 
        width: 80, 
        height: 80, 
        backgroundColor: "rgba(94, 106, 210, 0.08)",
        borderColor: "rgba(94, 106, 210, 0.4)",
        duration: 0.3 
      });
      gsap.to(cursorinner, { scale: 0.5, opacity: 0, duration: 0.3 });
    }
  });

  document.addEventListener("mouseout", (e) => {
    const target = (e.target as HTMLElement).closest("a, button, .group, [data-hover-glow]");
    if (target && cursor && cursorinner) {
      gsap.to(cursor, { 
        width: 25, 
        height: 25, 
        backgroundColor: "transparent",
        borderColor: "var(--primary-color)",
        duration: 0.3 
      });
      gsap.to(cursorinner, { scale: 1, opacity: 1, duration: 0.3 });
    }
  });
</script>
