---
import SectionHeader from "./SectionHeader.astro";
---

<section id="services" class="py-24 md:py-32 relative z-20 border-t border-white/5 bg-[#050816]">
  <div class="container mx-auto px-4 md:px-8 max-w-7xl">
    
    <SectionHeader 
      title="High-Value" 
      gradientText="Services" 
      subtitle="Engineering market-ready products with premium visual details and lightning-fast backend pipelines."
    />

    <div class="mt-16 md:mt-24 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      
      <!-- Service 01: Cognitive AI SaaS -->
      <div class="service-card group relative bg-[#0B1120] border border-white/5 hover:border-[#3B82F6]/30 rounded-3xl p-8 flex flex-col justify-between overflow-hidden transition-all duration-500 hover:shadow-[0_0_50px_rgba(59,130,246,0.15)]" data-aos="fade-up">
        <div class="absolute -right-24 -top-24 w-48 h-48 bg-[#3B82F6]/5 rounded-full blur-[60px] group-hover:bg-[#3B82F6]/15 transition-all duration-700"></div>
        
        <div>
          <div class="flex items-center justify-between mb-8">
            <span class="text-[9px] font-mono text-white/30 uppercase tracking-[0.2em]">// Service 01</span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#3B82F6] shadow-[0_0_10px_rgba(59,130,246,1)]"></span>
          </div>

          <h3 class="text-xl md:text-2xl font-black text-white uppercase tracking-tight mb-4">
            Cognitive AI SaaS Development
          </h3>
          <p class="text-xs md:text-sm text-[#94A3B8] leading-relaxed mb-6 font-light">
            I integrate advanced LLMs (OpenAI, Gemini, Anthropic, Grok) with custom agentic workflows, contextual RAG, and bilingual conversational interfaces (RTL support).
          </p>
        </div>

        <!-- Mini Interactive Graphic: Mock AI Stream -->
        <div class="w-full bg-[#050816]/60 border border-white/5 rounded-2xl p-4 font-mono text-[9px] space-y-3 relative overflow-hidden h-28 flex flex-col justify-center">
          <div class="flex items-center justify-between text-white/40">
            <span>api.routing.model</span>
            <span class="text-[#22D3EE] animate-pulse">● active</span>
          </div>
          <div class="p-2.5 rounded-lg bg-white/5 border border-white/10 text-white/90">
            "Compare survey responses in English & Arabic..."
          </div>
          <div class="text-[#60A5FA] flex items-center gap-1.5 font-bold">
            <span class="w-1.5 h-1.5 rounded-full bg-[#60A5FA]"></span>
            <span>Response generated in 42ms [Grok-3]</span>
          </div>
        </div>
      </div>

      <!-- Service 02: Full-Stack Web Architectures -->
      <div class="service-card group relative bg-[#0B1120] border border-white/5 hover:border-[#22D3EE]/30 rounded-3xl p-8 flex flex-col justify-between overflow-hidden transition-all duration-500 hover:shadow-[0_0_50px_rgba(34,211,238,0.15)]" data-aos="fade-up" data-aos-delay="100">
        <div class="absolute -right-24 -top-24 w-48 h-48 bg-[#22D3EE]/5 rounded-full blur-[60px] group-hover:bg-[#22D3EE]/15 transition-all duration-700"></div>
        
        <div>
          <div class="flex items-center justify-between mb-8">
            <span class="text-[9px] font-mono text-white/30 uppercase tracking-[0.2em]">// Service 02</span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#22D3EE] shadow-[0_0_10px_rgba(34,211,238,1)]"></span>
          </div>

          <h3 class="text-xl md:text-2xl font-black text-white uppercase tracking-tight mb-4">
            Full-Stack Architectures
          </h3>
          <p class="text-xs md:text-sm text-[#94A3B8] leading-relaxed mb-6 font-light">
            Building robust web platforms utilizing React, Next.js, Node.js, Express, PostgreSQL, and MongoDB. Structured for enterprise security, scalability, and infinite expansion.
          </p>
        </div>

        <!-- Mini Interactive Graphic: Mock Pipeline Schema -->
        <div class="w-full bg-[#050816]/60 border border-white/5 rounded-2xl p-4 font-mono text-[9px] space-y-3 relative overflow-hidden h-28 flex flex-col justify-center">
          <div class="flex justify-between items-center text-white/30">
            <span>CLIENT</span>
            <span>REST API</span>
            <span>DATABASE</span>
          </div>
          <div class="flex items-center justify-between gap-2">
            <div class="px-2.5 py-1.5 rounded bg-[#3B82F6]/10 border border-[#3B82F6]/20 text-[#60A5FA] text-center w-1/3">
              Next.js
            </div>
            <div class="h-[1px] bg-white/20 flex-1 relative">
              <div class="w-1.5 h-1.5 rounded-full bg-[#22D3EE] absolute top-1/2 left-0 -translate-y-1/2 animate-[ping-flow_2s_infinite]"></div>
            </div>
            <div class="px-2.5 py-1.5 rounded bg-[#10B981]/10 border border-[#10B981]/20 text-[#34D399] text-center w-1/3">
              PostgreSQL
            </div>
          </div>
          <div class="text-white/40 text-center">Connection secure (SSL Active)</div>
        </div>
      </div>

      <!-- Service 03: Real-Time Communication Hubs -->
      <div class="service-card group relative bg-[#0B1120] border border-white/5 hover:border-[#EC4899]/30 rounded-3xl p-8 flex flex-col justify-between overflow-hidden transition-all duration-500 hover:shadow-[0_0_50px_rgba(236,72,153,0.15)]" data-aos="fade-up" data-aos-delay="200">
        <div class="absolute -right-24 -top-24 w-48 h-48 bg-[#EC4899]/5 rounded-full blur-[60px] group-hover:bg-[#EC4899]/15 transition-all duration-700"></div>
        
        <div>
          <div class="flex items-center justify-between mb-8">
            <span class="text-[9px] font-mono text-white/30 uppercase tracking-[0.2em]">// Service 03</span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#EC4899] shadow-[0_0_10px_rgba(236,72,153,1)]"></span>
          </div>

          <h3 class="text-xl md:text-2xl font-black text-white uppercase tracking-tight mb-4">
            Real-Time Operations & WebSockets
          </h3>
          <p class="text-xs md:text-sm text-[#94A3B8] leading-relaxed mb-6 font-light">
            I engineer low-latency messaging workflows, notifications grids, and drag-and-drop systems using Socket.IO, Redis, and event loops that run dynamically.
          </p>
        </div>

        <!-- Mini Interactive Graphic: Mock Message Feed -->
        <div class="w-full bg-[#050816]/60 border border-white/5 rounded-2xl p-3 font-mono text-[9px] space-y-2 relative overflow-hidden h-28 flex flex-col justify-center">
          <div class="flex gap-2 items-center">
            <div class="w-2 h-2 rounded-full bg-[#10B981]"></div>
            <span class="text-white/40">Socket.IO stream connected</span>
          </div>
          <div class="flex justify-end">
            <div class="p-2 rounded-xl rounded-tr-none bg-[#3B82F6]/20 border border-[#3B82F6]/30 text-white/90 text-right">
              Patient checked in.
            </div>
          </div>
          <div class="flex justify-start">
            <div class="p-2 rounded-xl rounded-tl-none bg-white/5 border border-white/10 text-white/80">
              Calendar synchronized.
            </div>
          </div>
        </div>
      </div>

      <!-- Service 04: HIPAA-Compliant Healthcare SaaS -->
      <div class="service-card group relative bg-[#0B1120] border border-white/5 hover:border-[#10B981]/30 rounded-3xl p-8 flex flex-col justify-between overflow-hidden transition-all duration-500 hover:shadow-[0_0_50px_rgba(16,185,129,0.15)]" data-aos="fade-up" data-aos-delay="300">
        <div class="absolute -right-24 -top-24 w-48 h-48 bg-[#10B981]/5 rounded-full blur-[60px] group-hover:bg-[#10B981]/15 transition-all duration-700"></div>
        
        <div>
          <div class="flex items-center justify-between mb-8">
            <span class="text-[9px] font-mono text-white/30 uppercase tracking-[0.2em]">// Service 04</span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#10B981] shadow-[0_0_10px_rgba(16,185,129,1)]"></span>
          </div>

          <h3 class="text-xl md:text-2xl font-black text-white uppercase tracking-tight mb-4">
            Compliant Medical Systems
          </h3>
          <p class="text-xs md:text-sm text-[#94A3B8] leading-relaxed mb-6 font-light">
            I craft secure EHR record integrations, clinic calendar workflows, and patient registries designed around role-based credentials (doctor, patient, admin) with strict encryption.
          </p>
        </div>

        <!-- Mini Interactive Graphic: Mock Audit Log -->
        <div class="w-full bg-[#050816]/60 border border-white/5 rounded-2xl p-4 font-mono text-[9px] space-y-2 relative overflow-hidden h-28 flex flex-col justify-center">
          <div class="flex items-center justify-between">
            <span class="text-[#10B981] font-bold">HIPAA SECURE</span>
            <span class="text-white/40">AUDIT_LOG_OK</span>
          </div>
          <div class="space-y-1.5 text-white/50 text-[8.5px]">
            <div>&gt; Decrypting EHR file reference...</div>
            <div class="text-white font-bold">&gt; Session token verified (Dr. Tanuj)</div>
          </div>
        </div>
      </div>

      <!-- Service 05: Lighthouse & Performance Optimization -->
      <div class="service-card group relative bg-[#0B1120] border border-white/5 hover:border-[#F59E0B]/30 rounded-3xl p-8 flex flex-col justify-between overflow-hidden transition-all duration-500 hover:shadow-[0_0_50px_rgba(245,158,11,0.15)]" data-aos="fade-up" data-aos-delay="400">
        <div class="absolute -right-24 -top-24 w-48 h-48 bg-[#F59E0B]/5 rounded-full blur-[60px] group-hover:bg-[#F59E0B]/15 transition-all duration-700"></div>
        
        <div>
          <div class="flex items-center justify-between mb-8">
            <span class="text-[9px] font-mono text-white/30 uppercase tracking-[0.2em]">// Service 05</span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#F59E0B] shadow-[0_0_10px_rgba(245,158,11,1)]"></span>
          </div>

          <h3 class="text-xl md:text-2xl font-black text-white uppercase tracking-tight mb-4">
            Edge Performance & Conversion
          </h3>
          <p class="text-xs md:text-sm text-[#94A3B8] leading-relaxed mb-6 font-light">
            I migrate legacy client single-page apps to hybrid SSR/SSG models, optimizing core web vitals, asset delivery speeds, and page animations to drive user conversion rates.
          </p>
        </div>

        <!-- Mini Interactive Graphic: Lighthouse Dial -->
        <div class="w-full bg-[#050816]/60 border border-white/5 rounded-2xl p-3 font-mono text-[9px] space-y-2 relative overflow-hidden h-28 flex flex-col justify-center">
          <div class="flex items-center justify-between text-white/30">
            <span>Perf. Audit</span>
            <span>Edge Nodes</span>
          </div>
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-full border-2 border-dashed border-[#10B981] flex items-center justify-center font-bold text-xs text-[#10B981] shadow-[0_0_15px_rgba(16,185,129,0.3)] shrink-0 font-mono">
              98
            </div>
            <div class="space-y-1 w-full">
              <div class="text-white font-bold">SEO & Best Practices</div>
              <div class="w-full bg-white/10 h-1 rounded-full overflow-hidden">
                <div class="bg-[#10B981] h-full w-[98%] rounded-full"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Service 06: Zero-to-One MVP Development -->
      <div class="service-card group relative bg-[#0B1120] border border-white/5 hover:border-[#8B5CF6]/30 rounded-3xl p-8 flex flex-col justify-between overflow-hidden transition-all duration-500 hover:shadow-[0_0_50px_rgba(139,92,246,0.15)]" data-aos="fade-up" data-aos-delay="500">
        <div class="absolute -right-24 -top-24 w-48 h-48 bg-[#8B5CF6]/5 rounded-full blur-[60px] group-hover:bg-[#8B5CF6]/15 transition-all duration-700"></div>
        
        <div>
          <div class="flex items-center justify-between mb-8">
            <span class="text-[9px] font-mono text-white/30 uppercase tracking-[0.2em]">// Service 06</span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#8B5CF6] shadow-[0_0_10px_rgba(139,92,246,1)]"></span>
          </div>

          <h3 class="text-xl md:text-2xl font-black text-white uppercase tracking-tight mb-4">
            Founder MVP Launchpad
          </h3>
          <p class="text-xs md:text-sm text-[#94A3B8] leading-relaxed mb-6 font-light">
            I act as a fractional product agency, turning scoping boards into fully coded, database-backed web applications ready for client onboarding and investor demo pitches.
          </p>
        </div>

        <!-- Mini Interactive Graphic: Pipeline Stage -->
        <div class="w-full bg-[#050816]/60 border border-white/5 rounded-2xl p-4 font-mono text-[9px] space-y-2 relative overflow-hidden h-28 flex flex-col justify-center">
          <div class="flex justify-between items-center text-white/30">
            <span>STRATEGY</span>
            <span>CODE</span>
            <span>LAUNCH</span>
          </div>
          <div class="grid grid-cols-3 gap-1">
            <div class="p-1 text-center bg-white/5 border border-white/10 text-white/40 rounded">Done</div>
            <div class="p-1 text-center bg-[#8B5CF6]/20 border border-[#8B5CF6]/40 text-[#A78BFA] rounded">Build</div>
            <div class="p-1 text-center bg-white/5 border border-white/10 text-white/20 rounded">Deploy</div>
          </div>
          <div class="text-[#A78BFA] text-[8.5px] font-bold text-center">MVP shipping timeline: 3-5 Weeks</div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .service-card {
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.5s, box-shadow 0.5s;
  }
  .service-card:hover {
    transform: translateY(-6px);
  }
  
  @keyframes ping-flow {
    0% { left: 0%; opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }
</style>
