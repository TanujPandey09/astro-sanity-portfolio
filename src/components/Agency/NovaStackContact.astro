---
// NovaStack Contact Section: Two-Column Layout (Left Reassurance + Direct Channels | Right Prominent White Card Form)
// Preserves /api/contact endpoint, FormData payload, and all field names 100% untouched
import {
  PiEnvelopeSimpleDuotone,
  PiWhatsappLogoDuotone,
  PiCopyDuotone,
  PiClockDuotone,
  PiListChecksDuotone,
} from "react-icons/pi";
---

<section id="contact" class="ns-section bg-[var(--bg)] text-[var(--ink)]">
  <div class="ns-container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
      <!-- Left Column (5 cols): Reassurance + Direct Email / WhatsApp -->
      <div class="lg:col-span-5 space-y-6">
        <div class="space-y-3">
          <div class="flex items-center gap-2.5">
            <span class="w-5 h-px bg-[var(--blue-600)]" aria-hidden="true"></span>
            <span class="ns-mono-label text-[var(--blue-600)] font-medium">
              07 / Contact
            </span>
          </div>
          <h2 class="ns-h2 text-[var(--ink)]">
            Get a Written Scope &amp; <span class="text-[var(--blue-600)]">Fixed Quote</span> in 24h.
          </h2>
          <p class="ns-body">
            Share your goals, timeline, and links. Founder Tanuj Pandey reviews every brief personally and replies with clear architecture notes and an estimate.
          </p>
        </div>

        <!-- Direct Channels (2-col on Tablet, Stacked on Mobile & Desktop) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-3.5 sm:gap-4">
          <div class="rounded-[16px] bg-[var(--surface)] border border-[var(--border)] p-5 flex items-center justify-between gap-4">
            <div class="flex items-center gap-3.5 min-w-0">
              <div class="w-10 h-10 rounded-xl bg-[var(--blue-50)] border border-[var(--blue-600)]/15 flex items-center justify-center text-[var(--blue-600)] shrink-0">
                <PiEnvelopeSimpleDuotone className="w-5 h-5" />
              </div>
              <div class="min-w-0">
                <span class="text-xs font-mono uppercase tracking-[0.08em] text-[var(--muted)] block mb-0.5">
                  Direct Email
                </span>
                <a
                  href="mailto:tanujp09@gmail.com"
                  class="text-base font-mono font-medium text-[var(--ink)] hover:text-[var(--blue-600)] transition-colors truncate block"
                >
                  tanujp09@gmail.com
                </a>
              </div>
            </div>
            <button
              type="button"
              id="agency-copy-email-btn"
              data-email="tanujp09@gmail.com"
              class="shrink-0 inline-flex items-center gap-1.5 px-3.5 py-2 rounded-[12px] bg-[var(--bg)] border border-[var(--border)] hover:border-[var(--blue-600)] hover:text-[var(--blue-600)] text-xs font-mono font-medium text-[var(--ink)] transition-colors cursor-pointer"
            >
              <PiCopyDuotone className="w-3.5 h-3.5" />
              <span id="agency-copy-email-text">Copy</span>
            </button>
          </div>

          <div class="rounded-[16px] bg-[var(--surface)] border border-[var(--border)] p-5 flex items-center justify-between gap-4">
            <div class="flex items-center gap-3.5 min-w-0">
              <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-500/20 flex items-center justify-center text-emerald-600 shrink-0">
                <PiWhatsappLogoDuotone className="w-5 h-5" />
              </div>
              <div>
                <span class="text-xs font-mono uppercase tracking-[0.08em] text-[var(--muted)] block mb-0.5">
                  Phone / WhatsApp
                </span>
                <a
                  href="tel:+919557321978"
                  class="text-base font-mono font-medium text-[var(--ink)] hover:text-[var(--blue-600)] transition-colors tabular-nums"
                >
                  +91 9557321978
                </a>
              </div>
            </div>
            <a
              href="https://wa.me/919557321978?text=Hi%20Tanuj%2C%20I%20visited%20NovaStack%20Studio%20and%20want%20to%20discuss%20a%20project."
              target="_blank"
              rel="noopener noreferrer"
              class="shrink-0 inline-flex items-center gap-1.5 px-3.5 py-2 rounded-[12px] bg-[var(--blue-50)] text-[var(--blue-700)] hover:bg-[var(--blue-600)] hover:text-white text-xs font-mono font-medium transition-colors"
            >
              <span>WhatsApp ↗</span>
            </a>
          </div>
        </div>

        <!-- Reassurance Steps -->
        <div class="rounded-[16px] bg-[var(--surface)] border border-[var(--border)] p-6 space-y-3">
          <div class="flex items-center gap-2">
            <PiListChecksDuotone className="w-4 h-4 text-[var(--blue-600)] shrink-0" />
            <span class="ns-mono-label text-[var(--blue-600)] font-medium block">
              What Happens Next
            </span>
          </div>
          <ol class="space-y-3 text-base leading-[1.6] text-[var(--muted)]">
            <li>
              <strong class="text-[var(--ink)] font-semibold">1. Direct Review:</strong> Tanuj inspects your brief, Figma, or existing codebase personally.
            </li>
            <li>
              <strong class="text-[var(--ink)] font-semibold">2. Written Scope:</strong> Architecture plan, milestones, and estimate delivered within 24 hours.
            </li>
            <li>
              <strong class="text-[var(--ink)] font-semibold">3. Optional Call:</strong> A focused 15-minute alignment call if helpful—no sales pitch.
            </li>
          </ol>
        </div>
      </div>

      <!-- Right Column (7 cols): Clean White Form Card with 48px+ Inputs & Visible Labels -->
      <div class="lg:col-span-7 rounded-[16px] bg-[var(--surface)] border border-[var(--border)] p-5 sm:p-7 lg:p-8">
        <div class="mb-5 pb-4 border-b border-[var(--border)] flex flex-wrap items-center justify-between gap-3">
          <div>
            <h3 class="text-2xl font-semibold tracking-[-0.02em] text-[var(--ink)]">
              Project Inquiry
            </h3>
            <p class="text-base text-[var(--muted)] mt-1">
              Tell me what you are building for a direct technical assessment.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--blue-50)] text-[var(--blue-700)] text-xs font-mono font-medium">
            <PiClockDuotone className="w-3.5 h-3.5" />
            <span>Reply &lt; 24h</span>
          </span>
        </div>

        <form id="agencyContactForm" class="space-y-5" novalidate>
          <!-- Hidden Fields: Source & Anti-Spam Honeypot (Untouched) -->
          <input type="hidden" name="source" value="novastack" />
          <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
            <label for="agency-company-website">Company Website</label>
            <input id="agency-company-website" type="text" name="company_website" tabindex="-1" autocomplete="off" />
          </div>

          <!-- Row 1: Name & Work Email -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div class="space-y-2">
              <label for="agency-name" class="block text-sm font-medium text-[var(--ink)]">
                Full Name <span class="text-[#B91C1C]" aria-hidden="true">*</span>
              </label>
              <input
                id="agency-name"
                name="from_name"
                type="text"
                required
                placeholder="Rohan Mehta"
                class="w-full min-h-[48px] rounded-[12px] border border-[var(--border)] bg-[var(--surface)] px-4 py-3 text-base text-[var(--ink)] placeholder:text-[#64748B] focus:border-[var(--blue-600)] focus:ring-2 focus:ring-[#2563EB]/20 focus:outline-none transition-colors"
              />
              <span class="agency-error text-xs font-mono text-[#B91C1C] hidden" id="err-name">
                Please provide your full name.
              </span>
            </div>

            <div class="space-y-2">
              <label for="agency-email" class="block text-sm font-medium text-[var(--ink)]">
                Work Email <span class="text-[#B91C1C]" aria-hidden="true">*</span>
              </label>
              <input
                id="agency-email"
                name="from_email"
                type="email"
                required
                placeholder="rohan@kestrelhq.com"
                class="w-full min-h-[48px] rounded-[12px] border border-[var(--border)] bg-[var(--surface)] px-4 py-3 text-base text-[var(--ink)] placeholder:text-[#64748B] focus:border-[var(--blue-600)] focus:ring-2 focus:ring-[#2563EB]/20 focus:outline-none transition-colors"
              />
              <span class="agency-error text-xs font-mono text-[#B91C1C] hidden" id="err-email">
                Please enter a valid work email address.
              </span>
            </div>
          </div>

          <!-- Row 2: Company & Project Type -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div class="space-y-2">
              <label for="agency-company" class="block text-sm font-medium text-[var(--ink)]">
                Company / Studio <span class="text-[var(--muted)] font-normal">(Optional)</span>
              </label>
              <input
                id="agency-company"
                name="company_name"
                type="text"
                placeholder="Kestrel Labs"
                class="w-full min-h-[48px] rounded-[12px] border border-[var(--border)] bg-[var(--surface)] px-4 py-3 text-base text-[var(--ink)] placeholder:text-[#64748B] focus:border-[var(--blue-600)] focus:ring-2 focus:ring-[#2563EB]/20 focus:outline-none transition-colors"
              />
            </div>

            <div class="space-y-2">
              <label for="agency-service" class="block text-sm font-medium text-[var(--ink)]">
                Project Type <span class="text-[#B91C1C]" aria-hidden="true">*</span>
              </label>
              <select
                id="agency-service"
                name="service"
                required
                class="w-full min-h-[48px] rounded-[12px] border border-[var(--border)] bg-[var(--surface)] px-4 py-3 text-base text-[var(--ink)] focus:border-[var(--blue-600)] focus:ring-2 focus:ring-[#2563EB]/20 focus:outline-none transition-colors"
              >
                <option value="">Select project type...</option>
                <option value="Website Development">Web Design &amp; Development</option>
                <option value="SaaS Application">SaaS / Full-Stack Application</option>
                <option value="AI Integration">AI Integration &amp; Automation</option>
                <option value="Email Design Systems">Email Design System &amp; HTML</option>
                <option value="Dedicated Engineering Support">Dedicated Engineering Support</option>
              </select>
              <span class="agency-error text-xs font-mono text-[#B91C1C] hidden" id="err-service">
                Please select a project type.
              </span>
            </div>
          </div>

          <!-- Row 3: Budget & Timeline -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div class="space-y-2">
              <label for="agency-budget" class="block text-sm font-medium text-[var(--ink)]">
                Estimated Budget <span class="text-[#B91C1C]" aria-hidden="true">*</span>
              </label>
              <select
                id="agency-budget"
                name="budget"
                required
                class="w-full min-h-[48px] rounded-[12px] border border-[var(--border)] bg-[var(--surface)] px-4 py-3 text-base text-[var(--ink)] focus:border-[var(--blue-600)] focus:ring-2 focus:ring-[#2563EB]/20 focus:outline-none transition-colors"
              >
                <option value="">Select budget range...</option>
                <option value="$500 – $1,500 USD (Email System / Landing Page)">$500 – $1,500 USD (Email System / Landing Page)</option>
                <option value="$1,500 – $3,500 USD (Custom Marketing Website)">$1,500 – $3,500 USD (Custom Marketing Website)</option>
                <option value="$3,500 – $6,000 USD (AI Integration & Automation)">$3,500 – $6,000 USD (AI Integration &amp; Automation)</option>
                <option value="$6,000 – $15,000+ USD (SaaS MVP / Full-Stack)">$6,000 – $15,000+ USD (SaaS MVP / Full-Stack)</option>
                <option value="Weekly Sprint / Monthly Retainer">Weekly Sprint / Monthly Retainer</option>
              </select>
              <span class="agency-error text-xs font-mono text-[#B91C1C] hidden" id="err-budget">
                Please select a budget range.
              </span>
            </div>

            <div class="space-y-2">
              <label for="agency-timeline" class="block text-sm font-medium text-[var(--ink)]">
                Target Timeline <span class="text-[#B91C1C]" aria-hidden="true">*</span>
              </label>
              <select
                id="agency-timeline"
                name="timeline"
                required
                class="w-full min-h-[48px] rounded-[12px] border border-[var(--border)] bg-[var(--surface)] px-4 py-3 text-base text-[var(--ink)] focus:border-[var(--blue-600)] focus:ring-2 focus:ring-[#2563EB]/20 focus:outline-none transition-colors"
              >
                <option value="">Select timeline...</option>
                <option value="Immediate (< 2 weeks)">Immediate (&lt; 2 weeks)</option>
                <option value="2 to 4 weeks">2 to 4 weeks</option>
                <option value="1 to 2 months">1 to 2 months</option>
                <option value="Flexible / Planning phase">Flexible / Planning phase</option>
              </select>
              <span class="agency-error text-xs font-mono text-[#B91C1C] hidden" id="err-timeline">
                Please select your timeline expectations.
              </span>
            </div>
          </div>

          <!-- Row 4: Project Brief -->
          <div class="space-y-2">
            <label for="agency-message" class="block text-sm font-medium text-[var(--ink)]">
              Project Brief <span class="text-[#B91C1C]" aria-hidden="true">*</span>
            </label>
            <textarea
              id="agency-message"
              name="message"
              rows="4"
              required
              placeholder="Outline your goals, core features, existing links or Figma, and any stack preferences..."
              class="w-full rounded-[12px] border border-[var(--border)] bg-[var(--surface)] px-4 py-3 text-base text-[var(--ink)] placeholder:text-[#64748B] focus:border-[var(--blue-600)] focus:ring-2 focus:ring-[#2563EB]/20 focus:outline-none transition-colors resize-y"
            ></textarea>
            <span class="agency-error text-xs font-mono text-[#B91C1C] hidden" id="err-message">
              Please provide a brief project description.
            </span>
          </div>

          <!-- Submit Button -->
          <div class="pt-2">
            <button
              type="submit"
              id="agency-submit-btn"
              class="ns-btn-primary w-full py-4 px-6 text-base cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
            >
              <span id="agency-submit-text">Send Project Inquiry</span>
              <span id="agency-submit-icon" class="ns-arrow" aria-hidden="true">→</span>
            </button>
          </div>

          <!-- Live Status Feedback -->
          <div id="agency-form-status" class="hidden p-4 rounded-[12px] text-sm font-mono font-medium" role="status"></div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const setupAgencyContactForm = () => {
    const copyBtn = document.getElementById("agency-copy-email-btn");
    const copyText = document.getElementById("agency-copy-email-text");
    if (copyBtn && copyText && !copyBtn.dataset.bound) {
      copyBtn.dataset.bound = "true";
      copyBtn.addEventListener("click", async () => {
        const email = copyBtn.getAttribute("data-email") || "tanujp09@gmail.com";
        try {
          await navigator.clipboard.writeText(email);
          copyText.textContent = "Copied ✓";
          setTimeout(() => {
            copyText.textContent = "Copy";
          }, 2000);
        } catch {
          window.location.href = `mailto:${email}`;
        }
      });
    }

    const form = document.getElementById("agencyContactForm") as HTMLFormElement | null;
    const submitBtn = document.getElementById("agency-submit-btn") as HTMLButtonElement | null;
    const submitText = document.getElementById("agency-submit-text");
    const statusBox = document.getElementById("agency-form-status");

    if (!form || !submitBtn || form.dataset.bound === "true") return;
    form.dataset.bound = "true";

    const fields = [
      { id: "agency-name", errId: "err-name", validate: (v: string) => v.trim().length > 1 },
      { id: "agency-email", errId: "err-email", validate: (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim()) },
      { id: "agency-service", errId: "err-service", validate: (v: string) => v.trim().length > 0 },
      { id: "agency-budget", errId: "err-budget", validate: (v: string) => v.trim().length > 0 },
      { id: "agency-timeline", errId: "err-timeline", validate: (v: string) => v.trim().length > 0 },
      { id: "agency-message", errId: "err-message", validate: (v: string) => v.trim().length > 8 },
    ];

    fields.forEach(({ id, errId }) => {
      const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
      const err = document.getElementById(errId);
      if (!el || !err) return;

      const clear = () => err.classList.add("hidden");
      el.addEventListener("input", clear);
      el.addEventListener("change", clear);
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      let hasError = false;
      fields.forEach(({ id, errId, validate }) => {
        const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
        const err = document.getElementById(errId);
        if (!el || !err) return;

        if (!validate(el.value)) {
          err.classList.remove("hidden");
          hasError = true;
        } else {
          err.classList.add("hidden");
        }
      });

      if (hasError) {
        if (statusBox) {
          statusBox.className = "p-4 rounded-[12px] text-sm font-mono font-medium bg-[#FEF2F2] text-[#991B1B] border border-[#FECACA]";
          statusBox.textContent = "Please fill in all required fields accurately before submitting.";
          statusBox.classList.remove("hidden");
        }
        return;
      }

      submitBtn.disabled = true;
      if (submitText) submitText.textContent = "Sending Inquiry...";
      if (statusBox) statusBox.classList.add("hidden");

      try {
        const formData = new FormData(form);
        const res = await fetch("/api/contact", {
          method: "POST",
          body: formData,
        });

        const data = await res.json().catch(() => ({}));

        if (res.ok) {
          form.reset();
          if (statusBox) {
            statusBox.className = "p-4 rounded-[12px] text-sm font-mono font-medium bg-[#EFF6FF] text-[#1D4ED8] border border-[#BFDBFE]";
            statusBox.textContent = data.message || "Thank you! Your project inquiry has been received. Tanuj will reply within 24 hours.";
            statusBox.classList.remove("hidden");
          }
          if (submitText) submitText.textContent = "Inquiry Sent ✓";
        } else {
          throw new Error(data.message || "Failed to submit inquiry.");
        }
      } catch (err: any) {
        if (statusBox) {
          statusBox.className = "p-4 rounded-[12px] text-sm font-mono font-medium bg-[#FEF2F2] text-[#991B1B] border border-[#FECACA]";
          statusBox.textContent = err.message || "An error occurred while submitting. Please email tanujp09@gmail.com directly.";
          statusBox.classList.remove("hidden");
        }
        if (submitText) submitText.textContent = "Send Project Inquiry";
      } finally {
        submitBtn.disabled = false;
      }
    });
  };

  setupAgencyContactForm();
  document.addEventListener("astro:page-load", setupAgencyContactForm);
</script>
