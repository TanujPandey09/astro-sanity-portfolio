---
import { urlForImage } from "../BlogLayout/urlforImage";

const node = Astro.props.node || {};
const { asset, alt } = node;

let url = "";
let webpUrl = "";

if (asset) {
  try {
    if (typeof asset.url === "string" && !asset._ref && !asset._id) {
      url = `${asset.url}${asset.url.includes("?") ? "&" : "?"}auto=format&q=80`;
      webpUrl = `${asset.url}${asset.url.includes("?") ? "&" : "?"}fm=webp&q=80`;
    } else {
      url = urlForImage(asset).auto("format").quality(80).url();
      webpUrl = urlForImage(asset).format("webp").quality(80).url();
    }
  } catch {
    url = asset?.url || "";
    webpUrl = asset?.url || "";
  }
}
---

{url && (
  <picture>
    <source srcset={webpUrl} type="image/webp" />
    <img
      class="responsive__img rounded-2xl w-full h-auto object-cover my-6 border border-white/[0.08]"
      src={url}
      alt={alt || "Article content illustration"}
      loading="lazy"
      decoding="async"
    />
  </picture>
)}
