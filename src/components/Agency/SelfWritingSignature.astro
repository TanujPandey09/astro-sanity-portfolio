---
// Refined Executive Founder Signature ("Tanuj Pandey")
// Uses authentic Great Vibes calligraphy + subtle GSAP left-to-right ink write & blue underline flourish
interface Props {
  strokeColor?: string;
  className?: string;
  showBadge?: boolean;
}

const {
  strokeColor = "#0B111A",
  className = "",
  showBadge = false,
} = Astro.props;
---

<div
  class={`self-writing-signature-container inline-flex flex-col items-start select-none group cursor-pointer ${className}`}
  title="Click to replay signature"
>
  <div class="relative inline-block pr-2">
    <span
      class="sig-wordmark block leading-[1.1] tracking-[0.01em] whitespace-nowrap"
      style={`font-family: 'Great Vibes', cursive; font-size: 40px; color: ${strokeColor}; transform: rotate(-2deg);`}
      aria-label="Signature of Tanuj Pandey"
    >
      Tanuj Pandey
    </span>

    <!-- Clean Tapered Ink Underline Flourish (#2563EB) -->
    <svg
      viewBox="0 0 220 14"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="w-full h-3 -mt-1.5 overflow-visible"
      aria-hidden="true"
    >
      <path
        d="M 4 9 C 58 4, 146 2, 214 6"
        stroke="#2563EB"
        stroke-width="1.8"
        stroke-linecap="round"
        class="sig-underline-path"
        pathLength="1"
      />
    </svg>
  </div>

  {showBadge && (
    <span class="text-[11px] font-mono text-[var(--muted)] mt-1 tracking-[0.08em] uppercase">
      Founder Signature
    </span>
  )}
</div>

<style>
  .sig-wordmark {
    will-change: clip-path;
  }

  .sig-underline-path {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initFounderSignatureGSAP() {
    const containers = Array.from(
      document.querySelectorAll<HTMLElement>(".self-writing-signature-container")
    );
    if (!containers.length) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    containers.forEach((container, idx) => {
      const wordmark = container.querySelector<HTMLElement>(".sig-wordmark");
      const underline = container.querySelector<SVGPathElement>(".sig-underline-path");
      if (!wordmark || !underline) return;

      const playWrite = () => {
        if (reduceMotion) {
          gsap.set(wordmark, { clipPath: "inset(0 0% 0 0)" });
          gsap.set(underline, { strokeDashoffset: 0 });
          return;
        }
        const tl = gsap.timeline();
        tl.fromTo(
          wordmark,
          { clipPath: "inset(0 100% 0 0)" },
          { clipPath: "inset(0 0% 0 0)", duration: 1.05, ease: "power2.inOut" }
        ).fromTo(
          underline,
          { strokeDashoffset: 1 },
          { strokeDashoffset: 0, duration: 0.55, ease: "power2.out" },
          "-=0.25"
        );
      };

      if (!reduceMotion) {
        ScrollTrigger.getById(`agency-sig-${idx}`)?.kill();
        ScrollTrigger.create({
          id: `agency-sig-${idx}`,
          trigger: container,
          start: "top 90%",
          once: true,
          onEnter: playWrite,
        });
      }

      if (!container.dataset.sigBound) {
        container.dataset.sigBound = "true";
        container.addEventListener("click", playWrite);
      }
    });
  }

  initFounderSignatureGSAP();
  document.addEventListener("astro:page-load", initFounderSignatureGSAP);
  document.addEventListener("astro:after-swap", initFounderSignatureGSAP);
</script>
