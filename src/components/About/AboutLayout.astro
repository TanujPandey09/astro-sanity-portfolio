---
const { aboutData } = Astro.props;
import { PortableText } from "astro-portabletext";
import SectionHeader from "../SectionHeader.astro";
import PremiumBackground from "../PremiumBackground.astro";
import PortfolioThreadsCanvas from "../Effects/PortfolioThreadsCanvas.astro";
import { optimizePortraitImage } from "../../lib/optimizeImage";

const aboutPortraitUrl = optimizePortraitImage(aboutData?.[0]?.heroImage?.asset?.url, "about");

const chapters = [
  {
    num: "01",
    year: "2021 — 2022",
    title: "Frontend Foundations",
    subtitle: "Component Systems & Core Web Vitals",
    company: "Scube.co & Techmatys",
    desc: "Built responsive React and Next.js applications, cutting page load times by 50% through code-splitting, asset optimization, and standardizing reusable UI libraries across enterprise dashboards.",
    statNum: "+50% Speed",
    statLabel: "Core Web Vitals",
    kpi: "2 Enterprise UI Libraries Shipped",
    tags: ["React.js", "Next.js", "TypeScript", "Tailwind CSS", "Redux Toolkit"]
  },
  {
    num: "02",
    year: "2022 — 2023",
    title: "Solo SaaS Ownership",
    subtitle: "Multi-Role Healthcare Platforms",
    company: "Nasya IT",
    desc: "Owned the entire frontend architecture at Nasya IT across Super Admin, Doctor, Patient, and Clinic portals, shipping 10+ CRUD modules, role-based workflows, and real-time medical scheduling.",
    statNum: "10+ Modules",
    statLabel: "Zero-to-One Delivery",
    kpi: "4 Portals Shipped Single-Handedly",
    tags: ["Next.js 14", "Zustand", "REST APIs", "Role-Based Auth", "Charts.js"]
  },
  {
    num: "03",
    year: "2023 — 2025",
    title: "Multi-LLM & AI Engineering",
    subtitle: "RAG, Validation & Bilingual RTL UX",
    company: "Cxisuite",
    desc: "Engineered Sawt AI with multi-LLM orchestration across OpenAI, Gemini, Claude, and Perplexity, automated structured validation, contextual RAG retrieval, Arabic/English RTL interfaces, and billing.",
    statNum: "4 LLM Engines",
    statLabel: "Production AI Workflows",
    kpi: "Sub-Second TTFT & Zero Fallback Drift",
    tags: ["Multi-LLM", "Prompt Engineering", "Contextual RAG", "RTL / i18n", "Stripe / MyFatoorah"]
  },
  {
    num: "04",
    year: "2025 — Present",
    title: "Real-Time Full-Stack Systems",
    subtitle: "Socket.IO CRMs & Scalable APIs",
    company: "Enterprise Solutions",
    desc: "Architected event-driven Node.js and PostgreSQL backends with Socket.IO live state synchronization, SLA monitoring, database indexing, rate limiting, and automated webhook idempotency.",
    statNum: "<50ms Sync",
    statLabel: "Real-Time State",
    kpi: "Zero State Drift & 99.9% Production Uptime",
    tags: ["Node.js / Express", "Socket.IO", "PostgreSQL", "Prisma ORM", "Redis"]
  }
];
---

<div class="relative min-h-screen selection:bg-accent-primary/30 overflow-x-clip bg-canvas">
  <PremiumBackground />

  <!-- ACT 1: OBSIDIAN DARK HERO + LINEAR INDIGO DOT GRID & THREADS + TALL 3D PORTRAIT -->
  <section class="relative w-full overflow-x-clip bg-[#0A0B0E] text-white pt-24 sm:pt-28 md:pt-32 pb-16 sm:pb-20 border-b border-white/[0.08]">
    <PortfolioThreadsCanvas />

    <div class="relative z-10 mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="pb-8 border-b border-white/[0.08] flex flex-col md:flex-row md:items-end justify-between gap-4" data-gsap-hero="wordmark">
        <div>
          <span class="text-xs font-mono uppercase tracking-[0.2em] text-[#828FFF] block mb-2">ABOUT · TANUJ PANDEY</span>
          <h1 class="font-grotesk font-extrabold text-4xl sm:text-5xl md:text-6xl lg:text-[4.5rem] text-white tracking-[-0.045em] leading-[0.95] m-0">
            Engineering Background
          </h1>
        </div>
        <div class="flex items-center gap-2.5 text-xs font-mono text-slate-300 shrink-0 pb-1">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Available for Senior Roles &amp; Builds</span>
        </div>
      </div>

      <div class="pt-10 sm:pt-12 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        <!-- Left Tall Sticky 3D Portrait Card (Dominant Vertical Anchor) -->
        <div class="lg:col-span-5 lg:sticky lg:top-24 [perspective:1000px]" data-gsap-hero="portrait">
          <div
            id="about-portrait-tilt"
            class="relative w-full max-w-[460px] mx-auto lg:max-w-none h-[480px] sm:h-[560px] lg:h-[640px] rounded-[28px] overflow-hidden border border-white/15 hover:border-[#828FFF]/50 bg-gradient-to-b from-white/12 to-white/[0.02] p-2 shadow-2xl group transition-all duration-300 ease-out will-change-transform"
            style="transform-style: preserve-3d;"
          >
            <div class="relative w-full h-full rounded-[22px] overflow-hidden bg-slate-900">
              <img
                src={aboutPortraitUrl}
                alt="Tanuj Pandey - Full Stack Engineer"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                width="1000"
                height="1250"
                class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.03]"
              />
              <div
                id="about-portrait-sheen"
                class="pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
                style="background: radial-gradient(300px circle at var(--tilt-x, 50%) var(--tilt-y, 30%), rgba(130, 143, 255, 0.22), transparent 65%);"
              ></div>
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-transparent"></div>
              <div
                class="pointer-events-none absolute inset-x-4 bottom-4 flex items-center justify-between gap-2 px-3.5 py-2.5 rounded-xl bg-black/55 backdrop-blur-md border border-white/15 transition-transform duration-300"
                style="transform: translateZ(20px);"
              >
                <span class="text-[11px] font-mono uppercase tracking-[0.14em] text-white font-semibold">4+ Yrs Production</span>
                <span class="text-[11px] font-mono text-emerald-300 flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                  Remote Worldwide
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Compact Headline + Immediate CTAs First + Balanced Bio Prose -->
        <div class="lg:col-span-7 space-y-6 lg:py-2" data-gsap-hero="bio">
          <div class="space-y-3">
            <span class="font-mono text-xs text-[#828FFF] uppercase tracking-[0.16em] font-bold block">Engineering Philosophy</span>
            <h2 class="font-grotesk font-bold text-white tracking-tight leading-[1.2] text-xl sm:text-2xl md:text-[1.85rem] max-w-2xl">
              {aboutData?.[0]?.aboutName || "Shipping resilient software where backend architecture and frontend craft meet."}
            </h2>
          </div>

          <!-- Primary CTA Strip placed high for immediate conversion above the fold -->
          <div class="flex flex-wrap items-center gap-3 pt-1 pb-2 border-b border-white/[0.08]">
            <button
              type="button"
              data-open-contact
              data-contact-subject="Inquiry from About Page"
              class="magnetic-btn group inline-flex items-center gap-2.5 px-6 py-3 rounded-full bg-white text-[#0A0B0E] hover:bg-slate-200 font-grotesk font-bold text-xs uppercase tracking-wider transition-all cursor-pointer active:scale-95"
            >
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>Contact Tanuj Now</span>
              <span>↗</span>
            </button>

            <a
              href="https://wa.me/919557321978"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-emerald-500/15 border border-emerald-400/35 text-emerald-300 hover:bg-emerald-500/25 hover:text-white font-grotesk font-semibold text-xs uppercase tracking-wider transition-all"
            >
              <span>WhatsApp ↗</span>
            </a>

            <button
              id="about-resume-btn"
              type="button"
              aria-label="Download Resume PDF"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-white/[0.08] border border-white/15 hover:bg-white/15 text-white font-grotesk font-semibold text-xs uppercase tracking-wider transition-all cursor-pointer"
            >
              <span>Download Resume ↗</span>
            </button>
          </div>

          {aboutData?.[0]?.description ? (
            <div class="about-prose-dark max-w-2xl">
              <PortableText value={aboutData[0].description} />
            </div>
          ) : (
            <p class="text-slate-200 text-[15px] leading-[1.7] max-w-2xl">
              Full-Stack &amp; AI Engineer with 4+ years of commercial production experience building multi-LLM SaaS products, real-time Socket.IO CRM architectures, and 99+ Lighthouse Next.js web applications.
            </p>
          )}
        </div>
      </div>
    </div>
  </section>

  <main class="relative z-10">
    <!-- Stack & Snapshot Strip -->
    <section class="mx-auto w-full max-w-7xl px-4 md:px-6 lg:px-8 py-14 md:py-20 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 w-full items-stretch">

         <!-- Cell 3: Engineering Principles (Unique to About — zero overlap with Home #skills) -->
         <div class="bento-spotlight lg:col-span-6 rounded-2xl p-1.5 bg-white border border-black/[0.08] hover:border-accent-primary/40 transition-colors shadow-xs" data-aos="fade-up">
            <div class="bg-white p-5 sm:p-7 rounded-xl h-full flex flex-col justify-between">
               <div class="space-y-4 sm:space-y-5 w-full">
                  <span class="font-mono text-xs text-slate-600 font-bold block">Engineering Principles</span>
                  
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                     <div class="bg-slate-50 border border-black/[0.06] p-3.5 sm:p-4 rounded-xl flex items-center justify-between gap-3">
                        <div class="space-y-0.5">
                           <span class="text-[11px] font-mono text-slate-600">01 / Ownership</span>
                           <p class="text-xs font-bold text-[#0F172A]">Schema to Production Deploy</p>
                        </div>
                        <span class="w-2 h-2 rounded-full bg-accent-primary shrink-0"></span>
                     </div>

                     <div class="bg-slate-50 border border-black/[0.06] p-3.5 sm:p-4 rounded-xl flex items-center justify-between gap-3">
                        <div class="space-y-0.5">
                           <span class="text-[11px] font-mono text-slate-600">02 / Speed Budget</span>
                           <p class="text-xs font-bold text-[#0F172A]">99+ Lighthouse &amp; Sub-50ms Sync</p>
                        </div>
                        <span class="w-2 h-2 rounded-full bg-accent-primary shrink-0"></span>
                     </div>

                     <div class="bg-slate-50 border border-black/[0.06] p-3.5 sm:p-4 rounded-xl flex items-center justify-between gap-3">
                        <div class="space-y-0.5">
                           <span class="text-[11px] font-mono text-slate-600">03 / Reliability</span>
                           <p class="text-xs font-bold text-[#0F172A]">Zero-Drift Multi-LLM Pipelines</p>
                        </div>
                        <span class="w-2 h-2 rounded-full bg-accent-primary shrink-0"></span>
                     </div>

                     <div class="bg-slate-50 border border-black/[0.06] p-3.5 sm:p-4 rounded-xl flex items-center justify-between gap-3">
                        <div class="space-y-0.5">
                           <span class="text-[11px] font-mono text-slate-600">04 / Collaboration</span>
                           <p class="text-xs font-bold text-[#0F172A]">Weekly Staging &amp; Clean Docs</p>
                        </div>
                        <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
                     </div>
                  </div>
               </div>
            </div>
         </div>

         <!-- Cell 4: Verified Career Metrics & Resume (Bottom Right) -->
         <div class="bento-spotlight lg:col-span-6 rounded-2xl p-1.5 bg-white border border-black/[0.08] hover:border-accent-primary/40 transition-colors shadow-xs" data-aos="fade-up" data-aos-delay="80">
            <div class="bg-white p-5 sm:p-7 rounded-xl h-full flex flex-col justify-between">
               <div class="space-y-4 sm:space-y-5 w-full">
                  <span class="font-mono text-xs text-slate-600 font-bold block">Career Snapshot</span>
                  
                  <div class="grid grid-cols-3 gap-2 sm:gap-3.5 text-center">
                     <div class="bg-slate-50 border border-black/[0.06] p-3 sm:p-4 rounded-xl">
                        <p class="text-[10px] sm:text-[11px] font-mono text-slate-600 mb-1">Experience</p>
                        <p class="text-sm sm:text-lg md:text-xl text-[#0F172A] font-bold font-mono tabular-nums whitespace-nowrap">4+ Yrs</p>
                     </div>
                     <div class="bg-slate-50 border border-black/[0.06] p-3 sm:p-4 rounded-xl">
                        <p class="text-[10px] sm:text-[11px] font-mono text-slate-600 mb-1">Speed Gain</p>
                        <p class="text-sm sm:text-lg md:text-xl text-[#0F172A] font-bold font-mono tabular-nums whitespace-nowrap">+50%</p>
                     </div>
                     <div class="bg-slate-50 border border-black/[0.06] p-3 sm:p-4 rounded-xl">
                        <p class="text-[10px] sm:text-[11px] font-mono text-slate-600 mb-1">Delivery</p>
                        <p class="text-sm sm:text-lg md:text-xl text-[#0F172A] font-bold whitespace-nowrap">Full-Stack</p>
                     </div>
                  </div>
               </div>

               <div class="pt-4 sm:pt-5 border-t border-black/[0.08] mt-5 sm:mt-6 flex flex-col xs:flex-row sm:flex-row items-stretch sm:items-center justify-between gap-3 sm:gap-4">
                  <span class="text-xs font-mono text-slate-600 text-center sm:text-left">Ready for senior roles &amp; contracts</span>
                  <button 
                    type="button"
                    data-open-contact
                    data-contact-subject="Hiring / Collaboration Inquiry"
                    class="group inline-flex items-center justify-center gap-2.5 px-5 py-2.5 bg-[#0F172A] hover:bg-black text-white font-bold text-xs uppercase tracking-wider rounded-full transition-all duration-300 cursor-pointer shadow-sm"
                  >
                     <span>Message Tanuj</span>
                     <span>↗</span>
                  </button>
               </div>
            </div>
         </div>

      </div>
    </section>

    <!-- Career Progression: Sticky Stacking Cards Deck (Cards stack sequentially as you scroll) -->
    <section id="journey-timeline-section" class="relative py-20 md:py-28 bg-[#F4F5F8] border-y border-black/[0.08]">
      <div class="mx-auto w-full max-w-5xl px-4 md:px-6 lg:px-8">

        <!-- Section Intro + Quick Jump Pills -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 md:mb-16">
          <div>
            <span class="block text-xs font-mono uppercase tracking-[0.2em] text-accent-primary mb-2">
              // CAREER MILESTONES
            </span>
            <h2 class="font-grotesk font-extrabold text-3xl sm:text-5xl md:text-6xl text-[#0F172A] tracking-[-0.035em] leading-[0.98]">
              Career <span class="text-accent-primary">Progression</span>
            </h2>
            <p class="text-xs sm:text-sm md:text-base text-slate-600 mt-3 max-w-xl leading-relaxed">
              Four chapters of commercial engineering. Scroll smoothly as each milestone locks and stacks cleanly into place.
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-2 shrink-0">
            {chapters.map((ch) => (
              <a
                href={`#stack-card-${ch.num}`}
                class="px-3 py-1.5 rounded-full bg-white border border-black/[0.08] hover:border-accent-primary text-[11px] font-mono font-bold text-slate-700 hover:text-accent-primary transition-colors shadow-2xs"
              >
                CH {ch.num}
              </a>
            ))}
          </div>
        </div>

        <!-- Stacked Cards Vertical Runway -->
        <div class="career-stack-list relative space-y-8 sm:space-y-12 pb-8">
          {chapters.map((chapter, idx) => {
            const isFinal = idx === chapters.length - 1;
            const stickyTop = `calc(5.75rem + ${idx * 22}px)`;
            return (
              <div
                id={`stack-card-${chapter.num}`}
                class="career-stack-slot sticky scroll-mt-28"
                style={`top: ${stickyTop}; z-index: ${10 + idx};`}
                data-stack-card={idx}
              >
                <article
                  class={`career-stack-inner rounded-[28px] p-6 sm:p-8 md:p-10 transition-shadow duration-300 border ${
                    isFinal
                      ? 'bg-[#0A0B0E] text-white border-white/15 shadow-[0_28px_70px_rgba(10,11,14,0.38)]'
                      : 'bg-white text-[#0F172A] border-black/[0.09] shadow-[0_22px_60px_rgba(15,23,42,0.08)]'
                  }`}
                >
                  <!-- Top Stacked Tab Strip (Remains visible peeking above stacked cards) -->
                  <div class={`flex flex-wrap items-center justify-between gap-3 pb-5 mb-6 border-b ${isFinal ? 'border-white/10' : 'border-black/[0.08]'}`}>
                    <div class="flex flex-wrap items-center gap-2.5">
                      <span class={`text-xs font-mono px-3 py-1 rounded-full font-bold border ${
                        isFinal
                          ? 'bg-[#5E6AD2]/20 text-[#828FFF] border-[#5E6AD2]/40'
                          : 'bg-indigo-50 text-accent-primary border-indigo-500/20'
                      }`}>
                        CHAPTER {chapter.num}
                      </span>
                      <span class={`text-xs font-mono px-3 py-1 rounded-full border ${
                        isFinal
                          ? 'bg-white/[0.06] text-slate-300 border-white/15'
                          : 'bg-slate-100 text-slate-600 border-black/[0.08]'
                      }`}>
                        {chapter.year}
                      </span>
                      <span class={`text-xs font-mono uppercase tracking-[0.06em] font-semibold ${isFinal ? 'text-slate-300' : 'text-slate-700'}`}>
                        · {chapter.company}
                      </span>
                    </div>

                    <span class={`text-3xl sm:text-4xl font-extrabold font-grotesk tracking-tighter select-none ${isFinal ? 'text-white/15' : 'text-black/[0.07]'}`}>
                      {chapter.num}
                    </span>
                  </div>

                  <!-- Main Card Content Grid -->
                  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-start">
                    <div class="lg:col-span-8 space-y-3">
                      <h3 class={`text-2xl sm:text-3xl md:text-[2.1rem] font-bold font-grotesk tracking-tight leading-tight ${isFinal ? 'text-white' : 'text-[#0F172A]'}`}>
                        {chapter.title}
                      </h3>
                      <p class={`text-xs sm:text-sm font-mono font-semibold ${isFinal ? 'text-[#828FFF]' : 'text-accent-primary'}`}>
                        {chapter.subtitle}
                      </p>
                      <p class={`text-sm sm:text-base leading-relaxed pt-1 ${isFinal ? 'text-slate-300' : 'text-slate-600'}`}>
                        {chapter.desc}
                      </p>

                      <!-- Tech Stack Pills -->
                      <div class="flex flex-wrap gap-2 pt-3">
                        {chapter.tags.map((t: string) => (
                          <span class={`text-[11px] font-mono uppercase tracking-wider px-2.5 py-1 rounded-md border ${
                            isFinal
                              ? 'bg-white/[0.06] border-white/15 text-slate-200'
                              : 'bg-slate-50 border-black/[0.08] text-slate-700'
                          }`}>
                            {t}
                          </span>
                        ))}
                      </div>
                    </div>

                    <!-- Right Proof Tile -->
                    <div class={`lg:col-span-4 rounded-2xl p-5 border flex flex-col justify-between gap-4 ${
                      isFinal
                        ? 'bg-white/[0.04] border-white/10'
                        : 'bg-slate-50/90 border-black/[0.07]'
                    }`}>
                      <div>
                        <span class={`text-[10px] font-mono uppercase tracking-wider block mb-1 ${isFinal ? 'text-slate-300' : 'text-slate-600'}`}>
                          {chapter.statLabel}
                        </span>
                        <span class={`font-grotesk font-extrabold text-2xl sm:text-3xl tracking-tight tabular-nums ${isFinal ? 'text-white' : 'text-[#0F172A]'}`}>
                          {chapter.statNum}
                        </span>
                      </div>

                      <div class={`pt-3 border-t flex items-start gap-2 text-xs font-mono ${isFinal ? 'border-white/10 text-slate-300' : 'border-black/[0.07] text-slate-700'}`}>
                        <span class="w-2 h-2 rounded-full bg-[#10B981] shrink-0 mt-1"></span>
                        <span>{chapter.kpi}</span>
                      </div>
                    </div>
                  </div>
                </article>
              </div>
            );
          })}
        </div>

      </div>
    </section>

    <!-- Academic Background -->
    <section class="mx-auto w-full max-w-7xl px-4 md:px-6 lg:px-8 py-20 md:py-28 relative z-10">
       <div class="max-w-4xl mx-auto">
          <div class="mb-10">
             <h2 class="text-2xl md:text-3xl font-bold text-[#0F172A] tracking-tight">Education</h2>
             <p class="text-xs sm:text-sm text-slate-600 mt-1">Academic foundation in computer science and software engineering.</p>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
             <div class="bento-spotlight rounded-2xl p-1.5 bg-white border border-black/[0.08] hover:border-accent-primary/40 transition-colors shadow-xs">
                <div class="bg-white p-6 rounded-xl h-full flex flex-col justify-between">
                   <div>
                      <span class="font-mono text-xs text-accent-primary bg-indigo-50 border border-indigo-500/20 px-2.5 py-1 rounded-md inline-block mb-3 tabular-nums font-semibold">2018 - 2020</span>
                      <h3 class="text-lg font-bold text-[#0F172A] tracking-tight">Master of Computer Applications (MCA)</h3>
                   </div>
                   <p class="text-slate-600 font-mono text-xs mt-4 pt-3 border-t border-black/[0.08]">GBPEC Pauri Garhwal</p>
                </div>
             </div>

             <div class="bento-spotlight rounded-2xl p-1.5 bg-white border border-black/[0.08] hover:border-accent-primary/40 transition-colors shadow-xs">
                <div class="bg-white p-6 rounded-xl h-full flex flex-col justify-between">
                   <div>
                      <span class="font-mono text-xs text-slate-700 bg-slate-100 border border-black/[0.08] px-2.5 py-1 rounded-md inline-block mb-3 tabular-nums font-semibold">2015 - 2018</span>
                      <h3 class="text-lg font-bold text-[#0F172A] tracking-tight">Bachelor of Computer Applications (BCA)</h3>
                   </div>
                   <p class="text-slate-600 font-mono text-xs mt-4 pt-3 border-t border-black/[0.08]">BFIT Dehradun</p>
                </div>
             </div>
          </div>
       </div>
    </section>
  </main>

  <!-- Direct Conversion & Explore Next Section (Replaces Duplicate Skills Block) -->
  <section class="relative z-20 mx-auto w-full max-w-7xl px-4 md:px-6 lg:px-8 pb-20 md:pb-28">
    <div class="rounded-[28px] bg-[#0A0B0E] text-white p-8 sm:p-10 md:p-12 border border-white/10 shadow-2xl flex flex-col lg:flex-row lg:items-center justify-between gap-8">
      <div class="space-y-3 max-w-2xl">
        <span class="text-xs font-mono uppercase tracking-[0.18em] text-[#828FFF] font-semibold block">NEXT STEPS · BUILD TOGETHER</span>
        <h2 class="font-grotesk font-extrabold text-2xl sm:text-3xl md:text-4xl text-white tracking-tight">
          Want to see the full tech matrix or shipped case studies?
        </h2>
        <p class="text-sm sm:text-base text-slate-200 leading-relaxed">
          Explore production case studies, browse commercial Next.js templates, or message me directly to scope your product.
