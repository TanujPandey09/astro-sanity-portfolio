---
// Arshawn Arbabi Inspired Footer: Obsidian Canvas + Monogram + "Get in touch" CTA + Bleeding Monumental Wordmark
const currentYear = new Date().getFullYear();

const colOne = [
  { label: "WORKS", href: "/projects" },
  { label: "AGENCY", href: "/agency" },
  { label: "SERVICES", href: "/#services" },
  { label: "TEMPLATES", href: "/templates" },
];

const colTwo = [
  { label: "ABOUT", href: "/about" },
  { label: "BLOG", href: "/blogs" },
  { label: "PROCESS", href: "/#process" },
  { label: "CONTACT", href: "/#contact" },
];
---

<footer class="relative pt-16 sm:pt-24 md:pt-32 pb-8 border-t border-white/10 bg-[#0A0B0E] text-white overflow-hidden">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- 1. TOP STATUS & CTA STRIP (Arshawn Arbabi Style) -->
    <div class="pb-12 sm:pb-16 border-b border-white/10 flex flex-col md:flex-row md:items-center justify-between gap-8">
      <!-- Left: Monogram & Bio Indicator -->
      <div class="space-y-3">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-white/10 border border-white/15 flex items-center justify-center font-grotesk font-black text-lg text-white">
            TP<span class="text-accent-primary">.</span>
          </div>
          <div>
            <span class="font-grotesk font-bold text-base text-white block">Tanuj Pandey</span>
            <span class="text-xs font-mono text-slate-300">Full-Stack Architect &amp; AI Engineer</span>
          </div>
        </div>
        <p class="text-xs sm:text-sm text-slate-300 max-w-md font-sans">
          Building scalable full-stack applications, multi-LLM orchestration pipelines, and high-performance digital products.
        </p>
      </div>

      <!-- Right: Availability & Action Button -->
      <div class="flex flex-col sm:flex-row sm:items-center gap-4">
        <div class="text-left sm:text-right">
          <span class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-emerald-400">
            <span class="w-2 h-2 rounded-full bg-[#10B981] animate-pulse"></span>
            TAKING ON SELECT PROJECTS
          </span>
          <span class="block text-xs font-mono text-slate-300 mt-0.5">India &amp; Worldwide · Remote</span>
        </div>

        <a
          href="/#contact"
          data-open-contact
          class="magnetic-btn group inline-flex items-center justify-center gap-2.5 px-7 py-3 rounded-full bg-white text-[#0A0B0E] font-grotesk font-bold text-xs uppercase tracking-wider hover:bg-slate-200 transition-all duration-300 shadow-lg active:scale-95"
        >
          <span>Get In Touch</span>
          <span class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 font-bold">↗</span>
        </a>
      </div>
    </div>

    <!-- 2. DIRECTORY NAVIGATION ROW -->
    <div class="py-12 sm:py-16 grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-12 gap-8 border-b border-white/10">
      <div class="lg:col-span-4 space-y-2">
        <span class="text-xs font-mono uppercase tracking-[0.16em] text-slate-300 block mb-3">NAVIGATION</span>
        <ul class="space-y-2.5">
          {colOne.map((link) => (
            <li>
              <a href={link.href} class="text-xs sm:text-sm font-grotesk font-medium uppercase tracking-[0.05em] text-slate-200 hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-4 space-y-2">
        <span class="text-xs font-mono uppercase tracking-[0.16em] text-slate-300 block mb-3">PAGES</span>
        <ul class="space-y-2.5">
          {colTwo.map((link) => (
            <li>
              <a href={link.href} class="text-xs sm:text-sm font-grotesk font-medium uppercase tracking-[0.05em] text-slate-200 hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="col-span-2 lg:col-span-4 space-y-2">
        <span class="text-xs font-mono uppercase tracking-[0.16em] text-slate-300 block mb-3">CONNECT</span>
        <ul class="space-y-2.5">
          <li>
            <a href="https://github.com/TanujPandey09" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-xs sm:text-sm font-grotesk font-medium uppercase tracking-[0.05em] text-slate-300 hover:text-white transition-colors">
              <span>GITHUB</span>
              <span class="text-accent-primary">↗</span>
            </a>
          </li>
          <li>
            <a href="https://linkedin.com/in/tanujdev" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-xs sm:text-sm font-grotesk font-medium uppercase tracking-[0.05em] text-slate-300 hover:text-white transition-colors">
              <span>LINKEDIN</span>
              <span class="text-accent-primary">↗</span>
            </a>
          </li>
          <li>
            <a href="mailto:tanujp09@gmail.com" class="inline-flex items-center gap-2 text-xs sm:text-sm font-grotesk font-medium uppercase tracking-[0.05em] text-slate-300 hover:text-white transition-colors">
              <span>EMAIL</span>
              <span class="text-accent-primary">↗</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- 3. FULL MONUMENTAL GRADIENT SIGNATURE TYPOGRAPHY -->
    <div class="relative py-10 sm:py-14 pointer-events-none select-none overflow-x-clip">
      <span class="footer-giant-wordmark block w-full font-grotesk font-black text-[clamp(2.2rem,9.6vw,7.75rem)] tracking-[-0.045em] leading-[1.02] text-center uppercase whitespace-nowrap bg-gradient-to-b from-white via-slate-200 to-[#5E6AD2]/45 bg-clip-text text-transparent">
        Tanuj Pandey
      </span>
    </div>

    <!-- 4. BOTTOM COPYRIGHT METADATA STRIP -->
    <div class="pt-8 border-t border-white/[0.1] flex flex-col sm:flex-row justify-between items-center gap-4 text-[11px] font-mono uppercase tracking-[0.08em] text-slate-300">
      <span>&copy; {currentYear} TANUJ PANDEY. ALL RIGHTS RESERVED.</span>
      <span>[ ASTRO 5 · SANITY CMS · FULL-STACK ]</span>
    </div>

  </div>
</footer>
