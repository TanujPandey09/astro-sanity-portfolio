---
// NovaStack Founder Section: Editorial Spotlight (Obsidian Monochrome + Linear Indigo)
import SelfWritingSignature from "./SelfWritingSignature.astro";

interface Props {
  portraitUrl?: string;
}

const { portraitUrl = "" } = Astro.props;

const verifiedTechnologies = [
  "React 19",
  "Next.js 15",
  "TypeScript",
  "Node.js",
  "PostgreSQL",
  "AI / LLM APIs",
];
---

<section id="about" class="py-20 sm:py-28 bg-white text-[#09090B] border-b border-[#E4E4E7] relative overflow-hidden">
  
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2.5 text-[11px] font-mono font-semibold text-[#5E6AD2] uppercase tracking-[0.18em] mb-3">
        <span class="w-4 h-px bg-[#5E6AD2]"></span>
        <span>04 / The Founder</span>
        <span class="w-4 h-px bg-[#5E6AD2]"></span>
      </div>
      <h2 class="font-grotesk font-extrabold text-3xl sm:text-5xl text-[#09090B] tracking-[-0.035em] leading-[1.08]">
        Work Directly with the Engineer Shipping Your Code.
      </h2>
      <p class="text-sm sm:text-base text-[#52525B] mt-3 leading-relaxed font-sans max-w-xl mx-auto">
        No sales handoffs or junior subcontractors. Every architecture decision, line of code, and deployment is handled personally by Tanuj Pandey.
      </p>
    </div>

    <!-- Founder Spotlight Card -->
    <div class="agency-card rounded-2xl sm:rounded-3xl p-6 sm:p-10 lg:p-12 bg-[#F4F4F5] border border-[#E4E4E7] hover:border-[#5E6AD2]/40 transition-all duration-300 max-w-5xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">

        <!-- Left Column: Portrait & Signature (4 cols) -->
        <div class="lg:col-span-4 flex flex-col items-center text-center space-y-4">
          <div class="relative w-40 h-40 sm:w-44 sm:h-44 rounded-full overflow-hidden border border-[#D4D4D8] p-1 bg-white shadow-xs">
            <div class="w-full h-full rounded-full overflow-hidden bg-[#E4E4E7]">
              {portraitUrl ? (
                <img
                  src={portraitUrl}
                  alt="Tanuj Pandey — Founder & Full-Stack Developer"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover object-top"
                />
              ) : (
                <div class="w-full h-full flex flex-col items-center justify-center bg-[#09090B] text-white">
                  <span class="font-grotesk font-extrabold text-4xl text-[#A5AEF3]">TP</span>
                  <span class="text-[11px] font-mono text-[#A1A1AA] mt-1">Tanuj Pandey</span>
                </div>
              )}
            </div>
            <div class="absolute bottom-2 right-4 w-3.5 h-3.5 rounded-full bg-emerald-500 border-2 border-white"></div>
          </div>

          <div>
            <h3 class="font-grotesk font-extrabold text-2xl text-[#09090B] tracking-tight">
              Tanuj Pandey
            </h3>
            <p class="text-xs font-mono uppercase tracking-wider text-[#5E6AD2] font-bold mt-1">
              Founder &amp; Full-Stack Engineer
            </p>
            <p class="text-xs text-[#71717A] font-sans mt-0.5">
              NovaStack Studio · Remote Worldwide
            </p>

            <!-- Self-Writing Ink Signature -->
            <div class="mt-3 flex items-center justify-center">
              <SelfWritingSignature strokeColor="#09090B" className="w-44 sm:w-52 h-14" />
            </div>
          </div>

          <!-- Social Links -->
          <div class="flex items-center gap-3 text-xs font-mono pt-1">
            <a href="/" class="text-[#5E6AD2] hover:text-[#4E5AC2] font-semibold transition-colors">
              Portfolio ↗
            </a>
            <span class="text-[#D4D4D8]">·</span>
            <a href="https://github.com/TanujPandey09" target="_blank" rel="noopener noreferrer" class="text-[#52525B] hover:text-[#09090B] transition-colors">
              GitHub ↗
            </a>
            <span class="text-[#D4D4D8]">·</span>
            <a href="https://linkedin.com/in/tanujdev" target="_blank" rel="noopener noreferrer" class="text-[#52525B] hover:text-[#09090B] transition-colors">
              LinkedIn ↗
            </a>
          </div>
        </div>

        <!-- Right Column: Quote & Engineering Pillars (8 cols) -->
        <div class="lg:col-span-8 space-y-6">
          
          <div class="relative pl-5 border-l-2 border-[#5E6AD2]">
            <p class="font-grotesk font-medium text-lg sm:text-xl text-[#09090B] leading-relaxed">
              “I partner directly with founders and product teams to turn complex specifications into fast, maintainable web applications, SaaS platforms, and practical AI workflows.”
            </p>
            <footer class="mt-3 text-xs font-mono text-[#71717A]">
              — Tanuj Pandey, Founder of NovaStack Studio
            </footer>
          </div>

          <!-- 3 Focus Pillars -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="p-3.5 rounded-xl bg-white border border-[#E4E4E7]">
              <span class="text-[10px] font-mono uppercase tracking-wider text-[#5E6AD2] font-bold block mb-1">
                Frontend Systems
              </span>
              <p class="text-[11px] text-[#52525B] font-sans leading-relaxed">
                React 19, Next.js 15 App Router, Astro, and strict TypeScript interfaces.
              </p>
            </div>

            <div class="p-3.5 rounded-xl bg-white border border-[#E4E4E7]">
              <span class="text-[10px] font-mono uppercase tracking-wider text-[#5E6AD2] font-bold block mb-1">
                SaaS Architecture
              </span>
              <p class="text-[11px] text-[#52525B] font-sans leading-relaxed">
                Node.js APIs, PostgreSQL schemas, multi-tenant RBAC, and Stripe billing.
              </p>
            </div>

            <div class="p-3.5 rounded-xl bg-white border border-[#E4E4E7]">
              <span class="text-[10px] font-mono uppercase tracking-wider text-[#5E6AD2] font-bold block mb-1">
                Applied AI
              </span>
              <p class="text-[11px] text-[#52525B] font-sans leading-relaxed">
                Private RAG search, multi-model routing, and automated workflow agents.
              </p>
            </div>
          </div>

          <!-- Verified Tech Stack -->
          <div>
            <span class="text-[10px] font-mono uppercase tracking-wider text-[#71717A] font-semibold block mb-2">
              Core Production Stack
            </span>
            <div class="flex flex-wrap gap-2">
              {verifiedTechnologies.map((tech) => (
                <div class="flex items-center gap-1.5 px-3 py-1 rounded-lg bg-white border border-[#E4E4E7] text-xs font-mono font-medium text-[#09090B]">
                  <span class="text-[#5E6AD2] font-bold">✓</span>
                  <span>{tech}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="pt-1">
            <a
              href="#contact"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#09090B] hover:bg-[#5E6AD2] text-white font-grotesk font-bold text-xs uppercase tracking-wider transition-all"
            >
              <span>Work Directly with Tanuj</span>
              <span>→</span>
            </a>
          </div>

        </div>

      </div>
    </div>

  </div>
</section>
