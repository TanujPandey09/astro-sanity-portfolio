---
// Minimalist Technical Domain Ticker
const domains = [
  "Full-Stack Web Architecture",
  "Agentic AI & LLM Systems",
  "High-Performance React & Next.js",
  "Scalable Node & Express Services",
  "PostgreSQL & Relational Data",
  "Real-time WebSockets & Streaming",
  "Cloud & Container Infrastructure",
  "Production SaaS Engineering"
];
---

<div class="py-6 border-y border-border-subtle bg-black/20 backdrop-blur-sm overflow-hidden whitespace-nowrap group select-none relative z-10">
  <div class="ticker-track inline-flex animate-ticker items-center">
    <!-- Set 1 -->
    <div class="inline-flex items-center gap-6 px-4">
      {domains.map((item) => (
        <div class="inline-flex items-center gap-3 px-5 py-2 rounded-full bg-white/[0.03] border border-border-subtle hover:border-border-hover transition-colors">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-primary"></span>
          <span class="text-xs font-mono font-medium text-text-primary tracking-wide">{item}</span>
        </div>
      ))}
    </div>
    
    <!-- Set 2 for seamless loop -->
    <div class="inline-flex items-center gap-6 px-4">
      {domains.map((item) => (
        <div class="inline-flex items-center gap-3 px-5 py-2 rounded-full bg-white/[0.03] border border-border-subtle hover:border-border-hover transition-colors">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-primary"></span>
          <span class="text-xs font-mono font-medium text-text-primary tracking-wide">{item}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  @keyframes ticker {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .animate-ticker {
    animation: ticker 35s linear infinite;
  }
  .group:hover .animate-ticker {
    animation-play-state: paused;
  }
</style>
