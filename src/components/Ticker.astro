---
// Full-Bleed Domain Marquee & High-Contrast Impact Bento Strip
const domains = [
  "REACT.JS & NEXT.JS 15",
  "MULTI-LLM ORCHESTRATION",
  "NODE.JS & REAL-TIME SOCKETS",
  "TYPESCRIPT ARCHITECTURE",
  "POSTGRESQL & PRISMA ORM",
  "SANITY HEADLESS CMS",
  "PRODUCTION SAAS APIS",
  "99+ LIGHTHOUSE VITALS"
];

const metrics = [
  {
    num: "01",
    label: "Delivered Systems",
    value: "10",
    suffix: "+",
    desc: "Production SaaS modules shipped across multi-role portals & APIs.",
    dark: false,
  },
  {
    num: "02",
    label: "Speed Gain",
    value: "50",
    suffix: "%",
    desc: "Faster load times via code splitting, edge caching & bundle tuning.",
    dark: true,
  },
  {
    num: "03",
    label: "Core Web Vitals",
    value: "99",
    suffix: "+",
    desc: "Consistently scored across Next.js & Astro production storefronts.",
    dark: false,
  },
  {
    num: "04",
    label: "Experience",
    value: "4",
    suffix: "+ Yrs",
    desc: "Full-stack Next.js, Node.js, PostgreSQL & multi-LLM AI engineering.",
    dark: false,
  },
];
---

<!-- Full-Bleed Obsidian-Trimmed Domain Marquee -->
<div class="w-full py-3.5 border-y border-black/[0.08] bg-white overflow-hidden whitespace-nowrap group select-none relative z-10">
  <div class="ticker-track inline-flex animate-ticker items-center">
    <div class="inline-flex items-center gap-10 px-5">
      {domains.map((item) => (
        <div class="inline-flex items-center gap-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#5E6AD2]" aria-hidden="true"></span>
          <span class="text-xs font-mono font-semibold tracking-[0.12em] uppercase text-slate-700 group-hover:text-[#0F172A] transition-colors">{item}</span>
        </div>
      ))}
    </div>

    <div class="inline-flex items-center gap-10 px-5" aria-hidden="true">
      {domains.map((item) => (
        <div class="inline-flex items-center gap-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#5E6AD2]"></span>
          <span class="text-xs font-mono font-semibold tracking-[0.12em] uppercase text-slate-700 group-hover:text-[#0F172A] transition-colors">{item}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<!-- High-Contrast Impact Proof Section -->
<section aria-label="Impact Overview" class="w-full py-14 sm:py-16 lg:py-20 relative z-10 border-b border-black/[0.08] bg-[#FAFAFB]">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-8 sm:mb-10 flex flex-col lg:flex-row lg:items-end justify-between gap-4 lg:gap-10" data-gsap-heading>
      <div>
        <div class="flex items-center gap-2.5 mb-3">
          <span class="w-5 h-px bg-[#5E6AD2]" aria-hidden="true"></span>
          <span class="text-[11px] sm:text-xs font-mono font-semibold tracking-[0.14em] text-[#5E6AD2] uppercase">
            Proven Impact
          </span>
        </div>
        <h2 class="font-grotesk font-bold text-[#0F172A] text-3xl sm:text-4xl lg:text-[44px] leading-[1.08] tracking-[-0.03em] max-w-3xl">
          Engineered for measurable <span class="text-[#5E6AD2]">speed, scale &amp; reliability.</span>
        </h2>
      </div>

      <p class="max-w-md text-slate-600 text-sm sm:text-[15px] leading-[1.65] lg:text-right">
        Real production metrics across SaaS platforms, multi-LLM pipelines, and high-conversion web storefronts.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
      {metrics.map((m) => (
        <div
          data-gsap-card
          class={`relative overflow-hidden rounded-2xl p-6 flex flex-col justify-between transition-colors duration-200 ${
            m.dark
              ? "bg-[#0A0B0E] text-white border border-white/10 shadow-[0_16px_40px_-14px_rgba(10,11,14,0.35)]"
              : "bg-white text-[#0F172A] border border-black/[0.08] hover:border-[#5E6AD2]/45 shadow-xs"
          }`}
        >
          <div
            class={`absolute top-0 inset-x-0 h-[2px] ${m.dark ? "bg-[#828FFF]" : "bg-[#5E6AD2]/60"}`}
            aria-hidden="true"
          ></div>

          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class={`text-[11px] font-mono uppercase tracking-[0.12em] font-semibold ${m.dark ? "text-[#828FFF]" : "text-slate-500"}`}>
                {m.label}
              </span>
              <span class={`text-[11px] font-mono tabular-nums ${m.dark ? "text-slate-500" : "text-slate-400"}`}>
                {m.num}
              </span>
            </div>

            <div class={`font-grotesk font-bold text-4xl sm:text-[44px] leading-none tabular-nums tracking-[-0.03em] ${m.dark ? "text-white" : "text-[#0F172A]"}`}>
              <span data-counter={m.value} data-suffix={m.suffix}>{m.value}{m.suffix}</span>
            </div>
          </div>

          <p class={`text-xs sm:text-[13px] font-sans mt-4 leading-relaxed ${m.dark ? "text-slate-300" : "text-slate-600"}`}>
            {m.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
