---
const currentYear = new Date().getFullYear();
---

<footer class="relative py-10 md:py-10 border-t border-border-subtle bg-canvas overflow-hidden">
  <div class="mx-auto w-full max-w-7xl px-4 md:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-12 gap-8 md:gap-12 items-start">

      <div class="lg:col-span-6 space-y-4 md:space-y-5 text-center lg:text-left">
        <!-- Official Brand Logo -->
        <a href="/" aria-label="Tanuj Pandey - Home" class="inline-flex items-center group mb-1">
          <div class="relative w-10 h-10 md:w-11 md:h-11 rounded-xl flex items-center justify-center border border-white/10 bg-surface-elevated/60 group-hover:border-accent-primary/60 group-hover:bg-surface-elevated transition-all duration-300 overflow-hidden shadow-xl shadow-black/50">
             <img src="/favicon.svg" alt="Tanuj Pandey Logo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" width="44" height="44" />
          </div>
        </a>

        <div class="flex items-center gap-3 justify-center lg:justify-start">
          <div class="w-8 h-[1px] bg-accent-primary"></div>
          <span class="text-[10px] font-black uppercase tracking-[0.5em] text-accent-primary">Engineering</span>
        </div>
        <h2 class="text-3xl md:text-5xl font-black text-text-primary uppercase tracking-tighter leading-none">
          Building the Future <br />
          <span class="text-gradient">One Bit at a Time.</span>
        </h2>
        <p class="text-text-muted text-sm md:text-base max-w-md italic mx-auto lg:mx-0">
          "Building robust web applications and reliable software systems backed by modern, production-ready engineering practices."
        </p>
      </div>

      <div class="lg:col-span-6 grid grid-cols-2 md:grid-cols-3 gap-8 md:gap-12">
        <div class="space-y-4 md:space-y-5">
          <p class="text-[10px] font-black text-text-primary uppercase tracking-[0.4em]">Navigation</p>
          <ul class="space-y-2.5 md:space-y-3">
            <li>
              <a href="/projects" class="group inline-flex items-center gap-2.5 text-sm text-text-muted hover:text-white transition-all duration-300 py-1">
                <span class="w-1.5 h-1.5 rounded-full bg-white/20 group-hover:bg-accent-primary group-hover:scale-125 transition-all"></span>
                <span class="group-hover:translate-x-1 transition-transform duration-300">Portfolio</span>
              </a>
            </li>
            <li>
              <a href="/blogs" class="group inline-flex items-center gap-2.5 text-sm text-text-muted hover:text-white transition-all duration-300 py-1">
                <span class="w-1.5 h-1.5 rounded-full bg-white/20 group-hover:bg-accent-primary group-hover:scale-125 transition-all"></span>
                <span class="group-hover:translate-x-1 transition-transform duration-300">Blog</span>
              </a>
            </li>
            <li>
              <a href="/about" class="group inline-flex items-center gap-2.5 text-sm text-text-muted hover:text-white transition-all duration-300 py-1">
                <span class="w-1.5 h-1.5 rounded-full bg-white/20 group-hover:bg-accent-primary group-hover:scale-125 transition-all"></span>
                <span class="group-hover:translate-x-1 transition-transform duration-300">About</span>
              </a>
            </li>
          </ul>
        </div>

        <div class="space-y-4 md:space-y-5">
          <p class="text-[10px] font-black text-text-primary uppercase tracking-[0.4em]">Connect</p>
          <div class="flex flex-col gap-2.5">
            <a 
              href="https://github.com/TanujPandey09" 
              target="_blank" 
              rel="noopener noreferrer" 
              aria-label="GitHub Profile" 
              class="group px-3 py-2 rounded-xl bg-white/[0.02] border border-white/[0.06] hover:border-border-hover hover:bg-white/[0.06] text-sm text-text-muted hover:text-white transition-all duration-300 flex items-center justify-between"
            >
              <div class="flex items-center gap-2.5">
                <svg fill="currentColor" viewBox="0 0 24 24" class="w-4 h-4 group-hover:scale-110 transition-transform flex-shrink-0" aria-hidden="true">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
                <span>GitHub</span>
              </div>
              <span class="text-xs text-text-dim group-hover:text-accent-primary transition-colors">↗</span>
            </a>
            <a 
              href="https://linkedin.com/in/tanujdev" 
              target="_blank" 
              rel="noopener noreferrer" 
              aria-label="LinkedIn Profile" 
              class="group px-3 py-2 rounded-xl bg-white/[0.02] border border-white/[0.06] hover:border-border-hover hover:bg-white/[0.06] text-sm text-text-muted hover:text-white transition-all duration-300 flex items-center justify-between"
            >
              <div class="flex items-center gap-2.5">
                <svg fill="currentColor" viewBox="0 0 24 24" class="w-4 h-4 group-hover:scale-110 transition-transform" aria-hidden="true"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                <span>LinkedIn</span>
              </div>
              <span class="text-xs text-text-dim group-hover:text-accent-primary transition-colors">↗</span>
            </a>
            <a 
              href="mailto:tanujp09@gmail.com" 
              aria-label="Direct Email" 
              class="group px-3 py-2 rounded-xl bg-white/[0.02] border border-white/[0.06] hover:border-border-hover hover:bg-white/[0.06] text-sm text-text-muted hover:text-white transition-all duration-300 flex items-center justify-between"
            >
              <div class="flex items-center gap-2.5">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 group-hover:scale-110 transition-transform"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                <span>Email</span>
              </div>
              <span class="text-xs text-text-dim group-hover:text-accent-primary transition-colors">↗</span>
            </a>
          </div>
        </div>

        <div class="col-span-2 md:col-span-1 space-y-4 md:space-y-5">
          <p class="text-[10px] font-black text-text-primary uppercase tracking-[0.4em]">Location</p>
          <div class="space-y-1.5">
            <p class="text-sm text-text-muted hover:text-white transition-colors">tanujp09@gmail.com</p>
            <p class="text-sm text-text-muted">Pauri Garhwal, Uttarakhand, India</p>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-8 md:mt-12 pt-5 md:pt-6 border-t border-border-subtle flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="flex items-center gap-2.5 justify-center md:justify-start">
        <a href="/" aria-label="Tanuj Pandey - Home" class="w-5 h-5 rounded-md overflow-hidden border border-white/10 hover:border-accent-primary/60 transition-colors inline-flex items-center justify-center flex-shrink-0">
          <img src="/favicon.svg" alt="TP" class="w-full h-full object-cover" width="20" height="20" />
        </a>
        <span class="text-[11px] font-bold text-text-dim uppercase tracking-widest text-center md:text-left">
          &copy; {currentYear} Tanuj Pandey · All Rights Reserved
        </span>
      </div>
      <div class="flex items-center gap-4">
        <span class="text-[11px] font-mono font-medium text-white/30 uppercase tracking-[0.2em]">Experience: 4+ YOE</span>
        <div class="flex items-center gap-2 px-3 py-1 rounded-lg bg-status-live/10 border border-status-live/20">
          <div class="w-1.5 h-1.5 rounded-full bg-status-live animate-pulse shadow-[0_0_8px_rgba(16,185,129,0.5)]"></div>
          <span class="text-[11px] font-mono font-bold text-status-live uppercase tracking-wider">Available for Projects</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Background Accent -->
  <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-accent-primary/5 rounded-full blur-[120px] pointer-events-none"></div>
</footer>
