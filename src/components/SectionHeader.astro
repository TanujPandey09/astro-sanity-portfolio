---
interface Props {
  title: string;
  gradientText?: string;
  subtitle?: string;
  eyebrow?: string;
  center?: boolean;
}

const { title, gradientText, subtitle, eyebrow, center = false } = Astro.props;
---

<div class={`mb-8 md:mb-14 ${center ? 'text-center' : ''}`} data-aos="fade-up">
  {eyebrow && (
    <div class={`inline-flex items-center gap-2 mb-3 ${center ? 'justify-center' : ''}`}>
      <span class="w-1.5 h-1.5 rounded-full bg-accent-primary"></span>
      <span class="text-[10px] font-mono font-semibold uppercase tracking-[0.25em] text-accent-primary">{eyebrow}</span>
    </div>
  )}
  
  <h2 class="text-text-primary font-extrabold tracking-[-0.03em] leading-[1.1] text-3xl sm:text-4xl md:text-5xl">
    {title} {gradientText && <span class="text-gradient">{gradientText}</span>}
  </h2>
  
  {subtitle && (
    <p class={`mt-4 max-w-2xl text-text-muted text-sm md:text-base font-normal leading-relaxed ${center ? 'mx-auto' : ''}`}>
      {subtitle}
    </p>
  )}
</div>
