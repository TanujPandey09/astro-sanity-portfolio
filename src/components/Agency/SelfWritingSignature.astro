---
// Self-Writing Ink Signature Component (Inspired by React Bits Pro Signature)
// SVG path with stroke-dasharray animation that dynamically writes "Tanuj Pandey" in ink
interface Props {
  strokeColor?: string;
  className?: string;
  showBadge?: boolean;
}

const {
  strokeColor = "#09090B",
  className = "w-44 sm:w-52 h-14 sm:h-16",
  showBadge = false,
} = Astro.props;
---

<div class="self-writing-signature-container inline-flex flex-col items-start select-none group cursor-pointer" title="Click to replay signature">
  <div class="relative">
    <svg
      viewBox="0 0 320 90"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class={`self-writing-signature-svg ${className}`}
      aria-label="Handwritten signature of Tanuj Pandey"
    >
      <!-- Subtle Paper Ink Shadow Effect -->
      <filter id="ink-bleed" x="-10%" y="-10%" width="120%" height="120%">
        <feDropShadow dx="0.5" dy="1" stdDeviation="0.8" flood-color="rgba(94, 106, 210, 0.14)" />
      </filter>

      <!-- Signature Path 1: "T" flourish & stem -->
      <path
        d="M 22 28 C 38 16 68 14 92 18 C 104 20 86 36 62 38 C 48 40 45 22 45 14 L 42 70 C 41 78 36 84 28 80 C 22 76 26 62 38 60"
        stroke={strokeColor}
        stroke-width="2.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="sig-path sig-stroke-1"
        pathLength="1"
      />

      <!-- Signature Path 2: "anuj" connected cursive body -->
      <path
        d="M 50 56 C 56 48 64 48 68 54 C 72 60 74 68 68 72 C 62 76 56 72 56 64 C 56 52 70 50 76 68 L 78 70 C 82 56 88 56 92 68 C 94 56 100 56 104 68 C 108 58 114 58 118 66 L 120 70 L 122 52 L 122 84 C 122 94 114 98 106 92 C 100 86 108 74 120 76"
        stroke={strokeColor}
        stroke-width="2.3"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="sig-path sig-stroke-2"
        pathLength="1"
      />

      <!-- Signature Path 3: "Pandey" capital P loop & connected text -->
      <path
        d="M 138 48 C 142 36 148 28 156 28 C 168 28 174 38 168 50 C 162 62 146 62 142 56 L 138 82 M 156 58 C 160 52 168 52 172 58 C 176 64 174 72 168 74 C 162 76 158 70 162 62 C 166 54 176 56 180 70 C 182 58 188 58 192 68 C 196 58 202 58 206 68 L 208 42 L 208 72 C 212 60 218 60 222 68 L 226 58 L 226 84 C 226 94 218 98 212 92 C 206 86 214 74 226 76"
        stroke={strokeColor}
        stroke-width="2.3"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="sig-path sig-stroke-3"
        pathLength="1"
      />

      <!-- Signature Path 4: Elegant Underline Ink Swash Flourish -->
      <path
        d="M 28 84 C 95 80 185 76 265 78 C 285 79 280 84 260 86 C 195 89 115 87 65 86"
        stroke="#5E6AD2"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="sig-path sig-stroke-4"
        pathLength="1"
      />

      <!-- Final Pen Tip Ink Dot -->
      <circle cx="272" cy="79" r="2.2" fill="#5E6AD2" class="sig-dot" />
    </svg>

    <!-- Subtle Replay Indicator Pill (Appears on Hover) -->
    <div class="absolute -bottom-2 right-0 opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none">
      <span class="inline-flex items-center gap-1 text-[9px] font-mono text-[#5E6AD2] bg-[#EEF0FB] border border-[#D5D9F5] px-2 py-0.5 rounded-full">
        <span>Replay ↻</span>
      </span>
    </div>
  </div>

  {showBadge && (
    <span class="text-[10px] font-mono text-[#64748B] mt-1 tracking-wider uppercase">
      Verified Founder Signature
    </span>
  )}
</div>

<style>
  /* 
   * Self-Writing Ink Stroke Animation
   * Uses SVG pathLength="1" so stroke-dashoffset: 1 is completely invisible
   * and stroke-dashoffset: 0 reveals the path as if written live by a pen
   */
  .sig-path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    will-change: stroke-dashoffset;
  }

  .sig-dot {
    opacity: 0;
    transform: scale(0);
    transform-origin: center;
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  /* When the container has class 'is-written', animate each stroke in sequence */
  .self-writing-signature-container.is-written .sig-stroke-1 {
    animation: writeInkStroke 0.65s cubic-bezier(0.4, 0, 0.2, 1) forwards 0.1s;
  }

  .self-writing-signature-container.is-written .sig-stroke-2 {
    animation: writeInkStroke 0.75s cubic-bezier(0.4, 0, 0.2, 1) forwards 0.65s;
  }

  .self-writing-signature-container.is-written .sig-stroke-3 {
    animation: writeInkStroke 0.85s cubic-bezier(0.4, 0, 0.2, 1) forwards 1.3s;
  }

  .self-writing-signature-container.is-written .sig-stroke-4 {
    animation: writeInkStroke 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) forwards 2.05s;
  }

  .self-writing-signature-container.is-written .sig-dot {
    opacity: 1;
    transform: scale(1);
    transition-delay: 2.65s;
  }

  @keyframes writeInkStroke {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Micro-Motion: Hover triggers a smooth pen shimmer */
  .self-writing-signature-container:hover .sig-path {
    filter: drop-shadow(0 0 1px rgba(37, 99, 235, 0.3));
  }
</style>

<script>
  // Re-playable Self-Writing Signature on Scroll / Click
  function initSignatureWriting() {
    const containers = document.querySelectorAll<HTMLElement>(".self-writing-signature-container");

    containers.forEach((container) => {
      if (container.hasAttribute("data-sig-bound")) return;
      container.setAttribute("data-sig-bound", "true");

      const replaySignature = () => {
        container.classList.remove("is-written");
        void container.offsetWidth; // Force CSS reflow
        container.classList.add("is-written");
      };

      // 1. Trigger when entering the viewport
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              container.classList.add("is-written");
            }
          });
        },
        { threshold: 0.3 }
      );
      observer.observe(container);

      // 2. Click to replay writing
      container.addEventListener("click", () => {
        replaySignature();
      });
    });
  }

  initSignatureWriting();
  document.addEventListener("astro:page-load", initSignatureWriting);
  document.addEventListener("astro:after-swap", initSignatureWriting);
</script>
