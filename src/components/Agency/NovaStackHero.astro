---
// NovaStack Studio Hero + Verified Proof Strip
// Left-aligned oversized H1 (word stagger) + Compact Founder Credibility Chip + 3 Layered Real Sanity Browser Frames + Real Proof Bar
import { optimizeSanityImage } from "../../lib/optimizeImage";
import HeroProductShowcase, {
  type HeroProductItem,
} from "./HeroProductShowcase";

interface Props {
  sanityProjects?: any[];
  founderPortraitUrl?: string;
}

const { sanityProjects = [], founderPortraitUrl = "" } = Astro.props;

const getImg = (doc: any): string =>
  doc?.BackgroundImage?.asset?.url ||
  doc?.FeatureImage?.asset?.url ||
  doc?.thumbnailImage?.asset?.url ||
  (Array.isArray(doc?.gallery) && doc.gallery[0]?.asset?.url) ||
  "";

const normalizeUrl = (val: any): string => {
  if (!val) return "";
  if (typeof val === "string") return val.trim();
  if (typeof val === "object") {
    const c = val.url || val.href || val.current || "";
    return typeof c === "string" ? c.trim() : "";
  }
  return "";
};

const toHeroItem = (doc: any): HeroProductItem | null => {
  const rawImg = getImg(doc);
  if (!rawImg) return null;
  const title = String(doc?.projectName || doc?.templateName || "").trim();
  if (!title) return null;

  const isTemplate = doc?._type === "templates" || Boolean(doc?.gumroadLink);
  const slug = typeof doc?.slug === "string" ? doc.slug : doc?.slug?.current || "";
  const detailUrl = slug ? `${isTemplate ? "/templates/" : "/projects/"}${slug}` : "/projects";
  const demoUrl = normalizeUrl(doc?.demoLink);
  const displayUrl = demoUrl
    ? demoUrl.replace(/^https?:\/\//, "").replace(/\/$/, "")
    : `tanujbuilds.site${detailUrl}`;
  const tag =
    String(doc?.agencyHeroTag || doc?.category || (Array.isArray(doc?.tags) ? doc.tags[0] : "") || "").trim() ||
    (isTemplate ? "Commercial Template" : "Production Software");

  return {
    title,
    tag,
    url: detailUrl || demoUrl || "/projects",
    displayUrl,
    imageUrl: optimizeSanityImage(rawImg, 1400, 92),
    isExternal: false,
  };
};

// Prioritize real verified products in Sanity: Sawt AI, Omnexia CRM, CxiSuite / Paperfloow
const preferredMatchers = ["sawt", "omenixa", "omnexia", "cxisuite", "paperfloow"];
const selectedDocs: any[] = [];
const seenIds = new Set<string>();

for (const matcher of preferredMatchers) {
  if (selectedDocs.length >= 3) break;
  const match = (sanityProjects || []).find((doc) => {
    const id = String(doc?._id || doc?.slug || "");
    if (seenIds.has(id) || !getImg(doc)) return false;
    const hay = `${doc?.projectName || ""} ${doc?.templateName || ""} ${doc?.slug || ""}`.toLowerCase();
    return hay.includes(matcher);
  });
  if (match) {
    seenIds.add(String(match?._id || match?.slug || ""));
    selectedDocs.push(match);
  }
}

for (const doc of sanityProjects || []) {
  if (selectedDocs.length >= 3) break;
  const id = String(doc?._id || doc?.slug || "");
  if (!seenIds.has(id) && getImg(doc)) {
    seenIds.add(id);
    selectedDocs.push(doc);
  }
}

const heroProducts: HeroProductItem[] = selectedDocs
  .map(toHeroItem)
  .filter((item): item is HeroProductItem => Boolean(item));

// Real project count from Sanity CMS (non-fabricated)
const realSanityProjectCount = (sanityProjects || []).filter(
  (doc) => Boolean(doc?.projectName || doc?.templateName) && Boolean(getImg(doc))
).length;

// Real technologies used across shipped projects (no fake client logos)
const builtWithStack = [
  "Next.js",
  "React",
  "TypeScript",
  "Astro",
  "Node.js",
  "PostgreSQL",
  "Sanity CMS",
  "OpenAI / Claude",
];

// Real verified proof facts already stated on this site + live Sanity project count
const verifiedProofFacts = [
  {
    value: "4+ Years",
    label: "Production Engineering",
    detail: "Shipping web apps, SaaS & AI systems",
  },
  ...(realSanityProjectCount > 0
    ? [
        {
          value: String(realSanityProjectCount).padStart(2, "0"),
          label: "Verified Builds",
          detail: "Published directly in Sanity CMS",
        },
      ]
    : []),
  {
    value: "2–6 Weeks",
    label: "Fixed-Scope Sprints",
    detail: "Milestone-gated staging releases",
  },
  {
    value: "< 24 Hours",
    label: "Founder Response",
    detail: "Written technical scope & estimate",
  },
];
---

<section
  id="hero"
  class="relative w-full bg-[var(--surface)] text-[var(--ink)] border-b border-[var(--border)] overflow-hidden"
>
  <!-- Single allowed subtle radial wash (< 8% opacity) behind hero -->
  <div
    class="pointer-events-none absolute inset-0"
    style="background: radial-gradient(ellipse 65% 55% at 74% 28%, rgba(37, 99, 235, 0.065), transparent 72%);"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 ns-container pt-12 pb-16 lg:pt-20 lg:pb-20">
    <!-- Asymmetric 12-Col Composition: No Blank Voids at 1440px -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <!-- Left Column (6 cols): Who, What, Proof, Action -->
      <div class="lg:col-span-6 space-y-6">
        <div class="ns-hero-enter inline-flex items-center gap-2.5" style="--hero-delay: 0ms;">
          <span class="ns-status-dot w-2 h-2 rounded-full bg-[var(--blue-600)]" aria-hidden="true"></span>
          <span class="ns-mono-label text-[var(--muted)] font-medium">
            NovaStack Studio · Independent Engineering
          </span>
        </div>

        <!-- Oversized Left-Aligned H1 (Instant SSR Paint + Subtle Stagger Rise) -->
        <h1 class="ns-hero-enter ns-h1 text-[var(--ink)] tracking-[-0.03em] font-semibold" style="--hero-delay: 55ms;">
          Engineering <span class="text-[var(--blue-600)]">Web, SaaS</span><br class="hidden sm:inline" />
          &amp; <span class="text-[var(--blue-600)]">AI Products</span><br class="hidden sm:inline" />
          Built to Ship.
        </h1>

        <!-- Concise 2-Line Subcopy (18px / 1.65 desktop, 16px mobile) -->
        <p class="ns-hero-enter ns-body max-w-[540px]" style="--hero-delay: 110ms;">
          Senior full-stack architecture for startups and digital agencies—fixed-scope sprints, clean TypeScript codebases, and 100% repository ownership.
        </p>

        <!-- Primary Filled Blue CTA + Secondary Text Link with Arrow -->
        <div class="ns-hero-enter flex flex-wrap items-center gap-6 pt-2" style="--hero-delay: 165ms;">
          <a href="#contact" class="ns-btn-primary px-6 py-3.5 text-base">
            <span>Start a Project</span>
            <span class="ns-arrow" aria-hidden="true">→</span>
          </a>

          <a
            href="#work"
            class="ns-link-arrow inline-flex items-center gap-2 text-base font-medium text-[var(--ink)] hover:text-[var(--blue-600)] transition-colors duration-150 py-2"
          >
            <span>Explore Selected Work</span>
            <span class="ns-arrow text-[var(--blue-600)]" aria-hidden="true">→</span>
          </a>
        </div>

        <!-- Compact Founder Credibility Chip (Real Avatar, Name, Role, Existing Fact) -->
        <div class="ns-hero-enter pt-3" style="--hero-delay: 220ms;">
          <a
            href="#about"
            class="group inline-flex items-center gap-3.5 p-2.5 pr-5 rounded-[16px] bg-[var(--bg)] border border-[var(--border)] hover:border-[var(--blue-600)] hover:-translate-y-0.5 transition-[transform,border-color,box-shadow] duration-200 hover:shadow-[0_10px_24px_-12px_rgba(11,17,26,0.14)]"
          >
            <div class="w-11 h-11 rounded-full overflow-hidden border border-[var(--border)] bg-[var(--surface)] shrink-0">
              {founderPortraitUrl ? (
                <img
                  src={founderPortraitUrl}
                  alt="Tanuj Pandey — Founder & Full-Stack Engineer"
                  loading="eager"
                  decoding="async"
                  class="w-full h-full object-cover object-top transition-transform duration-300 ease-out group-hover:scale-105"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center bg-[var(--ink)] text-white font-semibold text-xs">
                  TP
                </div>
              )}
            </div>
            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-semibold text-[15px] text-[var(--ink)] group-hover:text-[var(--blue-600)] transition-colors">
                  Tanuj Pandey
                </span>
                <span class="px-2.5 py-0.5 rounded-full bg-[var(--blue-50)] text-[var(--blue-700)] text-[11px] font-mono font-medium">
                  Founder &amp; Engineer
                </span>
              </div>
              <p class="text-[13px] font-mono text-[var(--muted)] mt-0.5">
                4+ yrs production experience · Remote Worldwide
              </p>
            </div>
          </a>
        </div>
      </div>

      <!-- Right Column (6 cols): 3 Layered Real Product Browser Frames -->
      <div class="lg:col-span-6 ns-hero-enter" style="--hero-delay: 140ms;">
        <HeroProductShowcase client:load products={heroProducts} />
      </div>
    </div>

    <!-- Quiet "Built With" Real Technology Strip (Zero Fake Client Logos) -->
    <div class="mt-14 pt-7 border-t border-[var(--border)] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <span class="ns-mono-label text-[var(--muted)] shrink-0">
        Built with
      </span>
      <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-[13px] font-mono text-[var(--muted)]">
        {builtWithStack.map((tech) => (
          <li class="inline-flex items-center gap-2">
            <span class="w-1 h-1 rounded-full bg-[var(--border)]" aria-hidden="true"></span>
            <span class="text-[var(--ink)] font-medium">{tech}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Verified Proof Strip (Only Existing Site Facts + Live Sanity Project Count) -->
  <div class="bg-[var(--bg)] border-t border-[var(--border)]">
    <div class="ns-container py-8 lg:py-10">
      <dl
        class={`grid grid-cols-2 gap-6 lg:gap-8 ${
          verifiedProofFacts.length === 4 ? "lg:grid-cols-4" : "lg:grid-cols-3"
        }`}
      >
        {verifiedProofFacts.map((fact) => (
          <div class="group pl-3.5 border-l-2 border-[var(--border)] hover:border-[var(--blue-600)] transition-colors duration-200 space-y-1">
            <dt class="ns-mono-label text-[var(--blue-600)] font-medium">
              {fact.label}
            </dt>
            <dd class="text-2xl sm:text-3xl font-semibold tracking-[-0.025em] text-[var(--ink)]">
              {fact.value}
            </dd>
            <p class="text-sm text-[var(--muted)] leading-snug">
              {fact.detail}
            </p>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
