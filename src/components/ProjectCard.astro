---
const { project, index } = Astro.props;
import { getCaseStudyBySlug } from "../lib/caseStudies";

const study = getCaseStudyBySlug(project?.slug?.current, project);
---

<div class="group relative bg-[#11172a] border border-white/5 rounded-[2rem] overflow-hidden hover:border-[#3B82F6]/30 transition-all duration-700 hover:-translate-y-2 hover:shadow-[0_20px_40px_-15px_rgba(59,130,246,0.2)]" data-aos="fade-up" data-aos-delay={index * 50}>
  <a href={`/projects/${project.slug.current}`} class="block aspect-[4/3] relative overflow-hidden">
    {study.imageUrl && (
      <img 
        src={study.imageUrl} 
        alt={study.projectName}
        class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-1000 group-hover:scale-110 group-hover:rotate-1"
      />
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-[#000105] via-[#000105]/20 to-transparent opacity-90 group-hover:opacity-60 transition-opacity duration-700"></div>
    
    <div class="absolute bottom-6 left-6 right-6 translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
       <div class="flex flex-wrap gap-2 mb-3 opacity-0 group-hover:opacity-100 transition-opacity">
          {study.technologies.slice(0, 2).map((tech) => (
            <span class="text-[7px] font-black uppercase tracking-widest px-2 py-1 bg-white/10 rounded-full text-white/60">{tech.name}</span>
          ))}
       </div>
       <h4 class="text-white uppercase tracking-tighter project-card-title font-sans">{study.projectName}</h4>
    </div>
  </a>
</div>

<style>
  .project-card-title {
    font-size: clamp(var(--h4-mobile), 1.5vw, var(--h4-desktop));
    font-weight: var(--fw-bold);
  }
</style>
