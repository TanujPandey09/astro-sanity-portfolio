    perspective: 1200px;
    transform-style: preserve-3d;
    transform: perspective(1200px) rotateX(6deg) rotateY(-4deg) rotateZ(1deg);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mockup-3d-stage:hover {
    transform: perspective(1200px) rotateX(1deg) rotateY(-0.5deg) rotateZ(0deg);
  }

  @media (max-width: 640px) {
    .mockup-3d-stage,
    .mockup-3d-stage:hover {
      transform: none;
    }
  }

  .service-item-wrapper {
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
</style>

<script>
  function initServicesNavigator() {
    const serviceItems = document.querySelectorAll<HTMLElement>("[data-service-item]");
    const mockupPanels = document.querySelectorAll<HTMLElement>("[data-mockup-panel]");

    if (!serviceItems.length || !mockupPanels.length) return;

    const activateService = (serviceId: string) => {
      serviceItems.forEach((item) => {
        const id = item.getAttribute("data-service-item") || "";
        const details = item.querySelector<HTMLElement>(".service-details-panel");
        const iconBadge = item.querySelector<HTMLElement>(".service-icon-badge");
        const numLabel = item.querySelector<HTMLElement>(".service-num-label");

        if (id === serviceId) {
          item.setAttribute("aria-selected", "true");
          item.classList.add("bg-white", "border-[#5E6AD2]/40", "p-4", "sm:p-5", "shadow-sm", "ring-1", "ring-[#5E6AD2]/15");
          item.classList.remove("p-3.5", "sm:p-4", "border-transparent", "hover:bg-white/75", "hover:border-[#E4E4E7]");
          if (details) details.classList.remove("hidden");
          if (iconBadge) {
            iconBadge.classList.add("bg-[#EEF0FB]", "text-[#5E6AD2]", "border-[#D5D9F5]");
            iconBadge.classList.remove("bg-white", "text-[#52525B]", "border-[#E4E4E7]");
          }
          if (numLabel) {
            numLabel.classList.add("text-[#5E6AD2]");
            numLabel.classList.remove("text-[#A1A1AA]");
          }
        } else {
          item.setAttribute("aria-selected", "false");
          item.classList.remove("bg-white", "border-[#5E6AD2]/40", "p-4", "sm:p-5", "shadow-sm", "ring-1", "ring-[#5E6AD2]/15");
          item.classList.add("p-3.5", "sm:p-4", "border-transparent", "hover:bg-white/75", "hover:border-[#E4E4E7]");
          if (details) details.classList.add("hidden");
          if (iconBadge) {
            iconBadge.classList.remove("bg-[#EEF0FB]", "text-[#5E6AD2]", "border-[#D5D9F5]");
            iconBadge.classList.add("bg-white", "text-[#52525B]", "border-[#E4E4E7]");
          }
          if (numLabel) {
            numLabel.classList.remove("text-[#5E6AD2]");
            numLabel.classList.add("text-[#A1A1AA]");
          }
        }
      });

      mockupPanels.forEach((panel) => {
        const panelId = panel.getAttribute("data-mockup-panel") || "";
        if (panelId === serviceId) {
          panel.classList.remove("hidden");
          panel.style.opacity = "0";
          panel.style.transform = "translateY(6px)";
          requestAnimationFrame(() => {
            panel.style.transition = "opacity 0.35s ease, transform 0.35s ease";
            panel.style.opacity = "1";
            panel.style.transform = "translateY(0)";
          });
        } else {
          panel.classList.add("hidden");
        }
      });
    };

    serviceItems.forEach((item) => {
      if (item.hasAttribute("data-service-bound")) return;
      item.setAttribute("data-service-bound", "true");

      item.addEventListener("click", () => {
        const id = item.getAttribute("data-service-item");
        if (id) activateService(id);
      });

      item.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          const id = item.getAttribute("data-service-item");
          if (id) activateService(id);
        }
      });
    });
  }

  initServicesNavigator();
  document.addEventListener("astro:page-load", initServicesNavigator);
  document.addEventListener("astro:after-swap", initServicesNavigator);
</script>
