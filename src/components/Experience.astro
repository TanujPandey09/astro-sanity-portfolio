  {
    role: "Full Stack Developer",
    company: "Cxisuite",
    duration: "Sep 2025 - Present",
    period: "2025 — Present",
    type: "Remote",
    badge: "Current Role",
    companyUrl: "https://cxisuite.com/",
    description: "Architected and delivered Sawt AI, an AI-driven qualitative survey SaaS platform featuring bidirectional RTL layouts. Integrated multi-provider LLM pipelines (GPT-4, Gemini Pro, Grok) with context-aware fallback heuristics. Built CareAI CRM using high-throughput Socket.IO event channels, and designed an enterprise CX Intelligence drag-and-drop survey engine.",
    metrics: ["Bilingual RTL Support", "3+ AI Reasoning Engines", "Real-time Event Pipelines", "Multi-Tenant CRM Architecture"],
    technologies: [
