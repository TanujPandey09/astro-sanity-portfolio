---
import { useSanityClient, groq } from "astro-sanity";
import ProjectItem from "./ProjectItem.astro";
import BlogItem from "./BlogItem.astro";
import AiChatbot from "./AiChatbot";
import PremiumBackground from "./PremiumBackground.astro";
import Hero from "./Hero.astro";
import Services from "./Services.astro";
import Skills from "./Skills.astro";
import Experience from "./Experience.astro";
import Process from "./Process.astro";
import Contact from "./Contact.astro";
import SectionHeader from "./SectionHeader.astro";
import ProjectCard from "./ProjectCard.astro";
import Ticker from "./Ticker.astro";
import TemplateCard from "./TemplateCard.astro";

import { fetchAllTemplates } from "../lib/templates";

const query = groq`*[_type == "projects" && !defined(gumroadLink) && !(slug.current in [
  "lumina-dental-premium-dental-website-template",
  "apex-luxury-ultra-luxury-real-estate-and-architectural-web-template"
])]{...,BackgroundImage{asset->{url}}}`;
const blogquery = groq`*[_type == "blogs"] | order(_createdAt desc) {...,FeatureImage{asset->{url}}}`;

const projectData = await useSanityClient().fetch(query);
const blogData = await useSanityClient().fetch(blogquery);
const templatesData = await fetchAllTemplates();
---

<div class="relative min-h-screen selection:bg-accent-primary/30">
  <PremiumBackground />

  <div class="mx-auto w-full max-w-7xl px-4 md:px-6 lg:px-8 relative z-10">
    <!-- Hero Experience -->
    <Hero />

    <Ticker />

    <!-- Projects Section (Featured Works Right Upfront) -->
    <section id="projects" class="py-16 md:py-24 relative z-10 border-t border-border-subtle">
      <div class="max-w-7xl mx-auto">
        <SectionHeader 
          eyebrow="Showcase // Portfolio"
          title="Featured" 
          gradientText="Projects" 
          subtitle="A selection of production-ready applications, AI integrations, and full-stack platforms."
        />
        
        <!-- Featured Deliveries (Bento Grid) -->
        <div class="mt-12 md:mt-16 grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
          {projectData?.slice(0, 4).map((project, index) => (
            <ProjectItem project={project} index={index} />
          ))}
        </div>
        
        {projectData?.length > 4 && (
          <div class="mt-16 md:mt-24">
            <div class="flex flex-col md:flex-row items-center justify-between mb-8 md:mb-12 px-4 gap-8">
               <div class="space-y-2 text-center md:text-left">
                  <p class="text-[11px] font-black text-accent-primary uppercase tracking-[0.4em] md:tracking-[0.5em]">Project Index</p>
                  <h3 class="text-2xl md:text-3xl font-black text-text-primary uppercase tracking-tighter">Additional Projects</h3>
               </div>
               <button 
                 id="expand-repo"
                 aria-label="Show all additional projects"
                 aria-expanded="false"
                 class="group flex items-center gap-4 text-[11px] font-black uppercase tracking-[0.3em] md:tracking-[0.4em] text-text-muted hover:text-accent-primary transition-colors"
               >
                 Show All Projects
                 <div class="w-10 h-10 rounded-full border border-border-subtle flex items-center justify-center group-hover:border-accent-primary transition-all">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" id="repo-icon" class="transition-transform duration-500"><path d="m6 9 6 6 6-6"/></svg>
                 </div>
               </button>
            </div>

            <div id="repo-grid" class="hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
               {projectData?.slice(4).map((project, index) => (
                 <ProjectCard project={project} index={index} />
               ))}
            </div>

            <div class="mt-10 md:mt-14 flex justify-center">
               <a href="/projects" class="group relative px-10 py-5 md:px-12 md:py-6 border border-border-subtle rounded-full text-[11px] font-black uppercase tracking-[0.4em] md:tracking-[0.5em] text-text-primary overflow-hidden transition-all duration-500 hover:border-accent-primary text-center shadow-ambient">
                  <span class="relative z-10">View Full Portfolio</span>
                  <div class="absolute inset-0 bg-accent-primary translate-y-full group-hover:translate-y-0 transition-transform duration-500"></div>
               </a>
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- High-Value Bento Services -->
    <Services />

    <!-- Experience Timeline -->
    <Experience />

    <!-- Technology Stack -->
    <Skills />

    <!-- Strategic Development Workflow -->
    <Process />

    <!-- Commercial Templates & Digital Products Section -->
    {templatesData && templatesData.length > 0 && (
      <section id="templates" class="py-16 md:py-24 relative z-10 border-t border-border-subtle">
        <div class="max-w-7xl mx-auto">
          <SectionHeader 
            eyebrow="Digital Products // Commercial Templates"
            title="Featured" 
            gradientText="Templates" 
            subtitle="Commercial-ready web templates and boilerplates engineered with React, Next.js, and TypeScript. Ready to deploy for client projects."
          />

          <div class="mt-12 md:mt-16 grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
            {templatesData.slice(0, 2).map((template, index) => (
              <TemplateCard template={template} index={index} />
            ))}
          </div>

          <div class="mt-12 md:mt-16 flex justify-center">
            <a 
              href="/templates" 
              class="group relative px-10 py-5 md:px-12 md:py-6 border border-border-subtle rounded-full text-[11px] font-black uppercase tracking-[0.4em] md:tracking-[0.5em] text-text-primary overflow-hidden transition-all duration-500 hover:border-accent-primary text-center shadow-ambient"
            >
              <span class="relative z-10">Explore All Templates</span>
              <div class="absolute inset-0 bg-accent-primary translate-y-full group-hover:translate-y-0 transition-transform duration-500"></div>
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- Blogs Section -->
    <section id="blogs" class="py-16 md:py-20 relative z-10 border-t border-border-subtle">
      <div class="max-w-7xl mx-auto">
        <SectionHeader 
          title="Technical" 
          gradientText="Blog" 
          subtitle="Writing about modern software engineering, API designs, and full-stack best practices."
        />
        
        <div class="mt-16 md:mt-16">
          {blogData?.slice(0, 4).map((blog, index) => (
            <BlogItem blog={blog} index={index} />
          ))}
        </div>
        
        <div class="mt-12 md:mt-20 flex justify-center md:justify-end">
           <a href="/blogs" class="group flex items-center gap-4 md:gap-6 text-[11px] font-black uppercase tracking-[0.4em] md:tracking-[0.5em] text-text-muted hover:text-accent-primary transition-all">
              Explore All Articles
              <div class="w-8 md:w-12 h-[1px] bg-border-subtle group-hover:bg-accent-primary group-hover:w-20 md:group-hover:w-24 transition-all duration-700"></div>
           </a>
        </div>
      </div>
    </section>

    <!-- Contact Experience -->
    <Contact />
  </div>
</div>

<AiChatbot client:idle />

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Premium Section Transitions
  const sections = document.querySelectorAll('section');
  sections.forEach(section => {
    gsap.from(section, {
      opacity: 0,
      y: 50,
      duration: 1.5,
      ease: "power4.out",
      scrollTrigger: {
        trigger: section,
        start: "top 80%",
        toggleActions: "play none none none"
      }
    });
  });

  // Repository Expansion Logic
  const expandBtn = document.getElementById('expand-repo');
  const repoGrid = document.getElementById('repo-grid');
  const repoIcon = document.getElementById('repo-icon');

  expandBtn?.addEventListener('click', () => {
    repoGrid?.classList.toggle('hidden');
    repoIcon?.classList.toggle('rotate-180');
    
    const isExpanded = !repoGrid?.classList.contains('hidden');
    expandBtn.querySelector('span') && (expandBtn.querySelector('span')!.textContent = isExpanded ? 'Collapse List' : 'Show All Projects');
  });
</script>
