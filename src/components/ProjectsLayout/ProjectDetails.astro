---
const { detailsData } = Astro.props;
import { PortableText } from "astro-portabletext";
import PremiumBackground from "../PremiumBackground.astro";
import PortableTextImage from "../BlogLayout/PortableTextImage.astro";
import { optimizeSanityImage } from "../../lib/optimizeImage";

const components = {
  type: {
    image: PortableTextImage
  }
};

const formattedDate = detailsData?._createdAt
  ? new Date(detailsData._createdAt).toLocaleDateString("en-US", { month: "short", year: "numeric" })
  : "Production";
---

<div class="relative min-h-screen selection:bg-accent-primary/30 overflow-hidden bg-canvas">
  <PremiumBackground />

  <main class="mx-auto w-full max-w-7xl px-4 md:px-6 lg:px-8 pt-28 pb-16 md:pt-36 md:pb-24 relative z-10">
    <!-- Breadcrumb / Meta -->
    <div class="mb-10 md:mb-14 flex items-center justify-between gap-4" data-aos="fade-down">
       <a href="/projects" class="group inline-flex items-center gap-2.5 text-xs font-mono text-text-muted hover:text-text-primary transition-colors">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 group-hover:-translate-x-1 transition-transform">
            <path d="M19 12H5m7-7-7 7 7 7"/>
          </svg>
          <span>All Case Studies</span>
       </a>
       <span class="text-xs font-mono text-text-dim">Case Study · {formattedDate}</span>
    </div>

    <!-- Project Identity -->
    <section class="max-w-7xl mx-auto mb-16 md:mb-24">
      <div class="flex flex-col gap-6 mb-12 md:mb-16" data-aos="fade-up">
         <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-text-primary tracking-tight leading-[1.08] m-0">
           {detailsData?.projectName}
         </h1>

         <!-- Excerpt / Case Study Summary -->
         {detailsData?.excerpt && (
           <div class="max-w-3xl text-base md:text-lg text-text-muted leading-relaxed">
              <PortableText value={detailsData?.excerpt} components={components} />
           </div>
         )}

         <!-- Action and Tech Stack Row -->
         <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 pt-6 border-t border-border-subtle">
            <div class="flex flex-wrap gap-2">
               {detailsData?.tags?.map((tag: string) => (
                  <span class="px-3 py-1 rounded-md bg-white/[0.04] border border-border-subtle text-xs font-mono text-text-muted">
                     {tag}
                  </span>
               ))}
            </div>
            
            <div class="flex flex-wrap gap-3 w-full sm:w-auto">
                {detailsData?.gumroadLink && (
                  <a 
                    href={typeof detailsData.gumroadLink === 'string' ? detailsData.gumroadLink : detailsData.gumroadLink.current} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="px-6 py-3 bg-accent-primary text-white font-bold uppercase text-xs tracking-wider rounded-full hover:bg-accent-hover transition-all duration-300 text-center"
                  >
                    Get Template ↗
                  </a>
                )}
                {detailsData?.demoLink && (
                  <a 
                    href={typeof detailsData.demoLink === 'string' ? detailsData.demoLink : detailsData.demoLink.current} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="px-6 py-3 bg-text-primary text-canvas font-bold uppercase text-xs tracking-wider rounded-full hover:bg-white transition-all duration-300 text-center"
                  >
                    Live Application ↗
                  </a>
                )}
                {detailsData?.gitHubLink && (
                  <a 
                    href={typeof detailsData.gitHubLink === 'string' ? detailsData.gitHubLink : detailsData.gitHubLink.current} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="px-6 py-3 bg-white/[0.04] border border-white/10 text-text-primary font-semibold text-xs uppercase tracking-wider rounded-full hover:bg-white/[0.08] hover:border-border-hover transition-all duration-300 text-center"
                  >
                    Source Code ↗
                  </a>
                )}
            </div>
         </div>
      </div>

      <!-- Hero Image in Double-Bezel Frame -->
      <div class="rounded-2xl p-1.5 bg-white/[0.03] border border-white/[0.09] shadow-card">
        <div class="relative rounded-xl overflow-hidden border border-white/[0.05] bg-surface-card group">
           {detailsData?.BackgroundImage?.asset?.url && (
             <img 
               src={optimizeSanityImage(detailsData.BackgroundImage.asset.url, 1200, 80)} 
               alt={detailsData.projectName || "Project preview screenshot"}
               loading="lazy"
               decoding="async"
               class="w-full h-auto object-cover transition-all duration-700"
             />
           )}
        </div>
      </div>
    </section>

    <!-- Project Architecture & Breakdown -->
    <section class="max-w-5xl mx-auto pt-12 md:pt-20 border-t border-border-subtle">
       <div class="grid lg:grid-cols-12 gap-10 md:gap-16">
          <div class="lg:col-span-4">
             <div class="rounded-2xl p-1.5 bg-white/[0.02] border border-white/[0.08] lg:sticky lg:top-28">
               <div class="rounded-xl bg-surface-card p-6 border border-white/[0.04] space-y-5">
                 <h2 class="text-base font-bold text-text-primary tracking-tight">Project Overview</h2>
                 <div class="space-y-4 text-xs font-mono">
                    <div class="flex items-center justify-between py-2 border-b border-border-subtle">
                       <span class="text-text-dim">Engineer</span>
                       <span class="text-text-primary font-medium">Tanuj Pandey</span>
                    </div>
                    <div class="flex items-center justify-between py-2 border-b border-border-subtle">
                       <span class="text-text-dim">Timeline</span>
                       <span class="text-text-primary font-medium tabular-nums">{formattedDate}</span>
                    </div>
                    <div class="flex items-center justify-between py-2">
                       <span class="text-text-dim">Status</span>
                       <span class="inline-flex items-center gap-1.5 text-status-live">
                         <span class="w-1.5 h-1.5 rounded-full bg-status-live"></span>
                         Production
                       </span>
                    </div>
                 </div>
               </div>
             </div>
          </div>
          
          <div class="lg:col-span-8">
             <div class="prose-custom">
               <PortableText value={detailsData?.projectcontent} components={components} />
             </div>
          </div>
       </div>
    </section>
  </main>
</div>

<style>
  .prose-custom {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .prose-custom :global(p) {
    margin-bottom: 1.75rem;
  }
  .prose-custom :global(img) {
    width: 100%;
    height: auto;
    border-radius: 1rem;
    border: 1px solid var(--border-subtle);
    margin-top: 2rem;
    margin-bottom: 2rem;
    max-width: 100%;
  }
  .prose-custom :global(h2) {
    color: var(--text-primary);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-top: 3rem;
    margin-bottom: 1.25rem;
  }
  .prose-custom :global(ul) {
    list-style-type: disc;
    list-style-position: inside;
    margin-bottom: 2rem;
  }
  .prose-custom :global(ul > li + li) {
    margin-top: 0.5rem;
  }
  .prose-custom :global(ol) {
    list-style-type: decimal;
    list-style-position: inside;
    margin-bottom: 2rem;
  }
  .prose-custom :global(ol > li + li) {
    margin-top: 0.5rem;
  }
  .prose-custom :global(li) {
    color: var(--text-muted);
    margin-left: 0.5rem;
  }
  .prose-custom :global(li::marker) {
    color: var(--accent-primary);
  }
  .prose-custom :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }
</style>
