---
import Layout from "../../layouts/Layout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import PremiumBackground from "../../components/PremiumBackground.astro";
import TemplateCard from "../../components/TemplateCard.astro";
import { fetchAllTemplates } from "../../lib/templates";

const templates = await fetchAllTemplates();

const siteUrl = "https://tanujbuilds.site";
const itemList = {
  "@type": "ItemList",
  "@id": `${siteUrl}/templates#itemlist`,
  name: "Tanuj Pandey — Commercial Next.js & React Website Templates",
  description: "Production-ready Next.js, React, TypeScript, and Tailwind CSS website templates with 99+ Lighthouse performance, lifetime updates, and commercial licenses.",
  itemListElement: templates.map((template, index) => {
    const priceNumeric = template.price?.replace(/[^0-9.]/g, "") || "49";
    const rawImg = template.imageUrl || "/og-image-dark.png";
    const resolvedImg = rawImg.startsWith("http") ? rawImg : `${siteUrl}${rawImg.startsWith("/") ? "" : "/"}${rawImg}`;
    return {
      "@type": "ListItem",
      position: index + 1,
      name: template.templateName,
      url: `${siteUrl}/templates/${template.slug.current}`,
      item: {
        "@type": "Product",
        name: template.templateName,
        description: template.tagline || "Production-ready commercial website template engineered with Next.js, React, and Tailwind CSS.",
        image: [resolvedImg],
        url: `${siteUrl}/templates/${template.slug.current}`,
        sku: template.slug.current,
        category: "SoftwareApplication",
        brand: {
          "@type": "Brand",
          name: "Tanuj Builds",
        },
        offers: {
          "@type": "Offer",
          price: priceNumeric,
          priceCurrency: "USD",
          availability: "https://schema.org/InStock",
          url: template.gumroadLink || `${siteUrl}/templates/${template.slug.current}`,
          seller: {
            "@type": "Organization",
            name: "Tanuj Builds",
          },
          hasMerchantReturnPolicy: {
            "@type": "MerchantReturnPolicy",
            applicableCountry: "US",
            returnPolicyCategory: "https://schema.org/MerchantReturnNotPermitted",
          },
          shippingDetails: {
            "@type": "OfferShippingDetails",
            shippingRate: {
              "@type": "MonetaryAmount",
              value: "0",
              currency: "USD",
            },
            shippingDestination: {
              "@type": "DefinedRegion",
              addressCountry: "US",
            },
            deliveryTime: {
              "@type": "ShippingDeliveryTime",
              handlingTime: {
                "@type": "QuantitativeValue",
                minValue: 0,
                maxValue: 0,
                unitCode: "DAY",
              },
              transitTime: {
                "@type": "QuantitativeValue",
                minValue: 0,
                maxValue: 0,
                unitCode: "DAY",
              },
            },
          },
        },
      },
    };
  }),
};

const templatesFaqJsonLd = {
  "@type": "FAQPage",
  "@id": `${siteUrl}/templates#faq`,
  mainEntity: [
    {
      "@type": "Question",
      name: "What tech stack are these commercial website templates built with?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "All templates are built with modern production stacks including Next.js, React.js, TypeScript, Tailwind CSS, Framer Motion, and GSAP, engineered for 99+ Google PageSpeed and Core Web Vitals performance."
      }
    },
    {
      "@type": "Question",
      name: "Does the purchase include a commercial license for client projects?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Every template includes an unlimited commercial license allowing you to build and deploy both personal projects and paying client websites with zero recurring royalties."
      }
    },
    {
      "@type": "Question",
      name: "Do I get lifetime updates and source code access?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. You receive instant access to the full TypeScript/React source code, design tokens, setup documentation, and free lifetime updates via Gumroad."
      }
    }
  ]
};

const templateKeywords = [
  "Next.js Website Templates",
  "React Tailwind CSS Templates",
  "Commercial Website Templates",
  "Luxury Real Estate Next.js Template",
  "Dental Clinic Website Template Next.js",
  "Healthcare React Website Template",
  "TypeScript SaaS Templates",
  "High PageSpeed Website Templates",
  "Tanuj Pandey Templates"
];

const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Templates", path: "/templates" },
];
---

<Layout
  title="Commercial Next.js & React Website Templates | Tanuj Pandey"
  description="Download production-ready Next.js, React, TypeScript, and Tailwind CSS website templates for Real Estate, Healthcare, and SaaS. 99+ Lighthouse scores & commercial license included."
  schemaType="CollectionPage"
  keywords={templateKeywords}
  jsonLd={[itemList, templatesFaqJsonLd]}
  breadcrumbs={breadcrumbs}
>
  <div class="relative min-h-screen selection:bg-accent-primary/30 overflow-hidden bg-canvas">
    <PremiumBackground />

    <main class="mx-auto w-full max-w-7xl px-4 md:px-6 lg:px-8 py-24 md:py-32 relative z-10">
      
      <!-- Section Header -->
      <SectionHeader 
        eyebrow="Commercial Digital Products"
        title="Production-Ready" 
        gradientText="Templates" 
        subtitle="Next.js, React, and TypeScript templates engineered with 99+ Lighthouse performance and commercial licenses."
      />

      <!-- Category Filter Pills -->
      <div class="mt-10 md:mt-12 flex flex-wrap items-center justify-center gap-2 md:gap-3" id="template-filters">
        <button 
          data-filter="all"
          class="filter-btn active px-4 py-2 rounded-xl text-xs font-mono font-medium transition-all duration-300 bg-accent-primary text-white shadow-md shadow-accent-primary/20"
        >
          All Templates ({templates.length})
        </button>
        <button 
          data-filter="real estate"
          class="filter-btn px-4 py-2 rounded-xl text-xs font-mono font-medium transition-all duration-300 bg-white/5 border border-white/10 text-text-muted hover:text-white hover:bg-white/10"
        >
          Real Estate & Architecture
        </button>
        <button 
          data-filter="healthcare"
          class="filter-btn px-4 py-2 rounded-xl text-xs font-mono font-medium transition-all duration-300 bg-white/5 border border-white/10 text-text-muted hover:text-white hover:bg-white/10"
        >
          Healthcare & Clinic
        </button>
        <button 
          data-filter="react"
          class="filter-btn px-4 py-2 rounded-xl text-xs font-mono font-medium transition-all duration-300 bg-white/5 border border-white/10 text-text-muted hover:text-white hover:bg-white/10"
        >
          React & Next.js
        </button>
      </div>

      <!-- Templates Grid -->
      <div 
        id="templates-grid"
        class="mt-12 md:mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8 max-w-6xl mx-auto"
      >
        {templates.map((template, index) => (
          <TemplateCard template={template} index={index} />
        ))}
      </div>

      <!-- Value Proposition Matrix (Why Buy These Templates) -->
      <section class="mt-24 md:mt-36 pt-16 md:pt-20 border-t border-border-subtle">
        <div class="text-center max-w-2xl mx-auto mb-14">
          <p class="text-[11px] font-mono uppercase tracking-[0.3em] text-accent-primary mb-3">Engineered For Quality</p>
          <h2 class="text-2xl md:text-3xl font-bold text-text-primary tracking-tight">
            What Sets These Templates Apart?
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="rounded-2xl p-6 bg-white/[0.02] border border-white/10 hover:border-white/20 transition-colors">
            <div class="w-10 h-10 rounded-xl bg-accent-primary/10 border border-accent-primary/30 flex items-center justify-center text-accent-primary mb-4 font-mono font-bold text-sm">
              01
            </div>
            <h3 class="text-base font-bold text-text-primary mb-2">Commercial License</h3>
            <p class="text-xs text-text-muted leading-relaxed">
              Build unlimited client websites or commercial software. No recurring royalties or hidden restrictions.
            </p>
          </div>

          <div class="rounded-2xl p-6 bg-white/[0.02] border border-white/10 hover:border-white/20 transition-colors">
            <div class="w-10 h-10 rounded-xl bg-accent-primary/10 border border-accent-primary/30 flex items-center justify-center text-accent-primary mb-4 font-mono font-bold text-sm">
              02
            </div>
            <h3 class="text-base font-bold text-text-primary mb-2">99+ PageSpeed Scores</h3>
            <p class="text-xs text-text-muted leading-relaxed">
              Zero bloat, optimized image pipelines, and clean semantics engineered for maximum SEO ranking.
            </p>
          </div>

          <div class="rounded-2xl p-6 bg-white/[0.02] border border-white/10 hover:border-white/20 transition-colors">
            <div class="w-10 h-10 rounded-xl bg-accent-primary/10 border border-accent-primary/30 flex items-center justify-center text-accent-primary mb-4 font-mono font-bold text-sm">
              03
            </div>
            <h3 class="text-base font-bold text-text-primary mb-2">Typed & Modular</h3>
            <p class="text-xs text-text-muted leading-relaxed">
              Fully typed with TypeScript, reusable Tailwind components, and structured tokens for effortless restyling.
            </p>
          </div>

          <div class="rounded-2xl p-6 bg-white/[0.02] border border-white/10 hover:border-white/20 transition-colors">
            <div class="w-10 h-10 rounded-xl bg-accent-primary/10 border border-accent-primary/30 flex items-center justify-center text-accent-primary mb-4 font-mono font-bold text-sm">
              04
            </div>
            <h3 class="text-base font-bold text-text-primary mb-2">Lifetime Updates</h3>
            <p class="text-xs text-text-muted leading-relaxed">
              Access future dependency upgrades, bug fixes, and layout iterations at no extra charge via Gumroad.
            </p>
          </div>
        </div>
      </section>

      <!-- AEO / SEO Frequently Asked Questions Section -->
      <section class="mt-20 md:mt-28 pt-16 border-t border-border-subtle max-w-4xl mx-auto">
        <div class="text-center mb-10">
          <p class="text-[11px] font-mono uppercase tracking-[0.25em] text-accent-primary mb-2">Licensing &amp; Architecture FAQ</p>
          <h2 class="text-2xl md:text-3xl font-bold text-text-primary tracking-tight">
            Frequently Asked Questions
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          <div class="rounded-2xl p-6 bg-surface-card border border-white/[0.08]">
            <h3 class="text-sm font-bold text-text-primary mb-2">What tech stack powers these templates?</h3>
            <p class="text-xs text-text-muted leading-relaxed">
              Built with Next.js, React.js, TypeScript, Tailwind CSS, and GSAP/Framer Motion, achieving 99+ Google PageSpeed and Core Web Vitals scores out of the box.
            </p>
          </div>

          <div class="rounded-2xl p-6 bg-surface-card border border-white/[0.08]">
            <h3 class="text-sm font-bold text-text-primary mb-2">Can I use them for paying client projects?</h3>
            <p class="text-xs text-text-muted leading-relaxed">
              Yes. Every download includes a full commercial license to deploy unlimited personal and client websites with zero recurring royalties.
            </p>
          </div>

          <div class="rounded-2xl p-6 bg-surface-card border border-white/[0.08]">
            <h3 class="text-sm font-bold text-text-primary mb-2">How are source files and updates delivered?</h3>
            <p class="text-xs text-text-muted leading-relaxed">
              You receive an instant zip download with full TypeScript source code and documentation after checkout, plus automatic lifetime updates via Gumroad.
            </p>
          </div>
        </div>
      </section>

      <!-- Custom Project Banner -->
      <div class="mt-20 md:mt-28 py-10 md:py-14 border-t border-border-subtle flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="space-y-2">
          <p class="text-[11px] font-mono uppercase tracking-[0.3em] text-accent-primary">Bespoke Engineering</p>
          <p class="text-xl md:text-2xl font-semibold text-text-primary tracking-tight max-w-xl">
            Need custom design engineering or full-stack software development?
          </p>
        </div>
        <a href="/#contact" class="group inline-flex items-center gap-3 px-6 py-3.5 rounded-full bg-white/5 border border-white/10 text-xs font-mono uppercase tracking-[0.2em] text-text-primary hover:text-white hover:border-accent-primary transition-all">
          <span>Inquire About Custom Build</span>
          <span class="w-6 h-6 rounded-full bg-accent-primary/20 text-accent-primary flex items-center justify-center group-hover:bg-accent-primary group-hover:text-white transition-all text-xs">↗</span>
        </a>
      </div>

    </main>
  </div>
</Layout>

<script>
  // Simple client-side category filtering
  const filterButtons = document.querySelectorAll<HTMLButtonElement>("#template-filters .filter-btn");
  const cards = document.querySelectorAll<HTMLElement>(".template-card");

  filterButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      // Toggle active states
      filterButtons.forEach((b) => {
        b.classList.remove("active", "bg-accent-primary", "text-white", "shadow-md", "shadow-accent-primary/20");
        b.classList.add("bg-white/5", "border", "border-white/10", "text-text-muted");
      });

      btn.classList.add("active", "bg-accent-primary", "text-white", "shadow-md", "shadow-accent-primary/20");
      btn.classList.remove("bg-white/5", "border", "border-white/10", "text-text-muted");

      const filter = btn.dataset.filter?.toLowerCase() || "all";

      cards.forEach((card) => {
        const category = card.dataset.category || "";
        const tags = card.dataset.tags || "";

        if (filter === "all" || category.includes(filter) || tags.includes(filter)) {
          card.style.display = "flex";
          card.style.opacity = "1";
        } else {
          card.style.display = "none";
          card.style.opacity = "0";
        }
      });
    });
  });
</script>
