---
// Option 2: Dark Monochrome "Silk" Wave Backdrop
// Velvet undulating dark slate & Linear Indigo (#5E6AD2 / #828FFF) fabric waves on #090A0F Obsidian
---

<div class="pointer-events-none absolute inset-0 overflow-hidden z-0" aria-hidden="true">
  <canvas id="agency-silk-wave-canvas" class="w-full h-full block"></canvas>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_85%_60%_at_50%_20%,rgba(94,106,210,0.14)_0%,transparent_72%)]"></div>
  <div class="absolute inset-x-0 bottom-0 h-44 bg-gradient-to-t from-[#090A0F] via-[#090A0F]/80 to-transparent"></div>
</div>

<script>
  const initAgencySilkWave = () => {
    const canvas = document.getElementById("agency-silk-wave-canvas") as HTMLCanvasElement | null;
    if (!canvas) return;
    const parent = canvas.parentElement;
    if (!parent) return;

    const w = window as any;
    if (w.__agencySilkRaf) cancelAnimationFrame(w.__agencySilkRaf);
    if (w.__agencySilkCleanup) w.__agencySilkCleanup();

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let width = 0;
    let height = 0;
    let dpr = 1;
    let time = 0;
    let mouseY = 0.5;
    let targetMouseY = 0.5;
    let mouseX = 0.5;
    let targetMouseX = 0.5;

    const resize = () => {
      const rect = parent.getBoundingClientRect();
      width = Math.max(1, Math.floor(rect.width));
      height = Math.max(1, Math.floor(rect.height));
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const section = canvas.closest("section");
    const onPointerMove = (e: PointerEvent) => {
      const rect = parent.getBoundingClientRect();
      if (rect.width > 0 && rect.height > 0) {
        targetMouseX = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
        targetMouseY = Math.max(0, Math.min(1, (e.clientY - rect.top) / rect.height));
      }
    };
    const onPointerLeave = () => {
      targetMouseX = 0.5;
      targetMouseY = 0.5;
    };

    section?.addEventListener("pointermove", onPointerMove, { passive: true });
    section?.addEventListener("pointerleave", onPointerLeave, { passive: true });
    window.addEventListener("resize", resize, { passive: true });
    resize();

    // 7 layered silk ribbons with varied depth, amplitude, and obsidian-indigo sheen
    const ribbons = [
      { yFactor: 0.18, amp: 38, freq: 0.0024, speed: 0.48, topColor: "rgba(94, 106, 210, 0.24)", stroke: "rgba(130, 143, 255, 0.30)" },
      { yFactor: 0.26, amp: 46, freq: 0.0029, speed: -0.36, topColor: "rgba(30, 35, 62, 0.45)", stroke: "rgba(130, 143, 255, 0.22)" },
      { yFactor: 0.34, amp: 34, freq: 0.0033, speed: 0.54, topColor: "rgba(94, 106, 210, 0.16)", stroke: "rgba(255, 255, 255, 0.14)" },
      { yFactor: 0.43, amp: 52, freq: 0.0021, speed: -0.42, topColor: "rgba(18, 21, 34, 0.65)", stroke: "rgba(94, 106, 210, 0.28)" },
      { yFactor: 0.53, amp: 40, freq: 0.0027, speed: 0.38, topColor: "rgba(94, 106, 210, 0.12)", stroke: "rgba(130, 143, 255, 0.18)" },
      { yFactor: 0.64, amp: 44, freq: 0.0023, speed: -0.30, topColor: "rgba(13, 16, 26, 0.72)", stroke: "rgba(255, 255, 255, 0.09)" },
    ];

    const render = () => {
      if (document.visibilityState === "hidden") {
        w.__agencySilkRaf = requestAnimationFrame(render);
        return;
      }

      mouseX += (targetMouseX - mouseX) * 0.05;
      mouseY += (targetMouseY - mouseY) * 0.05;
      ctx.clearRect(0, 0, width, height);

      const stepX = Math.max(14, Math.floor(width / 64));

      ribbons.forEach((r, idx) => {
        const baseY = height * r.yFactor + (mouseY - 0.5) * (16 + idx * 5);
        const phaseShift = (mouseX - 0.5) * 1.4;

        // Fill soft silk fold body downward
        ctx.beginPath();
        let firstY = baseY;
        for (let x = 0; x <= width + stepX; x += stepX) {
          const fold =
            Math.sin(x * r.freq + time * r.speed + idx * 1.1 + phaseShift) * r.amp +
            Math.cos(x * (r.freq * 1.9) - time * (r.speed * 0.7) + idx) * (r.amp * 0.36);
          const y = baseY + fold;
          if (x === 0) {
            firstY = y;
            ctx.moveTo(x, y);
          } else {
            ctx.lineTo(x, y);
          }
        }

        // Crisp silk crest highlight stroke
        ctx.strokeStyle = r.stroke;
        ctx.lineWidth = idx % 2 === 0 ? 1.35 : 1;
        ctx.stroke();

        // Gradient body fade below each silk fold
        ctx.lineTo(width + stepX, baseY + 260);
        ctx.lineTo(0, baseY + 260);
        ctx.closePath();

        const foldGrad = ctx.createLinearGradient(0, firstY - r.amp, 0, baseY + 230);
        foldGrad.addColorStop(0, r.topColor);
        foldGrad.addColorStop(0.55, "rgba(15, 18, 28, 0.28)");
        foldGrad.addColorStop(1, "rgba(9, 10, 15, 0)");
        ctx.fillStyle = foldGrad;
        ctx.fill();
      });

      if (!reduceMotion) {
        time += 0.015;
        w.__agencySilkRaf = requestAnimationFrame(render);
      }
    };

    render();

    w.__agencySilkCleanup = () => {
      if (w.__agencySilkRaf) cancelAnimationFrame(w.__agencySilkRaf);
      section?.removeEventListener("pointermove", onPointerMove);
      section?.removeEventListener("pointerleave", onPointerLeave);
      window.removeEventListener("resize", resize);
    };
  };

  initAgencySilkWave();
  document.addEventListener("astro:page-load", initAgencySilkWave);
</script>

