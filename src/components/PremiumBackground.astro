---
// CodeOfSagar Inspired Light Studio Editorial Background (#FAFAFB)
---

<div class="fixed inset-0 -z-10 pointer-events-none select-none overflow-hidden bg-[#FAFAFB]">
  <!-- Top Ambient Illumination (Subtle Indigo Sheen) -->
  <div class="absolute -top-[15%] left-1/2 -translate-x-1/2 w-[1300px] h-[650px] rounded-full bg-[radial-gradient(ellipse_at_center,rgba(94,106,210,0.08)_0%,transparent_70%)] blur-3xl pointer-events-none"></div>

  <!-- Clean Minimalist Micro-Dot Grid Pattern with Soft Radial Falloff -->
  <div 
    class="absolute inset-0 opacity-[0.035] pointer-events-none bg-[radial-gradient(#0F172A_1px,transparent_1px)] [background-size:28px_28px] [mask-image:radial-gradient(ellipse_80%_60%_at_50%_25%,#000_50%,transparent_100%)]"
  ></div>

  <!-- Smooth Linear Vertical Fade -->
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#FAFAFB]/40 to-[#FAFAFB] pointer-events-none"></div>
</div>
