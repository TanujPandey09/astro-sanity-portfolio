---
// NovaStack Engagement Models: 4 Transparent Collaboration Structures
const models = [
  {
    id: "fixed-price",
    name: "Fixed-Price Projects",
    category: "Defined Scope & Milestones",
    description: "Ideal for well-specified products, feature modules, or complete website redesigns. We define the exact scope, timeline, and deliverables upfront with milestone-based invoicing.",
    features: [
      "Guaranteed delivery date & fixed budget cap",
      "Milestone-based payments tied to verified deliverables",
      "Comprehensive specification & architecture document",
      "Full source code handover & deployment support",
      "30-day post-launch warranty for bug fixes"
    ],
    bestFor: "MVPs with clear requirements, marketing sites, and discrete software features.",
    ctaText: "Request a Project Quote"
  },
  {
    id: "dedicated-dev",
    name: "Dedicated Engineering",
    category: "Full-Time or Fractional Capacity",
    description: "Direct integration of senior full-stack and AI engineers into your team. Flexible monthly capacity with transparent hours, daily standups, and shared Slack/Teams channels.",
    features: [
      "Direct senior developer integration with zero agency layers",
      "Flexible backlog prioritization adjusted on weekly sprints",
      "Transparent task tracking via Jira, Linear, or GitHub Projects",
      "Full access to our technical architect for high-level reviews",
      "Scalable capacity up or down with 30-day notice"
    ],
    bestFor: "Growing startups and funded companies needing sustained engineering velocity.",
    ctaText: "Discuss Dedicated Capacity"
  },
  {
    id: "saas-mvp",
    name: "SaaS MVP Acceleration",
    category: "4 to 8 Week Fast-Track Launch",
    description: "An intensive, focused sprint designed to take non-technical or early-stage founders from concept to a production-ready, revenue-generating SaaS product in weeks.",
    features: [
      "Complete core architecture: Auth, Database, UI & APIs",
      "Subscription billing setup (Stripe or regional gateways)",
      "Essential AI features or workflow automations integrated",
      "Responsive design optimized for conversions & mobile users",
      "Investor-ready documentation & product demo assets"
    ],
    bestFor: "Founders validating a SaaS thesis or pitching pre-seed/seed investors.",
    ctaText: "Scope Your SaaS MVP"
  },
  {
    id: "monthly-maintenance",
    name: "Monthly Maintenance & SLA",
    category: "Continuous Uptime & Enhancements",
    description: "Guaranteed peace of mind for established production systems. Ongoing security patches, dependency updates, uptime monitoring, and priority bug resolution.",
    features: [
      "Continuous uptime monitoring & automated error alerting",
      "Monthly dependency, library & security vulnerability updates",
      "Dedicated monthly hours for minor feature enhancements",
      "Guaranteed priority SLA response times (< 4 hours for P1 issues)",
      "Quarterly architecture health check & optimization review"
    ],
    bestFor: "Companies with live revenue-critical web software and SaaS portals.",
    ctaText: "Inquire About Maintenance"
  }
];
---

<section id="models" class="py-20 sm:py-28 bg-[#0C0E14] text-white border-b border-white/[0.08]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.05] border border-white/10 text-[11px] font-mono font-semibold text-[#828FFF] uppercase tracking-[0.16em] mb-4">
        // ENGAGEMENT MODELS
      </div>
      <h2 class="font-grotesk font-extrabold text-3xl sm:text-4xl md:text-5xl text-white tracking-[-0.035em] leading-tight">
        Flexible Partnerships Tailored to Your Growth Stage.
      </h2>
      <p class="text-sm sm:text-base md:text-lg text-slate-300 mt-4 leading-relaxed font-sans">
        We do not believe in rigid, one-size-fits-all contracts. NovaStack provides four transparent engagement structures designed to match your budget, timeline, and internal technical team.
      </p>
    </div>

    <!-- 4 Models Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
      {models.map((model, idx) => (
        <div data-agency-dir={idx % 2 === 0 ? 'left' : 'right'} class="rounded-2xl bg-white/[0.03] border border-white/[0.08] hover:border-[#828FFF]/40 p-6 sm:p-8 flex flex-col justify-between transition-all">
          <div>
            <!-- Header Badges -->
            <div class="flex items-center justify-between mb-4">
              <span class="text-[10px] font-mono uppercase tracking-wider font-semibold text-[#828FFF] bg-[#5E6AD2]/15 border border-[#5E6AD2]/30 px-3 py-0.5 rounded-full">
                {model.category}
              </span>
              <span class="w-2 h-2 rounded-full bg-white/25"></span>
            </div>

            <!-- Model Title -->
            <h3 class="font-grotesk font-bold text-2xl text-white tracking-tight mb-2">
              {model.name}
            </h3>

            <!-- Description -->
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-sans mb-6">
              {model.description}
            </p>

            <!-- Key Features -->
            <div class="mb-6 space-y-2">
              <span class="text-[11px] font-mono uppercase tracking-wider text-slate-300 font-semibold block mb-2">
                What's Included:
              </span>
              <ul class="space-y-2 text-xs text-slate-200 font-sans">
                {model.features.map((feat) => (
                  <li class="flex items-start gap-2">
                    <span class="text-emerald-400 font-bold mt-0.5 font-mono select-none">✓</span>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Bottom: Best For & CTA Button -->
          <div class="pt-5 border-t border-white/[0.08] space-y-4">
            <div class="text-[11px] font-mono text-slate-300">
              <strong class="text-white font-semibold font-sans">Best For:</strong> {model.bestFor}
            </div>

            <a
              href={`#contact?model=${encodeURIComponent(model.name)}`}
              class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-white hover:bg-slate-200 text-[#090A0F] font-grotesk font-bold text-xs uppercase tracking-wider transition-all active:scale-[0.98]"
            >
              <span>{model.ctaText}</span>
              <span>→</span>
            </a>
          </div>

        </div>
      ))}
    </div>

    <!-- Pricing Policy Transparency Notice -->
    <div class="mt-8 p-4 sm:p-5 rounded-2xl bg-white/[0.02] border border-white/[0.08] text-xs text-slate-400 flex items-start gap-3">
      <span class="text-[#828FFF] font-mono font-bold mt-0.5 text-sm">ⓘ</span>
      <p class="leading-relaxed">
        <strong class="text-white font-semibold">Custom Scoping Policy:</strong> Every software system carries unique requirements, security integrations, and data complexities. Rather than advertising arbitrary flat rates that lead to scope disputes, NovaStack evaluates your exact project requirements and provides an itemized proposal with clear milestone pricing.
      </p>
    </div>

  </div>
</section>

