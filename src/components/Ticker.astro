---
// Rushes Cinematic Domain Marquee & Impact Section
const domains = [
  "REACT.JS & NEXT.JS 15",
  "MULTI-LLM ORCHESTRATION",
  "NODE.JS & REAL-TIME SOCKETS",
  "TYPESCRIPT ARCHITECTURE",
  "POSTGRESQL & PRISMA ORM",
  "SANITY HEADLESS CMS",
  "PRODUCTION SAAS APIS",
  "99+ LIGHTHOUSE VITALS"
];
---

<!-- Modern Framer Domain Marquee -->
<div class="py-4 border-y border-black/[0.08] bg-slate-50 overflow-hidden whitespace-nowrap group select-none relative z-10">
  <div class="ticker-track inline-flex animate-ticker items-center">
    <!-- Set 1 -->
    <div class="inline-flex items-center gap-10 px-5">
      {domains.map((item) => (
        <div class="inline-flex items-center gap-4">
          <span class="text-accent-primary text-xs">✦</span>
          <span class="text-xs font-grotesk font-bold tracking-[0.08em] uppercase text-slate-600 group-hover:text-[#0F172A] transition-colors">{item}</span>
        </div>
      ))}
    </div>

    <!-- Set 2 for seamless loop -->
    <div class="inline-flex items-center gap-10 px-5">
      {domains.map((item) => (
        <div class="inline-flex items-center gap-4">
          <span class="text-accent-primary text-xs">✦</span>
          <span class="text-xs font-grotesk font-bold tracking-[0.08em] uppercase text-slate-600 group-hover:text-[#0F172A] transition-colors">{item}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<!-- Giant Typographic Metric Statement + 4-Tile Linear Bento Proof Strip -->
<section aria-label="Impact Overview" class="py-16 sm:py-24 md:py-28 relative z-10 border-b border-black/[0.08] bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" data-gsap-heading>
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-slate-50 border border-black/10 shadow-xs mb-6">
      <span class="w-1.5 h-1.5 rounded-full bg-accent-primary animate-pulse"></span>
      <span class="text-[11px] sm:text-xs font-mono font-medium tracking-[0.14em] text-slate-700 uppercase">
        [ METRICS &amp; IMPACT // PROVEN PERFORMANCE ]
      </span>
    </div>

    <h2 class="font-grotesk font-extrabold text-[#0F172A] text-3xl sm:text-5xl md:text-[3.5rem] leading-[1.06] tracking-[-0.04em] max-w-5xl mb-10 sm:mb-14">
      Engineered for measurable <span class="text-accent-primary">speed, scale &amp; reliability.</span>
    </h2>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
      <div data-gsap-card class="bento-spotlight rounded-[22px] bg-[#FAFAFB] border border-black/[0.08] hover:border-accent-primary/40 p-5 sm:p-6 transition-all shadow-[0_4px_18px_rgba(15,23,42,0.03)]">
        <span class="text-[10px] font-mono uppercase tracking-[0.14em] text-slate-600 block mb-2">DELIVERED SYSTEMS</span>
        <div class="font-grotesk font-extrabold text-3xl sm:text-4xl md:text-5xl text-[#0F172A] tabular-nums tracking-tight">
          <span data-counter="10" data-suffix="+">10+</span>
        </div>
        <p class="text-xs text-slate-600 font-sans mt-2 leading-relaxed">Production SaaS modules shipped across portals &amp; APIs.</p>
      </div>

      <div data-gsap-card class="bento-spotlight rounded-[22px] bg-[#FAFAFB] border border-black/[0.08] hover:border-accent-primary/40 p-5 sm:p-6 transition-all shadow-[0_4px_18px_rgba(15,23,42,0.03)]">
        <span class="text-[10px] font-mono uppercase tracking-[0.14em] text-slate-600 block mb-2">SPEED GAIN</span>
        <div class="font-grotesk font-extrabold text-3xl sm:text-4xl md:text-5xl text-accent-primary tabular-nums tracking-tight">
          <span data-counter="50" data-suffix="%">50%</span>
        </div>
        <p class="text-xs text-slate-600 font-sans mt-2 leading-relaxed">Faster load times via splitting, edge caching &amp; bundle tuning.</p>
      </div>

      <div data-gsap-card class="bento-spotlight rounded-[22px] bg-[#FAFAFB] border border-black/[0.08] hover:border-accent-primary/40 p-5 sm:p-6 transition-all shadow-[0_4px_18px_rgba(15,23,42,0.03)]">
        <span class="text-[10px] font-mono uppercase tracking-[0.14em] text-slate-600 block mb-2">CORE WEB VITALS</span>
        <div class="font-grotesk font-extrabold text-3xl sm:text-4xl md:text-5xl text-[#0F172A] tabular-nums tracking-tight">
          <span data-counter="99" data-suffix="+">99+</span>
        </div>
        <p class="text-xs text-slate-600 font-sans mt-2 leading-relaxed">Consistently scored across Next.js &amp; Astro storefronts.</p>
      </div>

      <div data-gsap-card class="bento-spotlight rounded-[22px] bg-[#FAFAFB] border border-black/[0.08] hover:border-accent-primary/40 p-5 sm:p-6 transition-all shadow-[0_4px_18px_rgba(15,23,42,0.03)]">
        <span class="text-[10px] font-mono uppercase tracking-[0.14em] text-slate-600 block mb-2">EXPERIENCE</span>
        <div class="font-grotesk font-extrabold text-3xl sm:text-4xl md:text-5xl text-[#0F172A] tabular-nums tracking-tight">
          <span data-counter="4" data-suffix="+">4+</span> <span class="text-xl sm:text-2xl font-bold text-slate-700">Yrs</span>
        </div>
        <p class="text-xs text-slate-600 font-sans mt-2 leading-relaxed">Full-stack Next.js, Node.js &amp; multi-LLM AI engineering.</p>
      </div>
    </div>
  </div>
</section>
