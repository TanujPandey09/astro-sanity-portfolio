---
// Modern Framer Developer Obsidian Slate Canvas Background (#0B0F17)
---

<div class="fixed inset-0 -z-10 pointer-events-none select-none overflow-hidden bg-[#0B0F17]">
  <!-- Top Ambient Illumination (Linear Indigo & Cyan Halo — Developer Framer Aesthetic) -->
  <div class="absolute -top-[15%] left-1/2 -translate-x-1/2 w-[1300px] h-[650px] rounded-full bg-[radial-gradient(ellipse_at_center,rgba(94,106,210,0.14)_0%,rgba(56,189,248,0.04)_40%,transparent_75%)] blur-3xl pointer-events-none"></div>

  <!-- Clean Developer Micro-Dot Grid Pattern with Soft Radial Falloff -->
  <div 
    class="absolute inset-0 opacity-[0.045] pointer-events-none bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:28px_28px] [mask-image:radial-gradient(ellipse_80%_60%_at_50%_25%,#000_50%,transparent_100%)]"
  ></div>

  <!-- Smooth Linear Vertical Fade -->
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#0B0F17]/30 to-[#0B0F17] pointer-events-none"></div>
</div>
