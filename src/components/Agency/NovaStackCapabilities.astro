---
// NovaStack Trusted Capabilities: Enterprise-Grade Technologies
const capabilities = [
  {
    name: "React & React 19",
    category: "Frontend UI Architecture",
    tagline: "Component Architecture & Fluid State",
    description: "Component-driven user interfaces, Server Components, optimistic UI updates, and sub-second rendering for complex web applications.",
    details: "React 19 Server Actions, Context API, Redux Toolkit, and hook architecture.",
    tag: "UI LIBRARY"
  },
  {
    name: "Next.js",
    category: "Full-Stack Web Framework",
    tagline: "Hybrid SSR, SSG & Edge Routing",
    description: "Production web applications leveraging App Router, dynamic server-side rendering, incremental static regeneration, and Core Web Vitals optimization.",
    details: "App Router, Server Actions, Middleware, Edge Functions, Image Optimization.",
    tag: "WEB FRAMEWORK"
  },
  {
    name: "TypeScript",
    category: "Enterprise Type Safety",
    tagline: "Strict Static Contracts & Scalability",
    description: "Strict compile-time type safety preventing runtime regressions across large codebases, shared client/server interfaces, and team handoffs.",
    details: "Generic typing, Zod schema validation, API contract safety, and zero `any` policy.",
    tag: "LANGUAGE"
  },
  {
    name: "Node.js",
    category: "High-Throughput Backends",
    tagline: "Asynchronous APIs & Event Streaming",
    description: "Scalable backend microservices, RESTful and GraphQL APIs, WebSockets via Socket.IO, and background queue workers.",
    details: "Express, Fastify, Redis Pub/Sub, BullMQ queue workers, and event-driven patterns.",
    tag: "BACKEND RUNTIME"
  },
  {
    name: "PostgreSQL",
    category: "Relational Data Modeling",
    tagline: "ACID Compliance & Scalable Schemas",
    description: "Production relational databases with strict relational constraints, optimized indexing strategies, migration pipelines, and Prisma ORM.",
    details: "Complex query optimization, JSONB indexing, connection pooling, and Prisma/Drizzle.",
    tag: "DATABASE"
  },
  {
    name: "React Native",
    category: "Cross-Platform Mobile",
    tagline: "Single Codebase for iOS & Android",
    description: "Native-speed mobile applications with shared business logic, offline sync, push notifications, and device hardware integration.",
    details: "Expo EAS workflows, Native Modules, reanimated gestures, and App Store releases.",
    tag: "MOBILE DEV"
  },
  {
    name: "OpenAI",
    category: "Applied Generative AI",
    tagline: "GPT-4o, Function Calling & Agents",
    description: "Enterprise LLM integration with structured JSON outputs, function calling, custom embeddings, semantic search, and autonomous workflows.",
    details: "GPT-4o, OpenAI Assistants API, Token optimization, and structured schemas.",
    tag: "AI ORCHESTRATION"
  },
  {
    name: "Claude (Anthropic)",
    category: "Advanced Reasoning & RAG",
    tagline: "Long-Context Synthesis & Analysis",
    description: "Long-context document analysis, sophisticated analytical reasoning, contextual retrieval-augmented generation (RAG), and brand-safe validation.",
    details: "Claude 3.5 Sonnet, prompt caching, citation verification, and complex document processing.",
    tag: "AI REASONING"
  },
  {
    name: "Sanity CMS",
    category: "Structured Headless Content",
    tagline: "Real-Time Content Lakes & Workflows",
    description: "Headless CMS modeling with custom editorial schemas, real-time previewing, GROQ querying, and seamless integration with Next.js & Astro.",
    details: "Custom Studio v3 desks, webhook-driven web revalidation, and CDN image asset delivery.",
    tag: "HEADLESS CMS"
  }
];
---

<section id="capabilities" class="py-20 sm:py-28 bg-[#0C0E14] text-white border-b border-white/[0.08]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.05] border border-white/10 text-[11px] font-mono font-semibold text-[#828FFF] uppercase tracking-[0.16em] mb-4">
        // TRUSTED CAPABILITIES
      </div>
      <h2 class="font-grotesk font-extrabold text-3xl sm:text-4xl md:text-5xl text-white tracking-[-0.035em] leading-tight">
        Engineered With Modern, Enterprise-Grade Technologies.
      </h2>
      <p class="text-sm sm:text-base md:text-lg text-slate-300 mt-4 leading-relaxed font-sans">
        We do not rely on bloated templates or fragile low-code workarounds. NovaStack builds upon battle-tested open-source foundations and leading AI platforms that guarantee performance, security, and long-term ownership.
      </p>
    </div>

    <!-- 9 Capabilities Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
      {capabilities.map((item, index) => {
        const colDir = index % 3 === 0 ? 'left' : index % 3 === 1 ? 'center' : 'right';
        return (
        <div data-agency-dir={colDir} class="group relative rounded-2xl bg-white/[0.03] hover:bg-white/[0.06] border border-white/[0.08] hover:border-[#828FFF]/40 p-6 sm:p-7 transition-all duration-300 flex flex-col justify-between">
          
          <div>
            <!-- Top Tag & Index -->
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-mono font-semibold tracking-wider bg-white/[0.06] border border-white/10 text-slate-200 uppercase">
                {item.tag}
              </span>
              <span class="text-xs font-mono font-bold text-slate-400 tabular-nums">
                0{index + 1}/
              </span>
            </div>

            <!-- Title & Category -->
            <h3 class="font-grotesk font-bold text-xl text-white tracking-tight group-hover:text-[#828FFF] transition-colors">
              {item.name}
            </h3>
            <p class="text-xs font-mono font-medium text-[#828FFF] mt-1 mb-3">
              {item.tagline}
            </p>

            <!-- Description -->
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-sans mb-4">
              {item.description}
            </p>
          </div>

          <!-- Bottom Technical Details -->
          <div class="pt-4 border-t border-white/[0.08]">
            <span class="block text-[11px] font-mono text-slate-300">
              <strong class="text-white font-semibold font-sans">Scope:</strong> {item.details}
            </span>
          </div>

        </div>
      );})}
    </div>

    <!-- Architectural Assurance Banner -->
    <div class="mt-10 sm:mt-12 rounded-2xl bg-white/[0.03] border border-white/10 p-5 sm:p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-white text-[#090A0F] flex items-center justify-center font-mono font-bold text-sm shrink-0">
          &lt;/&gt;
        </div>
        <div>
          <h4 class="font-grotesk font-bold text-sm text-white">100% Client Codebase &amp; IP Ownership</h4>
          <p class="text-xs text-slate-400 font-sans mt-0.5">All repositories, credentials, architecture documentation, and cloud infrastructure belong exclusively to your business.</p>
        </div>
      </div>
      <a href="#contact" class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-[#828FFF] hover:text-white transition-colors whitespace-nowrap">
        <span>Request Tech Stack Consultation</span>
        <span>→</span>
      </a>
    </div>

  </div>
</section>

