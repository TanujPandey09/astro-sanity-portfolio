---
import SectionHeader from "./SectionHeader.astro";
import { useSanityClient, groq } from "astro-sanity";

const skillquery = groq`*[_type == "skillsSection"] {
  ...,
  logoCase[]-> {
    adminstrativetitle,
    Logo {
      ...,
      asset-> {
        ...,
        url,
      }
    }
  }
}[0]`;

let skillsData = null;
try {
  skillsData = await useSanityClient().fetch(skillquery);
} catch (err) {
  console.warn("Could not fetch skillsSection from Sanity:", err);
}

const rawLogos = skillsData?.logoCase || [];

// Map Sanity logo entries cleanly
const sanityLogoMap = new Map<string, string>();
rawLogos.forEach((item: any) => {
  const title = (item?.adminstrativetitle || item?.Logo?.alt || "").toLowerCase();
  const url = item?.Logo?.asset?.url;
  if (!url) return;
  if (title.includes('react')) sanityLogoMap.set('react', url);
  else if (title.includes('node')) sanityLogoMap.set('node', url);
  else if (title.includes('redux')) sanityLogoMap.set('redux', url);
  else if (title.includes('graphql')) sanityLogoMap.set('graphql', url);
  else if (title.includes('rest')) sanityLogoMap.set('rest', url);
  else if (title.includes('sanity')) sanityLogoMap.set('sanity', url);
  else if (title.includes('contentful')) sanityLogoMap.set('contentful', url);
  else if (title.includes('js') || title.includes('javascript')) sanityLogoMap.set('js', url);
  else if (title.includes('html')) sanityLogoMap.set('html', url);
  else if (title.includes('css')) sanityLogoMap.set('css', url);
});

// Streamlined, human-psychology-optimized skill categories (scannable in 3 seconds)
const skillGroups = [
  {
    title: "Frontend & Mobile",
    subtitle: "Web, Native & Reactive UI",
    icon: "code",
    skills: [
      { name: "React.js", logo: sanityLogoMap.get('react'), color: "#61DAFB", highlight: true },
      { name: "Next.js", color: "#FFFFFF", highlight: true },
      { name: "TypeScript", color: "#3178C6", highlight: true },
      { name: "React Native", color: "#61DAFB", highlight: true },
      { name: "Tailwind CSS", color: "#38BDF8" },
      { name: "Redux Toolkit", logo: sanityLogoMap.get('redux'), color: "#764ABC" },
      { name: "Astro", color: "#FF5D01" },
      { name: "HTML5 / CSS3", logo: sanityLogoMap.get('html'), color: "#E34F26" }
    ]
  },
  {
    title: "Backend & APIs",
    subtitle: "Services, Real-Time & Auth",
    icon: "server",
    skills: [
      { name: "Node.js", logo: sanityLogoMap.get('node'), color: "#47A248", highlight: true },
      { name: "Express.js", color: "#FFFFFF", highlight: true },
      { name: "REST APIs", logo: sanityLogoMap.get('rest'), color: "#6366F1", highlight: true },
      { name: "Socket.IO", color: "#010101", highlight: true },
      { name: "FastAPI", color: "#009688" },
      { name: "GraphQL", logo: sanityLogoMap.get('graphql'), color: "#E10098" }
    ]
  },
  {
    title: "Databases & Headless CMS",
    subtitle: "Storage, ORMs & Content",
    icon: "database",
    skills: [
      { name: "PostgreSQL", color: "#336791", highlight: true },
      { name: "MongoDB", color: "#47A248", highlight: true },
      { name: "Prisma ORM", color: "#2D3748", highlight: true },
      { name: "Sanity.io", logo: sanityLogoMap.get('sanity'), color: "#F03E2F", highlight: true },
      { name: "Contentful", logo: sanityLogoMap.get('contentful'), color: "#2478CC" },
      { name: "Strapi", color: "#8E75FF" }
    ]
  },
  {
    title: "AI, Cloud & Tools",
    subtitle: "LLMs, Pipelines & Workflow",
    icon: "cpu",
    skills: [
      { name: "OpenAI APIs", color: "#10A37F", highlight: true },
      { name: "Claude / Gemini", color: "#D97706", highlight: true },
      { name: "RAG & Prompts", color: "#5E6AD2", highlight: true },
      { name: "Git & Vercel", color: "#F05032" },
      { name: "Figma", color: "#F24E1E" },
      { name: "shadcn / MUI", color: "#000000" }
    ]
  }
];
---

<section id="skills" class="py-16 sm:py-24 md:py-32 relative z-10 border-t border-white/[0.10]">
  <div class="w-full">
    
    <SectionHeader 
      eyebrow="CORE STACK & TOOLS"
      title="The Stack" 
      gradientText="In Production" 
      subtitle="Core languages, frameworks, and architectural tools I use daily to ship fast, reliable software."
    />

    <!-- 4 Clean, Scannable Domain Cards (Parsed in 3 Seconds) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
      {skillGroups.map((group, idx) => (
        <div data-gsap-card class="bento-spotlight group relative rounded-[20px] bg-[#111726] border border-white/[0.10] p-6 flex flex-col justify-between hover:border-accent-primary/40 transition-all duration-300 shadow-[0_18px_45px_rgba(0,0,0,0.5)]">
          <!-- Subtle HUD Corner Crosshairs -->
          <span class="pointer-events-none absolute top-3 left-3 w-3.5 h-[1px] bg-white/35 group-hover:bg-accent-primary transition-colors"></span>
          <span class="pointer-events-none absolute top-3 left-3 w-[1px] h-3.5 bg-white/35 group-hover:bg-accent-primary transition-colors"></span>

          <div>
            <!-- Group Header -->
            <div class="flex items-center justify-between pb-4 mb-5 border-b border-white/[0.08]">
              <div>
                <span class="text-[10px] font-mono uppercase tracking-[0.14em] text-accent-primary font-bold block mb-1">0{idx + 1}/ DOMAIN</span>
                <h3 class="text-lg font-grotesk font-bold text-[#F8FAFC] tracking-[-0.025em]">
                  {group.title}
                </h3>
              </div>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-white/[0.04] border border-white/[0.08] text-[#38BDF8] font-semibold">
                [{group.skills.length}]
              </span>
            </div>

            <!-- Instant-Recognition Tech Chips -->
            <div class="flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <div 
                  class={`flex items-center gap-2 px-3 py-2 rounded-xl text-xs font-semibold tracking-wide transition-all duration-200 border cursor-default select-none ${
                    skill.highlight
                      ? 'bg-white/[0.08] border-white/25 text-[#F8FAFC] hover:border-accent-primary/60 hover:bg-white/[0.12] shadow-sm'
                      : 'bg-white/[0.03] border-white/[0.08] text-[#94A3B8] hover:border-white/20 hover:text-[#F8FAFC] hover:bg-white/[0.06]'
                  }`}
                >
                  <!-- Real Logo or Brand Accent Dot -->
                  {skill.logo ? (
                    <img 
                      src={skill.logo} 
                      alt={`${skill.name} logo`} 
                      width="16" 
                      height="16" 
                      loading="lazy" 
                      decoding="async" 
                      class="w-4 h-4 object-contain rounded-sm"
                    />
                  ) : (
                    <span 
                      class={`w-2 h-2 rounded-full shrink-0 ${skill.highlight ? 'bg-accent-primary' : 'bg-white/40'}`}
                    ></span>
                  )}
                  <span class="whitespace-nowrap">{skill.name}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Subtle Bottom Indicator -->
          <div class="mt-6 pt-3 border-t border-white/5 flex items-center justify-between text-[10px] font-mono text-[#64748B]">
            <span>Production Verified</span>
            <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>
          </div>

        </div>
      ))}
    </div>

    <!-- Quick Architectural Focus Bar (Clean & Reassuring) -->
    <div class="mt-8 p-4 md:p-5 rounded-2xl bg-white/[0.02] border border-white/5 flex flex-col md:flex-row items-start md:items-center justify-between gap-3 md:gap-4 text-xs font-mono text-text-muted">
      <div class="flex flex-wrap items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-accent-primary shrink-0"></span>
        <span class="text-white font-semibold">Primary Daily Driver:</span>
        <span class="text-text-primary">TypeScript • React / Next.js • Node.js • PostgreSQL</span>
      </div>
      <div class="flex flex-wrap items-center gap-3 sm:gap-6 text-[11px] text-text-dim">
        <span>Sub-100ms APIs</span>
        <span>•</span>
        <span>Strict Type Safety</span>
        <span>•</span>
        <span>Production AI Integrations</span>
      </div>
    </div>

  </div>
</section>
